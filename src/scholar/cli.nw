The run's rows are what the file returned, by its lines, or, without
a file, the selected papers, all in the batch [[--batch]] named.  Each
sheet is then compared with its batch's rows, by the papers both
name; an id of the sheet that names no paper of the session stays as
written, and so counts as missing.  One sheet is compared with every
row when it has no batch id or the rows name no batch: a screener
that dropped the [[# batch:]] line has still answered the one sheet
it was given, and comparing it with no row would hide its strays.
Every other row that no sheet's batch takes, a batch with no sheet or
rows without a batch id beside batched sheets, is not compared at all;
such rows are counted per batch ([[SheetCheck.uncompared]]) and
reported, never skipped in silence, since under [[--strict]] a row
nothing could check is refused like a row not on its sheet.

<<sessions command>>=
@dataclass(frozen=True)
class SheetComparison:
    """A sheet against the rows of its batch.

    `listed` is the number of ids on the sheet; `missing` the sheet's
    ids no row returned, in the sheet's order; `extra` the rows' ids
    that are not on the sheet, in the run's order.
    """

    sheet: ScreenSheet
    listed: int
    missing: tuple[str, ...]
    extra: tuple[str, ...]


def returned_rows(trace_of: dict, selected: dict, batch: str | None) -> list:
    """`(id as given, batch)` per row of a run, in the run's order."""
    if trace_of:
        lines = {id(entry): entry for entry in trace_of.values()}
        return [(entry.paper, entry.batch) for entry in
                sorted(lines.values(), key=lambda entry: entry.line)]
    return list(dict.fromkeys(
        (decision.paper.id, batch) for decision in selected.values()
    ))


@dataclass(frozen=True)
class SheetCheck:
    """The sheets against a run's rows.

    `uncompared` maps a batch id (None: no batch id) to the rows of the
    run that no sheet was compared with, as given, in the run's order.
    """

    comparisons: list[SheetComparison]
    uncompared: dict


def compare_with_sheets(sheets, rows, by_id: dict, by_doi: dict) -> SheetCheck:
    """Compare each sheet with the rows of its batch; count the rest."""
    def papers(value: str) -> set[str]:
        matches = decisions_named_by(value, by_id, by_doi)
        return {d.paper.id for d in matches} or {value}

    whole = len(sheets) == 1 and (
        sheets[0].batch is None
        or all(row_batch is None for _, row_batch in rows)
    )
    covered = {held.batch for held in sheets}
    uncompared: dict = {}
    if not whole:
        for value, row_batch in rows:
            if row_batch not in covered:
                uncompared.setdefault(row_batch, []).append(value)
    comparisons = []
    for held in sheets:
        batch_rows = [value for value, row_batch in rows
                      if whole or row_batch == held.batch]
        returned = set().union(*map(papers, batch_rows))
        listed = {value: papers(value) for value in held.ids}
        on_sheet = set().union(*listed.values())
        comparisons.append(SheetComparison(
            held, len(held.ids),
            tuple(value for value, named in listed.items()
                  if not named & returned),
            tuple(dict.fromkeys(value for value in batch_rows
                                if not papers(value) & on_sheet)),
        ))
    return SheetCheck(comparisons, {
        row_batch: tuple(dict.fromkeys(values))
        for row_batch, values in uncompared.items()
    })
