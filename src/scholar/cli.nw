    first_extra = 2 + len(layout.columns)
    extra = ", ".join(
        f"{index} ({column!r})"
        for index, column in enumerate(
            columns[first_extra - 1:], start=first_extra
        )
    )
    problems.append(
        f"line {number}: extra column {extra} after {layout.last} "
        f"({layout.holds}; a tab inside a reason starts a new column)"
    )
