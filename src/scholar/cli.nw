class TestBatchesInDecideAndScreen:
  """Batch ids and sheets in `sessions decide` and `screen` (#292)."""

  def _setup(self, tmp_path, monkeypatch, count):
    helper = TestDecideChecksTheBatch()
    path, _ = helper._make_session(tmp_path, monkeypatch, count)
    return helper, path

  def test_each_named_batch_is_checked(self, tmp_path, monkeypatch):
    from scholar.review import load_session

    helper, path = self._setup(tmp_path, monkeypatch, 60)
    reasons = helper._file(tmp_path, (
      ["# batch: b-1"]
      + [f"doi:10.1/batch-{n}\tWork {n} is about topic {n}, not ours."
         f"\t{(0.6, 0.75, 0.9)[n % 3]}" for n in range(30)]
      + ["# batch: b-2"]
      + [f"doi:10.1/batch-{n}\tWork {n} studies topic {n} instead."
         "\t0.85" for n in range(30, 60)]
    ))
    before = path.read_bytes()
    refused = helper._decide("--reasons-file", reasons, "--strict")
    assert refused.exit_code == 2, refused.output
    assert "--strict: the batch has 1 batch finding(s)." in refused.output
    assert path.read_bytes() == before
    result = helper._decide("--reasons-file", reasons)
