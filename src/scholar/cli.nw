    from dataclasses import asdict

    print(
        _json.dumps(
            [asdict(candidate) for candidate in candidates],
            ensure_ascii=False,
            indent=2,
        )
    )
    return

if not candidates:
    err_console.print("[yellow]No candidate passages found.[/yellow]")
    return

for candidate in candidates:
    <<print a quote candidate>>
