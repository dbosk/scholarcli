    assert drawn.exit_code == 0, drawn.output
    for sample in load_session("cli-bands-kept").llm_samples:
        for paper in sample.papers:
            decided = runner.invoke(app, [
                "sessions", "decide", "cli-bands-kept", "--discard",
                "--paper-id", paper["paper_id"], "--tag", "off-topic",
                "--source", "human",
            ])
            assert decided.exit_code == 0, decided.output
    session_file_path(load_session("cli-bands-gone")).unlink()
    reported = runner.invoke(
        app, ["llm", "sample", "cli-bands-kept", "--report", "-f", "json"])
    (report,) = json.loads(reported.output)
    assert report["not_found"] == 2 and report["unreviewed"] == []
    assert report["estimate"] is None
    assert report["estimate_withheld"].startswith(
        "no estimate for the whole population is given while sampled "
        "decisions are not found")
