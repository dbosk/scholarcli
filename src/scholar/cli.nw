def test_a_later_decision_replaces_the_reason(self, tmp_path, monkeypatch):
  from scholar.review import load_session

  self._make_session(tmp_path, monkeypatch)
  first = ("--source", "agent", "--doi", "10.1/one")
  steps = (
    (("--keep", "--tag", "ml", "--reason", "First.", "--by", "a"),
     ("First.", "a")),
    (("--discard", "--tag", "off-topic-false-hit", "--reason",
      "Second."), ("Second.", None)),
    (("--discard", "--tag", "off-topic-false-hit"), (None, None)),
    (("--keep", "--tag", "ml", "--reason", "Third.", "--by", "b"),
