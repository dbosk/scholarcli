class TestProvPaperId:
    """The provenance block carries the paper id (#230)."""

    LOSSY = "Developers’ “view” – a study"

    @staticmethod
    def _paper(title, **fields):
        from scholar import Paper
        return Paper(title=title, authors=fields.pop("authors", ["A B"]),
                     year=2024, **fields)

    def _stub(self, tmp_path, paper, capsys):
        """Write `paper` as `search -f bibtex+prov` does, CLAIM filled."""
        BibTeXProvFormatter().format([SearchResult(
            query="q", provider="dblp", timestamp="2024-01-01T00:00:00",
            papers=[paper],
        )])
        text = capsys.readouterr().out.replace("% CLAIM: TODO",
                                               "% CLAIM: stubbed")
        bib = tmp_path / "refs.bib"
        bib.write_text(text, encoding="utf-8")
        return bib

    @staticmethod
    def _notes():
        from scholar.notes import list_papers_with_notes
        return {n.paper_id: n for n in list_papers_with_notes()}

    def test_the_stub_names_the_paper(self, tmp_path, capsys):
        paper = self._paper(self.LOSSY)
        text = self._stub(tmp_path, paper, capsys).read_text()
        assert f"% ID: {paper.id}\n" in text

    def test_import_keys_a_lossy_title_by_the_recorded_id(
        self, tmp_path, monkeypatch, capsys
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        paper = self._paper(self.LOSSY)
        bib = self._stub(tmp_path, paper, capsys)
        assert CliRunner().invoke(
            app, ["prov", "import", str(bib)]).exit_code == 0
        notes = self._notes()
        assert list(notes) == [paper.id]
        assert "CLAIM: stubbed" in notes[paper.id].note
        assert "ID:" not in notes[paper.id].note

    def test_export_writes_the_id_of_the_note(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import save_note
        paper = self._paper("R&D in practice")
        save_note(paper, "=== provenance: b2024 ===\nCLAIM: c")
        bib = tmp_path / "refs.bib"
        bib.write_text(
            BibTeXFormatter()._format_paper(paper, "b2024") + "\n",
            encoding="utf-8")
        result = CliRunner().invoke(app, ["prov", "export", str(bib)])
        assert result.exit_code == 0
        assert f"% ID: {paper.id}\n% CLAIM: c" in result.output

    def test_a_file_without_the_id_meets_an_escaped_author(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import save_note
        paper = self._paper("A talk", authors=["Conan O’Brien"])
        save_note(paper, "=== provenance: b2024 ===\nCLAIM: from the TUI")
        bib = tmp_path / "refs.bib"
        bib.write_text(
            BibTeXFormatter()._format_paper(paper, "b2024") + "\n",
            encoding="utf-8")
        assert "O'Brien" in bib.read_text()
        result = CliRunner().invoke(app, ["prov", "export", str(bib)])
        assert "% CLAIM: from the TUI" in result.output

    def test_a_note_keyed_by_hand_escaped_text_is_continued(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import save_note
        old = self._paper(r"R\&D in practice")
        save_note(old, "=== provenance: b2024 ===\nCLAIM: old")
        bib = tmp_path / "refs.bib"
        bib.write_text(
            "% === provenance: b2024 ===\n% CLAIM: new\n"
