  first, third = self._id(1), self._id(3)
  assert self._run("--record", first, "--record", third).exit_code == 0
  assert [m is not None for m in self._marks()] \
    == [True, False, True, False]
  again = self._run("--record", first[:4])
  assert f"[{first}] openalex: draft --limit 50 is already retired" \
    in " ".join(again.output.split())
  result = self._run("--record", third, "--undo")
  assert result.exit_code == 0, result.output
  assert "Made 1 search record(s) current" in result.output
  assert [m is not None for m in self._marks()] \
    == [True, False, False, False]

