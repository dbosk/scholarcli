class TestSessionsCheckSnippets:
  """sessions check --backend s2-snippets."""

  ANSWER = {"data": [
    {"score": 0.9, "snippet": {"snippetKind": "body"},
     "paper": {"corpusId": "1", "title": "Kept one", "authors": ["Ann"]}},
    {"score": 0.8, "snippet": {"snippetKind": "abstract"},
     "paper": {"corpusId": "1", "title": "Kept one", "authors": ["Ann"]}},
    {"score": 0.7, "snippet": {"snippetKind": "title"},
     "paper": {"corpusId": "2", "title": "Missed one", "authors": ["Bo"]}},
  ]}
  BATCH = [
    {"paperId": "p1", "externalIds": {"DOI": "10.1/KEPT"}, "year": 2020},
    None,
  ]

  def _setup(self, tmp_path, monkeypatch, batch=(200, None)):
    import requests
    import requests.adapters
    from scholar.review import (
      ReviewSession, ReviewDecision, DecisionStatus, save_session,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime.now(), name="kw")
    session.decisions.append(ReviewDecision(
      paper=Paper(title="Kept one", authors=["Ann"], doi="10.1/kept"),
      provider="openalex", status=DecisionStatus.KEPT,
      tags=["supports-claim"],
    ))
    save_session(session)
    sent = []
    status, body = batch
    answers = [(200, self.ANSWER), (status, body or self.BATCH)]

    def send(adapter, request, **kwargs):
      sent.append(request.url)
      status, payload = answers.pop(0)
      response = requests.Response()
      response.status_code = status
      response.headers["Content-Type"] = "application/json"
      response._content = json.dumps(payload).encode()
      response.url = request.url
      response.request = request
      return response

    monkeypatch.setattr(requests.adapters.HTTPAdapter, "send", send)
    return sent

