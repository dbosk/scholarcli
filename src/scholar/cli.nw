QUOTE_MARK = "quote not in title or abstract"


def reason_quotes_line(tally: dict) -> str:
    """The `sessions show` summary of the quote check, or "" if no reason."""
    reasons = sum(counts["reasons"] for counts in tally.values())
    if not reasons:
        return ""
    checked = sum(counts["checked"] for counts in tally.values())
    unmatched = sum(counts["unmatched"] for counts in tally.values())
    return (
        f"Reasons: {reasons} recorded, {checked} with quotes checked, "
        f"{unmatched} with a quote not found in the record's title or "
        "abstract"
    )
