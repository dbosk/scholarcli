            Paper(title="Answer", authors=["A"], doi="10.1/skip-answer"),
        ]
        monkeypatch.setattr(providers, "PROVIDERS", {"blockable": mock})
        return mock

    @staticmethod
    def _block():
        from scholar import ratelimit
        ratelimit.get_limiter("blockable").record_limit_hit(
            reason="daily quota spent", exhausted_daily=True
        )

    def test_skip_is_recorded_and_shown(self, tmp_path, monkeypatch):
        from scholar.review import load_session

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        mock = self._provider(monkeypatch)
        self._block()
        result = runner.invoke(
            app, ["search", "q", "-n", "skipped", "-f", "csv"]
        )
        mock.search.assert_not_called()
        assert "# Results: failed (skipped: daily quota spent; resets " \
            in result.stdout
        record = load_session("skipped").search_records[0]
        assert record.provider == "blockable"
        assert record.hits == 0
        assert record.error.startswith("skipped: daily quota spent")

    def test_skip_keeps_an_earlier_answer(self, tmp_path, monkeypatch):
        from scholar.review import load_session

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        self._provider(monkeypatch)
        runner.invoke(app, ["search", "q", "-n", "kept", "-f", "csv"])
        self._block()
        runner.invoke(app, ["search", "q", "-n", "kept", "-f", "csv"])
        records = load_session("kept").search_records
        assert [(r.hits, r.error) for r in records] == [(1, None)]
