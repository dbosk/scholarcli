        self._make_session(tmp_path, monkeypatch)
        result = self._decide("--keep", "--doi", "10.1/withdoi")
        assert result.exit_code == 2
        assert "pass --source human|agent|llm" in result.output
        assert load_session("headless").kept_papers() == []

    def test_a_terminal_defaults_to_human(self, tmp_path, monkeypatch):
        import os
        import subprocess
        import sys

        pty = pytest.importorskip("pty")
        from scholar.review import ReviewSource, load_session

        self._make_session(tmp_path, monkeypatch)
        leader, follower = pty.openpty()
        try:
            completed = subprocess.run(
                [sys.executable, "-c",
                 "from scholar.cli import main; main()",
                 "sessions", "decide", "headless",
                 "--keep", "--doi", "10.1/withdoi"],
                stdin=follower, capture_output=True, text=True,
                timeout=120, env=dict(os.environ),
            )
        finally:
            os.close(leader)
            os.close(follower)
        assert completed.returncode == 0, completed.stdout + completed.stderr
        kept = load_session("headless").kept_papers()
        assert [d.source for d in kept] == [ReviewSource.HUMAN]
        assert [d.human_decided_via for d in kept] == ["decide"]

