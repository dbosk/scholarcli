def test_from_filters(self, tmp_path, monkeypatch):
  from scholar.review import ReviewSource, load_session

  self._make_session(tmp_path, monkeypatch)
  result = self._relabel("--from", "human", "--to", "llm", "--all")
  assert result.exit_code == 0, result.output
  assert [d.source for d in load_session("relabel").decisions] == [
    ReviewSource.LLM_UNREVIEWED, ReviewSource.LLM_REVIEWED,
    ReviewSource.HUMAN, ReviewSource.LLM_UNREVIEWED,
  ]
  assert [len(d.relabelled) for d in load_session("relabel").decisions] \
    == [1, 0, 0, 0]
  named = self._relabel("--from", "human", "--to", "agent",
                        "--doi", "10.1/reviewed", "--doi", "10.1/pending")
  assert named.exit_code == 0, named.output
  flat = " ".join(named.output.split())
