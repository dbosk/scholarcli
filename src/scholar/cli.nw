Ctrl-C during the wait must keep the session as a refusal does, and
end with the one line and exit code 130, not a traceback.  The saver
runs [[sessions decide]] through the entry point in a process of its
own, with a long timeout and an early notice; when the notice appears
on its standard error, the test sends it SIGINT.

<<test functions>>=
class TestInterruptedWait:
  """Ctrl-C while waiting for the lock keeps the session (#316)."""

  SAVER = """
    import sys
    import scholar.review as review
    review.SESSION_LOCK_TIMEOUT = 120
    review.SESSION_LOCK_NOTICE = 0.3
    from scholar.cli import main
    sys.argv = ["scholar", "sessions", "decide", "locked", "--keep",
                "--doi", "10.5555/locked-0", "--source", "human"]
    main()
  """

  def test_ctrl_c_keeps_the_session(self, tmp_path, monkeypatch):
    import json
    import signal
    import subprocess
    import textwrap
    from scholar.review import unsaved_session_files
    path = TestRefusedSaveCommands._session(tmp_path, monkeypatch)
    before = path.read_bytes()
    holder = TestRefusedSaveCommands._hold("locked")
    try:
      saver = subprocess.Popen(
        [sys.executable, "-c", textwrap.dedent(self.SAVER)],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True,
      )
      seen = []
      for line in saver.stderr:
        seen.append(line)
        if "is locked by another scholar process" in line:
          break
      assert "Ctrl-C stops waiting" in "".join(seen)
      saver.send_signal(signal.SIGINT)
      _, rest = saver.communicate(timeout=60)
    finally:
      holder.communicate("go\n", timeout=60)
    err = "".join(seen) + rest
    assert saver.returncode == 130, err
    assert "Traceback" not in err
    assert "the wait for its lock was interrupted" in err
    assert path.read_bytes() == before
    [kept] = unsaved_session_files()
    assert str(kept) in " ".join(err.split()) or str(kept) in err
    statuses = [d["status"] for d in json.loads(kept.read_text())[
      "decisions"]]
    assert statuses == ["kept", "pending"]
