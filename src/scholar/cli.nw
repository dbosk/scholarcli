def _session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    save_session,
  )

  save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="humans", decisions=[
      ReviewDecision(paper=Paper(title="One", authors=["A"],
                                 doi="10.1/one"), provider="openalex"),
      ReviewDecision(paper=Paper(title="Two", authors=["A"],
                                 doi="10.1/two"), provider="openalex"),
      ReviewDecision(paper=Paper(title="Agent", authors=["A"],
                                 doi="10.1/agent"), provider="openalex",
                     status=DecisionStatus.DISCARDED, tags=["off-topic"],
                     source=ReviewSource.AGENT_UNREVIEWED,
                     llm_confidence=0.7),
    ],
  ))

def _decide(self, *args):
  return runner.invoke(app, ["sessions", "decide", "humans", *args])

def _decisions(self):
  from scholar.review import load_session

  return {d.paper.title: d for d in load_session("humans").decisions}

def _clock(self, monkeypatch, at):
  import scholar.utils

  monkeypatch.setattr(scholar.utils, "utc_now_iso", lambda: at)

def test_a_human_decision_is_recorded(self, tmp_path, monkeypatch):
  self._session(tmp_path, monkeypatch)
  self._clock(monkeypatch, "2026-11-20T09:00:00+00:00")
  result = self._decide("--source", "human", "--keep", "--tag", "ml",
                        "--doi", "10.1/one", "--doi", "10.1/two",
                        "--by", "the author")
  assert result.exit_code == 0, result.output
  decisions = self._decisions()
  for title in ("One", "Two"):
    assert (decisions[title].human_decided_at,
            decisions[title].human_decided_via,
            decisions[title].human_by) \
      == ("2026-11-20T09:00:00+00:00", "decide", "the author")
  assert decisions["Agent"].human_decided_at is None

def test_a_confirmation_is_recorded(self, tmp_path, monkeypatch):
  from scholar.review import ReviewSource

  self._session(tmp_path, monkeypatch)
  result = self._decide("--source", "human", "--discard",
                        "--tag", "off-topic", "--doi", "10.1/agent")
  assert result.exit_code == 0, result.output
  agent = self._decisions()["Agent"]
  assert agent.source is ReviewSource.AGENT_REVIEWED
  assert agent.human_decided_via == "decide"
  assert agent.human_by is None
  assert agent.human_decided_at.endswith("+00:00")

