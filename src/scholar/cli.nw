    help="LLM-assisted paper classification.",
    no_args_is_help=True,
)
app.add_typer(llm_app, name="llm")


@llm_app.command("classify")
def llm_classify(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name to classify papers in.",
            autocompletion=complete_session_name,
        ),
    ],
    count: Annotated[
        int,
        typer.Option(
            "--count", "-n",
            help="Number of papers to classify in this batch.",
        ),
    ] = 10,
    model: Annotated[
        str | None,
        typer.Option(
            "--model", "-m",
            help="Base LLM model to use (uses llm default if not specified).",
            autocompletion=complete_model,
        ),
    ] = None,
    model_analytic: Annotated[
        str | None,
        typer.Option(
            "--model-analytic",
            help="Override -m for analytic tasks (classification, query generation).",
            autocompletion=complete_model,
        ),
    ] = None,
    model_writing: Annotated[
        str | None,
        typer.Option(
            "--model-writing",
            help="Override -m for writing tasks (synthesis generation).",
            autocompletion=complete_model,
        ),
    ] = None,
     dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Show the prompt without calling LLM.",
        ),
    ] = False,
    no_enrich: Annotated[
        bool,
        typer.Option(
            "--no-enrich",
            help="Skip automatic enrichment of papers without abstracts.",
        ),
    ] = False,
    no_examples: Annotated[
        bool,
        typer.Option(
            "--no-examples",
            help="Skip examples entirely for zero-shot classification, "
            "even if some exist.",
        ),
    ] = False,
    full_text: Annotated[
        bool,
        typer.Option(
            "--full-text",
            help="Classify using supporting passages from each paper's full "
            "text, not just the abstract (needs a research context).",
        ),
    ] = False,
    tag: Annotated[
        Optional[list[str]],
        typer.Option(
            "--tag", "-t",
            help="Add TAG to the vocabulary the model must use (repeatable; "
                 "tags already used in the session are always included).",
        ),
    ] = None,
    allow_new_tags: Annotated[
        bool,
        typer.Option(
            "--allow-new-tags",
            help="Let the model propose tags outside the vocabulary instead "
                 "of dropping them.",
        ),
    ] = False,
    include_llm_examples: Annotated[
        bool,
        typer.Option(
            "--include-llm-examples",
            help="Also use unreviewed LLM decisions as examples (by default "
                 "only human or human-confirmed decisions are).",
        ),
    ] = False,
) -> None:
    """
    Classify pending papers using LLM.

    Uses human-reviewed papers as training examples when available. Tagged
    examples are recommended (ideally 5+, with at least 1 kept and 1
    discarded) but no longer required: if too few exist, a warning is shown
    and classification proceeds with whatever examples are present. Pass
    --no-examples to skip examples entirely and run zero-shot classification
    using only the research context, even when examples are available.
    Examples are decisions a human made or confirmed; unreviewed LLM
    decisions are used too only with --include-llm-examples.

    With --full-text, supporting passages from each paper's PDF (matched
    against the research context) are added to the prompt, so classification
    can go beyond the abstract.

    The tags already used in the session form the vocabulary the model must
    stay within; tags it invents are dropped (with a warning) and the batch
    is retried once. --tag adds tags to that vocabulary, so a fresh session
    can be constrained from the first batch; --allow-new-tags asks the model
    to prefer the vocabulary but lets it add tags when none fits.

    When the vocabulary holds audit categories (supports-claim,
    qualifies-claim, adjacent-subtopic, off-topic-false-hit), every paper
    must get exactly one of them; a paper that does not, even after the
    retry, is left pending and listed at the end. Note tags such as
    duplicate-record-of-cited-source are for humans and never assigned.
    So is a paper whose answer is unusable (no answer, a decision other
    than kept/discarded, a missing or out-of-range confidence): nothing
    is filled in for the model.

    Each decision records the model, the time (UTC), a prompt version,
    the model's reason and whether the abstract was truncated.

    Example:
        scholar llm classify "my review" --count 20
        scholar llm classify "my review" --no-examples
        scholar llm classify "my review" --full-text
        scholar llm classify "my review" -t supports-claim -t qualifies-claim
        scholar llm classify "my review" --allow-new-tags
    """
    import scholar.review as review
    from scholar.review import save_session
    from scholar.utils import LLMModelSelection, select_model_id
    from scholar.llm_review import (
        classify_papers_with_llm,
        apply_llm_decisions,
        get_review_statistics,
    )

    console = Console()
    session = open_session_argument(session_name)

    if session is None:
        console.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)

    model_selection = LLMModelSelection(
        base=model,
        analytic=model_analytic,
        writing=model_writing,
    )

    try:
        result = classify_papers_with_llm(
            session=session,
            count=count,
            model_id=select_model_id(model_selection, "analytic"),
            enrich_missing=not no_enrich,
            dry_run=dry_run,
            require_examples=not no_examples,
            use_fulltext=full_text,
            vocabulary=set(tag) if tag else None,
            allow_new_tags=allow_new_tags,
            include_llm_examples=include_llm_examples,
        )

        if dry_run:
            console.print("[bold]Prompt (dry run):[/bold]")
            console.print(result)
            return

        # Apply decisions
        updated = apply_llm_decisions(session, result)

        # Save session
        save_session(session)

        # Show summary
        stats = get_review_statistics(session)
        console.print(f"[green]Classified {len(updated)} papers[/green]")
        console.print(f"  Model: {result.model_id}")
        console.print(f"  Prompt version: {result.prompt_version}")
        console.print(f"  LLM unreviewed: {stats['llm_unreviewed']}")
        console.print(f"  Pending: {stats['pending']}")
        <<report papers left pending by the classifier>>
        <<report reasons quoting words not in the record>>

    except ValueError as e:
        console.print(f"[red]Error: {escape(str(e))}[/red]")
        raise typer.Exit(1)
    except ImportError as e:
        console.print(f"[red]{escape(str(e))}[/red]")
        raise typer.Exit(1)


