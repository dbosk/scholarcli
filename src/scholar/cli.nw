def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, LLMSample, ReviewDecision, ReviewSession,
    ReviewSource, SearchRecord, new_screening, record_human_decision,
    record_screening, relabel_source, reset_decision, retire_record,
    save_session, set_abstract,
  )
  kept, discarded = DecisionStatus.KEPT, DecisionStatus.DISCARDED
  agent, llm = ReviewSource.AGENT_UNREVIEWED, ReviewSource.LLM_UNREVIEWED

  def decision(title, doi=None, status=DecisionStatus.PENDING, tags=(),
               source=ReviewSource.HUMAN, provider="openalex", **kw):
    return ReviewDecision(
      paper=Paper(title=title, authors=["Ada Lovelace"], year=2021,
                  doi=doi),
      provider=provider, status=status, tags=list(tags), source=source,
      **kw)

  human = decision(
    "A long title about teaching recursion to first-year students in "
    "2019 and 2020, with 3 case studies, see "
    "https://example.org/recursion for the data and more words to wrap",
    "10.5555/pin-1", kept, ["recursion", "supports-claim"])
  record_human_decision(human, "decide", by="a reviewer",
                        at="2026-11-01T10:00:00+00:00")
  reasoned = decision(
    "Agent kept this", "10.5555/pin-2", kept,
    ["recursion", "adjacent-subtopic"], agent, llm_confidence=0.8,
    agent_reason='It says "treated recursion as a loop" and ' + "more " * 40,
    agent_by="agent-7", agent_decided_at="2026-11-02T10:00:00+00:00")
  reasoned.paper.abstract = "Most students treated recursion as a loop."
  marked_up = decision(
    "Classifier kept [bold]this[/bold] \\ and [link=x]that",
    "10.5555/pin-3", kept, ["loops", "qualifies-claim"], llm,
    llm_model="m-1", llm_reason='Quotes "recursion was taught late".',
    provider="openalex, dblp")
  relabelled = decision(
    "Relabelled to the agent", "10.5555/pin-4", discarded,
    ["off-topic-false-hit"], ReviewSource.LLM_REVIEWED, llm_model="m-1")
  relabel_source(relabelled, agent, at="2026-11-03T10:00:00+00:00")
  drifted = decision(
    "Relabelled, then changed", "10.5555/pin-5", discarded,
    ["off-topic-false-hit"], ReviewSource.LLM_REVIEWED)
  relabel_source(drifted, agent, at="2026-11-03T10:00:00+00:00")
  drifted.source = llm
  reset = decision("Reset to pending", "10.5555/pin-6", discarded,
                   ["no-abstract"], llm, llm_model="m-1")
  reset_decision(reset, at="2026-11-04T10:00:00+00:00")
  hand = decision("Abstract given by hand", "10.5555/pin-7")
  set_abstract([hand], "An abstract found elsewhere.", "Crossref",
               at="2026-11-05T10:00:00+00:00")
  wide = decision(
    "Unicode: café, Müller, 中文标题 and :smile: "
    "in a title that is long enough to wrap at eighty columns",
    "10.5555/pin-8", discarded, ["off-topic-false-hit", "naïve"])
  screened = decision(
    "Screened twice", "10.5555/pin-10", discarded,
    ["off-topic-false-hit"], llm, llm_model="m-1",
    llm_reason="Not about it.", llm_decided_at="2026-11-01T00:00:00+00:00")
  record_screening(screened, new_screening(
    kind="agent", name="a:id:2", status="kept",
    tags=["adjacent-subtopic"],
    reason="Background.", recorded_at="2026-11-02T00:00:00+00:00"))
  namesake = decision("Namesake", None, kept, ["loops"])
  namesake.paper.year = 2020
  namesake.same_id_copies = [
    {"year": 1990, "venue": "Old Venue", "provider": "dblp"}]
  copies = [
    decision("Copy work A", "10.5555/pin-a", kept, ["recursion"]),
    decision("Copy work A", None, discarded, ["off-topic-false-hit"],
             provider="dblp"),
    decision("Copy work B", "10.5555/pin-b", kept, ["recursion"]),
    decision("Copy work B", None, kept, ["loops"], provider="dblp"),
    decision("Copy work C", "10.5555/pin-c", kept, ["recursion"]),
    decision("Copy work C", None, provider="dblp"),
    decision("Copy work D", "10.5555/pin-d", kept, ["recursion"]),
    decision("Copy work D!", None, provider="dblp"),
    namesake,
  ]
  records = [
    SearchRecord("recursion AND novices", "openalex", None, 100, hits=42,
                 searched_at="2026-11-01T09:00:00+00:00",
                 fetched_at="2026-10-01T09:00:00+00:00", from_cache=True),
    SearchRecord("recursion", "s2", None, 0, hits=784, via="bulk",
                 total=784, total_estimated=True),
