One query run with two filter sets is two searches
(\url{https://github.com/dbosk/scholar/issues/140}), and a paper each
run returned must name its own run, filter flags included.  An old
two-part link that both runs match is reported as not reproducible, with
both runs as the candidates---not the provider's other searches, which
the link rules out---never as a guessed FOUND-VIA line.  The
sessions are built through the real [[create_review_session]], as
[[search -n]] builds them, and the old file is written by hand in the
format of the time.

<<test functions>>=
class TestFoundViaFilters:
  """prov found-via tells runs with different filters apart (#140)."""

  @staticmethod
  def _search_into(session_name, papers, year, query="Q"):
    from scholar.review import create_review_session, save_session
    from scholar.scholar import SearchResult
    result = SearchResult(
      query=query, provider="openalex", timestamp="t", papers=papers,
      filters={"year": year},
    )
    save_session(
      create_review_session([result], query, session_name=session_name)
    )

  def test_each_paper_names_its_own_run(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    old = Paper(title="Old", authors=["A"], year=2015, doi="10.1/fv-old")
    new = Paper(title="New", authors=["B"], year=2022, doi="10.1/fv-new")
    self._search_into("fv", [old], "2010-2019")
    self._search_into("fv", [new], "2020-2024")

    for paper, year in ((old, "2010-2019"), (new, "2020-2024")):
      result = runner.invoke(
        app, ["prov", "found-via", paper.id, "-f", "json"]
      )
      records = json.loads(result.output)
      assert [r["command"] for r in records] == [
        f"scholar search Q -p openalex --year {year}"
      ]
      assert records[0]["link"] == "recorded"

  def test_ambiguous_old_link_is_not_reproducible(
    self, tmp_path, monkeypatch
  ):
    from scholar.review import _get_sessions_dir
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    paper = Paper(title="P", authors=["A"], year=2015, doi="10.1/fv-amb")
    self._search_into("fv", [paper], "2010-2019")
    self._search_into("fv", [], "2020-2024")
    self._search_into("fv", [], "2020-2024", query="Other")
    path = _get_sessions_dir() / "fv.json"
    data = json.loads(path.read_text())
    for decision in data["decisions"]:
      for link in decision["found_by"]:
        del link["filters"]
    path.write_text(json.dumps(data))

    result = runner.invoke(app, ["prov", "found-via", paper.id])
    assert result.exit_code == 0
    assert "FOUND-VIA:" not in result.output
    assert "Not reproducible:" in result.output

    as_json = runner.invoke(
      app, ["prov", "found-via", paper.id, "-f", "json"]
    )
    records = json.loads(as_json.output)
    assert [r["link"] for r in records] == ["missing"]
    assert records[0]["command"] is None
    assert records[0]["candidate_commands"] == [
      "scholar search Q -p openalex --year 2020-2024",
      "scholar search Q -p openalex --year 2010-2019",
    ]
