<<decide reason test methods>>=
def _refused(self, path, result, code, message):
  assert result.exit_code == code, result.output
  assert message in " ".join(result.output.split()), result.output
  assert path.read_bytes() == self._content

def test_usage_errors(self, tmp_path, monkeypatch):
  _, path = self._make_session(tmp_path, monkeypatch)
  self._content = path.read_bytes()
  good = self._file(tmp_path, "10.1/one\tFine.\n")
  keep = ("--keep", "--tag", "ml")
  cases = (
    (("--source", "llm", "--doi", "10.1/one", "--reason", "Why."),
     "recorded by `scholar llm classify`"),
    (("--source", "human", "--doi", "10.1/one", "--reason", "Why."),
     "a human's reason is not recorded"),
    (("--source", "human", "--reasons-file", good),
     "a human's reason is not recorded"),
    (("--source", "agent", "--doi", "10.1/one", "--by", "a"),
     "--by names who gave the reason"),
    (("--source", "agent", "--reasons-file", good, "--reason", "Why."),
     "not both"),
    (("--source", "agent", "--reasons-file", good, "--doi", "10.1/one"),
     "selects the papers itself"),
    (("--source", "agent", "--doi", "10.1/one", "--reason", "  "),
     "--reason: empty reason"),
    (("--source", "agent", "--doi", "10.1/one", "--reason", "x" * 2001),
     "reason of 2001 characters, over the limit of 2000"),
    (("--source", "agent", "--doi", "10.1/one", "--reason", "Why.",
      "--by", " "), "--by: empty name"),
  )
  for args, message in cases:
    result = self._decide(*keep, *args)
    self._refused(path, result, 2, message)
    elsewhere = runner.invoke(app, [
      "sessions", "decide", "no-such-session", *keep, *args,
    ])
    assert elsewhere.exit_code == 2, (args, elsewhere.output)
  result = self._decide(*keep, "--source", "agent", "--doi", "10.1/one",
                        "--reason", "x" * 2000)
  assert result.exit_code == 0, result.output

