Selection keeps every decision of a selected paper, in session order,
and collects the selectors that match nothing so that one run names all
typos.  Of the selected decisions, those that are decided and hold a
[[--from]] source are relabelled; with explicit selectors the others
are named, with what they hold.

<<select the decisions to relabel>>=
if all_papers:
    selected = list(session.decisions)
else:
    wanted_dois = {v.strip().lower(): v for v in doi or []}
    wanted_ids = set(paper_id or [])
    selected = [
        d for d in session.decisions
        if d.paper.id in wanted_ids
        or (d.paper.doi and d.paper.doi.strip().lower() in wanted_dois)
    ]
    found_dois = {
        d.paper.doi.strip().lower() for d in selected if d.paper.doi
    }
    found_ids = {d.paper.id for d in selected}
    missing = [
        f"DOI {v}" for k, v in wanted_dois.items() if k not in found_dois
    ] + [f"paper id {v}" for v in paper_id or [] if v not in found_ids]
    if missing:
        for entry in missing:
            console.print(f"[red]Not in session: {escape(entry)}[/red]")
        console.print("[yellow]No changes saved.[/yellow]")
        raise typer.Exit(1)
chosen = [
    d for d in selected if d.is_decided and d.source.value in sources
]
if not all_papers:
    for d in selected:
        if d not in chosen:
            console.print(
                f"[yellow]{escape(d.paper.id)} is {d.status.value} "
                f"({escape(d.source.value)}); not relabelled.[/yellow]"
            )
