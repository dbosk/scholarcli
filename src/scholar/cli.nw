  data["decisions"][0]["source"] = "manual"
  path.write_text(json.dumps(data))
  result = self._relabel("--from", "manual", "--to", "agent", "--all")
  assert result.exit_code == 0, result.output
  decision = load_session("relabel").decisions[0]
  assert decision.source is ReviewSource.AGENT_UNREVIEWED
  assert decision.relabelled[0]["from"] == "manual"

def test_sessions_show_names_the_correction(self, tmp_path, monkeypatch):
  import json

  path = self._make_session(tmp_path, monkeypatch)
  self._relabel("--from", "human", "--to", "llm", "--all")
  self._relabel("--from", "llm", "--to", "agent", "--doi", "10.1/human")
  flat = " ".join(runner.invoke(
    app, ["sessions", "show", "relabel"]
  ).output.split())
  assert "Human (openalex) [supports-claim, ml] (agent, unreviewed) " \
    "(relabelled from llm)" in flat
  assert "Unreviewed (openalex) [ml] (LLM, unreviewed) doi:10.1/llm" \
    in flat
  data = json.loads(
    runner.invoke(app, ["sessions", "show", "relabel", "-f", "json"]).output
  )
  assert [r["to"] for r in data["decisions"][0]["relabelled"]] \
    == ["llm", "agent"]
  assert "relabelled" not in data["decisions"][1]
  stale = json.loads(path.read_text())
  stale["decisions"][0]["source"] = "llm"
  path.write_text(json.dumps(stale))
  flat = " ".join(runner.invoke(
    app, ["sessions", "show", "relabel"]
  ).output.split())
  assert "(relabelled from llm to agent, now llm)" in flat
@

\subsection{Setting decisions back to pending}
\label{sec:sessions-reset}

A screen that turns out flawed should be redone in the session that
holds it, so that its search record (queries, providers, hits, dates)
stays what the report states
(\url{https://github.com/dbosk/scholarcli/issues/248}).  [[llm
classify]] classifies pending papers only, so the papers must first be
set back to pending.  [[sessions reset]] does that through
[[reset_decision]] (\cref{sec:reset-decision} of the review module,
which explains what a reset clears, why the source becomes [[human]]
and what the reset history keeps), and is modelled on [[sessions
relabel]] (\cref{sec:sessions-relabel}).

Papers are selected by [[--doi]] and [[--paper-id]], by [[--all]], or
by [[--source]] alone, which selects every paper whose decision has one
of the given sources.  [[--source]] is repeatable and takes comma
lists, like relabel's [[--from]]; given together with [[--doi]],
[[--paper-id]] or [[--all]] it narrows their selection.  One of these
forms is required, so that no bare command resets a session, and
[[--all]] together with explicit selectors is a usage error, as in
relabel.  A [[--doi]] or [[--paper-id]] that matches no paper aborts the
batch unsaved (exit status~1), as in [[sessions decide]].  A
[[--source]] that matches no decision is not an error: it is a filter,
and a script that resets [[--source llm]] twice finds nothing to do the
second time, because a reset paper is pending.  A [[--source]] value
that Scholar does not know and no decision holds is a misspelling, and
is refused as relabel refuses one.  As in relabel, a selector picks
every decision of a paper.

Pending papers are skipped, and named when they were selected by id;
so are papers that [[--source]] leaves out.  A selected decision that a
human made or confirmed ([[human]], [[llm_reviewed]],
[[agent_reviewed]]) refuses the whole batch with exit status~2 and
nothing written, naming the decisions; a caller who means to leave them
alone excludes them with [[--source]].  There is no [[--force]]: a
human redoes their own decision in the TUI or with [[sessions decide
--source human]], and a decision wrongly recorded as theirs is
relabelled first.  The refusal names at most [[RESET_REFUSAL_NAMES]]
decisions and counts the rest by source, because [[--all]] on a session
screened by a human would otherwise print thousands of ids.

A selection that reaches two copies of one work decided apart
([[same_id_pairs]], \cref{sec:session-copies} of the review module) is
refused too, unless [[--all-copies]] is given, for the reason given
with [[sessions decide]] (\cref{sec:sessions-decide}): resetting both
ends a disagreement the copy lists show, kept only in the reset
histories, without a word to a caller who did not know there were
two.

The command prints how many decisions it reset, counted by old status
and source.  With [[--dry-run]] it prints the same counts and the same
refusals and writes nothing, not even the backup.  Otherwise it first
copies the session file with [[keep_copy_before_run]] under the label
[[pre-reset]], as relabel does, and saves with [[save_session]], which
takes the lock and merges what other processes saved meanwhile.  All
records of one run carry one time from the review module's clock seam
[[_utcnow]], the caller's [[--note]] and [[--by]]; who is recorded only
when given, for the reason given with relabel.

<<sessions command>>=
@sessions_app.command("reset")
def sessions_reset(
    name: Annotated[
        str,
        typer.Argument(
            help="Session name or query whose decisions to reset.",
            autocompletion=complete_session_name,
        ),
    ],
    doi: Annotated[
        Optional[list[str]],
        typer.Option(
            "--doi",
            help="Select a paper by DOI (case-insensitive). Repeatable.",
        ),
    ] = None,
    paper_id: Annotated[
        Optional[list[str]],
        typer.Option(
            "--paper-id",
            help="Select a paper by its session paper id. Repeatable.",
            autocompletion=complete_session_paper_id,
        ),
    ] = None,
    sources: Annotated[
        Optional[list[str]],
        typer.Option(
            "--source",
            help="Select the decisions with this source (agent, llm or a "
                 "stored unknown value); with --doi, --paper-id or --all, "
                 "only those. Repeatable or comma-separated.",
        ),
    ] = None,
    all_papers: Annotated[
        bool,
        typer.Option(
            "--all",
            help="Select every paper.",
        ),
    ] = False,
    all_copies: Annotated[
        bool,
        typer.Option(
            "--all-copies",
            help="Also reset copies of one work decided apart.",
        ),
    ] = False,
    dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Print what would be reset; write nothing.",
        ),
    ] = False,
    note: Annotated[
        Optional[str],
        typer.Option(
            "--note",
            help="Why the decisions are reset, kept with each record.",
        ),
    ] = None,
    by: Annotated[
        Optional[str],
        typer.Option(
            "--by",
            help="Who made or asked for the reset, kept with each record "
                 "as given (nothing is recorded without it).",
        ),
    ] = None,
) -> None:
    """
    Set decided papers back to pending, keeping each decision's history.

    Clears status, tags, confidence and the classifier's record of the
    selected decisions, so that `scholar llm classify` or a reviewer
    can decide them again. The old decision (status, tags, source,
    confidence, the classifier's trace, time, --note, --by) is kept in
    the record's reset history, shown by `sessions show` and the CSV
    export. Search records, `found_by` and paper metadata are untouched.
    A Scholar older than this command drops the history when it saves
    the session.

    Only unreviewed decisions (agent, llm) can be reset: a selection that
    holds a human's decision or confirmation (human, llm_reviewed,
    agent_reviewed) is refused (exit 2); leave those out with --source.
    Pending papers are skipped. If --doi or --paper-id matches nothing,
    nothing is saved (exit 1). The session file is copied to
    `<name>.json.pre-reset-<time>.bak` before it is saved; --dry-run
    writes nothing.

    Examples:
        scholar sessions reset my-review --source llm,agent --dry-run
        scholar sessions reset my-review --source llm \\
            --note "classified before the trace was recorded" \\
            --by "the author"
        scholar sessions reset my-review --doi 10.1145/3568813
    """
    from collections import Counter

    from scholar.review import (
        CopyConflict, ReviewSource, SessionFileError, _utcnow,
        copy_conflict_line, keep_copy_before_run, reset_decision,
        same_id_pairs, save_session,
    )

    console = Console()
    <<validate reset options>>
    try:
        session = open_session_argument(name, strict=True)
    except SessionFileError as error:
        exit_on_unreadable_session(error)
    if session is None:
        console.print(f"[red]Session not found: {escape(name)}[/red]")
        raise typer.Exit(1)
    <<refuse an unknown [[--source]] nobody holds>>
    <<select the decisions to reset>>
    <<refuse to reset a human's decision>>
    <<refuse to reset copies decided apart>>

    changes = Counter((d.status.value, d.source.value) for d in chosen)
    verb = "Would reset" if dry_run else "Reset"
    console.print(
        f"{verb} {len(chosen)} decision(s) in session '{escape(name)}' "
        "to pending:"
    )
    for (status, source), count in changes.items():
        console.print(f"  {escape(status)} by {escape(source)}: {count}")
    if dry_run or not chosen:
        return
    copy = keep_copy_before_run(session, "pre-reset")
    at = _utcnow().isoformat(timespec="seconds")
    for decision in chosen:
        reset_decision(decision, at, note, by)
    save_session(session)
    if copy is not None:
        console.print(f"[dim]Copy of the session before: {copy}[/dim]")
