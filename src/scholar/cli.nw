  assert list(path.parent.glob("*.pre-set-abstract-*")) == []

def test_an_existing_abstract_needs_replace(self, tmp_path, monkeypatch):
  from scholar.review import load_session

  path = self._make_session(tmp_path, monkeypatch)
  content = path.read_bytes()
  text = tmp_path / "a.txt"
  text.write_text("New text.")
  args = ["--doi", "10.1/held", "--file", str(text), "--from", "OpenAlex"]
