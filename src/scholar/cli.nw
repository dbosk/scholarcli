        ),
    ] = None,
    confidence: Annotated[
        Optional[float],
        typer.Option(
            "--confidence", "-c",
            help="The machine screener's confidence (0-1); in a "
                 "verdicts file, for lines without their own. Refused "
                 "with --as human.",
        ),
    ] = None,
    blind: Annotated[
        Optional[bool],
        typer.Option(
            "--blind/--not-blind",
            help="Declare that the screener did (not) see the other "
                 "verdicts. Without either, nothing is claimed.",
        ),
    ] = None,
    sample: Annotated[
        Optional[str],
        typer.Option(
            "--sample",
            help="The review sample of the session (`scholar llm "
                 "sample`) the screen was made for, by its id.",
        ),
    ] = None,
    all_copies: Annotated[
        bool,
        typer.Option(
            "--all-copies",
            help="Screen every copy of a work the session holds twice "
                 "under one id, decided apart (refused otherwise).",
        ),
    ] = False,
    dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Print what would be recorded; write nothing.",
        ),
    ] = False,
    strict_quotes: Annotated[
        bool,
        typer.Option(
            "--strict-quotes",
            help="Refuse the batch (exit 2, nothing saved) when a "
                 "reason quotes, between double quote marks, three or "
                 "more words that its record's title and abstract do "
                 "not hold. Without it such quotes are listed on "
                 "stderr.",
        ),
    ] = False,
    strict: Annotated[
        bool,
        typer.Option(
            "--strict",
            help="With --reason or --verdicts-file: refuse the batch (exit 2, "
                 "nothing saved) on any finding of the batch check (a "
                 "reason shared by 10 or more records with different "
                 "titles, one confidence on every row of 20 or more) "
                 "and on any quote not found, which "
                 "--strict-quotes refuses alone. A single --reason "
                 "for many records is noted, never refused. Without "
                 "it the findings are listed on stderr and the batch "
                 "is saved.",
        ),
    ] = False,
) -> None:
    """
    Record another screener's verdicts beside the decisions.

    Each verdict is stored as a screening of the paper (kind, name,
    status, tags, confidence, reason, time); the decision itself is not
    changed. The first screening of a decided paper also stores the
    decision's current verdict, so that a later change of the decision
    does not change what the first screener said. `sessions show`
    counts the screenings and lists them in its JSON.

    --as agent|human|llm says who screened (llm: a classifier's
    verdicts relayed from outside Scholar), and --by names the
    screener (the model for llm); --by is required. --as defaults to
    human at a terminal and is required otherwise. A screener cannot
    screen a decision it made itself (same kind and name): that is a
    change of mind, recorded with `sessions decide`.

    Give one verdict for papers selected with --doi/--paper-id
    (--keep or --discard, --tag, --reason, -c), or a verdict per paper
    in --verdicts-file. A discard needs a tag. When the session uses
    category tags (supports-claim, ...), an agent's or classifier's
    verdict must carry exactly one that fits its status. Any bad line,
    any id not in the session or one paper given two verdicts aborts
    the batch unsaved.

    A verdicts file is also checked as a whole, as `sessions decide`
    checks a reasons file (a reason shared by many records with
    different titles, one confidence on every row): the findings are
    listed on stderr and the batch is saved, unless --strict refuses it
    (exit 2), which it also does for a quote not found.

    A verdicts file may name its batch in a comment line `# batch: ID`
    (a screen sheet starts with one; a later such line starts a new
    batch), and --batch ID names the batch otherwise. The id is stored
    with each screening; a file that names batches is also checked
    batch by batch. --sheet FILE compares a batch with the screen sheet
    it answers, as in `sessions decide`.

    Examples:
        scholar sessions screen my-review --as agent --by second-agent \\
            --verdicts-file verdicts.tsv --blind
        scholar sessions screen my-review --as human --by "a colleague" \\
            --discard --tag off-topic-false-hit --doi 10.1145/3568813
    """
    from scholar.review import (
        AUDIT_CATEGORIES, CopyConflict, SessionFileError,
        copy_conflict_line, keep_copy_before_run, new_screening,
        record_screening, same_id_pairs, save_session, verdict_screener,
    )
    from scholar.utils import utc_now_iso

    console = Console()
    <<validate screen options>>
