@sessions_app.command("show")
def sessions_show(
    name: Annotated[
        str,
        typer.Argument(
            help="Session name or query to show.",
            autocompletion=complete_session_name,
        ),
    ],
    output_format: Annotated[
        str,
        typer.Option(
            "--format", "-f",
            help="Output format: table or json.",
            autocompletion=complete_display_format,
        ),
    ] = "table",
) -> None:
    """
    Show details of a saved review session.

    Displays all papers with their decisions, themes, and motivations,
    each with the paper id that `sessions decide --paper-id` accepts.
    Uses a pager for interactive viewing when output is a terminal.

    "Decided by:" counts the decisions by source; each source that
    claims a human (human, LLM or agent reviewed by a human) says how
    many carry a record of the review (made in the TUI or with
    `sessions decide --source human`). Decisions made before such
    records were kept have none, which does not mean that no human
    made them.

    A paper whose abstract looks like something other than an abstract
    (a disclosure or funding statement, a keywords line, text too
    short to be one) is marked "doubtful abstract" with the reason;
    replace it with `scholar sessions set-abstract --replace`.
    """
    import sys
    from scholar.review import (
        agent_audit_of, decision_source_counts, decision_source_rows,
        human_record_counts, human_record_of, source_row_text,
    )
    from scholar.review import conflicting_copies, copy_conflict_line
    from scholar.review import alike_copies, possible_copies
    from scholar.review import foldable_copies
    from scholar.review import (
        quote_check_tally, reason_quote_checks, unmatched_quotes_of,
    )
    from scholar.review import screenings_summary
    from scholar.review import link_places_data, tier_overview_line
    from scholar.review import (
        tier_sample_counts, tier_sample_data, tier_sample_line,
    )
    from scholar.review import (
        abstract_gap, decided_without_abstract_sentence,
    )
    from scholar.review import abstract_doubt

    console = Console()
    session = open_session_argument(name)

    if session is None:
        print_show_line(console, (f"Session not found: {name}", "red"))
        raise typer.Exit(1)

    quote_checks = {id(d): reason_quote_checks(d) for d in session.decisions}
    quote_tally = quote_check_tally(quote_checks.values())
    doubts = {id(d): abstract_doubt(d) for d in session.decisions}
    <<compute the double screen once>>
    unmatched = {
        key: unmatched_quotes_of(checks)
        for key, checks in quote_checks.items()
    }

    if output_format == "json":
        output = {
            "query": session.query,
            "providers": session.providers,
            "query_provider_pairs": session.query_provider_pairs,
            "search_records": [
                {
                    "id": r.record_id,
                    "query": r.query,
                    "provider": r.provider,
                    "filters": r.filters,
                    "limit": r.limit,
                    "hits": r.hits,
                    "error": r.error,
                    "retries": r.retries,
                    "total": r.total,
                    "total_estimated": r.total_estimated,
                    "searched_at": r.searched_at,
                    "fetched_at": r.fetched_at,
                    "from_cache": r.from_cache,
                    **(
                        {"ranked": True}
                        if is_ranked_provider(r.provider) else {}
                    ),
                    **({"via": r.via} if r.via else {}),
                    **({"order": r.order} if r.order else {}),
                    **(
                        {"retired": r.retired}
                        if r.retired is not None else {}
                    ),
                }
                for r in session.search_records
            ],
            "timestamp": session.timestamp.isoformat(),
            "themes": dict(session.theme_counts()),
            "decision_sources": {
                source.value: count
                for source, count in
                decision_source_counts(session.decisions).items()
            },
            "review_records": {
                source.value: count
                for source, count in
                human_record_counts(session.decisions).items()
            },
            "decisions": [
                {
                    "title": d.paper.title,
                    "authors": d.paper.authors,
                    "year": d.paper.year,
                    "doi": d.paper.doi,
                    "paper_id": d.paper.id,
                    "status": d.status.value,
                    "tags": d.tags,
                    "source": d.source.value,
                    "provider": d.provider,
                    **(
                        {"ranks": link_places_data(d)}
                        if link_places_data(d) else {}
                    ),
                    **({"relabelled": d.relabelled} if d.relabelled else {}),
                    **({"resets": d.resets} if d.resets else {}),
                    **(
                        {"abstract_set": d.abstract_set}
                        if d.abstract_set else {}
                    ),
                    **(
                        {"abstract_lookup": d.abstract_lookup}
                        if d.abstract_lookup else {}
                    ),
                    **(
                        {"screenings": d.screenings}
                        if d.screenings else {}
                    ),
                    **(
                        {"llm_trace": EARLIER_TRACE_LABEL}
                        if earlier_classifier_trace(d) else {}
                    ),
                    **agent_audit_of(d),
                    **human_record_of(d),
                    **(
                        {"unmatched_quotes": unmatched[id(d)]}
                        if unmatched[id(d)] else {}
                    ),
                    **abstract_data_of(d, doubts[id(d)]),
                }
                for d in session.decisions
            ],
            **(
                {"reason_quotes": quote_tally}
                if reason_quotes_line(quote_tally) else {}
            ),
            **decided_without_abstract_data(
                abstract_gap(d for d in session.decisions if d.is_decided)
            ),
            **{
                key: [
                    {
                        "paper_ids": [d.paper.id for d in c.decisions],
                        "statuses": [d.status.value for d in c.decisions],
                        "other_works": c.copies,
                        "description": copy_conflict_line(c),
                    }
                    for c in copies(session)
                ]
                for key, copies in (
                    ("conflicting_copies", conflicting_copies),
                    ("alike_copies", alike_copies),
                )
            },
            "possible_copies": [d.paper.id for d in possible_copies(session)],
            "foldable_copies": [
                [bare.paper.id, with_doi.paper.id]
                for bare, with_doi in foldable_copies(session)
            ],
            <<the samples of a tier's rest as JSON>>
            **(
                {"double_screening": screening_overview.data()}
                if screening_overview is not None else {}
            ),
        }
        print(json.dumps(output, indent=2))
    else:
        # Every line is a Text with the stored strings as plain text
        def print_session_details(con: Console) -> None:
            """Print session details with Rich formatting."""
            def line(*parts) -> None:
                print_show_line(con, *parts)

            line((f"Session: {session.query}", "bold"))
            line((
                f"Date: {session.timestamp.strftime('%Y-%m-%d %H:%M')}",
                "dim",
            ))

            # Always show query (with any filters) per provider
            if session.search_records:
                line((
                    "Queries by provider:"
                    f"{_record_counts_text(session.search_records)}",
                    "dim",
                ))
                for record in session.search_records:
                    flags = _search_flags(record.filters, record.limit)
                    suffix = (" " + " ".join(flags)) if flags else ""
                    line(
                        (
                            f"  [{record.record_id}] "
                            f"{_record_provider_label(record)}: "
                            f"{record.query}{suffix}",
                            "dim",
                        ),
                        *_record_outcome_parts(record),
                        *_record_order_parts(record),
                        *_record_dates_parts(record),
                        *_record_retired_parts(record),
                    )
            else:
                # Fallback: show providers with session query
                line(("Queries by provider:", "dim"))
                for provider in session.providers:
                    line((f"  {provider}: {session.query}", "dim"))
            con.print()

            # Show who decided
            sources = decision_source_rows(
                session.decisions, always_note=True
            )
            if sources:
                line(("Decided by:", "cyan bold"))
                for label, count, note in sources:
                    line(f"  • {label}: {source_row_text(count, note)}")
                con.print()

            <<show how many pending papers a first tier holds>>
            <<show the samples of a tier's rest>>

            # Show the quote check of the machine reasons
            quotes_line = reason_quotes_line(quote_tally)
            if quotes_line:
                line((quotes_line, "cyan"))
                con.print()

            # Count the doubtful abstracts marked below
            doubts_line = doubtful_abstracts_line(doubts)
            if doubts_line:
                line((doubts_line, "yellow"))
                con.print()

            # Count the decisions made on records without an abstract
            without_abstract = decided_without_abstract_sentence(
                session.decisions
            )
            if without_abstract:
                line((without_abstract, "cyan"))
                con.print()

            # Count the screenings beside the decisions
            screenings_line = screenings_summary(session.decisions)
            if screenings_line:
                line((screenings_line, "cyan"))
                con.print()

            <<show the double screen in a few lines>>

            # Show themes overview
            themes = session.theme_counts()
            if themes:
                line(("Themes:", "cyan bold"))
                for theme, count in sorted(themes.items()):
                    papers = "paper" if count == 1 else "papers"
                    line(f"  • {theme} ({count} {papers})")
                con.print()

            # Show kept papers
            kept = session.kept_papers()
            if kept:
                line((f"Kept ({len(kept)}):", "green bold"))
                print_paper_lines(con, kept, unmatched, doubts)
                con.print()

            # Show discarded papers
            discarded = session.discarded_papers()
            if discarded:
                line((f"Discarded ({len(discarded)}):", "red bold"))
                print_paper_lines(con, discarded, unmatched, doubts)
                con.print()

            # Show pending papers
            pending = session.pending_papers()
            if pending:
                line((f"Pending ({len(pending)}):", "yellow bold"))
                print_paper_lines(con, pending, unmatched, doubts)
                con.print()

            <<show the conflicting copies>>

        # Use pager if TTY, otherwise print directly
        if sys.stdout.isatty():
            with console.pager(styles=True):
                print_session_details(console)
        else:
            print_session_details(console)


