        with patch(
            "scholar.enrich.enrich_papers", side_effect=adopt_bare
        ), patch(
            "scholar.crossref.annotate_papers",
            side_effect=self._identity_annotate,
        ), patch(
            "scholar.notes.migrate_paper_id"
        ) as mock_migrate:
            result = runner.invoke(app, ["enrich", name])
        assert result.exit_code == 0, result.stdout
        assert "Adopted preprint 10.48550/arXiv.2401.1" in result.stdout
        assert "10.1/bare" in result.stdout
        mock_migrate.assert_called_once_with(
            "doi:10.1/bare", "doi:10.48550/arxiv.2401.1"
