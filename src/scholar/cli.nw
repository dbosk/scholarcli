class TestEnrichSelectionAndSaving:
  """--pending-only, --fields and the save after every chunk (#137)."""

  @staticmethod
  def _session(tmp_path, monkeypatch, count, name="chunks"):
    """Save a session of `count` pending papers; return its name."""
    from scholar import Paper, SearchResult
    from scholar.review import create_review_session, save_session

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    papers = [
      Paper(title=f"Paper {i}", authors=["a"], doi=f"10.1/c137-{i}",
            sources=["m"])
      for i in range(count)
    ]
    save_session(create_review_session(
      [SearchResult(query="q", provider="m", timestamp="t",
                    papers=papers)],
      "q", session_name=name,
    ))
    return name

  @staticmethod
  def _saved(name):
    """Return the saved decisions by DOI, read in a fresh registry."""
    from scholar import isolated_registry
    from scholar.review import load_session

    with isolated_registry():
      return {d.paper.doi: d for d in load_session(name).decisions}

  @staticmethod
  def _invoke(args, enrich, annotate=None):
    """Run `scholar enrich` with stand-ins for the network steps."""
    with patch("scholar.enrich.enrich_papers", side_effect=enrich), patch(
      "scholar.crossref.annotate_papers",
      side_effect=annotate or (lambda papers, **kw: list(papers)),
    ):
      return runner.invoke(app, ["enrich", *args])

  @staticmethod
  def _enriched(papers):
    from dataclasses import replace

    return [replace(p, abstract="Enriched.") for p in papers]

  <<enrich selection and saving test methods>>
