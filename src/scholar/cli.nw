One function, [[draw_rest_sample]], selects the tier, takes what it
leaves and draws, for the export and its dry run alike; it returns the
tier, the record and the decisions to list, one per drawn paper id in
the order drawn.

<<sessions command>>=
def draw_rest_sample(session, decisions, rule, size: int, seed: int):
    """Select the tier of `rule` from `decisions`, draw `size` papers of
    what it leaves out, and record the draw in `session` (unsaved).

    Returns the `TierSelection`, the `TierSample` and the drawn
    decisions in the order drawn.
    """
    from scholar.llm_review import draw_tier_sample, outside_tier
    from scholar.notes import get_paper_id
    from scholar.review import screening_tier

    tier = screening_tier(decisions, session, rule)
    rest = outside_tier(decisions, tier)
    draw = draw_tier_sample(session, rest, rule, size=size, seed=seed)
    by_id = {}
    for decision in rest:
        by_id.setdefault(get_paper_id(decision.paper), decision)
    return tier, draw, [by_id[paper_id] for paper_id in draw.papers]


def rest_sample_data(draw) -> dict:
    """The draw as `BASE-tier.json` gives it, or nothing without one."""
    if draw is None:
        return {}
    data = draw.to_dict()
    del data["rule"]
    return {"rest_sample": data}


def rest_draw_line(draw, recorded: bool = True) -> str:
    """Say what was drawn; by its id only when the draw is `recorded`."""
    taken = (f"all {len(draw.papers)} (a census)" if draw.census
             else f"{len(draw.papers)}")
    what = (f"{taken} of the {draw.rest} pending papers outside the tier, "
            f"seed {draw.seed}")
    if recorded:
        return f"Sample of the rest {draw.sample_id}: {what}."
    return (f"Would draw {what}; the sample's id is assigned when the "
            "draw is recorded.")
