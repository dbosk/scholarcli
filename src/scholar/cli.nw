  self._clock(monkeypatch, "2026-11-20T10:00:00+00:00")
  result = self._decide("--source", "human", "--discard",
                        "--tag", "off-topic", "--doi", "10.1/one")
  assert result.exit_code == 0, result.output
  one = self._decisions()["One"]
  assert (one.human_decided_at, one.human_by) \
