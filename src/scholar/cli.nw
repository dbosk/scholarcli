def _record_provider_label(record) -> str:
    """The provider of a search record, with the endpoint if recorded."""
    via = getattr(record, "via", None)
    return f"{record.provider} (via {via})" if via else record.provider


def _record_outcome_markup(record) -> str:
    """Rich markup for a search record's outcome, or "" if unknown."""
    from scholar.review import search_outcome_label

    label = search_outcome_label(record)
    if not label:
        return ""
    if record.error:
        return f" [yellow]— {escape(label)}[/yellow]"
    if is_ranked_provider(record.provider) or record.is_merged:
        return f"[dim] — {escape(label)}[/dim]"
    return f"[dim] — hits: {escape(label)}[/dim]"


def _record_dates_markup(record) -> str:
    """Rich markup for when a search ran and was fetched, or ""."""
    from scholar.review import search_dates_label

    label = search_dates_label(record)
    return f"[dim] — {escape(label)}[/dim]" if label else ""


def reset_mark(decision) -> str:
    """The `sessions show` note on a decision's last reset to pending."""
    last = decision.resets[-1]
    return f"reset from {last.get('status')} by {last.get('source')}"


def abstract_mark(decision) -> str:
    """The `sessions show` note on an abstract given by hand."""
    from scholar.review import hand_abstract_replaced

    origin = decision.abstract_set[-1].get("from")
    since = ", since replaced" if hand_abstract_replaced(decision) else ""
    return f"abstract added by hand, from {origin}{since}"


def relabel_after_reset(decision) -> bool:
    """Tell whether the last relabel describes the current decision.

    True without a reset; never for a reset paper still pending (a
    relabel needs a decision, so it came before the reset); otherwise
    when the last relabel is not older than the last reset.
    """
    if not decision.relabelled:
        return False
    if not decision.resets:
        return True
    if not decision.is_decided:
        return False
    return str(decision.relabelled[-1].get("at") or "") \
        >= str(decision.resets[-1].get("at") or "")


def relabel_mark(decision) -> str:
    """The `sessions show` note on a decision's last source correction."""
    last = decision.relabelled[-1]
    old, new = str(last.get("from")), str(last.get("to"))
    if decision.source.value == new:
        return f"relabelled from {old}"
    return f"relabelled from {old} to {new}, now {decision.source.value}"


def session_paper_line(decision, unmatched_quotes=()) -> str:
    """Return the Rich markup `sessions show` prints for one paper.

    Two lines: the title with provider and tags, then the paper id that
    `sessions decide --paper-id` accepts (`doi:...` or `hash:...`).
    A mark follows the title when `unmatched_quotes` holds a quote of
    its reasons that the record does not.
    """
    from scholar.review import unreviewed_mark

    paper = decision.paper
    provider = f" [dim]({decision.provider})[/dim]" if decision.provider else ""
    tag_list = ", ".join(escape(t) for t in decision.tags)
    tags = f" [dim]\\[{tag_list}][/dim]" if decision.tags else ""
    mark = unreviewed_mark(decision)
    unreviewed = f" [magenta]({escape(mark)})[/magenta]" if mark else ""
    if relabel_after_reset(decision):
        unreviewed += f" [dim]({escape(relabel_mark(decision))})[/dim]"
    if decision.resets:
        unreviewed += f" [dim]({escape(reset_mark(decision))})[/dim]"
    if decision.abstract_set:
        unreviewed += f" [dim]({escape(abstract_mark(decision))})[/dim]"
    if earlier_classifier_trace(decision):
        unreviewed += f" [dim](llm trace: {EARLIER_TRACE_LABEL})[/dim]"
    if unmatched_quotes:
        unreviewed += f" [yellow]({QUOTE_MARK})[/yellow]"
    return (
        f"  • {escape(paper.title or '')}{provider}{tags}{unreviewed}\n"
        f"    [dim]{escape(paper.id)}[/dim]"
        + agent_reason_line(decision)
    )


