The lines name each sheet by its file name and batch.

<<sessions command>>=
def _first_ids(ids) -> str:
    shown = ", ".join(ids[:BATCH_PAPERS_SHOWN])
    more = len(ids) - BATCH_PAPERS_SHOWN
    return shown + (f" \N{HORIZONTAL ELLIPSIS}and {more} more"
                    if more > 0 else "")


def sheet_comparison_lines(check: SheetCheck, strict: bool) -> list[str]:
    """The stderr lines of `--sheet`: missing, extra and uncompared rows."""
    comparisons = check.comparisons
    lines = []
    for comparison in comparisons:
        held = comparison.sheet
        label = held.path.name + (f" (batch {held.batch})"
                                  if held.batch else " (no batch id)")
        returned = comparison.listed - len(comparison.missing)
        line = f"{label}: returned {returned} of {comparison.listed}"
        if comparison.missing:
            line += (f"; {len(comparison.missing)} missing: "
                     f"{_first_ids(comparison.missing)}")
        lines.append(line + ".")
        if comparison.extra:
            lines.append(
                f"{label}: {len(comparison.extra)} id(s) not on the "
                f"sheet: {_first_ids(comparison.extra)}"
            )
    if any(comparison.missing for comparison in comparisons):
        lines.append(
            "Missing rows are fine: fewer rows are better than defaulted "
            "ones; the missing records are left as they were."
        )
    if any(comparison.extra for comparison in comparisons) and not strict:
        lines.append("--strict refuses ids that are not on their sheet.")
    for row_batch, values in check.uncompared.items():
        which = (f"of batch {row_batch}" if row_batch is not None
                 else "with no batch id")
        lines.append(
            f"{len(values)} row(s) {which} were not compared with any "
            f"sheet: {_first_ids(values)}"
        )
    if check.uncompared and not strict:
        lines.append("--strict refuses rows not compared with any sheet.")
    return lines
