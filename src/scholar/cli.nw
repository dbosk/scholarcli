  def _make_session(self, tmp_path, monkeypatch):
    from scholar.review import (
      DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
      new_screening, record_screening, save_session,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))

    def decision(n, batch, source=ReviewSource.AGENT_UNREVIEWED):
      return ReviewDecision(
        paper=Paper(title=f"Reset Work {n}", authors=["A"],
                    doi=f"10.1/reset-{n}"),
        provider="openalex", status=DecisionStatus.DISCARDED, tags=["t"],
        source=source, agent_reason=f"Reason {n}.", agent_by="agent-1",
        agent_decided_at="2026-11-20T10:00:00+00:00", agent_batch=batch,
      )

    decisions = [decision(n, "b-1") for n in range(3)] + [
      decision(3, "b-1", ReviewSource.AGENT_REVIEWED),
      decision(4, "b-2"), decision(5, "b-2"),
    ]
    record_screening(decisions[4], new_screening(
      kind="agent", name="second", status="kept", tags=["t"],
      recorded_at="2026-11-20T11:00:00+00:00", batch="b-1"))
    save_session(ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
      name="resets", decisions=decisions))

  def _reset(self, *args):
    return runner.invoke(app, ["sessions", "reset", "resets", *args])

  def test_a_batch_is_reset_as_a_unit(self, tmp_path, monkeypatch):
    from scholar.review import counted_screenings, load_session

    self._make_session(tmp_path, monkeypatch)
    refused = self._reset("--batch", "b-1")
    assert refused.exit_code == 2, refused.output
    assert "Leave them out with --source agent,llm." in " ".join(
      refused.output.split())
    result = self._reset("--batch", " b-1 ", "--source", "agent")
    assert result.exit_code == 0, result.output
    assert "discarded by agent: 3" in result.output
    after = {d.paper.doi: d for d in load_session("resets").decisions}
    assert [after[f"10.1/reset-{n}"].status.value for n in range(6)] == [
      "pending", "pending", "pending", "discarded", "discarded",
      "discarded"]
    assert after["10.1/reset-0"].resets[-1]["trace"]["agent_batch"] \
      == "b-1"
    assert len(counted_screenings(after["10.1/reset-4"])) == 2
    again = self._reset("--batch", "b-1", "--source", "agent")
    assert again.exit_code == 0, again.output
    assert "Reset 0 decision(s)" in again.output
    unheld = self._reset("--batch", "b-9")
    assert unheld.exit_code == 0, unheld.output
    assert "No decision carries batch b-9" in " ".join(
      unheld.stderr.split())

