def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, LLMSample, ReviewDecision, ReviewSession,
    ReviewSource, new_screening, record_screening, save_session,
  )

  decisions = []
  verdicts = [("discarded", "discarded")] * 3 + [
    ("discarded", "kept"), ("kept", "kept")]
  for i, (machine, agent) in enumerate(verdicts):
    category = ("supports-claim" if machine == "kept"
                else "off-topic-false-hit")
    agent_category = ("supports-claim" if agent == "kept"
                      else "off-topic-false-hit")
    decision = ReviewDecision(
      paper=Paper(title=f"Agree {i}", authors=["A"],
                  doi=f"10.5555/cli-agree-{i}"),
      provider="openalex", status=DecisionStatus(machine),
      tags=[category], source=ReviewSource.LLM_UNREVIEWED,
      llm_model="m-1", llm_decided_at="2020-01-01T00:00:00+00:00")
    record_screening(decision, new_screening(
      kind="agent", name="a-2", status=agent, tags=[agent_category],
      recorded_at="2020-01-03T00:00:00+00:00"))
    decisions.append(decision)
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2020, 1, 1),
    name="agree", decisions=decisions)
  session.llm_samples = [LLMSample(
    sample_id="s-1", seed=1, drawn_at="2020-01-02T00:00:00+00:00",
    criteria={}, sessions=["agree"], population=50,
    population_digest="d", size=5,
    papers=[{"paper_id": d.paper.id, "status": d.status.value,
             "source": "llm", "confidence": 0.9} for d in decisions])]
  save_session(session)

def test_the_tables_of_a_pair(self, tmp_path, monkeypatch):
  self._make_session(tmp_path, monkeypatch)
  result = runner.invoke(app, ["sessions", "agreement", "agree"])
  assert result.exit_code == 0, result.output
  lines = result.output.splitlines()
  assert lines[:3] == [
    "Pair --pair llm:m-1,agent:a-2",
    "  A = llm (m-1); B = agent (a-2)",
    "  5 records screened by A, 5 by B, 5 by both",
  ]
  assert "Kept/discarded, 5 records screened by both:" in lines
  assert "  observed agreement  80.0 %" in lines
  assert any(l.startswith("  Cohen's kappa       0.55") for l in lines)
  assert ("3 of 5 records were discarded by both, so observed agreement "
          "is at least 3/5 (60.0 %) whatever the screeners did with the "
          "rest; positive agreement counts only records at least one "
          "screener kept.") in lines
  shown = runner.invoke(app, ["sessions", "show", "agree"]).output
  assert ("Double screening: llm (m-1) vs agent (a-2): 5 records, "
          "kept/discarded agreement 80.0 %, kappa 0.55 (prevalence index "
          "-0.40, bias index -0.20); 1 status conflicts (0 resolved)"
