                     "--from", "Crossref, 2026-11-20", "--by", "the author")
  assert result.exit_code == 0, result.output
  flat = " ".join(result.output.split())
  assert "Set the abstract of 1 paper(s)" in flat
  assert "doi:10.1/bare: 25 characters from Crossref, 2026-11-20" in flat
  decision = load_session("hand").decisions[0]
  assert decision.paper.abstract == "We study things in depth."
  assert decision.abstract_set == [{
    "at": self.AT, "from": "Crossref, 2026-11-20", "by": "the author",
    "chars": 25, "text": "We study things in depth.",
  }]
  assert path.with_name("hand.json.pre-set-abstract-20261120T100000Z.bak") \
    .exists()

