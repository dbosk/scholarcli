def test_bad_verdict_lines_are_all_named(self, tmp_path, monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  verdicts = self._file(tmp_path, "\n".join([
    "# a comment",
    "10.1/llm\tkept\tcompilers",
    "10.1/llm\tmaybe\tx\tA reason.",
    "\tkept\tx\tA reason.",
    "10.1/llm\tdiscarded\t\tNo tag.",
    "10.1/llm\tkept\tsupports-claim,adjacent-subtopic\tTwo.",
    "10.1/llm\tkept\tx\t0.9",
    "10.1/llm\tkept\tx\tPLACEHOLDER",
    "10.1/llm\tkept\tx\tA reason.\t1.5",
    "10.1/llm\tkept\tx\tA reason.\t0.5\t",
    "",
  ]))
  result = self._screen("--as", "agent", "--by", "agent-2", "--verdicts-file", verdicts)
  assert result.exit_code == 2, result.output
  flat = " ".join(result.output.split())
  for expected in (
    "line 2: too few columns",
    "line 3: verdict 'maybe' is neither kept nor discarded",
    "line 4: empty id",
    "line 5: a discard needs a tag",
    "line 6: a verdict holds one category",
    "line 7: reason '0.9' is only a number",
    "line 8: reason 'PLACEHOLDER' is a placeholder",
    "line 9: confidence 1.5 is not between 0 and 1",
    "line 10: extra column 6 ('')",
  ):
    assert expected in flat, expected
  assert "line 1:" not in flat
  assert all("screenings" not in d for d in self._saved(path).values())

def test_a_verdicts_file_gives_each_paper_its_verdict(self, tmp_path,
                                                      monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  verdicts = self._file(tmp_path, (
    "﻿doi:10.1/LLM\tKept\tcompilers, teaching\tA course.\t0.8\r\n"
