def _sample(self, sample_id, group=None):
  from scholar.review import LLMSample

  criteria = {"statuses": ["discarded"]}
  if group:
    criteria["stratum"] = {"group": group, "band": 0, "bands": 2,
                           "cuts": [0.5]}
  return LLMSample(sample_id=sample_id, seed=1, drawn_at=self.AT,
                   criteria=criteria, sessions=["screens"], population=1,
                   population_digest="0", size=1,
                   papers=[{"paper_id": "doi:10.1/llm"}])

def test_the_sample_must_be_the_sessions(self, tmp_path, monkeypatch):
  path = self._make_session(tmp_path, monkeypatch, samples=[
    self._sample("s-1"), self._sample("s-2-band", group="s-2"),
  ])
  result = self._screen("--as", "agent", "--by", "agent-2", "--keep", "--doi", "10.1/llm",
                        "--sample", "s-9")
  assert result.exit_code == 2
  assert "it holds s-1, s-2, s-2-band" in result.output
  for sample in ("s-1", "s-2"):
    result = self._screen("--as", "agent", "--by", "agent-2", "--keep", "--doi", "10.1/llm",
                          "--sample", sample)
    assert result.exit_code == 0, result.output
  assert [r["sample_id"] for r in self._saved(path)["10.1/llm"][
    "screenings"]] == [None, "s-1", "s-2"]

def test_copies_decided_apart_need_all_copies(self, tmp_path, monkeypatch):
