  content = path.read_bytes()
  result = self._relabel("--from", "human,llm_reviewed", "--to", "agent",
                         "--all", "--dry-run")
  assert result.exit_code == 0, result.output
  assert "Would relabel 2 decision(s)" in result.output
  assert "human -> agent: 1" in result.output
  assert "llm_reviewed -> agent: 1" in result.output
  assert path.read_bytes() == content
  assert list(path.parent.glob("*.pre-relabel-*")) == []

def test_a_selector_matching_nothing_aborts(self, tmp_path, monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  content = path.read_bytes()
  result = self._relabel("--from", "human", "--to", "agent",
                         "--doi", "10.1/human", "--doi", "10.1/nope",
                         "--paper-id", "hash:nope")
  assert result.exit_code == 1
  assert "Not in session: DOI 10.1/nope" in result.output
  assert "Not in session: paper id hash:nope" in result.output
  assert path.read_bytes() == content

def test_from_filters(self, tmp_path, monkeypatch):
  from scholar.review import ReviewSource, load_session

  self._make_session(tmp_path, monkeypatch)
  result = self._relabel("--from", "human", "--to", "llm", "--all")
  assert result.exit_code == 0, result.output
  assert [d.source for d in load_session("relabel").decisions] == [
    ReviewSource.LLM_UNREVIEWED, ReviewSource.LLM_REVIEWED,
    ReviewSource.HUMAN, ReviewSource.LLM_UNREVIEWED,
  ]
  assert [len(d.relabelled) for d in load_session("relabel").decisions] \
    == [1, 0, 0, 0]
  named = self._relabel("--from", "human", "--to", "agent",
                        "--doi", "10.1/reviewed", "--doi", "10.1/pending")
  assert named.exit_code == 0, named.output
  flat = " ".join(named.output.split())
  assert "doi:10.1/reviewed is discarded (llm_reviewed); not relabelled" \
    in flat
  assert "doi:10.1/pending is pending (human); not relabelled" in flat
  assert "Relabelled 0 decision(s)" in flat

