AT = "2026-11-20T10:00:00+00:00"

def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from datetime import timezone
  import scholar.review as review
  from scholar.review import (
    ReviewDecision, ReviewSession, SearchRecord, save_session,
    session_file_path,
  )

  monkeypatch.setattr(
    review, "_utcnow",
    lambda: datetime(2026, 11, 20, 10, 0, tzinfo=timezone.utc),
  )
  session = ReviewSession(
    query="final", providers=["openalex", "dblp"],
    timestamp=datetime(2026, 11, 20), name="retire",
  )
  session.search_records = [
    SearchRecord("draft", "openalex", {}, 50, hits=3),
    SearchRecord("final", "openalex", {"year": "2010-2019"}, 50, hits=4),
    SearchRecord("final", "openalex", {"year": "2020-2024"}, 50, hits=5),
    SearchRecord("final", "dblp", {}, 50, hits=0, error="HTTP 500"),
  ]
  session.decisions.append(ReviewDecision(
    paper=Paper(title="Draft hit", authors=["A"], doi="10.5555/ret-1"),
    provider="openalex", found_by=[session.search_records[0].key],
  ))
  save_session(session)
  return session_file_path(session)

def _run(self, *args):
  return runner.invoke(app, ["sessions", "retire-search", "retire", *args])

def _marks(self):
  from scholar.review import load_session
  return [r.retired for r in load_session("retire").search_records]

def _id(self, n):
  """The id of the session's n-th record as made."""
  from scholar.review import load_session
  return load_session("retire").search_records[n - 1].record_id

def test_query_retires_and_copies(self, tmp_path, monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  result = self._run("--query", "draft", "--note", "first version",
