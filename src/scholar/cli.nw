def test_notes_clear_deletes_the_notes_file(tmp_path, monkeypatch):
    """notes clear deletes the file NOTES_FILE names."""
    import scholar.notes as notes
    from scholar.notes import get_data_dir, invalidate_notes_cache
    from scholar.notes import save_note

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    monkeypatch.setattr(notes, "NOTES_FILE", "renamed_notes.json")
    invalidate_notes_cache()
    save_note(Paper(title="T", authors=["A"], doi="10.1/t"), "Note.")
    notes_file = get_data_dir() / "renamed_notes.json"
    assert notes_file.exists()

    result = CliRunner().invoke(app, ["notes", "clear", "--force"])
    assert result.exit_code == 0
