      "  year = {n.d.},\n  date = {2010-01-01},\n}\n"
    )
    result = self._export(tmp_path, bib)
    assert result.exit_code == 0, result.output
    assert "0 by title, 1 not in the session" \
      in " ".join(result.stderr.split())

