class TestSearchRecordsPerProvider:
    """search -n records each provider's search on its own (#164)."""

    def _providers(self, monkeypatch):
        from scholar import providers

        good = Mock()
        good.name = "good"
        good.MAX_LIMIT = None
        good.search.return_value = [
            Paper(title="Kept", authors=["A"], doi="10.1/rpp-kept"),
        ]
        dead = Mock()
        dead.name = "dead"
        dead.MAX_LIMIT = None
        dead.search.return_value = []
        dead.last_error = "non-JSON response"
        dead.last_retries = 0
        monkeypatch.setattr(
            providers, "PROVIDERS", {"good": good, "dead": dead}
        )

