    from scholar import review
    from scholar.scholar import Paper

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = review.ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 1, 1),
      name="cit",
    )
    kept, discarded = review.DecisionStatus.KEPT, \
      review.DecisionStatus.DISCARDED
    session.decisions = [
      review.ReviewDecision(
        paper=Paper(title="Agent kept", authors=["Ann Ash"], year=2020,
                    doi="10.1/cit-agent"),
        provider="openalex", status=kept, tags=["ml"],
        source=review.ReviewSource.AGENT_UNREVIEWED, llm_confidence=0.8,
      ),
