    plain = sheets._sheet(tmp_path, "plain.tsv", None, ["doi:10.1/batch-7"])
    again = sheets._sheet(tmp_path, "again.tsv", "b-1", ["doi:10.1/batch-8"])
    reasons = self._reasons(helper, tmp_path, ["0"])
    for other, message in ((plain, "has no # batch: line"),
                           (again, "two sheets name batch b-1")):
      result = runner.invoke(app, [
        "sessions", "decide", "no-such-session", "--source", "agent",
        "--discard", "--tag", "t", "--by", "a", "--reasons-file", reasons,
        "--sheet", first, "--sheet", other])
      assert result.exit_code == 2, result.output
      assert message in " ".join(result.output.split())
