                 error="refused \\"),
  ]
  retire_record(records[-3], at="2026-11-06T10:00:00+00:00",
                note="a draft, replaced \\", by="a reviewer")
  sample = LLMSample(
    sample_id="20261120T120000Z-0001", seed=1,
    drawn_at="2026-11-20T12:00:00+00:00", criteria={"status": "kept"},
    sessions=["pinned[a]"], population=2, population_digest="0" * 16,
    size=1, papers=[{"paper_id": "doi:10.5555/pin-3", "status": "kept",
                     "source": "llm", "confidence": None}])
  save_session(ReviewSession(
    query="recursion [novices] :+1: \\", providers=["openalex", "s2"],
    timestamp=datetime(2026, 11, 20, 12, 0), name="pinned[a]",
    research_context="A context with [bold] and a:b:c \\",
    decisions=[human, reasoned, marked_up, relabelled, drifted, reset,
               hand,
               decision("A theme ending in a backslash", "10.5555/pin-15",
                        kept, ["theme \\", "see [it]", ":+1:"]),
               decision("Tags that hold brackets", "10.5555/pin-12",
                        discarded, ["x[bold", "plain", "a]b[c"]),
               decision("Ends in a backslash \\", "10.5555/pin-13",
                        discarded, ["off-topic-false-hit", "slash\\"],
                        provider="p\\"),
               decision("Keys like key:id:value and a:b:c", "10.5555/pin-14",
                        discarded, ["off-topic-false-hit"]),
               wide,
               decision("No provider", "10.5555/pin-9", provider=""),
               decision("Provider with brackets", "10.5555/pin-11",
                        provider="open[alex]"),
               screened, *copies],
    search_records=records, llm_samples=[sample]))

def _shown(self, columns, **env):
  return runner.invoke(app, ["sessions", "show", "pinned[a]"], env={
    "COLUMNS": str(columns), "FORCE_COLOR": None, "NO_COLOR": None,
    "TTY_COMPATIBLE": None, "TTY_INTERACTIVE": None, **env,
  })

@pytest.mark.parametrize("columns", [80, 200])
def test_piped_output_is_the_recorded_text(
  self, tmp_path, monkeypatch, columns
):
  self._make_session(tmp_path, monkeypatch)
  result = self._shown(columns)
  assert result.exit_code == 0, result.output
  assert result.output.splitlines() == list(PINNED_SHOW[columns])
  assert result.output.endswith("\n")

def test_providers_of_a_session_without_searches(
  self, tmp_path, monkeypatch
):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import ReviewSession, save_session

  save_session(ReviewSession(
    query="q", providers=["open[alex]", "s2"],
    timestamp=datetime(2026, 11, 20, 12, 0), name="bare"))
  result = runner.invoke(app, ["sessions", "show", "bare"], env={
    "COLUMNS": "80", "FORCE_COLOR": None, "NO_COLOR": None,
    "TTY_COMPATIBLE": None, "TTY_INTERACTIVE": None,
  })
  assert result.exit_code == 0, result.output
  assert result.output.splitlines()[2:5] == [
    "Queries by provider:", "  open[alex]: q", "  s2: q"]

def test_chunks_print_the_same_text(self, tmp_path, monkeypatch):
  import scholar.cli

  self._make_session(tmp_path, monkeypatch)
  monkeypatch.setattr(scholar.cli, "PAPER_LINES_PER_PRINT", 2)
  result = self._shown(80)
  assert result.exit_code == 0, result.output
  assert result.output.splitlines() == list(PINNED_SHOW[80])

def test_stored_text_prints_as_stored(self, tmp_path, monkeypatch):
  self._make_session(tmp_path, monkeypatch)
  result = self._shown(200)
  assert result.exit_code == 0, result.output
  assert "Provider with brackets (open[alex])" in result.output
  assert "Tags that hold brackets (openalex) [x[bold, plain, a]b[c]\n" \
    in result.output
  assert ("Ends in a backslash \\ (p\\) "
          "[off-topic-false-hit, slash\\]\n") in result.output
  assert "Keys like key:id:value and a:b:c (openalex)" in result.output
  assert "] openalex: key:id:value --limit 1000" in result.output
