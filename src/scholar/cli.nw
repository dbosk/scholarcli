def _drawn(self, tmp_path, monkeypatch):
  sheet = TestRestSampleSheet()
  sheet._save(tmp_path, monkeypatch)
  sheet._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  return sheet._session().tier_samples[0]

def _decide(self, paper_ids, status="discard", tag="off-topic-false-hit"):
  options = []
  for paper_id in paper_ids:
    options += ["--paper-id", paper_id]
  result = runner.invoke(app, [
    "sessions", "decide", "rest-sheet", f"--{status}", "--tag", tag,
    "--source", "human", *options,
  ])
  assert result.exit_code == 0, result.output

def _show(self, *options):
  return runner.invoke(app, ["sessions", "tier-sample", "rest-sheet",
                             *options])

def test_listed_then_reported(self, tmp_path, monkeypatch):
  from scholar.llm_review import modified_wilson_interval

  draw = self._drawn(tmp_path, monkeypatch)
  listed = self._show()
  assert listed.exit_code == 0, listed.output
  text = " ".join(listed.output.split())
  assert "tier --top 1: 3 of 5 pending papers outside the tier; " \
    "0 screened, 0 bearing" in text
  assert text.count("not yet screened:") == 3
  self._decide(draw.papers[:2])
  data = json.loads(self._show("--report", "-f", "json").output)[0]
  assert (data["screened"], data["rate"], data["interval"]) == (2, None,
                                                                None)
  assert data["withheld"] == "1 of the 3 drawn records is not yet screened"
  assert data["deciders"] == {"human": 2}
  self._decide(draw.papers[2:], "keep", "supports-claim")
  data = json.loads(self._show("--report", "-f", "json").output)[0]
  assert (data["screened"], data["bearing"]) == (3, 1)
  assert data["rate"] == pytest.approx(1 / 3)
  assert data["interval"] == pytest.approx(
    list(modified_wilson_interval(1, 3)))
  assert data["sentence"].startswith("Of the 5 records pending on ")
  assert ("outside the first tier (a place at most 1 in the answer of a "
          "current search ordered by relevance), a random sample of 3 "
          "(seed 315) was screened (by human: 3); 1 bore on the question "
          "(33.3%;") in data["sentence"]
  report = self._show("--report")
  assert "95% modified Wilson interval" in " ".join(report.output.split())

def test_a_backslash_in_the_rule(self, tmp_path, monkeypatch):
