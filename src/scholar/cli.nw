\subsection{Escaped entries}
\label{sec:bib-escape-round-trip}

Let's verify the escaping of \cref{sec:bibtex-escaping} and what it
means for the round trip.  Every special that [[escape_bibtex]] handles
comes out as the session export writes it: the title, author and
journal lines of [[search -f bibtex]] equal those of
[[format_bibtex_entry]], and none of the characters that broke a
document is left.  A symbol or a Greek letter is only compared with the
export: how the escaper writes one is the escaper's business, and the
exact text and the compiled document should not depend on it.  A plain
entry is byte for byte what the formatter wrote before.  A document citing such entries compiles with biber and
pdfLaTeX; that test runs the real tools when they are installed, since
only they can tell whether an entry is safe, and is skipped otherwise.

The round trip has three cases, all for papers without a DOI, whose id
hashes the title as the provider wrote it, and for files without the
[[ID]] line of \cref{sec:prov-paper-id}, which the tests after it
cover.  A note taken on the paper
elsewhere (here [[save_note]], as the TUI does) is found by
[[prov export]] from the escaped entry; a first [[prov import]] of a
stub for a title with a BibTeX special keys the new note by the
paper's id; and a title that the escaper changes beyond inversion (a
curly apostrophe) still meets an existing note.  Of two notes whose
titles escape alike, the entry's authors pick the right one, a
namesake by another author never.

<<test functions>>=
class TestBibtexFormatterEscaping:
    """search -f bibtex escapes like the session export (#230)."""

    SPECIALS = [
        "R&D", "100% sure", "$5 cost", "C# code", "snake_case",
        'a "quoted" word', "\u201cCurly\u201d \u2013 dash\u2026",
        "Developers\u2019 view",
    ]
    SYMBOLS = ["star \u2606 here", "\u03c0-calculus"]

    @staticmethod
    def _entry(title, **fields):
        from scholar import Paper
        paper = Paper(title=title, authors=fields.pop("authors", ["A B"]),
                      year=2024, **fields)
        return BibTeXFormatter()._format_paper(paper, "b2024"), paper

    @staticmethod
    def _line(entry, field):
        [line] = [l for l in entry.splitlines()
                  if l.startswith(f"  {field} = ")]
        return line

    def test_fields_are_escaped_as_the_export_escapes_them(self):
        from scholar.review import format_bibtex_entry
        for title in self.SPECIALS + self.SYMBOLS:
            entry, paper = self._entry(
                title, authors=[f"Ann {title}"], venue=f"J {title}")
            export = format_bibtex_entry(paper, "b2024")
            for field in ("title", "author", "journal"):
                assert self._line(entry, field) == self._line(export, field)
        entry, _ = self._entry("R&D 100% $5 C# a_b \"q\"", venue="J & K")
        title = self._line(entry, "title")
        assert title == (r'  title = {R\&D 100\% \$5 C\# a\_b '
                         r'\textquotedbl{}q\textquotedbl{}},')
        assert self._line(entry, "journal") == r"  journal = {J \& K},"

    def test_a_plain_entry_is_unchanged(self):
        entry, _ = self._entry("Plain Title", authors=["Ann Smith", "Bo Li"],
                               doi="10.1/plain_x", venue="Venue")
        assert entry == (
            "@article{b2024,\n"
            "  title = {Plain Title},\n"
            "  author = {Ann Smith and Bo Li},\n"
            "  year = {2024},\n"
            "  doi = {10.1/plain_x},\n"
            "  journal = {Venue},\n"
            "}"
        )

    NONLATIN = dict(title="\u6df1\u5ea6\u5b66\u4e60\u7684\u7814\u7a76",
                    authors=["\u0418\u0432\u0430\u043d "
                             "\u041f\u0435\u0442\u0440\u043e\u0432"])

    def _formatted(self, capsys, papers):
        """Return what `search -f bibtex` prints for `papers`."""
        BibTeXFormatter().format([SearchResult(
            query="q", provider="dblp", timestamp="2024-01-01T00:00:00",
            papers=papers,
        )])
        return capsys.readouterr().out

    def _compile(self, tmp_path, bib, engine, preamble):
        """Compile a document citing `bib` with `engine` and biber."""
        import shutil
        import subprocess
        if not (shutil.which(engine) and shutil.which("biber")
                and shutil.which("pdftotext")):
            pytest.skip(f"{engine}, biber and pdftotext are needed")
        (tmp_path / "refs.bib").write_text(bib, encoding="utf-8")
        (tmp_path / "doc.tex").write_text(
            "\\documentclass{article}\n" + preamble
            + "\\usepackage[backend=biber]{biblatex}\n"
            "\\addbibresource{refs.bib}\n\\begin{document}\n"
            "\\nocite{*}\\printbibliography\n\\end{document}\n",
            encoding="utf-8",
        )
        def run(*command):
            return subprocess.run(
                command, cwd=tmp_path, capture_output=True, text=True,
                timeout=300,
            )
        latex = (engine, "-interaction=nonstopmode", "-halt-on-error",
                 "doc.tex")
        assert run(*latex).returncode == 0
        biber = run("biber", "doc")
        assert biber.returncode == 0, biber.stdout[-2000:]
        assert "ERROR" not in biber.stdout
        final = run(*latex)
        assert final.returncode == 0, final.stdout[-2000:]
        return run("pdftotext", "doc.pdf", "-").stdout

    def test_a_document_citing_the_entries_compiles(self, tmp_path, capsys):
        from scholar import Paper
        from scholar.review import NONLATIN_MARKER
        papers = [
            Paper(title=title, authors=["Ann Smith"], year=2024,
                  venue=f"J {title}")
            for title in self.SPECIALS
        ] + [Paper(year=2024, venue="J", **self.NONLATIN)]
        bib = self._formatted(capsys, papers)
        text = self._compile(tmp_path, bib, "pdflatex",
                             "\\usepackage[T1]{fontenc}\n")
        assert NONLATIN_MARKER in text

    @pytest.mark.parametrize("engine", ["xelatex", "lualatex"])
    def test_a_unicode_engine_prints_the_non_latin_text(
        self, tmp_path, capsys, engine
    ):
        import subprocess
        from scholar import Paper
        font = "Noto Sans CJK SC"
        fonts = subprocess.run(["fc-list", ":", "family"],
                               capture_output=True, text=True).stdout
        if font not in fonts:
            pytest.skip(f"the font {font} is needed")
        bib = self._formatted(capsys,
                              [Paper(year=2024, venue="J", **self.NONLATIN)])
        text = self._compile(
            tmp_path, bib, engine,
            f"\\usepackage{{fontspec}}\n\\setmainfont{{{font}}}\n")
        assert self.NONLATIN["title"] in text
        assert self.NONLATIN["authors"][0] in text

    def test_the_preamble_comes_once_and_only_when_used(self, capsys):
        from scholar import Paper
        from scholar.review import nonlatin_definition
        plain = [Paper(title="Plain", authors=["Ann Smith"], year=2024)]
        out = self._formatted(capsys, plain)
        assert out == (
            "@article{smith2024,\n  title = {Plain},\n"
            "  author = {Ann Smith},\n  year = {2024},\n}\n\n"
        )
        mixed = plain + [Paper(year=2024, **self.NONLATIN),
                         Paper(year=2023, **self.NONLATIN)]
        for formatter in (BibTeXFormatter(), BibTeXProvFormatter()):
            formatter.format([SearchResult(
                query="q", provider="dblp",
                timestamp="2024-01-01T00:00:00", papers=mixed,
            )])
            out = capsys.readouterr().out
            [preamble] = [l for l in out.splitlines()
                          if l.startswith("@preamble")]
            assert out.startswith(preamble + "\n\n")
            for line in nonlatin_definition():
                assert line in preamble

    @staticmethod
    def _bib(tmp_path, entry, block=None):
        bib = tmp_path / "refs.bib"
        lines = []
        if block:
            lines += ["% === provenance: b2024 ===", f"% CLAIM: {block}"]
        bib.write_text("\n".join(lines + [entry, ""]), encoding="utf-8")
        return bib

    def test_export_finds_a_note_taken_on_the_paper(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import save_note
        entry, paper = self._entry("R&D: Developers\u2019 \u201cview\u201d")
        save_note(paper, "=== provenance: b2024 ===\nCLAIM: from the TUI")
        result = CliRunner().invoke(
            app, ["prov", "export", str(self._bib(tmp_path, entry))])
        assert result.exit_code == 0
        assert "% CLAIM: from the TUI" in result.output

    def test_first_import_keys_the_note_by_the_papers_id(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import get_note
        entry, paper = self._entry('R&D of a_b at 100% "now"')
        bib = self._bib(tmp_path, entry, block="imported")
        assert CliRunner().invoke(
            app, ["prov", "import", str(bib)]).exit_code == 0
        note = get_note(paper)
        assert note is not None and "CLAIM: imported" in note.note

    def test_export_ignores_a_namesake_by_another_author(
        self, tmp_path, monkeypatch
    ):
        """Two notes share the escaped title; the authors pick the one."""
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import save_note
        _, other = self._entry("Developers’ view", authors=["Cy Other"])
        save_note(other, "=== provenance: b2024 ===\nCLAIM: not this one")
        entry, paper = self._entry("Developers' view")
        save_note(paper, "=== provenance: b2024 ===\nCLAIM: this one")
        result = CliRunner().invoke(
            app, ["prov", "export", str(self._bib(tmp_path, entry))])
        assert result.exit_code == 0
        assert "not this one" not in result.output
        assert "% CLAIM: this one" in result.output

    def test_import_meets_an_existing_note_despite_lossy_escapes(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.notes import get_note, list_papers_with_notes, save_note
        entry, paper = self._entry("Developers\u2019 \u201cview\u201d")
        save_note(paper, "personal prose")
        bib = self._bib(tmp_path, entry, block="merged")
        assert CliRunner().invoke(
            app, ["prov", "import", str(bib)]).exit_code == 0
        assert [n.paper_id for n in list_papers_with_notes()] == [paper.id]
        note = get_note(paper)
        assert "personal prose" in note.note and "CLAIM: merged" in note.note
