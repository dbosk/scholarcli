The first screen has sheets of its own (\cref{sec:first-screen-sheet}).
On an invented session of six pending papers, one of them held twice
under one id, and two decided ones, [[--pending]] lists the six pending
papers once each, with the columns of the other sheets, and no decided
one; the batch ids of the pending sheets are not those of the decided
sheets of the same size.  The option is refused with [[--sample]],
[[--undecided-by]] and another format before any session is read (a
session that does not exist would exit 1).  Then the first screen goes
round the loop with two batches of three: the first screener returns
two of its three records, which is reported and saved; the second
returns its three and one record of the first batch, which
[[--strict]] refuses and which is saved, with the batch id, without
it.

<<test functions>>=
class TestFirstScreenSheets:
  """`-f screen-sheet --pending` hands out pending papers (#292)."""

  def _save(self, tmp_path, monkeypatch):
    from datetime import datetime
    from scholar import review
    from scholar.scholar import Paper

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))

    def paper(n):
      return Paper(title=f"Pending invented title {n}", authors=["B"],
                   year=2000 + n, venue=f"Venue {n}",
                   doi=f"10.5555/first-{n}", abstract=f"Abstract {n}.")

    pending = [review.ReviewDecision(paper=paper(n), provider="openalex")
               for n in range(6)]
    copy = review.ReviewDecision(paper=paper(2), provider="dblp")
    decided = [review.ReviewDecision(
      paper=paper(10 + n), provider="openalex",
      status=review.DecisionStatus.DISCARDED, tags=["off-topic-false-hit"],
      source=review.ReviewSource.AGENT_UNREVIEWED, agent_by="a-1")
      for n in range(2)]
    session = review.ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
      name="first", decisions=pending[:3] + [copy] + decided + pending[3:])
    review.save_session(session)
    out = tmp_path / "out"
    out.mkdir()
    return out

  def _export(self, out, *options, name="first"):
    return runner.invoke(app, ["sessions", "export", name, "-f",
                               "screen-sheet", "-o", str(out), *options])

  def test_pending_papers_once_each(self, tmp_path, monkeypatch):
    out = self._save(tmp_path, monkeypatch)
    result = self._export(out / "p.tsv", "--pending")
    assert result.exit_code == 0, result.output
    assert "6 paper(s) on the screen sheet." in result.output
    lines = (out / "p.tsv").read_text(encoding="utf-8").splitlines()
    assert lines[0] == "id\ttitle\tyear\tvenue\tabstract"
    assert lines[1] == ("doi:10.5555/first-0\tPending invented title 0"
                        "\t2000\tVenue 0\tAbstract 0.")
    assert [line.split("\t")[0] for line in lines[1:]] == [
      f"doi:10.5555/first-{n}" for n in range(6)]

  def test_pending_and_decided_sheets_have_other_ids(
    self, tmp_path, monkeypatch
  ):
    out = self._save(tmp_path, monkeypatch)
    assert self._export(out / "p", "--pending", "--batch-size",
                        "2").exit_code == 0
    assert self._export(out / "d", "--batch-size", "2").exit_code == 0
    first = (out / "p-001.tsv").read_text().splitlines()[0]
    decided = (out / "d-001.tsv").read_text().splitlines()[0]
    assert first.startswith("# batch: ") and decided.startswith("# batch: ")
    assert first != decided

  def test_refusals_before_loading(self, tmp_path, monkeypatch):
    out = self._save(tmp_path, monkeypatch)
    for options in (["-f", "screen-sheet", "--pending", "--sample", "s"],
                    ["-f", "screen-sheet", "--pending",
                     "--undecided-by", "a-1"],
                    ["-f", "csv", "--pending"]):
      result = runner.invoke(app, ["sessions", "export", "no-such-session",
                                   "-o", str(out / "x"), *options])
      assert result.exit_code == 2, (options, result.output)
    assert list(out.iterdir()) == []

  def test_the_first_screen_goes_round_the_loop(self, tmp_path,
                                                 monkeypatch):
    from scholar.review import load_session

    out = self._save(tmp_path, monkeypatch)
    assert self._export(out / "b", "--pending", "--batch-size",
                        "3").exit_code == 0
    sheets = [out / "b-001.tsv", out / "b-002.tsv"]
    lines = [s.read_text(encoding="utf-8").splitlines() for s in sheets]
    ids = [[line.split("\t")[0] for line in sheet[4:]] for sheet in lines]
    batches = [sheet[0].removeprefix("# batch: ") for sheet in lines]

    def reasons(name, sheet, chosen):
      path = out / name
      path.write_text("".join(
        [line + "\n" for line in sheet[:3]]
        + [f"{value}\tInvented reason about {value}.\n"
           for value in chosen]), encoding="utf-8")
      return str(path)

    def decide(path, sheet, *extra):
      return runner.invoke(app, [
        "sessions", "decide", "first", "--source", "agent", "--discard",
        "--tag", "off-topic-false-hit", "--by", "agent-5",
        "--reasons-file", path, "--sheet", str(sheet), *extra])

    short = decide(reasons("r1.tsv", lines[0], ids[0][:2]), sheets[0])
    assert short.exit_code == 0, short.output
    stderr = " ".join(short.stderr.split())
    assert (f"b-001.tsv (batch {batches[0]}): returned 2 of 3; 1 missing: "
            f"{ids[0][2]}.") in stderr
    assert "Missing rows are fine" in stderr
    stray = reasons("r2.tsv", lines[1], ids[1] + [ids[0][2]])
    refused = decide(stray, sheets[1], "--strict")
    assert refused.exit_code == 2, refused.output
    assert "1 id(s) not on their sheet" in refused.output
    saved = decide(stray, sheets[1])
    assert saved.exit_code == 0, saved.output
    assert (f"b-002.tsv (batch {batches[1]}): 1 id(s) not on the sheet: "
            f"{ids[0][2]}") in " ".join(saved.stderr.split())
    stored = {d.paper.id: d.agent_batch
              for d in load_session("first").decisions
              if d.agent_by == "agent-5"}
    assert stored[ids[0][0]] == batches[0]
    assert stored[ids[1][0]] == batches[1]
    assert stored[ids[0][2]] == batches[1]
