class TestExportMoves:
  """A failed move leaves the earlier export and says so (#320)."""

  <<export moves test methods>>

<<export moves test methods>>=
def _save(self, tmp_path, monkeypatch, count):
  from scholar import review

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  session = review.ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 23),
    name="moves",
  )
  session.decisions = [review.ReviewDecision(
    paper=Paper(title=f"Tidal Ledger {n}", authors=["Pia Lund"],
                year=2024, doi=f"10.5555/moves-{n}"),
    provider="openalex", status=review.DecisionStatus.KEPT,
  ) for n in range(count)]
  review.save_session(session)

def _earlier_export(self, tmp_path, monkeypatch, fmt="all"):
  out_dir = tmp_path / "out"
  out_dir.mkdir()
  self._save(tmp_path, monkeypatch, 1)
  assert self._export(out_dir, fmt).exit_code == 0
  self._save(tmp_path, monkeypatch, 2)
  return out_dir

def _export(self, out_dir, fmt="all"):
  return runner.invoke(app, [
    "sessions", "export", "moves", "-f", fmt, "-o", str(out_dir / "rep"),
  ])

def _content(self, out_dir):
  return {
    p.name: "dir" if p.is_dir() else p.read_bytes()
    for p in out_dir.iterdir() if p.name != ".scholar-outputs.lock"
  }

def _fail_on(self, monkeypatch, failing):
  import os

  real_replace = os.replace

  def replace(source, target, *args, **kwargs):
    if failing(Path(source), Path(target)):
      raise OSError(28, "No space left on device")
    return real_replace(source, target, *args, **kwargs)

  monkeypatch.setattr(os, "replace", replace)

def test_a_directory_at_the_second_target_changes_nothing(
  self, tmp_path, monkeypatch,
):
  out_dir = self._earlier_export(tmp_path, monkeypatch, fmt="latex")
  (out_dir / "rep.csv").mkdir()
  before = self._content(out_dir)
  result = self._export(out_dir)
  assert result.exit_code == 1
  assert self._content(out_dir) == before
  text = " ".join(result.output.split())
  assert "Export failed, no files were written or changed:" in text
  assert f"{out_dir / 'rep.csv'} is a directory" in text

def test_a_failed_last_move_is_rolled_back(self, tmp_path, monkeypatch):
  from scholar.utils import STAGING_PREFIX

  out_dir = self._earlier_export(tmp_path, monkeypatch)
  before = self._content(out_dir)
  self._fail_on(monkeypatch, lambda source, target: (
    STAGING_PREFIX in str(source) and target.name == "rep.tex"
  ))
  result = self._export(out_dir)
  assert result.exit_code == 1
  assert self._content(out_dir) == before
  text = " ".join(result.output.split())
  assert ("Export failed and was rolled back, no files were written or "
          "changed: OSError: [Errno 28] No space left on device") in text

def test_a_failed_restore_lists_each_file(self, tmp_path, monkeypatch):
  from scholar.utils import KEPT_PREFIX, STAGING_PREFIX

  out_dir = self._earlier_export(tmp_path, monkeypatch)
  old_bib = (out_dir / "rep.bib").read_bytes()
  self._fail_on(monkeypatch, lambda source, target: (
    STAGING_PREFIX in str(source) and target.name == "rep.tex"
    or KEPT_PREFIX in str(source) and target.name == "rep.bib"
  ))
  result = self._export(out_dir)
  assert result.exit_code == 1
  text = " ".join(result.output.split())
  assert "no files were written" not in text
  assert "Export failed part-way and could not be rolled back" in text
  [kept] = [p for p in out_dir.iterdir() if p.name.startswith(KEPT_PREFIX)]
  assert (kept / "rep.bib").read_bytes() == old_bib
  assert (f"Holding the new version: {out_dir / 'rep.bib'} (earlier "
          f"version kept as {kept / 'rep.bib'})") in text
  assert (f"Holding the earlier version: {out_dir / 'rep.csv'}, "
          f"{out_dir / 'rep.tex'}") in text
