        pairs=[("query a", "openalex"), ("query b", "openalex")],
        paper=paper, provider="openalex", limit=40,
    )

    result = runner.invoke(app, ["prov", "found-via", paper.id])
    assert result.exit_code == 0
    assert "FOUND-VIA:" not in result.output
    assert "did not record" in result.output
    assert "2 openalex searches" in result.output
    for query in ("query a", "query b"):
        assert (
            f"scholar search '{query}' -p openalex --limit 40 -n w45"
        ) in result.output

    as_json = runner.invoke(
        app, ["prov", "found-via", paper.id, "-f", "json"]
    )
    record = json.loads(as_json.output)[0]
    assert record["link"] == "missing"
    assert record["command"] is None
    assert record["candidate_queries"] == ["query a", "query b"]
    assert record["candidate_commands"] == [
        "scholar search 'query a' -p openalex --limit 40",
        "scholar search 'query b' -p openalex --limit 40",
    ]

def test_found_via_infers_the_only_search(self, tmp_path, monkeypatch):
