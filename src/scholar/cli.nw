def _save(self, name, query, doi):
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    save_session,
  )

  session = ReviewSession(
    query=query, providers=["p"], timestamp=datetime(2026, 11, 19),
    name=name,
  )
  session.decisions.append(ReviewDecision(
    paper=Paper(title=f"T {doi}", authors=["A"], doi=doi),
    provider="p", status=DecisionStatus.KEPT, tags=["ml"],
    source=ReviewSource.LLM_UNREVIEWED, llm_confidence=0.9,
  ))
  return save_session(session)

def _pair(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  return (self._save("foo", "bar", "10.1/named"),
          self._save(None, "foo", "10.1/unnamed"))

@pytest.mark.parametrize("args", [
  ["sessions", "show", "foo"],
  ["sessions", "export", "foo", "-f", "csv"],
