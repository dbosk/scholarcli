def test_quote_on_an_unreadable_pdf_is_one_line(self, tmp_path, monkeypatch):
  from unittest.mock import MagicMock, patch
  from scholar.pdf import get_cached_pdf_path

  monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
  url = "https://pub.example/a.pdf"
  truncated = make_cli_pdf(tmp_path / "p.pdf").read_bytes()[:200]
  get_cached_pdf_path(url).write_bytes(truncated)
  response = MagicMock()
  response.headers = {"content-type": "application/pdf"}
  response.iter_content.return_value = [truncated]
  with patch("scholar.pdf.requests.get", return_value=response):
    result = runner.invoke(
      app, ["pdf", "quote", url, "--claim", "x", "--no-llm"],
      env={"COLUMNS": "500"},
    )
  assert result.exit_code == 1
  assert isinstance(result.exception, SystemExit)
  assert "Traceback" not in result.output
  assert "Download failed: URL did not return a readable PDF" \
    in result.output

def test_usage_and_refusals_exit_2(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
  pdf = make_cli_pdf(tmp_path / "paper.pdf")
  page = tmp_path / "page.pdf"
  page.write_text("<html><body>Verify you are human</body></html>")
  for args in (
    ["pdf", "import", str(pdf)],
    ["pdf", "import", str(pdf), "--url", "https://a/", "--doi", "10.1/x"],
    ["pdf", "import", "--doi", "10.9999/ex.1"],
    ["pdf", "import", str(tmp_path / "missing.pdf"), "--doi", "10.9999/x"],
    ["pdf", "import", str(pdf), "--doi", "not-a-doi"],
  ):
    assert runner.invoke(app, args).exit_code == 2, args
  result = runner.invoke(
    app, ["pdf", "import", str(page), "--url", "https://a/"],
    env={"COLUMNS": "500"},
  )
  assert result.exit_code == 2
  assert "page.pdf is not a PDF" in result.output
  assert "HTML page" in result.output

def test_replace(self, tmp_path, monkeypatch):
  import hashlib

  monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
  first = make_cli_pdf(tmp_path / "first.pdf", width=200)
  second = make_cli_pdf(tmp_path / "second.pdf", width=300)
  url = ["--url", "https://pub.example/a.pdf"]
  env = {"COLUMNS": "500"}
  assert runner.invoke(app, ["pdf", "import", str(first), *url]) \
    .exit_code == 0
  result = runner.invoke(app, ["pdf", "import", str(second), *url], env=env)
  assert result.exit_code == 2
  assert hashlib.sha256(first.read_bytes()).hexdigest() in result.output
  result = runner.invoke(app, ["pdf", "import", str(first), *url], env=env)
  assert result.exit_code == 0
  assert "nothing copied" in result.output
  result = runner.invoke(
    app, ["pdf", "import", str(second), *url, "--replace"], env=env
  )
  assert result.exit_code == 0
  assert "Replaced with second.pdf" in result.output

def test_info_and_clear(self, tmp_path, monkeypatch):
  import os
  from scholar.pdf import get_cached_pdf_path

  monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
  pdf = make_cli_pdf(tmp_path / "paper.pdf")
  env = {"COLUMNS": "500"}
  runner.invoke(app, [
    "pdf", "import", str(pdf), "--doi", "10.9999/ex.1", "--from", "ILL",
  ])
  get_cached_pdf_path("https://pub.example/b.pdf").write_bytes(b"x")
  orphan = get_cached_pdf_path("https://pub.example/c.pdf")
  orphan.with_name(orphan.stem + ".import.json").write_text("{}")
  leftover = orphan.with_name(".0123456789abcdef.pdf.k3x9.tmp")
  leftover.write_bytes(b"%PDF-1.7 partial")
  os.utime(leftover, (0, 0))

  result = runner.invoke(app, ["pdf", "info", "--list-imported"], env=env)
  assert result.exit_code == 0
  assert "Imported by hand" in result.output
  assert "Orphaned import records" in result.output
  assert "Stale temporary files" in result.output
  assert "paper.pdf" in result.output and "ILL" in result.output
  assert "10.9999/ex.1" in result.output

  result = runner.invoke(app, ["pdf", "clear"], env=env)
  assert "Cleared 1 cached PDF(s)." in result.output
  assert "Kept 1 imported PDF(s)" in result.output
  result = runner.invoke(app, ["pdf", "clear", "--include-imported"], env=env)
  assert "Cleared 1 cached PDF(s)." in result.output
  assert "Kept" not in result.output
