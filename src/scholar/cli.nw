\subsection{Reconciling copies of one work}
\label{sec:sessions-reconcile}

One provider records a paper with its DOI, another without, and a
session holds the two copies as two decisions.  An append never folds
them (\cref{sec:session-copies} in the review chapter explains why: a
fold in memory raced every other process that saved the session before
it did).  [[sessions reconcile]] does it on request: under the session
file's lock it loads the file, folds every foldable pair, writes, and
then moves the notes of the folded copies ([[reconcile_session]]).  It
prints each fold as the old and the new id, so the user sees what
became of the ids they may have noted; [[--dry-run]] prints the same
list and writes nothing.

<<sessions command>>=
@sessions_app.command("reconcile")
def sessions_reconcile(
    name: Annotated[
        str,
        typer.Argument(
            help="Session name to reconcile.",
            autocompletion=complete_session_name,
        ),
    ],
    dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="List the copies that would be folded; write nothing.",
        ),
    ] = False,
) -> None:
    """
    Fold the copies of one work, with and without a DOI, in a session.

    A copy nobody has screened is folded into the decided one, and two
    equal decisions become one; copies decided differently are left for
    `sessions show` to list. Notes move to the folded entry's id.
    """
    from scholar.review import (
        SessionArgumentError, SessionFileError, reconcile_session,
    )

    console = Console()
    try:
        folds = reconcile_session(name, dry_run=dry_run)
    except SessionArgumentError as error:
        Console(stderr=True).print(f"[red]{escape(str(error))}[/red]")
        raise typer.Exit(2)
    except FileNotFoundError:
        console.print(f"[red]Session not found: {escape(name)}[/red]")
        raise typer.Exit(1)
    except SessionFileError as error:
        exit_on_unreadable_session(error)
    for old_id, new_id in folds:
        console.print(f"  {escape(old_id)} -> {escape(new_id)}")
    verb = "Would fold" if dry_run else "Folded"
    console.print(f"{verb} {len(folds)} copies in {escape(name)}.")
@

The command is run on a saved session, once as a dry run and once for
real; the second run finds nothing left to fold.

<<test functions>>=
class TestSessionsReconcile:
  def test_dry_run_then_fold(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    from scholar.review import (
      ReviewSession, ReviewDecision, DecisionStatus, save_session,
      load_session,
    )
    bare = Paper(title="A Work", authors=["Ada Lovelace"], year=2021)
    session = ReviewSession(
      query="rc", providers=["openalex"], timestamp=datetime.now(),
      name="rc",
    )
    session.decisions.extend([
      ReviewDecision(paper=bare, provider="dblp"),
      ReviewDecision(
        paper=Paper(title="A Work", authors=["Ada Lovelace"], year=2021,
                    doi="10.1/rc"),
        provider="openalex", status=DecisionStatus.KEPT,
      ),
    ])
    save_session(session)

    shown = runner.invoke(app, ["sessions", "show", "rc"])
    assert "Foldable copies: 1" in shown.output
    assert "scholar sessions reconcile rc" in shown.output

    dry = runner.invoke(app, ["sessions", "reconcile", "rc", "--dry-run"])
    assert dry.exit_code == 0, dry.output
    assert f"{bare.id} -> doi:10.1/rc" in dry.output
    assert "Would fold 1 copies in rc." in dry.output
    assert len(load_session("rc").decisions) == 2

    done = runner.invoke(app, ["sessions", "reconcile", "rc"])
    assert done.exit_code == 0, done.output
    assert "Folded 1 copies in rc." in done.output
    assert len(load_session("rc").decisions) == 1
    again = runner.invoke(app, ["sessions", "reconcile", "rc"])
    assert "Folded 0 copies" in again.output

    missing = runner.invoke(app, ["sessions", "reconcile", "nope"])
    assert missing.exit_code == 1
