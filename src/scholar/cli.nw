class TestSessionsScreen:
  """`sessions screen` records verdicts beside the decisions (#253)."""

  <<sessions screen test methods>>

<<sessions screen test methods>>=
AT = "2026-11-20T10:00:00+00:00"

def _make_session(self, tmp_path, monkeypatch, categories=False,
                  samples=()):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    record_human_decision, save_session,
  )

  off_topic = "off-topic-false-hit" if categories else "off-topic"
  llm = ReviewDecision(
    paper=Paper(title="Compilers for Beginners", authors=["A"],
                doi="10.1/llm",
                abstract="We describe a compiler course for beginners."),
    provider="openalex", status=DecisionStatus.DISCARDED,
    tags=[off_topic], source=ReviewSource.LLM_UNREVIEWED,
    llm_confidence=0.7, llm_model="m-1", llm_reason="About compilers.",
    llm_decided_at=self.AT,
  )
  human = ReviewDecision(
    paper=Paper(title="Recursion Misconceptions", authors=["B"],
                doi="10.1/human",
                abstract="Most students treated recursion as a loop."),
    provider="openalex", status=DecisionStatus.KEPT,
    tags=["supports-claim"] if categories else ["recursion"],
    source=ReviewSource.LLM_REVIEWED, llm_model="m-1",
  )
  record_human_decision(human, "tui", by="the author", at=self.AT)
  pending = ReviewDecision(
    paper=Paper(title="Loops in Practice", authors=["C"],
                doi="10.1/pending", abstract="A study of loops."),
    provider="openalex",
  )
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="screens", decisions=[llm, human, pending],
  )
  session.llm_samples = list(samples)
  return save_session(session)

def _screen(self, *args, name="screens"):
  return runner.invoke(app, ["sessions", "screen", name, *args])

def _saved(self, path):
  import json

  return {d["paper"]["doi"]: d
          for d in json.loads(path.read_text())["decisions"]}

def _file(self, tmp_path, text):
  path = tmp_path / "verdicts.tsv"
  path.write_text(text)
  return str(path)

def test_an_agent_screening_leaves_the_decision(self, tmp_path,
                                                 monkeypatch):
  import scholar.utils

  path = self._make_session(tmp_path, monkeypatch)
  before = self._saved(path)
  monkeypatch.setattr(scholar.utils, "utc_now_iso", lambda: self.AT)
  result = self._screen("--as", "agent", "--by", "agent-2", "--keep",
                        "--tag", "compilers", "--reason", "Teaching.",
                        "-c", "0.6", "--doi", "10.1/llm",
                        "--doi", "10.1/pending", "--blind")
  assert result.exit_code == 0, result.output
  flat = " ".join(result.output.split())
  assert "Recorded 2 screening(s) by agent agent-2 on 2 paper(s)" in flat
  assert "(1 snapshot(s) of the decision taken)" in flat
  after = self._saved(path)
  for doi in before:
    rest = {k: v for k, v in after[doi].items() if k != "screenings"}
    assert rest == before[doi], doi
  snapshot, screening = after["10.1/llm"]["screenings"]
  assert (snapshot["origin"], snapshot["kind"], snapshot["name"],
          snapshot["status"]) == ("decision", "llm", "m-1", "discarded")
  assert {k: screening[k] for k in (
    "origin", "kind", "name", "status", "tags", "reason", "confidence",
    "blind", "blind_basis", "recorded_at", "via", "sample_id")} == {
    "origin": "screen", "kind": "agent", "name": "agent-2",
    "status": "kept", "tags": ["compilers"], "reason": "Teaching.",
    "confidence": 0.6, "blind": True, "blind_basis": "declared",
    "recorded_at": self.AT, "via": "screen", "sample_id": None,
  }
  [pending] = after["10.1/pending"]["screenings"]
  assert pending["origin"] == "screen"
  assert "screenings" not in after["10.1/human"]

def test_a_confirmed_call_is_snapshot_as_the_humans(self, tmp_path,
                                                     monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  result = self._screen("--as", "agent", "--by", "agent-2", "--discard", "--tag",
                        "off-topic", "--doi", "10.1/human")
  assert result.exit_code == 0, result.output
  snapshot, screening = self._saved(path)["10.1/human"]["screenings"]
  assert (snapshot["kind"], snapshot["name"], snapshot["confirmed_from"],
          snapshot["confirmed_name"]) == ("human", "the author", "llm",
                                          "m-1")
  assert (screening["kind"], screening["name"], screening["blind"]) \
    == ("agent", "agent-2", None)

def test_who_screened_is_required_off_a_terminal(self, tmp_path,
                                                 monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  for args, message in (
    ([], "pass --as agent|human|llm"),
    (["--as", "robot"], "Invalid --as"),
    (["--as", "llm"], "--by: name the screener"),
    (["--as", "agent"], "--by: name the screener"),
    (["--as", "human", "-c", "0.5"], "a human screening carries none"),
    (["--as", "agent", "--by", " "], "--by: empty name"),
  ):
    result = self._screen(*args, "--keep", "--doi", "10.1/llm")
    assert result.exit_code == 2, (args, result.output)
    assert message in result.output, args
  for args, message in (
    (["--doi", "10.1/llm"], "exactly one of --keep or --discard"),
    (["--keep"], "Select at least one paper"),
    (["--discard", "--doi", "10.1/llm"], "requires at least one --tag"),
    (["--keep", "-t", "supports-claim", "-t", "adjacent-subtopic",
      "--doi", "10.1/llm"], "holds one category"),
    (["--keep", "--doi", "10.1/llm", "--strict-quotes"],
     "--strict-quotes checks"),
    (["--keep", "--doi", "10.1/llm", "--reason", "TODO"],
     "is a placeholder"),
  ):
    result = self._screen("--as", "agent", "--by", "agent-2", *args)
    assert result.exit_code == 2, (args, result.output)
    assert message in result.output, args
  result = self._screen("--as", "agent", "--by", "agent-2", "--keep",
                        "--doi", "10.1/llm", name="no-such-session")
  assert result.exit_code == 1
  assert all("screenings" not in d for d in self._saved(path).values())

def test_a_relayed_classifier_verdict_names_its_model(self, tmp_path,
                                                      monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  result = self._screen("--as", "llm", "--by", "m-2", "--keep",
                        "--doi", "10.1/pending", "-c", "0.9")
  assert result.exit_code == 0, result.output
  [screening] = self._saved(path)["10.1/pending"]["screenings"]
  assert (screening["kind"], screening["name"], screening["confidence"]) \
    == ("llm", "m-2", 0.9)
