Papers are looked up as [[sessions decide]] looks them up
([[<<select decisions by doi and paper id>>]] there): a DOI or an id
selects every decision under it, every unmatched selector or line is
named before the batch aborts unsaved (status~1), and one paper given
two different verdicts by two lines (by id and by DOI, say) is refused
(status~2).  [[trace_of]] maps each decision named in the file to its
line, under the name the quote check reads
([[<<check the quotes of the agent's reasons>>]]), and [[verdict_of]]
gives any selected decision its verdict, from its line or from the
command line.

<<select the papers screened>>=
by_doi: dict[str, list] = {}
by_id: dict[str, list] = {}
for d in session.decisions:
    if d.paper.doi:
        by_doi.setdefault(d.paper.doi.strip().lower(), []).append(d)
    by_id.setdefault(d.paper.id, []).append(d)
selected: dict[int, Any] = {}
missing: list[str] = []
for value in doi or []:
    matches = by_doi.get(value.strip().lower())
    if not matches:
        missing.append(f"DOI {value}")
    for decision in matches or []:
        selected[id(decision)] = decision
for value in paper_id or []:
    matches = by_id.get(value)
    if not matches:
        missing.append(f"paper id {value}")
    for decision in matches or []:
        selected[id(decision)] = decision
trace_of: dict[int, VerdictLine] = {}
clashes: list[str] = []
for entry in verdict_lines:
    matches = decisions_named_by(entry.paper, by_id, by_doi)
    if not matches:
        missing.append(f"verdicts-file line {entry.line}: {entry.paper}")
    for decision in matches:
        earlier = trace_of.setdefault(id(decision), entry)
        if earlier.line != entry.line and (
            earlier.status, earlier.tags, earlier.reason, earlier.confidence
        ) != (entry.status, entry.tags, entry.reason, entry.confidence):
            clashes.append(
                f"verdicts-file lines {earlier.line} and {entry.line} give "
                f"{decision.paper.id} different verdicts"
            )
        selected[id(decision)] = decision
if missing:
    for entry in missing:
        console.print(f"[red]Not in session: {escape(entry)}[/red]")
    console.print("[yellow]No changes saved.[/yellow]")
    raise typer.Exit(1)
for clash in clashes:
    console.print(f"[red]{escape(clash)}[/red]", soft_wrap=True)
if clashes:
    console.print("[yellow]No changes saved.[/yellow]")
    raise typer.Exit(2)


def verdict_of(decision) -> tuple[str, list[str], str | None, float | None]:
    """The verdict given for `decision`: status, tags, reason, confidence."""
    entry = trace_of.get(id(decision))
    if entry is None:
        return ("kept" if keep else "discarded", tags, reason, confidence)
    return (entry.status, list(entry.tags), entry.reason,
            entry.confidence if entry.confidence is not None
            else confidence)
