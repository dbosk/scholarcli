AT = "2026-11-19T10:00:00+00:00"

def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from datetime import timezone
  import scholar.review as review
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    SearchRecord, save_session, session_file_path,
  )

  monkeypatch.setattr(
    review, "_utcnow",
    lambda: datetime(2026, 11, 19, 10, 0, tzinfo=timezone.utc),
  )
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 19),
    name="reset",
  )
  session.search_records.append(SearchRecord(
    query="q", provider="openalex", filters={}, limit=50, hits=5,
    searched_at="2026-11-01T08:00:00+00:00",
  ))
  link = [("q", "openalex", "")]

  def decision(title, doi, **fields):
    return ReviewDecision(
      paper=Paper(title=title, authors=["A"], doi=doi, year=2024,
                  abstract=f"About {title}."),
      provider="openalex", found_by=list(link), **fields,
    )

  session.decisions.extend([
    decision(
      "Classified", "10.1/llm", status=DecisionStatus.DISCARDED,
      tags=["off-topic-false-hit"], source=ReviewSource.LLM_UNREVIEWED,
      llm_confidence=0.8, llm_model="m-1",
      llm_decided_at="2026-11-01T09:00:00+00:00",
      llm_prompt_version="0123456789abcdef", llm_reason="Off topic.",
      llm_abstract_truncated=False,
    ),
    decision("Agent", "10.1/agent", status=DecisionStatus.KEPT,
             tags=["supports-claim"], source=ReviewSource.AGENT_UNREVIEWED),
    decision("Human", "10.1/human", status=DecisionStatus.KEPT,
             tags=["supports-claim"]),
    decision("Confirmed", "10.1/confirmed", status=DecisionStatus.KEPT,
             tags=["adjacent-subtopic"], source=ReviewSource.LLM_REVIEWED,
             llm_model="m-1"),
    decision("Pending", "10.1/pending"),
  ])
  save_session(session)
  return session_file_path(session)

def _reset(self, *args):
  return runner.invoke(app, ["sessions", "reset", "reset", *args])

def test_llm_and_agent_decisions_are_reset(self, tmp_path, monkeypatch):
  from dataclasses import asdict
  from scholar.review import (
    DecisionStatus, ReviewSource, load_session,
  )

  path = self._make_session(tmp_path, monkeypatch)
  before = load_session("reset")
  result = self._reset("--source", "llm,agent", "--note", "redo",
                       "--by", "the author")
  assert result.exit_code == 0, result.output
  flat = " ".join(result.output.split())
  assert "Reset 2 decision(s)" in flat
  assert "discarded by llm: 1" in flat
  assert "kept by agent: 1" in flat
  after = load_session("reset")
  classified, agent, human, confirmed, pending = after.decisions
  assert classified.resets == [{
    "at": self.AT, "status": "discarded",
    "tags": ["off-topic-false-hit"], "source": "llm",
    "llm_confidence": 0.8, "is_example": False,
    "trace": {
      "llm_model": "m-1", "llm_decided_at": "2026-11-01T09:00:00+00:00",
      "llm_prompt_version": "0123456789abcdef",
      "llm_reason": "Off topic.", "llm_abstract_truncated": False,
    },
    "note": "redo", "by": "the author",
  }]
  assert agent.resets[0]["source"] == "agent"
  assert "trace" not in agent.resets[0]
  for reset in (classified, agent):
    assert reset.status is DecisionStatus.PENDING
    assert (reset.tags, reset.llm_confidence, reset.llm_model) \
      == ([], None, None)
    assert reset.source is ReviewSource.HUMAN
  for old, new in zip(before.decisions, after.decisions):
    assert new.paper.to_dict() == old.paper.to_dict()
    assert (new.found_by, new.provider) == (old.found_by, old.provider)
  for old, new in zip(before.decisions[2:], after.decisions[2:]):
    assert asdict(new) == asdict(old)
  assert [asdict(r) for r in after.search_records] \
    == [asdict(r) for r in before.search_records]
  assert path.with_name("reset.json.pre-reset-20261119T100000Z.bak") \
    .exists()

def test_a_human_decision_refuses_the_batch(self, tmp_path, monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  content = path.read_bytes()
  for args in (["--all"], ["--doi", "10.1/llm", "--doi", "10.1/CONFIRMED"],
               ["--source", "human"]):
    result = self._reset(*args)
    assert result.exit_code == 2, result.output
    flat = " ".join(result.output.split())
    assert "only a human can change them" in flat
    assert path.read_bytes() == content
  flat = " ".join(self._reset("--all").output.split())
  assert "doi:10.1/human is kept (human)" in flat
  assert "doi:10.1/confirmed is kept (llm_reviewed)" in flat
  assert list(path.parent.glob("*.pre-reset-*")) == []

