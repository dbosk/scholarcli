The run records a second-screen verdict on both decided papers, says
that the same model made one of the decisions, and leaves every
decision as it was saved; the pending paper is not touched.

<<classify second screen test methods>>=
def test_screens_are_saved_and_decisions_are_not(self, tmp_path,
                                                 monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  before = self._saved(path)
  self._fake(monkeypatch)
  result = self._classify("--second-screen", "--over", "all",
                          "--no-enrich", "-m", "model-a")
  assert result.exit_code == 0, result.output
  flat = " ".join(result.output.split())
  assert ("Recorded 2 second-screen verdict(s) by llm model-a on 2 "
          "paper(s)") in flat
  assert "(2 snapshot(s) of the decision taken); no decision was " \
    "changed." in flat
  assert "Same model as the first screen for 1 paper(s): model-a made " \
    "those decisions" in flat
  assert "Left to screen: 0" in flat
  after = self._saved(path)
  for doi in before:
    rest = {k: v for k, v in after[doi].items() if k != "screenings"}
    assert rest == before[doi], doi
  snapshot, screening = after["10.5555/cs-machine"]["screenings"]
  assert (snapshot["via"], snapshot["name"]) == ("snapshot", "model-a")
  assert (screening["via"], screening["name"], screening["status"],
          screening["blind_basis"]) == ("classify", "model-a", "kept",
                                        "prompt")
  assert "screenings" not in after["10.5555/cs-pending"]
  again = self._classify("--second-screen", "--over", "all",
                        "--no-enrich")
  assert again.exit_code == 1
  assert "2 already screened by it" in " ".join(again.output.split())
