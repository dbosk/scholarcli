@notes_app.command("show")
def notes_show(
    paper_id: Annotated[
        str,
        typer.Argument(
            help="Paper ID (DOI or hash) to show notes for.",
            autocompletion=complete_paper_id,
        ),
    ],
) -> None:
    """
    Show notes for a specific paper.

    Use 'scholar notes list' to find paper IDs.
    """
    from scholar.notes import list_papers_with_notes

    console = Console()
    notes = list_papers_with_notes()

    for note in notes:
        if note.paper_id == paper_id or paper_id in note.paper_id:
            console.print(f"[bold]{escape(str(note.title or ''))}[/bold]")
            console.print(f"[dim]ID: {escape(note.paper_id)}[/dim]")
            console.print(
                f"[dim]Updated: "
                f"{note.updated_at.strftime('%Y-%m-%d %H:%M')}[/dim]"
            )
            console.print()
            console.print(note.note, markup=False)
            return

    console.print(f"[red]No notes found for paper ID: {escape(paper_id)}[/red]")
    raise typer.Exit(1)

