  assert "marked discarded" not in result.output
  strict = self._decide("--reasons-file", reasons, "--dry-run", "--strict")
  assert strict.exit_code == 2, strict.output
  missing = self._decide("--doi", "10.1/not-there", "--reason", "Off.",
                         "--dry-run")
  assert missing.exit_code == 1, missing.output
  assert path.read_bytes() == before
  assert list(path.parent.glob("*.bak")) == []
@

\paragraph{A batch against its sheet.}
\label{sec:batch-against-sheet}
A screener may return fewer rows than its sheet held, or rows for
records that were never on it: an id copied from the wrong batch, or a
record the screener added.  [[sessions decide]] and [[sessions
screen]] cannot know a sheet they are not given, so [[--sheet FILE]]
(repeatable) gives it.  Each sheet is compared with the rows of its
batch, the batch named by the sheet's own [[# batch:]] line (the
sheets of \cref{sec:sheet-batches} begin with one): the rows that the
file's [[# batch:]] lines or [[--batch]] gave that id.  A sheet without
a [[# batch:]] line, such as the single sheet of an export without
[[--batch-size]], is compared with every row of the run.  Ids are
matched as the file's lines are matched to the session
([[decisions_named_by]]), so a DOI written without [[doi:]] on one side
meets its paper id on the other.

The differences go to standard error: \enquote{returned 88 of 100; 12
missing: \dots} and \enquote{3 id(s) not on the sheet: \dots}, with
the first [[BATCH_PAPERS_SHOWN]] ids of each.  Missing rows are no
error, and the output says so: a screener that leaves out the records
it did not read has done better than one that fills them with a
default, and the missing records stay as they were, ready for another
batch.  An id not on the sheet is a verdict on a record the screener
was not given, so [[--strict]] refuses the run for it, with the batch
check's other refusals; without [[--strict]] the run is saved and the
output says that [[--strict]] would refuse it.

A sheet is read as a file of this kind is read (UTF-8 with an optional
byte-order mark, lines ended by a newline): blank lines and comment
lines are skipped, a header line whose first column is [[id]] is
skipped, and every other line's first column is an id.  It is read by
hand, like the reasons file, not by the [[csv]] module: [[csv.reader]]
ends a line at a lone carriage return, which this format keeps inside
a field, and with its default quoting it would strip the quote marks
of a field quoted whole, which this format stores as written.  A sheet that
cannot be read, that lists no id or names two batches, or whose batch
line is refused, is a usage error before the session is loaded, like a
bad line of the file itself.

<<sessions command>>=
@dataclass(frozen=True)
class ScreenSheet:
    """A screen sheet given with `--sheet`: its file, batch and ids."""

    path: Path
    batch: str | None
    ids: tuple[str, ...]


def parse_screen_sheet(text: str) -> tuple[str | None, list[str], list[str]]:
    """The batch id, the ids and the problems of a screen sheet's text."""
    batch: str | None = None
    ids: list[str] = []
    problems: list[str] = []
    header_seen = False
    for number, raw in enumerate(text.split("\n"), start=1):
        raw = raw.removesuffix("\r")
        if not raw.strip():
            continue
        if raw.lstrip().startswith("#"):
            marked = BATCH_LINE.fullmatch(raw.strip())
            if marked and batch is not None:
                problems.append(f"line {number}: names a second batch")
            elif marked:
                batch, problem = read_batch_id(marked.group(1))
                if problem:
                    problems.append(f"line {number}: # batch: {problem}")
            continue
        first = raw.split("\t")[0].strip()
        if not header_seen:
            header_seen = True
            if first == "id":
                continue
        if first and first not in ids:
            ids.append(first)
    if not ids:
        problems.append("lists no id")
    return batch, ids, problems


def read_screen_sheets(paths) -> tuple[list[ScreenSheet], list[str]]:
    """Read the `--sheet` files; return them and their problems."""
    sheets: list[ScreenSheet] = []
    problems: list[str] = []
    for path in paths:
        try:
            text = path.read_bytes().decode("utf-8-sig")
        except (OSError, UnicodeDecodeError) as error:
            problems.append(f"--sheet {path}: cannot be read ({error})")
            continue
        batch, ids, sheet_problems = parse_screen_sheet(text)
        problems.extend(f"--sheet {path}: {p}" for p in sheet_problems)
        sheets.append(ScreenSheet(path, batch, tuple(ids)))
    <<refuse sheets that cannot be told apart>>
    return sheets, problems
