Enrichment of a large session takes hours, and it saves the session it
loaded at the start.  That is how two classified sessions lost all their
decisions and their research context
(\url{https://github.com/dbosk/scholar/issues/107},
\cref{sec:session-integrity}): the research context was set and the papers
classified while an enrichment ran, and the enrichment's save then wrote
its stale copy over them.  We replay that sequence through the real
command, with the classification happening inside the stubbed enrichment,
and require both the classification and the enrichment to survive.

<<test functions>>=
def test_enrich_keeps_decisions_saved_while_it_ran(tmp_path, monkeypatch):
    """A classification saved during `scholar enrich` is not undone."""
    from dataclasses import replace
    from scholar import Paper, SearchResult, isolated_registry
    from scholar.review import (
        DecisionStatus, create_review_session, load_session, save_session,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    papers = [
        Paper(title=f"Paper {i}", authors=["a"], doi=f"10.1/wp1-enrich-{i}")
        for i in range(2)
    ]
    save_session(create_review_session(
        [SearchResult(query="q", provider="m", timestamp="t", papers=papers)],
        "q", session_name="race",
    ))

    def classify_meanwhile(papers, **kwargs):
        with isolated_registry():
            other = load_session("race")
            other.research_context = "Does X support Y?"
            for decision in other.decisions:
                decision.status = DecisionStatus.DISCARDED
                decision.tags = ["off-topic"]
            save_session(other)
        return [replace(p, abstract="Enriched.") for p in papers]

    with patch(
        "scholar.enrich.enrich_papers", side_effect=classify_meanwhile
    ), patch(
        "scholar.crossref.annotate_papers", side_effect=lambda ps, **kw: ps
    ):
        result = runner.invoke(app, ["enrich", "race"])
    assert result.exit_code == 0, result.stdout

    with isolated_registry():
        saved = load_session("race")
    assert saved.research_context == "Does X support Y?"
    assert [d.status for d in saved.decisions] == [DecisionStatus.DISCARDED] * 2
    assert all(d.paper.abstract == "Enriched." for d in saved.decisions)
