            "the same one, 0.85: doi:10.1/batch-30") in stderr
    assert "In batch b-1" not in stderr
    stored = {d.paper.doi: d.agent_batch
              for d in load_session("batch").decisions}
    assert stored["10.1/batch-0"] == "b-1"
    assert stored["10.1/batch-59"] == "b-2"
    shown = json.loads(runner.invoke(
      app, ["sessions", "show", "batch", "-f", "json"]).output)
