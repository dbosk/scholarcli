A second Ctrl-C while the session is being kept is held back: the kept
file is written whole, and the command still ends with the one line and
exit code 130.  The saver's serialisation is slowed by a second and
announces itself, so that the second interrupt lands inside the keep.
Then [[sessions recover --discard]] deletes the kept file, and refuses
the session file itself with exit code~2.

<<test functions>>=
class TestSecondInterruptDuringTheKeep:
  """A second Ctrl-C does not leave an empty kept file (#316)."""

  SLOW_KEEP = """
    import time
    import scholar.review as review
    serialise = review.session_file_data
    def slow(session):
      print("keeping", file=sys.stderr, flush=True)
      time.sleep(1)
      return serialise(session)
    review.session_file_data = slow
  """

  def test_held_back_then_discarded(self, tmp_path, monkeypatch):
    import json
    import signal
    import subprocess
    import textwrap
    from scholar.review import unsaved_session_files
    path = TestRefusedSaveCommands._session(tmp_path, monkeypatch)
    before = path.read_bytes()
    holder = TestRefusedSaveCommands._hold("locked")
    code = textwrap.dedent(TestInterruptedWait.SAVER).replace(
      "from scholar.cli import main",
      textwrap.dedent(self.SLOW_KEEP) + "from scholar.cli import main")
    try:
      saver = subprocess.Popen(
        [sys.executable, "-c", code],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True,
      )
      seen = []
      for wanted in ("is locked by another scholar process", "keeping"):
        for line in saver.stderr:
          seen.append(line)
          if wanted in line:
            break
        saver.send_signal(signal.SIGINT)
      _, rest = saver.communicate(timeout=60)
    finally:
      holder.communicate("go\n", timeout=60)
    err = "".join(seen) + rest
    assert saver.returncode == 130, err
    assert "Traceback" not in err
    assert "is kept in" in err and "--discard" in err
    assert path.read_bytes() == before
    [kept] = unsaved_session_files()
    statuses = [d["status"] for d in json.loads(kept.read_text())[
      "decisions"]]
    assert statuses == ["kept", "pending"]
    listed = runner.invoke(app, ["sessions", "list"])
    assert "--discard" in " ".join(listed.output.split())
    refused = runner.invoke(app, ["sessions", "recover", str(path),
                                  "--discard"])
    assert refused.exit_code == 2 and path.read_bytes() == before
    deleted = runner.invoke(app, ["sessions", "recover", kept.name,
                                  "--discard"])
    assert deleted.exit_code == 0, deleted.output
    assert unsaved_session_files() == [] and path.read_bytes() == before
