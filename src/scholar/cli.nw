def _relabel(self, *args):
  return runner.invoke(app, ["sessions", "relabel", "relabel", *args])

def _fields(self, decision):
  from dataclasses import asdict

  fields = asdict(decision)
  for name in ("source", "relabelled", "paper", "is_example"):
    del fields[name]
  return fields

def test_human_to_agent_keeps_the_decision(self, tmp_path, monkeypatch):
  from scholar.review import ReviewSource, load_session

  path = self._make_session(tmp_path, monkeypatch)
  before = self._fields(load_session("relabel").decisions[0])
  result = self._relabel("--from", "human", "--to", "agent",
                         "--doi", "10.1/HUMAN", "--note", "an agent decided",
                         "--by", "the author")
  assert result.exit_code == 0, result.output
  assert "human -> agent: 1" in result.output
  decision = load_session("relabel").decisions[0]
  assert decision.source is ReviewSource.AGENT_UNREVIEWED
  assert self._fields(decision) == before
  assert decision.relabelled == [{
    "from": "human", "to": "agent", "at": self.AT,
    "note": "an agent decided", "by": "the author", "is_example": False,
  }]
  assert path.with_name(
    "relabel.json.pre-relabel-20261119T100000Z.bak"
  ).exists()

def test_reviewed_llm_call_keeps_its_trace(self, tmp_path, monkeypatch):
  from scholar.review import (
    LLM_AUDIT_FIELDS, ReviewSource, llm_audit_of, load_session,
  )

  self._make_session(tmp_path, monkeypatch)
  before = load_session("relabel").decisions[1]
  trace = (llm_audit_of(before), before.llm_confidence)
  result = self._relabel("--from", "llm_reviewed", "--to", "agent", "--all")
  assert result.exit_code == 0, result.output
  assert "llm_reviewed -> agent: 1" in result.output
  after = load_session("relabel").decisions[1]
  assert after.source is ReviewSource.AGENT_UNREVIEWED
  assert (llm_audit_of(after), after.llm_confidence) == trace
  assert after.llm_model == "m-1"
  assert after.is_example is False
  assert after.relabelled[0]["is_example"] is True

