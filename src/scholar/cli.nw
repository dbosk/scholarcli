  self._make_session(tmp_path, monkeypatch)
  result = self._screen("--as", "human", "--by", "a colleague", "--verdicts-file", self._file(
    tmp_path, "10.1/llm\tkept\tx\tFine.\t0.5\n"))
  assert result.exit_code == 2
  assert "line 1: a human screening carries no confidence" in result.output
