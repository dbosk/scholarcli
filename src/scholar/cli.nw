line_problems = [] if paper else ["empty id"]
values = []
for index, column in enumerate(layout.columns, start=1):
    text_value = columns[index] if index < len(columns) else None
    if text_value is None or (column.optional and not text_value.strip()):
        values.append(None)
        continue
    value, problem = column.read(text_value)
    if problem:
        line_problems.append(problem)
    values.append(value)
if not line_problems and layout.check is not None:
    line_problems.extend(layout.check(tuple(values)))
if line_problems:
    problems.append(f"line {number}: {'; '.join(line_problems)}")
    continue
entries.append((number, paper, tuple(values)))
@

The reason column is checked as [[--reason]] is
([[checked_agent_reason]]), and as a column it can also be shifted
([[reason_column_shift]], \cref{sec:decide-quote-check}).  The
confidence is a number between 0 and~1, the range of [[-c]].

<<sessions command>>=
def read_reason_column(text: str) -> tuple[str, str | None]:
    """Read a reason column: stripped, checked, not a shifted column."""
    reason, problem = checked_agent_reason(text)
    return reason, problem or reason_column_shift(reason)


def read_confidence_column(text: str) -> tuple[float | None, str | None]:
    """Read a confidence column: a number between 0 and 1."""
    try:
        confidence = float(text)
    except ValueError:
        return None, f"confidence {text.strip()!r} is not a number"
    if not 0.0 <= confidence <= 1.0:
        return None, f"confidence {confidence} is not between 0 and 1"
    return confidence, None


REASONS_LAYOUT = TabFileLayout(
    columns=(
        TabFileColumn(read_reason_column),
        TabFileColumn(read_confidence_column, optional=True),
    ),
    too_few="no tab between the id and the reason",
    holds="a line holds an id, a reason and an optional confidence",
    last="the confidence",
)
@

Once the session is loaded, each line's id is looked up as
[[--paper-id]] would look it up, and otherwise as a DOI: the paper id
of a paper with a DOI is [[doi:]] and the DOI, so a DOI with the prefix
that is not spelt as the id (other case, say) still finds its paper,
and a bare DOI finds it as [[--doi]] does; a [[hash:]] id that is not
in the session matches no DOI either.  A line selects every decision under its id, as [[--doi]] and
[[--paper-id]] do, so a work held twice under one id gets the reason
on both copies (with [[--all-copies]] when they are decided apart).

<<sessions command>>=
def decisions_named_by(value: str, by_id: dict, by_doi: dict) -> list:
    """The decisions a `--reasons-file` id names: by paper id, else DOI."""
    if value in by_id:
        return by_id[value]
    doi = value[4:] if value.lower().startswith("doi:") else value
    return by_doi.get(doi.strip().lower(), [])
