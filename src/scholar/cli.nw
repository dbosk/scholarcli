        SearchRecord("a AND b", "s2", None, 0, hits=784, via="bulk"),
        SearchRecord("plain", "s2", None, 100, hits=3),
      ],
    ))

    result = runner.invoke(app, ["sessions", "show", "via-show"])
    assert result.exit_code == 0
    assert "s2 (via bulk): a AND b" in result.output
    assert "  s2: plain" in result.output

    data = json.loads(runner.invoke(
      app, ["sessions", "show", "via-show", "-f", "json"]
    ).output)
    assert [r.get("via") for r in data["search_records"]] == ["bulk", None]
