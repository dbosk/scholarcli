    Draw a seeded random sample of unreviewed LLM decisions for review.

    The sample is drawn from all given sessions together, recorded in
    each of them (seed, criteria, date, papers) and queued for review:
    the TUI lists it under filter s, and each paper can be decided with
    `scholar sessions decide`. With --report, show for each stored
    sample how many sampled decisions were reviewed, how many the
    reviewer changed, and the disagreement rate with a 95% modified
    Wilson interval (Brown, Cai & DasGupta 2001). A stratified sample
    (--bands) is reported band by band, and, once every band is
    reviewed, with the stratified estimate for all its decisions (no
    interval is given for that estimate).

    Examples:
        scholar llm sample my-review --discarded --min-confidence 0.9 \\
            -n 50 --seed 20261118
        scholar llm sample my-review --discarded --bands 0.5,0.7,0.9 \\
            -n 20 --seed 20261120
        scholar llm sample my-review --report
    """
    from scholar.review import save_session

    console = Console()
    <<load the sessions to sample>>
    if report:
        <<report the stored samples>>
        return
    <<check the sampling criteria>>
    <<draw and record the sample>>
@

A session named twice ([[x x.json]], \cref{sec:cli-session-arguments})
is loaded once: two copies of one file would record the sample twice
in it and count its papers twice in a report.

<<load the sessions to sample>>=
from scholar.review import session_file_path

sessions = []
for name in session_names:
    session = open_session_argument(name)
    if session is None:
        console.print(f"[red]Session not found: {escape(name)}[/red]")
        raise typer.Exit(1)
    if all(session_file_path(session) != session_file_path(s)
           for s in sessions):
        sessions.append(session)
@

The criteria are checked together, so that one run names every
problem, and nothing is drawn while any remains.  A census
([[--census]]) takes everything that matches and so needs neither a
size nor a seed; a size given with it would suggest a sample, and is
refused.  [[--no-confidence]] selects only decisions without a
confidence, which no bound can select, and [[--bands]] splits the
population by confidence itself, so neither can be combined with a
bound, nor with each other (\cref{sec:llm-sample-bands} in the LLM
review module).  A minimum at or above the maximum would select
nothing.

<<check the sampling criteria>>=
from scholar.llm_review import check_band_cuts

problems = []
if not discarded and not kept:
    problems.append("give --discarded, --kept or both")
if census and size is not None:
    problems.append("-n cannot be combined with --census")
if not census and (size is None or size < 1):
    problems.append("give the sample size with -n (at least 1)")
if not census and seed is None:
    problems.append("give the seed with --seed")
for option, value in (("--min-confidence", min_confidence),
                      ("--max-confidence", max_confidence)):
    if value is not None and not 0 <= value <= 1:
        problems.append(f"{option} must be between 0 and 1")
if min_confidence is not None and max_confidence is not None \
        and min_confidence >= max_confidence:
    problems.append("--min-confidence must be below --max-confidence")
bounded = min_confidence is not None or max_confidence is not None
if no_confidence and bounded:
    problems.append(
        "--no-confidence cannot be combined with a confidence bound")
cuts = None
if bands is not None:
    if bounded or no_confidence:
        problems.append("--bands cannot be combined with --min-confidence, "
                        "--max-confidence or --no-confidence")
    try:
        cuts = [float(cut) for cut in bands.split(",")]
        check_band_cuts(cuts)
    except ValueError as error:
        problems.append(
            f"--bands takes cut points like 0.5,0.7,0.9 ({error})")
if problems:
    console.print(f"[red]Cannot draw: {'; '.join(problems)}.[/red]")
    raise typer.Exit(2)
@

The drawn papers are printed with the session argument that opens
their session, so that each can be passed to [[sessions decide]]; a
stratified draw first says what it drew from each band.

<<draw and record the sample>>=
from scholar.llm_review import draw_llm_sample
from scholar.notes import get_paper_id

statuses = {s for s, wanted in (("discarded", discarded), ("kept", kept))
            if wanted}
try:
    draw = draw_llm_sample(
        sessions, statuses=statuses, size=size, seed=seed,
        min_confidence=min_confidence, max_confidence=max_confidence,
        no_confidence=no_confidence, bands=cuts, census=census,
    )
except ValueError as error:
    console.print(f"[red]{escape(str(error))}[/red]")
    raise typer.Exit(1)
for session in sessions:
    save_session(session)
console.print(
    f"[green]Sample {escape(draw.sample_id)}: "
    f"{'took' if census else 'drew'} {len(draw.drawn)} of "
    f"{draw.population} eligible decisions[/green]"
)
for band in draw.bands:
    console.print(
        f"  band {band['band']}: "
        + ("none" if not band["population"]
           else f"all {band['population']} (census)" if band["census"]
           else f"{band['drawn']} of {band['population']}")
    )
from scholar.review import session_argument

held_by = {id(d): s for s in sessions for d in s.decisions}
for name, decision in draw.drawn:
    session_of = held_by.get(id(decision))
    if session_of is not None:
        name = session_argument(session_of)
    console.print(
        f"  {escape(name)}  {escape(get_paper_id(decision.paper))}  "
        f"{decision.status.value}  {escape(decision.paper.title)}"
    )
console.print(
    "Review them in the TUI (filter s) or with: scholar sessions decide "
    "SESSION --keep|--discard --paper-id ID --source human"
)
@

The report shows each sample as before.  A stratified sample is shown
once, with its sentence and then one line per band: the band, its
population, how many were drawn, reviewed and changed, the rate, and
the band's interval; a census band has no interval and says instead
that all of it is reviewed, or how many are left.  The JSON keeps the
keys a single sample always had, so scripts that read them keep
working, and gives a stratified sample the same keys for its totals,
[[stratified]], the list of [[bands]] (each with a single sample's
keys plus [[band]] and [[census]]) and the [[estimate]], [[null]] until
every band is reviewed, with [[estimate_withheld]] saying why while it
is [[null]] (the sentence's reason; [[null]] once it is given).

<<report the stored samples>>=
from scholar.llm_review import (
    StratifiedReport, band_label, group_sample_reports,
    pooled_sample_sessions, sample_report_sentence, sample_reports,
)

reports = group_sample_reports(
    sample_reports(pooled_sample_sessions(sessions)))
if output_format == "json":
    print(json.dumps([sample_report_data(r) for r in reports], indent=2))
    return
if not reports:
    console.print("No samples have been drawn in these sessions.")
for r in reports:
    sample_id = r.group if isinstance(r, StratifiedReport) else r.sample_id
    console.print(f"[bold]Sample {escape(sample_id)}[/bold]")
    console.print(f"  {escape(sample_report_sentence(r))}")
    if isinstance(r, StratifiedReport):
        <<print one line per band>>
    for name, paper_id in r.unreviewed:
        console.print(
            f"  not yet reviewed: {escape(name)}  {escape(paper_id)}"
        )
@

<<print one line per band>>=
console.print(
    f"  {'band':<20} {'population':>10} {'drawn':>5} {'reviewed':>8} "
    f"{'changed':>7} {'rate':>6}  95% interval"
)
for band in r.bands:
    console.print(
        f"  {escape(band_label(band)):<20} {band.population:>10} "
        f"{band.size:>5} {band.reviewed:>8} {band.changed:>7} "
        f"{band_rate_text(band):>6}  {band_interval_text(band)}"
    )
@

The line fits an 80-column terminal, so the interval column holds at
most fourteen characters: the band's modified Wilson interval, or for a
census band \enquote{all $N$ reviewed} or \enquote{census, $k$ left},
and \enquote{empty} for a band that held no decision when drawn (it is
recorded, so that the bands still cover the whole population, and
counts as a census of nothing).

<<llm command helpers>>=
def band_rate_text(band) -> str:
    """Return a band's rate for the band table, or '-' without reviews."""
    return f"{band.rate:.1%}" if band.rate is not None else "-"


def band_interval_text(band) -> str:
    """Return a band's interval column: its interval or its census state."""
    if band.population == 0:
        return "empty"
    if band.census:
        left = len(band.unreviewed)
        return (f"all {band.reviewed} reviewed" if not left
                else f"census, {left} left")
    if band.interval is not None:
        return f"{band.interval[0]:.1%} to {band.interval[1]:.1%}"
    return "-"
@

The JSON of a single sample is the dictionary [[llm sample --report]]
always printed, with [[census]] added only for a census, so that the
output for samples drawn before is unchanged.

<<llm command helpers>>=
def sample_report_data(report) -> dict:
    """Return a sample report (single or stratified) as JSON-ready data."""
    from scholar.llm_review import StratifiedReport, band_label

    if not isinstance(report, StratifiedReport):
        data = {
            "sample_id": report.sample_id, "seed": report.seed,
            "drawn_at": report.drawn_at, "criteria": report.criteria,
            "sessions": report.sessions, "population": report.population,
            "size": report.size, "reviewed": report.reviewed,
            "changed": report.changed, "rate": report.rate,
            "interval": list(report.interval) if report.interval else None,
            "not_found": report.not_found,
            "reset_since_draw": report.reset_since_draw,
            "unreviewed": [list(u) for u in report.unreviewed],
        }
        if report.census:
            data["census"] = True
        return data
    estimate = report.estimate()
    return {
        "sample_id": report.group, "stratified": True,
        "seed": report.seed, "drawn_at": report.drawn_at,
        "criteria": report.criteria, "sessions": report.sessions,
        "population": report.population, "size": report.size,
        "reviewed": report.reviewed, "changed": report.changed,
        "not_found": report.not_found,
        "reset_since_draw": report.reset_since_draw,
        "unreviewed": [list(u) for u in report.unreviewed],
        "bands": [
            {**sample_report_data(band), "band": band_label(band),
             "census": band.census}
            for band in report.bands
        ],
        "estimate": None if estimate is None else {
            "rate": estimate.rate,
            "changed_not_reviewed": estimate.changed_not_reviewed,
            "population": estimate.population,
            "reviewed": estimate.reviewed,
            "changed": estimate.changed,
            "interval": None,
        },
        "estimate_withheld": report.withheld_reason(),
    }
@

Let's run the procedure end to end on two saved sessions: draw a
sample over both, review two of the drawn papers with
[[sessions decide]] (one confirmed, one changed), and report.  The
report agrees with what was done, and the draw refuses to run without
a seed.

<<test functions>>=
class TestLLMSampleCommand:
    <<llm sample command test methods>>

<<llm sample command test methods>>=
def test_help_names_the_interval_it_computes(self):
    result = runner.invoke(app, ["llm", "sample", "--help"])
    assert result.exit_code == 0
    assert "modified" in " ".join(result.stdout.split())

def _save(self, name, count):
    from datetime import datetime
    from scholar import review

    session = review.ReviewSession(
        query=name, providers=["p"], timestamp=datetime(2026, 11, 18),
        name=name,
    )
    session.decisions = [
        review.ReviewDecision(
            paper=Paper(title=f"{name} {i}", authors=["A"],
                        doi=f"10.5555/cli-sample-{name}-{i}"),
            provider="p", status=review.DecisionStatus.DISCARDED,
            tags=["off-topic"], source=review.ReviewSource.LLM_UNREVIEWED,
            llm_confidence=0.95,
        )
        for i in range(count)
    ]
    review.save_session(session)

def test_draw_review_and_report(self):
    from scholar.review import load_session

    self._save("cli-sample-a", 4)
    self._save("cli-sample-b", 3)
    result = runner.invoke(app, [
        "llm", "sample", "cli-sample-a", "cli-sample-b", "--discarded",
        "--min-confidence", "0.9", "-n", "5", "--seed", "7",
    ])
    assert result.exit_code == 0, result.output
    assert "drew 5 of 7 eligible decisions" in " ".join(result.output.split())
    drawn = [
        (s.name, p["paper_id"])
        for s in (load_session("cli-sample-a"), load_session("cli-sample-b"))
        for p in s.llm_samples[0].papers
    ]
    assert len(drawn) == 5
    for (name, paper_id), flag in zip(drawn[:2], ["--discard", "--keep"]):
        decided = runner.invoke(app, [
            "sessions", "decide", name, flag, "--paper-id", paper_id,
            "--tag", "off-topic", "--source", "human",
        ])
        assert decided.exit_code == 0, decided.output

    reported = runner.invoke(
        app, ["llm", "sample", "cli-sample-a", "--report", "-f", "json"]
    )
    assert reported.exit_code == 0, reported.output
    (report,) = json.loads(reported.output)
    assert (report["size"], report["reviewed"], report["changed"]) == (
        5, 2, 1
    )
    assert report["not_found"] == 0 and len(report["unreviewed"]) == 3
    assert report["criteria"]["min_confidence"] == 0.9

def test_draw_needs_seed_and_size(self):
    self._save("cli-sample-c", 2)
    result = runner.invoke(
        app, ["llm", "sample", "cli-sample-c", "--discarded"]
    )
    assert result.exit_code == 2
    assert "give the seed with --seed" in " ".join(result.output.split())
    from scholar.review import load_session
    assert load_session("cli-sample-c").llm_samples == []

def test_report_reads_the_pooled_file_not_its_label(self):
    """The unnamed session of query foo, pooled before a named foo (#231)."""
    from datetime import datetime
    from scholar import review

    def save(name, query):
        session = review.ReviewSession(
            query=query, providers=["p"], timestamp=datetime(2026, 11, 19),
            name=name,
        )
        session.decisions = [review.ReviewDecision(
            paper=Paper(title=query, authors=["A"],
                        doi=f"10.5555/cli-wp231-{query}"),
            provider="p", status=review.DecisionStatus.DISCARDED,
            tags=["off-topic"], source=review.ReviewSource.LLM_UNREVIEWED,
        )]
        review.save_session(session)

    save(None, "foo")
    save("cli-wp231-x", "cli-wp231-x")
    drawn = runner.invoke(app, [
        "llm", "sample", "foo", "cli-wp231-x", "--discarded", "-n", "2",
        "--seed", "3",
    ])
    assert drawn.exit_code == 0, drawn.output
    decided = runner.invoke(app, [
        "sessions", "decide", "foo", "--keep", "--paper-id",
        "doi:10.5555/cli-wp231-foo", "--source", "human",
    ])
    assert decided.exit_code == 0, decided.output
    save("foo", "bar")
    reported = runner.invoke(
        app, ["llm", "sample", "cli-wp231-x", "--report", "-f", "json"]
    )
    assert reported.exit_code == 0, reported.output
    (report,) = json.loads(reported.output)
    assert (report["reviewed"], report["changed"], report["not_found"]) == (
        1, 1, 0)
