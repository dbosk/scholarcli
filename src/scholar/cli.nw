class TestEnrichKeepsTheLookup:
  """`scholar enrich` keeps each abstract lookup on the decision (#293)."""

  def test_the_outcome_is_kept(self, tmp_path, monkeypatch):
    from scholar.review import load_session, save_session

    name = TestEnrichSelectionAndSaving._session(tmp_path, monkeypatch, 3)
    session = load_session(name)
    session.decisions[2].paper.abstract = (
      "Already here: an invented abstract about recursion, long enough "
      "not to be judged doubtful by the check of abstracts.")
    save_session(session)
    s2 = TestEnrichLookupTally._throttled_s2(monkeypatch, "10.1/c137-1")
    result = TestEnrichLookupTally._invoke(
