def _make_session(self, tmp_path, monkeypatch, count, copies=0,
                  without_abstract=(), lookups=None):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    ReviewDecision, ReviewSession, save_session, session_file_path,
  )

  papers = [
    Paper(title=f"Batch Work {n}", authors=["A"], doi=f"10.1/batch-{n}",
          abstract=(None if n in without_abstract
                    else f"An abstract about work {n}. It reports an "
                         "invented study of novices reading recursive "
                         "programs, with interviews."))
    for n in range(count)
  ] + [
    Paper(title=f"Batch Work {n}", authors=["A"],
          abstract=f"An abstract about work {n}. It reports an invented "
                   "study of novices reading recursive programs, with "
                   "interviews.")
    for n in range(copies)
  ]
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="batch", decisions=[
      ReviewDecision(paper=paper, provider="openalex",
