\subsection{The copy from before the run}

[[.bak]] cannot serve as the way back from a whole run
(\cref{sec:enrich-chunks}), so the command keeps its own copy.
The tests run the real command with chunks of one paper, so that the
[[.bak]] differs from the pre-run copy, and check that the copy is the
file as it was, that the next run replaces it, that no copy is made
when there is nothing to enrich, that both the final and the interrupt
message name it, and that the commands which read every session file
do not mistake it for a session.

<<test functions>>=
class TestEnrichPreRunBackup:
  """A copy of the session from before the run (#153)."""

  @staticmethod
  def _prepare(tmp_path, monkeypatch, count=2):
    monkeypatch.setattr("scholar.cli.ENRICH_SAVE_EVERY", 1)
    name = TestEnrichSelectionAndSaving._session(
      tmp_path, monkeypatch, count, name="prerun"
    )
    return name, tmp_path / "review_sessions" / f"{name}.json"

  @staticmethod
  def _enrich(papers, **kwargs):
    return TestEnrichSelectionAndSaving._enriched(papers)

  def test_copy_is_the_session_as_it_was(self, tmp_path, monkeypatch):
    name, path = self._prepare(tmp_path, monkeypatch)
    before = path.read_bytes()

    result = TestEnrichSelectionAndSaving._invoke([name], self._enrich)
    assert result.exit_code == 0, result.stdout

    (copy,) = self._copies(path)
    assert copy.read_bytes() == before
    assert path.read_bytes() != before
    # one chunk per paper: .bak holds the state before the last chunk
    assert path.with_name(f"{name}.json.bak").read_bytes() != before
    assert "pre-enrich-" in "".join(result.stdout.split())

  @staticmethod
  def _copies(path):
    return sorted(path.parent.glob(f"{path.name}.pre-enrich-*.bak"))

  @staticmethod
  def _at(monkeypatch, *stamps):
    """Make the successive runs happen at the given UTC times."""
    from datetime import datetime, timezone

    times = iter(datetime.strptime(t, "%Y%m%dT%H%M%S").replace(
      tzinfo=timezone.utc) for t in stamps)
    monkeypatch.setattr("scholar.review._utcnow", lambda: next(times))

  def test_second_run_keeps_the_first_copy(self, tmp_path, monkeypatch):
    name, path = self._prepare(tmp_path, monkeypatch)
    self._at(monkeypatch, "20261118T100000", "20261118T110000")
    original = path.read_bytes()

    for _ in range(2):
      result = TestEnrichSelectionAndSaving._invoke([name], self._enrich)
      assert result.exit_code == 0, result.stdout

    first, second = self._copies(path)
    assert first.name.endswith("pre-enrich-20261118T100000Z.bak")
    assert first.read_bytes() == original
    assert second.name.endswith("pre-enrich-20261118T110000Z.bak")
    assert second.read_bytes() != original

  def test_fourth_run_prunes_the_oldest(self, tmp_path, monkeypatch):
    name, path = self._prepare(tmp_path, monkeypatch)
    self._at(monkeypatch, *[f"20261118T1{i}0000" for i in range(4)])

    for _ in range(4):
      result = TestEnrichSelectionAndSaving._invoke([name], self._enrich)
      assert result.exit_code == 0, result.stdout

    assert [c.name.split("pre-enrich-")[1] for c in self._copies(path)] == [
      "20261118T110000Z.bak", "20261118T120000Z.bak",
      "20261118T130000Z.bak",
    ]
    assert result.stdout.count("pre-enrich-") == 1  # names the newest

  def test_adoption_is_mentioned(self, tmp_path, monkeypatch):
    from dataclasses import replace

    name, path = self._prepare(tmp_path, monkeypatch, count=1)

    def adopt(papers, **kwargs):
      return [replace(p, doi="10.1/adopted-153") for p in papers]

    result = TestEnrichSelectionAndSaving._invoke([name], adopt)
    assert result.exit_code == 0, result.stdout
    assert "does not undo the notes" in " ".join(result.stdout.split())
    plain = TestEnrichSelectionAndSaving._invoke([name], self._enrich)
    assert "does not undo" not in plain.stdout

  def test_nothing_to_enrich_makes_no_copy(self, tmp_path, monkeypatch):
    from scholar.review import DecisionStatus, load_session, save_session

    name, path = self._prepare(tmp_path, monkeypatch)
    session = load_session(name)
    for decision in session.decisions:
      decision.status = DecisionStatus.KEPT
      decision.tags = ["t"]
    save_session(session)

    result = TestEnrichSelectionAndSaving._invoke(
      [name, "--pending-only"], self._enrich
    )
    assert result.exit_code == 0, result.stdout
    assert self._copies(path) == []

  def test_interrupt_names_the_copy(self, tmp_path, monkeypatch):
    name, path = self._prepare(tmp_path, monkeypatch)
    calls = []

    def enrich(papers, **kwargs):
      calls.append(papers)
      if len(calls) == 2:
        raise KeyboardInterrupt
      return TestEnrichSelectionAndSaving._enriched(papers)

    before = path.read_bytes()
    result = TestEnrichSelectionAndSaving._invoke([name], enrich)
    assert result.exit_code == 130
    assert "pre-enrich-" in "".join(result.stdout.split())
    (copy,) = self._copies(path)
    assert copy.read_bytes() == before

  def test_the_copy_is_not_a_session(self, tmp_path, monkeypatch):
    from scholar.review import list_sessions, sessions_mentioning

    name, path = self._prepare(tmp_path, monkeypatch)
    result = TestEnrichSelectionAndSaving._invoke([name], self._enrich)
    assert result.exit_code == 0, result.stdout
    assert len(self._copies(path)) == 1

    assert [s["name"] for s in list_sessions()] == [name]
    assert [s.name for s in sessions_mentioning("10.1/c137-0")] == [name]
@

A time limit ends a process with SIGTERM, whose default action ends
Python without running its exit handlers.
While the command runs, SIGTERM is turned into the same interruption,
and the previous handler is back afterwards.
The stand-in checks that a handler of the command's own is installed
before it sends the signal, so the test cannot kill the test run.

<<enrich selection and saving test methods>>=
def test_sigterm_is_an_interrupt(self, tmp_path, monkeypatch):
  import signal

  monkeypatch.setattr("scholar.cli.ENRICH_SAVE_EVERY", 1)
  name = self._session(tmp_path, monkeypatch, 2)
  before = signal.getsignal(signal.SIGTERM)
  calls = []

  def enrich(papers, **kwargs):
    calls.append(papers)
    if len(calls) == 2:
      assert signal.getsignal(signal.SIGTERM) is not before
      signal.raise_signal(signal.SIGTERM)
    return self._enriched(papers)

  result = self._invoke([name], enrich)
  assert result.exit_code == 130, result.stdout
  assert self._saved(name)["10.1/c137-0"].paper.abstract == "Enriched."
  assert signal.getsignal(signal.SIGTERM) is before
@

Each save merges what other processes saved meanwhile
(\cref{sec:session-integrity}), and that has to hold for every save,
not only the last: a classification saved between two chunks survives,
both for the paper already enriched and for the one being enriched.

<<enrich selection and saving test methods>>=
def test_decision_between_chunks_survives(self, tmp_path, monkeypatch):
  from scholar import isolated_registry
  from scholar.review import DecisionStatus, load_session, save_session

  monkeypatch.setattr("scholar.cli.ENRICH_SAVE_EVERY", 1)
  name = self._session(tmp_path, monkeypatch, 2)
  calls = []

  def enrich(papers, **kwargs):
    calls.append(papers)
    if len(calls) == 2:
      with isolated_registry():
        other = load_session(name)
        for decision in other.decisions:
          decision.status = DecisionStatus.DISCARDED
          decision.tags = ["off-topic"]
        save_session(other)
    return self._enriched(papers)

  result = self._invoke([name], enrich)
  assert result.exit_code == 0, result.stdout
  saved = self._saved(name).values()
  assert [d.status for d in saved] == [DecisionStatus.DISCARDED] * 2
  assert all(d.paper.abstract == "Enriched." for d in saved)
@

