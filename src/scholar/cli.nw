def tier_rule_flags(rule: dict) -> str:
    """The options that give a stored tier rule (`TierRule.data`), on
    one line: a line break or tab in a value is shown as a space."""
    from scholar.review import one_line

    flags = []
    if rule.get("top") is not None:
        flags.append(f"--top {rule['top']}")
    if rule.get("min_providers") is not None:
        flags.append(f"--min-providers {rule['min_providers']}")
    for provider in rule.get("providers") or []:
        flags.append(f"--provider {shlex.quote(one_line(provider))}")
    if rule.get("query_like"):
        flags.append(
            f"--query-like {shlex.quote(one_line(rule['query_like']))}")
    return " ".join(flags)
