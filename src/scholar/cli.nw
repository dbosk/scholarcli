<<sheet tier test methods>>=
def _save(self, tmp_path, monkeypatch):
  from scholar.review import (
    ReviewDecision, ReviewSession, SearchRecord, save_session,
  )

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  def decision(name, *links):
    d = ReviewDecision(
      paper=Paper(title=f"Paper {name}", authors=["Ada Lovelace"],
                  year=2021, doi=f"10.5555/sheet-tier-{name}"),
      provider="openalex",
    )
    for provider, rank in links:
      d.record_search("q", provider, "", rank)
    return d
  save_session(ReviewSession(
    query="q", providers=["openalex", "arxiv", "scopus"],
    timestamp=datetime(2026, 11, 23), name="sheet-tier",
    search_records=[
      SearchRecord("q", "openalex", {}, 50, hits=50, order="relevance"),
      SearchRecord("q", "arxiv", {}, 50, hits=50, order="relevance"),
      SearchRecord("q", "scopus", {}, 50, hits=50, order="date"),
    ],
    decisions=[
      decision("head", ("openalex", 2)),
      decision("newest", ("scopus", 1)),
      decision("both", ("openalex", 40), ("arxiv", 30)),
      decision("deep", ("openalex", 45)),
      decision("old", ("openalex", None)),
    ],
  ))

def _export(self, tmp_path, *options):
  out = tmp_path / "sheet"
  result = runner.invoke(app, [
    "sessions", "export", "sheet-tier", "-f", "screen-sheet", "--pending",
    "-o", str(out), *options,
  ])
  return result, out

def _ids(self, path):
  lines = path.read_text(encoding="utf-8").splitlines()
  return [line.split("\t")[0] for line in lines
          if not line.startswith("#")][1:]

def test_top_and_min_providers(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  result, out = self._export(tmp_path, "--top", "10",
                             "--min-providers", "2")
  assert result.exit_code == 0, result.output
  assert self._ids(tmp_path / "sheet.tsv") == [
    "doi:10.5555/sheet-tier-head", "doi:10.5555/sheet-tier-both",
  ]
  assert "Tier: 2 of 5 pending papers selected, 3 not selected." \
    in result.output
  tier = json.loads((tmp_path / "sheet-tier.json").read_text())
  assert tier["selection"]["pending"] is True
  assert (tier["selected"], tier["not_selected"]) == (2, 3)
  assert tier["met"] == {"top": 1, "min_providers": 1}
  assert tier["only"] == {"top": 1, "min_providers": 1}
  assert tier["place_unknown"] == 1
  assert tier["placed_only_outside_relevance_order"] == 1
  assert tier["rule"]["top"] == 10

def test_a_tier_in_batches_gets_its_own_ids(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  whole, _ = self._export(tmp_path, "--batch-size", "2")
  first = (tmp_path / "sheet-001.tsv").read_text().splitlines()[0]
  tiered, _ = self._export(tmp_path, "--batch-size", "2", "--top", "50")
  assert tiered.exit_code == 0, tiered.output
  assert (tmp_path / "sheet-tier.json").exists()
  assert (tmp_path / "sheet-001.tsv").read_text().splitlines()[0] != first
  assert self._ids(tmp_path / "sheet-001.tsv") == [
    "doi:10.5555/sheet-tier-head", "doi:10.5555/sheet-tier-both",
  ]

def test_without_the_options_the_sheet_is_unchanged(
  self, tmp_path, monkeypatch,
):
  self._save(tmp_path, monkeypatch)
  result, _ = self._export(tmp_path)
  assert result.exit_code == 0
  assert "Tier:" not in result.output
  assert not (tmp_path / "sheet-tier.json").exists()
  assert len(self._ids(tmp_path / "sheet.tsv")) == 5

def test_a_provider_and_its_query(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  result, _ = self._export(tmp_path, "--provider", "scopus",
                           "--query-like", "Q")
  assert result.exit_code == 0, result.output
  assert self._ids(tmp_path / "sheet.tsv") == [
    "doi:10.5555/sheet-tier-newest",
  ]

def test_refusals(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  for options in (["--top", "0"], ["--min-providers", "0"],
                  ["--query-like", "q"], ["--provider", "dblp"]):
    result, _ = self._export(tmp_path, *options)
    assert result.exit_code == 2, (options, result.output)
  other = runner.invoke(app, ["sessions", "export", "sheet-tier",
                              "-f", "csv", "--top", "5",
                              "-o", str(tmp_path / "x")])
  assert other.exit_code == 2
@

