def test_failed_export_leaves_previous_outputs(tmp_path, monkeypatch):
    """A failing LaTeX step must not leave a half-new export (#83)."""
    from datetime import datetime
    from scholar import review
    from scholar.scholar import Paper

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = review.ReviewSession(
        query="q", providers=["openalex"], timestamp=datetime(2026, 1, 1),
        name="atomic",
    )
    session.decisions = [review.ReviewDecision(
        paper=Paper(title="Kept", authors=["A"], year=2024,
                    doi="10.1/wp1-export"),
        provider="openalex", status=review.DecisionStatus.KEPT,
    )]
    review.save_session(session)
    out_dir = tmp_path / "out"
    out_dir.mkdir()
    out = out_dir / "rep"
    result = runner.invoke(
        app, ["sessions", "export", "atomic", "-f", "all", "-o", str(out)]
    )
    assert result.exit_code == 0, result.output
    before = {p.name: p.read_bytes() for p in out_dir.iterdir()}
    assert set(before) == {"rep.csv", "rep.tex", "rep.bib"}

    def failing_latex(session, output_path, *, standalone=True):
        output_path.with_suffix(".bib").write_text("half-new bib")
        raise AttributeError("'list' object has no attribute 'replace'")

    session.decisions[0].tags = ["changed"]
    review.save_session(session)
    monkeypatch.setattr(review, "generate_latex_report", failing_latex)
    result = runner.invoke(
        app, ["sessions", "export", "atomic", "-f", "all", "-o", str(out)]
    )
    assert result.exit_code == 1
    assert "Export failed" in result.output
    assert "Traceback" not in result.output
    after = {p.name: p.read_bytes() for p in out_dir.iterdir()}
    assert after == before
