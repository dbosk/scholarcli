<<sessions command>>=
SHEET_DIGEST_CHARS = 8


@dataclass(frozen=True)
class SheetBatch:
    """One numbered sheet of a batched screen sheet."""

    batch: str
    number: int
    rows: list[list[str]]


def screen_sheet_batches(
    rows: list[list[str]], size: int, session_file: str
) -> list[SheetBatch]:
    """`rows` cut into sheets of at most `size`, each with its batch id.

    The id is a digest of `session_file`, `size` and the rows' ids, then
    the sheet's number: `5be0c1d2-001`.
    """
    import hashlib

    selection = json.dumps([session_file, size, [row[0] for row in rows]])
    digest = hashlib.sha256(selection.encode("utf-8")).hexdigest()
    digest = digest[:SHEET_DIGEST_CHARS]
    return [
        SheetBatch(f"{digest}-{number:03d}", number, rows[start:start + size])
        for number, start in enumerate(range(0, len(rows), size), start=1)
    ]
@

The manifest lists the sheets, one line per sheet under a header, so
that whoever hands out the sheets can check them off and a sheet's id
can be found from its file.  Unlike the sheets it is a new file, read
by scripts rather than by a screener, so it is written by the standard
library's [[csv]] module, tab-separated with [[\n]] line ends: a field
holding a tab, a line break or a quote mark (an [[-o]] name, a
DOI) is quoted as [[csv]] quotes it and reads back whole with
[[csv.reader(..., delimiter="\t")]].  It has no comment line, which a
CSV reader would take for a row; each sheet names its session.

<<sessions command>>=
SHEET_MANIFEST_COLUMNS = ("batch", "file", "records", "first_id", "last_id")


def write_sheet_manifest(
    path: Path, batches: list[SheetBatch], stem: str
) -> None:
    """Write the manifest of batched sheets named `stem-NNN.tsv`."""
    import csv

    with path.open("w", newline="", encoding="utf-8") as manifest:
        writer = csv.writer(manifest, delimiter="\t", lineterminator="\n")
        writer.writerow(SHEET_MANIFEST_COLUMNS)
        writer.writerows(
            (batch.batch, f"{stem}-{batch.number:03d}.tsv",
             len(batch.rows), batch.rows[0][0], batch.rows[-1][0])
            for batch in batches
        )
