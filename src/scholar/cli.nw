A search without [[--limit]] fetches everything
(\cref{sec:no-limit-default}), so a practice search copied from a lesson
must carry a small limit, or one lesson step could page through a whole
database.  The test reads every command a lesson shows (lines of its
code blocks, joined where they end in a backslash; not the
[[tutorial-step]] blocks, which define the steps and may list a
command as a quiz answer) and requires a
positive [[-l]] or [[--limit]] on each line that runs [[scholar search]]
or [[scholar rq]], wherever on the line: after a prompt ([[$]]), after
[[uv run]] or behind a path.  It reads the tangled [[.md]], the text the
learner copies from.

The learner may still leave the flag out, so each search step's
required pattern demands it too (the lessons' prose says how).  That is
checked against the lesson itself: every pattern of a step that names
[[scholar search]] or [[scholar rq]] must match one of the commands the
step shows, and none of them once their limit is taken out or set to [[0]].
It must also take the other spellings the command line accepts: the
number glued to [[-l]] ([[-l5]]), [[--limit=5]], and the limit written
first, right after [[scholar search]] ([[limit_variants]]).

The commands are fed to the patterns as the transcript holds them, not
as one joined line.  pytorial records the terminal and matches a
regular expression with [[re.search]] against that record after
replaying the line editing and turning carriage returns into line
breaks ([[transcript_matches_pattern]] and [[normalise_recorded_text]]
in its [[run]] module): no [[re.DOTALL]], nothing joins a continued
command.  A command the lesson shows over two lines, ending the first
in a backslash, is typed that way, and the shell prompts for the rest
with its continuation prompt, [[> ]] (bash's default [[PS2]]; pytorial
sets only [[PS1]], to [[pytorial $ ]], in its [[shell]] module).  So
the transcript holds the first line, a line break, [[> ]] and the
second line, and a [[.*]] in a pattern stops at the line break.
[[tutorial_commands(text, typed=True)]] gives each command in that
shape, after the prompt, and every regular-expression pattern of every
lesson that matches a command's joined form must match its typed form
too.

<<test functions>>=
TUTORIAL_LIMIT = re.compile(r"(?:^|\s)(?:-l\s*|--limit[\s=]+)[1-9]\d*\b")
TUTORIAL_SEARCH = re.compile(r"(?:^|[^\w-])scholar\s+(?:search|rq)\b")


TUTORIAL_PROMPT = "pytorial $ "   # pytorial's PS1
TUTORIAL_CONTINUATION = "\n> "    # a line break and bash's default PS2


def tutorial_commands(text: str, typed: bool = False) -> list[str]:
    """The commands shown in a lesson's code blocks, continuations joined.

    With `typed`, each command is given as a terminal transcript holds
    it: after the prompt, a continued line after a line break and the
    continuation prompt.  A `tutorial-step` block is pytorial's step
    definition, not commands.
    """
    commands, in_block, shown, joined, as_typed = [], False, False, "", ""
    for line in text.splitlines():
        if line.startswith("```"):
            in_block, joined, as_typed = not in_block, "", ""
            shown = in_block and not line[3:].startswith("tutorial-")
            continue
        if not shown:
            continue
        as_typed += (TUTORIAL_CONTINUATION if as_typed else "") + line.rstrip()
        joined += line.strip()
        if joined.endswith("\\"):
            joined = joined[:-1].rstrip() + " "
            continue
        commands.append(TUTORIAL_PROMPT + as_typed if typed else joined)
        joined, as_typed = "", ""
    return commands


def tutorial_searches(text: str, typed: bool = False) -> list[str]:
    """The `scholar search` and `scholar rq` commands a lesson shows."""
    return [
        c for c in tutorial_commands(text, typed)
        if TUTORIAL_SEARCH.search(c)
    ]


@pytest.mark.parametrize("name", TUTORIAL_FILES)
def test_tutorial_searches_carry_a_limit(name):
    """Every practice search of a lesson asks for a few results only."""
    text = (TUTORIAL_DIR / name).read_text(encoding="utf-8")
    unlimited = [
        c for c in tutorial_searches(text) if not TUTORIAL_LIMIT.search(c)
    ]
    assert not unlimited, f"{name}: searches without a limit: {unlimited}"


@pytest.mark.parametrize("name", TUTORIAL_FILES)
def test_tutorial_search_steps_require_the_limit(name):
    """A search step passes only with the limit typed."""
    from pytorial.catalog import load_tutorial_file

    tutorial = load_tutorial_file(TUTORIAL_DIR / name)
    for step in tutorial.steps:
        shown = tutorial_searches(step.instructions, typed=True)
        patterns = [
            p.pattern for p in step.required_patterns
            if p.mode == "regex" and re.search(r"scholar\\s\+", p.pattern)
            and re.search(r"search|rq", p.pattern)
        ]
        for pattern in patterns:
            matched = [c for c in shown if re.search(pattern, c)]
            assert matched, (
                f"{name}: {step.title!r}: {pattern} matches no command"
            )
            for command in matched:
                accepted, refused = limit_variants(command)
                for variant in accepted:
                    assert re.search(pattern, variant), (
                        f"{name}: {step.title!r}: {pattern} refuses "
                        f"{variant!r}"
                    )
                for variant in refused:
                    assert not re.search(pattern, variant), (
                        f"{name}: {step.title!r}: {pattern} passes "
                        f"{variant!r}"
                    )


def limit_variants(command: str) -> tuple[list[str], list[str]]:
    """Spellings of `command`'s limit the CLI accepts, and two it should not.

    Accepted: the limit glued to `-l`, as `--limit=N`, and written first,
    right after `scholar search`.  Refused: no limit, and `-l 0`.
    """
    number = re.search(r"[1-9]\d*", TUTORIAL_LIMIT.search(command)[0])[0]
    without = TUTORIAL_LIMIT.sub(" ", command)
    first = TUTORIAL_SEARCH.sub(
        lambda m: f"{m[0]} -l {number}", without, count=1
    )
    accepted = [
        TUTORIAL_LIMIT.sub(f" -l{number}", command),
        TUTORIAL_LIMIT.sub(f" --limit={number}", command),
        first,
    ]
    return accepted, [without, TUTORIAL_LIMIT.sub(" -l 0", command)]


@pytest.mark.parametrize("name", TUTORIAL_FILES)
def test_tutorial_patterns_match_commands_as_typed(name):
    """A pattern that fits a command fits it as the transcript holds it."""
    from pytorial.catalog import load_tutorial_file

    tutorial = load_tutorial_file(TUTORIAL_DIR / name)
    for step in tutorial.steps:
        commands = zip(
            tutorial_commands(step.instructions),
            tutorial_commands(step.instructions, typed=True),
        )
        patterns = [
            p.pattern for p in step.required_patterns if p.mode == "regex"
        ]
        for joined, typed in commands:
            for pattern in patterns:
                if re.search(pattern, joined):
                    assert re.search(pattern, typed), (
                        f"{name}: {step.title!r}: {pattern} misses "
                        f"{typed!r}"
                    )


def test_tutorial_commands_join_continuations():
    step = "```tutorial-step\noptions:\n  - scholar rq\n```\n"
    assert tutorial_commands(step) == []
    text = "```\nscholar search q -p openalex \\\n    -l 5 -n x\n```\n"
    assert tutorial_commands(text) == ["scholar search q -p openalex -l 5 -n x"]
    assert tutorial_commands(text, typed=True) == [
      "pytorial $ scholar search q -p openalex \\\n>     -l 5 -n x"
    ]
    assert TUTORIAL_LIMIT.search(tutorial_commands(text)[0])
    assert not TUTORIAL_LIMIT.search("scholar search q -l 0")


def test_tutorial_searches_are_found_anywhere_on_the_line():
    text = (
        "```\n$ scholar search a\nuv run scholar rq b\n"
