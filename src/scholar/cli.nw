@sessions_app.command("resume")
def sessions_resume(
    name: Annotated[
        str,
        typer.Argument(
            help="Session name or query to resume.",
            autocompletion=complete_session_name,
        ),
    ],
    <<report option>>
    by: Annotated[
        str | None,
        typer.Option(
            "--by",
            help="Your name, recorded with the decisions and blind "
            "screenings you make in this review.",
        ),
    ] = None,
    blind: Annotated[
        bool,
        typer.Option(
            "--blind",
            help="Start in blind review of the review sample, before any "
            "verdict is shown (needs a sample; asks your name without "
            "--by).",
        ),
    ] = False,
) -> None:
    """
    Resume reviewing a saved session in the TUI.

    Opens the interactive review interface with the saved session loaded.
    Use --report/-R to be prompted for saving reports after review.

    --by names you: your decisions record the name, and blind review
    needs it (without --by it asks).

    --blind starts in blind review of the review sample (`scholar llm
    sample`): the list stays on the sample, and a paper's status mark,
    confidence and tags, the status filters, its share of the status
    counts and its tags in the tag dialogs are hidden until you give
    your own verdict, recorded as a blind screening; then the verdict
    is shown for you to confirm or change. Key b switches blind mode
    during a run, but verdicts were on the screen before, so screenings
    are then recorded as not blind. Not hidden: the session file, other
    commands, and what the sample's criteria tell (a sample of discards
    only is all discards; a draw by confidence tells the range).
    """
    from scholar.review import save_session
    from scholar.tui import PaperReviewApp, prompt_for_report

    console = Console()
    <<check the reviewer's name>>
    session = open_session_argument(name)

    if session is None:
        console.print(f"[red]Session not found: {escape(name)}[/red]")
        raise typer.Exit(1)

    console.print(f"[dim]Resuming session: {escape(session.query)}[/dim]")

    app = PaperReviewApp(session, reviewer=by, blind=blind)
    app.run()

    # Save updated session
    save_session(session)

    if report:
        prompt_for_report(session)
