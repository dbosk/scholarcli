if as_kind != "human" and any(
    t in AUDIT_CATEGORIES for d in session.decisions for t in d.tags
):
    from scholar.llm_review import STATUS_CATEGORIES

    given = (
        [(f"verdicts-file line {e.line}", e.status, e.tags)
         for e in verdict_lines]
        or [("the verdict", "kept" if keep else "discarded", tags)]
    )
    unfit: list[str] = []
    for where, status, verdict_tags in given:
        categories = [t for t in verdict_tags if t in AUDIT_CATEGORIES]
