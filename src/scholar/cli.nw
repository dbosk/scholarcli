class TestVerifyCommand:
    """Tests for the verify command."""

    def _make_session(self, tmp_path, monkeypatch):
        """Create a two-paper session on disk and return its name."""
        from dataclasses import replace as _replace  # noqa: F401

        from scholar import Paper, SearchResult
        from scholar.review import create_review_session, save_session

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        papers = [
            Paper(title="Bad", authors=["a"], doi="10.1/bad", sources=["m"]),
            Paper(title="Good", authors=["b"], doi="10.1/good", sources=["m"]),
        ]
        result = SearchResult(
            query="q", provider="m", timestamp="t", papers=papers
        )
        session = create_review_session([result], "q", session_name="vtest")
        save_session(session)
        return "vtest"

    @staticmethod
    def _fake_annotate(papers, progress_callback=None):
        """Mark the 10.1/bad paper retracted, others checked-clean."""
        from dataclasses import replace

        out = []
        for paper in papers:
            if paper.doi == "10.1/bad":
                out.append(
                    replace(
                        paper,
                        updated_by=[{"doi": "10.1/n", "type": "retraction"}],
                        newer_versions=[],
                    )
                )
            else:
                out.append(replace(paper, updated_by=[], newer_versions=[]))
        return out

    def test_human_report_flags_retraction(self, tmp_path, monkeypatch):
        """The human report names the retracted paper and a tally."""
        name = self._make_session(tmp_path, monkeypatch)
        with patch(
            "scholar.crossref.annotate_papers", side_effect=self._fake_annotate
        ):
            result = runner.invoke(app, ["verify", name])
        assert result.exit_code == 0
        assert "RETRACTED" in result.stdout
        assert "1 retracted" in result.stdout

    def test_json_output_is_pure_json(self, tmp_path, monkeypatch):
        """--json emits a parseable array with per-paper status."""
        import json as _json

        name = self._make_session(tmp_path, monkeypatch)
        with patch(
            "scholar.crossref.annotate_papers", side_effect=self._fake_annotate
        ):
            result = runner.invoke(app, ["verify", name, "--json"])
        assert result.exit_code == 0
        report = _json.loads(result.stdout)
        by_doi = {entry["doi"]: entry["status"] for entry in report}
        assert by_doi["10.1/bad"] == "retracted"
        assert by_doi["10.1/good"] == "ok"

    def test_missing_session_exits_nonzero(self, tmp_path, monkeypatch):
        """An unknown session name exits with a non-zero code."""
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        result = runner.invoke(app, ["verify", "no-such-session"])
        assert result.exit_code == 1

    def test_adopted_preprint_shows_as_preprint_not_superseded(
        self, tmp_path, monkeypatch
    ):
        """A deliberate preprint substitution is info, not a warning."""
        from dataclasses import replace

        from scholar import Paper, SearchResult
        from scholar.review import create_review_session, save_session

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        adopted = Paper(
            title="Adopted",
            authors=["a"],
            doi="10.48550/arXiv.2401.1",
            sources=["m"],
            published_versions=[
                {"doi": "10.1/published", "relation": "preprint-of"}
            ],
        )
        result = SearchResult(
            query="q", provider="m", timestamp="t", papers=[adopted]
        )
        save_session(
            create_review_session([result], "q", session_name="ptest")
        )

        def annotate(papers, progress_callback=None):
            return [
                replace(
                    p,
                    updated_by=[],
                    newer_versions=[
                        {
                            "doi": "10.1/published",
                            "relation": "is-preprint-of",
                        }
                    ],
