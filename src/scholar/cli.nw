\subsubsection{Where the query is matched}

The [[--in]] option sets [[SearchFilters.search_in]]
(\cref{sec:search-in} in the [[scholar]] module).  Its only value,
[[title-abstract]], asks for matches in title and abstract instead of a
provider's default fields, which for OpenAlex include the full text
(\url{https://github.com/dbosk/scholar/issues/135}).  The help names the
providers that honour it, because the others warn and search as usual:
a user comparing databases needs to know which counts are comparable
before running the search, not only from a log line afterwards.
[[scholar syntax]] lists what each provider searches by default.  The
option is typed by an [[Enum]] of the values in [[SEARCH_IN_CHOICES]],
so Typer rejects any other value with a usage error (exit code~2) that
lists the valid ones, and a typo never silently runs a full-text
search.  (A [[click.Choice]] passed as [[click_type]] validated too, but
with the Typer release we use its error escaped as a traceback.)  The
command bodies pass on the enum's [[value]], the plain string that
[[SearchFilters]] stores and serialises.  The option sits with the
filters because it is one: it reaches the cache
keys, the session's search record and the reproduced command the same
way.  Since [[rq]] shares [[<<search filter options>>]], it gets the
option too.

<<search field option>>=
search_in: Annotated[
    Optional[SearchIn],
    typer.Option(
        "--in",
        help="Match the query in title-abstract only, not each "
             "provider's default fields (OpenAlex: also full text). "
             "Honoured: OpenAlex and its preprint servers, Scopus "
             "(TITLE-ABS-KEY), WoS (TS= already covers title, abstract, "
             "keywords). Ignored with a warning: Semantic Scholar, DBLP, "
             "IEEE, arXiv, HAL. See 'scholar syntax'.",
    ),
] = None
<<cli imports>>=
from enum import Enum
from scholar.scholar import SEARCH_IN_CHOICES, filter_flags
<<constants>>=
SearchIn = Enum(
    "SearchIn",
    {value.replace("-", "_"): value for value in SEARCH_IN_CHOICES},
    type=str,
)
@

Let's verify the option end to end with a fake provider that remembers
the filters it was given (a stand-in for a remote service, which the
test must not reach): the value reaches the provider, a search without
it sends no filters at all, an unknown value is refused, and a session
that ran one query both ways keeps two searches, each shown and
reproduced with its own flags.

<<test functions>>=
class TestSearchInOption:
  """search --in title-abstract reaches the provider and the session."""

  class _FieldsProvider:
    """A provider fake that remembers the filters of each search.

    It honours `--in` (like OpenAlex), so its records keep it.
    """
    name = "fake"
    MAX_LIMIT = None
    last_error = None
    last_retries = 0
    HONOURS_SEARCH_IN = True

    def __init__(self, papers):
      self.papers = papers
      self.seen = []

    def search(self, query, limit=100, filters=None):
      self.seen.append(filters)
      if filters and filters.search_in:
        return self.papers[:1]
      return self.papers

  def _install(self, monkeypatch, papers):
    from scholar import providers
    fake = self._FieldsProvider(papers)
    monkeypatch.setattr(providers, "PROVIDERS", {"fake": fake})
    return fake

  def test_value_reaches_the_provider(self, monkeypatch):
    fake = self._install(monkeypatch, [])
    result = runner.invoke(
      app, ["search", "q", "-p", "fake", "--in", "title-abstract",
            "-f", "json"]
    )
    assert result.exit_code == 0
    assert fake.seen[0].search_in == "title-abstract"

  def test_default_sends_no_filters(self, monkeypatch):
    fake = self._install(monkeypatch, [])
    runner.invoke(app, ["search", "q", "-p", "fake", "-f", "json"])
    assert fake.seen == [None]

  def test_unknown_value_is_refused(self, monkeypatch):
    fake = self._install(monkeypatch, [])
    result = runner.invoke(
      app, ["search", "q", "-p", "fake", "--in", "fulltext"]
    )
    assert result.exit_code == 2
    assert fake.seen == []

  def test_session_keeps_both_runs(self, tmp_path, monkeypatch):
    from scholar.review import load_session
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    narrow = Paper(title="In abstract", authors=["A"], doi="10.1/in-ta")
    broad = Paper(title="In full text", authors=["B"], doi="10.1/in-ft")
    self._install(monkeypatch, [narrow, broad])
    for extra in ([], ["--in", "title-abstract"]):
      result = runner.invoke(
        app, ["search", "q", "-p", "fake", "-n", "both", "-f", "json"]
        + extra
      )
      assert result.exit_code == 0

    session = load_session("both")
    assert sorted(
      (r.filters or {}).get("search_in", "") for r in session.search_records
    ) == ["", "title-abstract"]
    assert sorted(r.hits for r in session.search_records) == [1, 2]

    shown = runner.invoke(app, ["sessions", "show", "both"])
    assert "--in title-abstract" in shown.stdout

    found = runner.invoke(
      app, ["prov", "found-via", broad.id, "-f", "json"]
    )
    assert [r["command"] for r in json.loads(found.output)] == [
      "scholar search q -p fake"
    ]
    found = runner.invoke(
      app, ["prov", "found-via", narrow.id, "-f", "json"]
    )
    assert sorted(r["command"] for r in json.loads(found.output)) == [
      "scholar search q -p fake",
      "scholar search q -p fake --in title-abstract",
    ]

  def test_rq_passes_it_to_the_provider(self, tmp_path, monkeypatch):
    """rq shares the filter options, so --in must reach its searches."""
    import sys
    import types
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    paper = Paper(title="P", authors=["A"], doi="10.1/rq-in",
                  abstract="Abstract.")
    fake = self._install(monkeypatch, [paper])

    class Answer:
      def __init__(self, text):
        self._text = text

      def text(self):
        return self._text

    class Model:
      """Stands in for the language model rq asks (no service)."""
      model_id = "dummy"

      def prompt(self, prompt):
        if "Papers to Classify" in prompt:
          return Answer(json.dumps({"classifications": [{
            "paper_index": 0, "decision": "kept", "tags": ["t"],
            "confidence": 0.9, "reasoning": "r",
          }]}))
        return Answer(json.dumps(
          {"queries": [{"provider": "fake", "query": "rq query"}]}
        ))

    llm_mod = types.ModuleType("llm")
    llm_mod.get_model = lambda model_id=None: Model()
    monkeypatch.setitem(sys.modules, "llm", llm_mod)

    result = runner.invoke(app, [
      "rq", "Does rq pass --in?", "--provider", "fake", "--count", "1",
      "--no-enrich", "--in", "title-abstract",
    ])
    assert result.exit_code == 0, result.output
    assert [f.search_in for f in fake.seen] == ["title-abstract"]
@

\subsection{Executing the search}

We import the [[Search]] class from the core module and execute the query.
The results are then passed to the appropriate formatter.

Since providers automatically paginate to fetch results beyond their per-request
limits, users can request more than a single page of results.
The [[--limit/-l]] option controls the maximum results per provider, and
[[--limit 0]] fetches all available pages.
Large (or unlimited) searches may take time and consume API quotas, but the
provider implementations handle paging and rate limiting automatically:

<<execute search and display results>>=
from scholar import Search, SearchFilters, SearchResult
from scholar.providers import get_default_providers, expand_provider_names
import sys

# Determine which providers will be used. Group aliases (e.g.
# "preprints") are expanded here so the log and any session record
# name the actual per-server providers.
if provider is None:
    provider_names = [p.name for p in get_default_providers()]
else:
    provider_names = expand_provider_names(provider)

<<refuse what a semantic search cannot do>>
providers_for_enrich = parse_enrich_providers(enrich_providers)

effective_limit = UNLIMITED_PROVIDER_LIMIT if limit == 0 else limit
limit_label = "unlimited" if limit == 0 else str(limit)

logger.info(f"Searching with providers: {', '.join(provider_names)}")
logger.debug(f"Search query: '{query}'")
logger.debug(f"Limit per provider: {limit_label}")

# Build search filters from CLI options
filters = None
if any([
    year, open_access, venue, min_citations is not None, pub_type, search_in,
]):
    filters = SearchFilters(
        year=year,
        open_access=open_access,
        venue=venue,
        min_citations=min_citations,
        pub_types=pub_type,
        search_in=search_in.value if search_in else None,
    )
<<refuse filters for a semantic search>>

s = Search(query)
results = s.execute(
    providers=None if provider is None else provider_names,
    limit=effective_limit,
    filters=filters,
)

logger.debug(f"Retrieved {len(results)} result sets")

# Merge results from all providers (deduplicates and consolidates data)
<<merge search results>>

# Optionally enrich papers with missing abstracts
<<enrich papers if requested>>

# If review mode, launch TUI instead of displaying results
if review:
    from scholar.tui import run_review
    from scholar.review import SessionFileError
    session_name = name if name else query
    try:
        run_review(
            merged_results,
            query,
            session_name,
            prompt_report=report,
            search_filters=filters,
        )
    except SessionFileError as error:
        exit_on_unreadable_session(error)
    return

# An explicit -n without --review still records the search
if name:
    <<persist search to named session>>

# Auto-detect format based on TTY
actual_format = output_format
if output_format == "auto":
    actual_format = "table" if sys.stdout.isatty() else "csv"

display_results(merged_results, actual_format)
