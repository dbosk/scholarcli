class TestProvBibParse:
    """Tests for parsing provenance blocks out of a .bib file."""

    def test_parses_stacked_blocks_and_fields(self):
        """Two blocks above one entry are both attached to it."""
        text = (
            "% === provenance: alice2024 ===\n"
            "% CLAIM: first\n"
            "% === provenance: alice2024 ===\n"
            "% CLAIM: second\n"
            "@article{alice2024,\n"
            "  title = {A Paper},\n"
            "  author = {Alice Smith},\n"
            "  doi = {10.1/x},\n"
            "}\n"
        )
        entries = _parse_bib_entries(text)
        assert len(entries) == 1
        claims = [b[1]["CLAIM"] for b in entries[0].prov_blocks]
        assert claims == ["first", "second"]
        assert entries[0].fields["doi"] == "10.1/x"
        assert entries[0].fields["author"] == "Alice Smith"

    def test_blank_line_detaches_comment(self):
        """A blank line between comment and entry detaches it."""
