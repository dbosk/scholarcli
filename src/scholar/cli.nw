def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    relabel_source, save_session, session_file_path,
  )

  decision = ReviewDecision(
    paper=Paper(title="Unix lineage", authors=["A"], doi="10.1/unix"),
    provider="openalex", status=DecisionStatus.DISCARDED,
    tags=["supports-claim"], source=ReviewSource.LLM_REVIEWED,
    is_example=True, llm_confidence=0.9, **self.AUDIT,
  )
  relabel_source(decision, ReviewSource.AGENT_UNREVIEWED,
                 at="2026-11-19T10:00:00+00:00", note="agent checked")
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 19),
    name="trace", decisions=[decision],
  )
  save_session(session)
  return session_file_path(session)

def _decide(self, *args):
  return runner.invoke(app, [
    "sessions", "decide", "trace", "--doi", "10.1/unix", *args,
  ])

CORRECTION = ("--discard", "--tag", "off-topic-false-hit")

def test_the_correction_keeps_the_classifier_call(
  self, tmp_path, monkeypatch
):
  from scholar.llm_review import build_llm_screening_latex
  from scholar.review import ReviewSource, llm_audit_of, load_session

  self._make_session(tmp_path, monkeypatch)
  result = self._decide(*self.CORRECTION, "-c", "0.8",
                        "--source", "agent", "--keep-trace")
  assert result.exit_code == 0, result.output
  session = load_session("trace")
  decision = session.decisions[0]
  assert decision.tags == ["off-topic-false-hit"]
  assert decision.source is ReviewSource.AGENT_UNREVIEWED
  assert llm_audit_of(decision) == self.AUDIT
  assert decision.llm_confidence == 0.8
  assert decision.is_example is False
  assert [r["to"] for r in decision.relabelled] == ["agent"]
  report = " ".join(build_llm_screening_latex(session))
  assert "model m-1: 1" in report
  assert "0123456789abcdef" in report

def test_without_the_flag_the_trace_is_cleared(
  self, tmp_path, monkeypatch
):
  from scholar.llm_review import build_llm_screening_latex
  from scholar.review import LLM_AUDIT_FIELDS, llm_audit_of, load_session

  self._make_session(tmp_path, monkeypatch)
  result = self._decide(*self.CORRECTION, "-c", "0.8", "--source", "agent")
  assert result.exit_code == 0, result.output
  session = load_session("trace")
  assert llm_audit_of(session.decisions[0]) \
    == dict.fromkeys(LLM_AUDIT_FIELDS)
  assert "m-1" not in " ".join(build_llm_screening_latex(session))

