def test_a_human_decision_only_notes_the_flag(
  self, tmp_path, monkeypatch
):
  from dataclasses import asdict
  import scholar.utils
  from scholar.review import load_session

  # Both runs record the human's review; one clock, so its time is equal.
  monkeypatch.setattr(scholar.utils, "utc_now_iso",
                      lambda: "2026-11-20T09:00:00+00:00")
  outcomes = []
  for run, flag in (("with", ["--keep-trace"]), ("without", [])):
    self._make_session(tmp_path / run, monkeypatch)
    result = self._decide("--keep", "--tag", "ml", "--source", "human",
                          *flag)
    assert result.exit_code == 0, result.output
    noted = "a human decision never clears" in " ".join(
      result.output.split()
