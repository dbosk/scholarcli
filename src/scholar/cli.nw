def _session(self, tmp_path, monkeypatch):
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, save_session,
  )

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  empty_llm_registries(monkeypatch, tmp_path)
  kept = [
    ReviewDecision(
      paper=Paper(title=f"Tracing Study {n}", authors=["A"],
                  doi=f"10.5555/unknown-model-{n}", year=2024,
                  abstract="Students traced recursive calls."),
      provider="openalex", status=DecisionStatus.KEPT, tags=[tag],
    )
    for n, tag in enumerate(["tracing", "misconceptions"])
  ]
  pending = ReviewDecision(
    paper=Paper(title="Loops in Practice", authors=["C"],
                doi="10.5555/unknown-model-pending",
                abstract="A study of loops."),
    provider="openalex",
  )
  save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="unknown-model", research_context="Do novices misread recursion?",
    decisions=[*kept, pending],
  ))

