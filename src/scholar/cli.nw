The verdicts file is the reasons file's layout with two columns more
before the reason, the verdict and the tags, and a check of the whole
line that a discard has a tag.  The verdict is spelt as the session
stores it, [[kept]] or [[discarded]], in any case; the tags are split
at commas, stripped and taken once each, and more than one category is
refused there, before any session is read.

<<sessions command>>=
@dataclass(frozen=True)
class VerdictLine:
    """One line of a `--verdicts-file`: which paper and its verdict."""

    line: int
    paper: str
    status: str
    tags: tuple[str, ...]
    reason: str
    confidence: float | None


def read_verdict_column(text: str) -> tuple[str | None, str | None]:
    """Read a verdict column: kept or discarded."""
    verdict = text.strip().lower()
    if verdict in ("kept", "discarded"):
        return verdict, None
    return None, f"verdict {text.strip()!r} is neither kept nor discarded"


def read_tags_column(text: str) -> tuple[tuple[str, ...], str | None]:
    """Read a tags column: comma-separated, at most one category."""
    from scholar.review import AUDIT_CATEGORIES

    tags = tuple(dict.fromkeys(
        t.strip() for t in text.split(",") if t.strip()
    ))
    categories = [t for t in tags if t in AUDIT_CATEGORIES]
    if len(categories) > 1:
        return tags, ("a verdict holds one category, not "
                      f"{', '.join(categories)}")
    return tags, None


def _discard_has_a_tag(values: tuple) -> list[str]:
    status, tags = values[0], values[1]
    if status == "discarded" and not tags:
        return ["a discard needs a tag (motivation)"]
    return []


VERDICTS_LAYOUT = TabFileLayout(
    columns=(
        TabFileColumn(read_verdict_column),
        TabFileColumn(read_tags_column),
        TabFileColumn(read_reason_column),
        TabFileColumn(read_confidence_column, optional=True),
    ),
    too_few="too few columns (a line holds an id, kept or discarded, "
            "the tags and a reason, separated by tabs)",
    holds="a line holds an id, a verdict, the tags, a reason and an "
          "optional confidence",
    last="the confidence",
    check=_discard_has_a_tag,
)


def parse_verdicts_file(text: str) -> tuple[list[VerdictLine], list[str]]:
    """Parse a `--verdicts-file`: `ID<TAB>STATUS<TAB>TAGS<TAB>REASON` lines.

    An optional fifth column gives the confidence. Returns the valid
    lines and a problem per invalid line, naming its number. Blank lines
    and lines starting with `#` are skipped.
    """
    entries, problems = parse_tab_file(text, VERDICTS_LAYOUT)
    return [
        VerdictLine(number, paper, *values)
        for number, paper, values in entries
    ], problems
