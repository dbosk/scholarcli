    out.parent.mkdir(exist_ok=True)
    result = runner.invoke(app, [
      "sessions", "export", "sheet-safe", "-o", str(out), *options,
    ])
    assert result.exit_code == 0, result.output
    with open(f"{out}.csv", newline="", encoding="utf-8") as f:
      return next(_csv.DictReader(f))

  def test_export_csv_and_all(self, tmp_path, monkeypatch):
    self._session(tmp_path, monkeypatch)
    raw = self._export(tmp_path, "-f", "csv")
    assert (raw["title"], raw["authors"], raw["venue"]) == (
      "=1+2 is a formula", "-Ada Example", "@Proceedings of Nothing")
    for options in (["-f", "csv", "--spreadsheet-safe"],
                    ["-f", "all", "--spreadsheet-safe"]):
      safe = self._export(tmp_path, *options)
      assert (safe["title"], safe["authors"], safe["venue"]) == (
        "'=1+2 is a formula", "'-Ada Example",
        "'@Proceedings of Nothing"), options
      assert safe["year"] == "2021"

  def test_export_refuses_the_flag_without_the_csv(
      self, tmp_path, monkeypatch):
    self._session(tmp_path, monkeypatch)
    out = tmp_path / "out" / "r"
    result = runner.invoke(app, [
      "sessions", "export", "sheet-safe", "-f", "latex",
      "--spreadsheet-safe", "-o", str(out),
    ])
    assert result.exit_code == 2
    assert "--spreadsheet-safe applies to the CSV only" in result.output
    assert not out.parent.exists()

  def _provider(self, monkeypatch):
    from scholar import providers
    from scholar.scholar import Paper

    mock_provider = Mock()
    mock_provider.name = "mock"
    mock_provider.MAX_LIMIT = None
    mock_provider.last_error = None
    mock_provider.last_retries = 0
    mock_provider.search.return_value = [Paper(
      title="+Sum of parts", authors=["=Ada Example"], year=2021,
      doi="10.5555/sheet-safe", venue="-Venue",
    )]
    monkeypatch.setattr(providers, "PROVIDERS", {"mock": mock_provider})
    return mock_provider

  def test_search_csv(self, monkeypatch):
    self._provider(monkeypatch)
    raw = runner.invoke(app, ["search", "+Sum", "-f", "csv"])
    safe = runner.invoke(
      app, ["search", "+Sum", "-f", "csv", "--spreadsheet-safe"])
    assert raw.exit_code == safe.exit_code == 0
    assert ("+Sum of parts\t=Ada Example\t2021\t10.5555/sheet-safe\t"
            "-Venue\t" in raw.stdout.splitlines())
    assert ("'+Sum of parts\t'=Ada Example\t2021\t10.5555/sheet-safe\t"
