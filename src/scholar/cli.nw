if all_papers or not (doi or paper_id):
    selected = list(session.decisions)
else:
    wanted_dois = {v.strip().lower(): v for v in doi or []}
    wanted_ids = set(paper_id or [])
    selected = [
        d for d in session.decisions
        if d.paper.id in wanted_ids
        or (d.paper.doi and d.paper.doi.strip().lower() in wanted_dois)
    ]
    found_dois = {
        d.paper.doi.strip().lower() for d in selected if d.paper.doi
    }
    found_ids = {d.paper.id for d in selected}
    missing = [
        f"DOI {v}" for k, v in wanted_dois.items() if k not in found_dois
    ] + [f"paper id {v}" for v in paper_id or [] if v not in found_ids]
    if missing:
