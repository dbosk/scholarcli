def decided_without_abstract_data(gap) -> dict:
    """The `sessions show` JSON counts of decided papers without one."""
    if not gap.without and not gap.doubtful:
        return {}
    return {"decided_without_abstract": {
        "decided": gap.papers,
        "without_abstract": gap.without,
        "every_source_had_none": gap.none_found,
        "not_asked": gap.not_asked,
        "lookup_failed": gap.failed,
        "no_record": gap.no_record,
        "doubtful_abstract": gap.doubtful,
    }}
