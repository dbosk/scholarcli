  assert result.exit_code == 0, result.output
  assert "Retired 1 search record(s)" in result.output
  assert f"[{self._id(1)}] openalex: draft --limit 50" in result.output
  assert self._marks() == [
    {"at": self.AT, "by": "the author", "note": "first version"},
    None, None, None,
  ]
  copy = path.with_name(
    f"{path.name}.pre-retire-search-20261120T100000Z.bak"
  )
  assert copy.exists()
  assert '"retired"' not in copy.read_text()
  from scholar.review import load_session
  [decision] = load_session("retire").decisions
  assert decision.found_by == [("draft", "openalex", "")]

