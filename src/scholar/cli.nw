        good, blocked = Mock(), Mock()
        good.name, blocked.name = "good", "blocked"
        good.search.return_value = [
            Paper(title="Found", authors=["A"], year=2024,
                  doi="10.1/rq-skip", abstract="Abstract."),
        ]
        monkeypatch.setattr(
            providers, "PROVIDERS", {"good": good, "blocked": blocked}
        )
        ratelimit.get_limiter("blocked").record_limit_hit(
            reason="daily quota spent", exhausted_daily=True
        )

        class Reply:
            def __init__(self, data):
                self._text = json.dumps(data)

            def text(self):
                return self._text

        class Model:
            model_id = "dummy"

            def prompt(self, prompt):
                if "Papers to Classify" in prompt:
                    return Reply({"classifications": [{
                        "paper_index": 0, "decision": "kept",
                        "tags": ["theme"], "confidence": 0.9,
                        "reasoning": "Relevant.",
                    }]})
                return Reply({"queries": [
                    {"provider": "good", "query": "good query"},
                    {"provider": "blocked", "query": "blocked query"},
                ]})

        llm_mod = types.ModuleType("llm")
        llm_mod.get_model = lambda model_id=None: Model()
        monkeypatch.setitem(sys.modules, "llm", llm_mod)

        result = runner.invoke(app, [
            "rq", "A question?", "-p", "good", "-p", "blocked",
            "--count", "1", "--no-enrich", "-n", "rq-skip",
        ])
        assert result.exit_code == 0, result.output
        blocked.search.assert_not_called()
        records = {
            r.provider: r for r in load_session("rq-skip").search_records
        }
        assert records["good"].hits == 1
        assert records["blocked"].query == "blocked query"
        assert records["blocked"].error.startswith(
            "skipped: daily quota spent; resets "
        )
@

