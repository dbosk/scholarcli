    for problem in unfit:
        console.print(f"[red]{escape(problem)}[/red]", soft_wrap=True)
    if unfit:
        def fitting(status: str) -> str:
            return ", ".join(sorted(
                STATUS_CATEGORIES[status], key=AUDIT_CATEGORIES.get
            ))

        console.print(
            f"[red]The session uses categories, so an {as_kind}'s "
            "screening carries exactly one that fits its verdict: kept "
            f"takes {fitting('kept')}; discarded takes "
            f"{fitting('discarded')}.[/red]\n"
            "[yellow]No changes saved.[/yellow]",
            soft_wrap=True,
        )
        raise typer.Exit(2)
