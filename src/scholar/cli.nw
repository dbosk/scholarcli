def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    relabel_source, save_session,
  )

  def decided(title, source, **audit):
    return ReviewDecision(
      paper=Paper(title=title, authors=["A"], doi=f"10.1/{title}"),
      provider="openalex", status=DecisionStatus.DISCARDED,
      tags=["off-topic-false-hit"], source=source, **audit,
    )

  corrected = decided("corrected", ReviewSource.LLM_REVIEWED,
                      llm_model="m-1", llm_reason="Fits.")
  relabel_source(corrected, ReviewSource.AGENT_UNREVIEWED,
                 at="2026-11-19T10:00:00+00:00")
  save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 19),
    name="shown", decisions=[
      corrected,
      decided("classified", ReviewSource.LLM_UNREVIEWED, llm_model="m-1"),
      decided("agents", ReviewSource.AGENT_UNREVIEWED),
    ],
  ))

