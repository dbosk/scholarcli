<<sessions command>>=
def _conflict_verdict(record, profile_label) -> str:
    """One screener's side of a conflict, on one line."""
    from scholar.review import audit_category

    category = audit_category(list(record.get("tags") or [])) \
        or "no category"
    reason = record.get("reason") or ""
    if len(reason) > SHOW_REASON_CHARS:
        reason = reason[:SHOW_REASON_CHARS - 1].rstrip() + "…"
    return (f"      {profile_label}: {record.get('status')}, {category}"
            + (f": {reason}" if reason else ""))


def conflicts_lines(listed, outcomes, profiles) -> list[str]:
    """The text of `sessions conflicts`."""
    from scholar.agreement import (
        ScreenerProfile, conflict_counts, conflict_counts_line,
        outcome_line, sorted_outcomes,
    )
    from scholar.review import audit_category

    def label(screener):
        return (profiles.get(screener) or ScreenerProfile(screener)).label

    lines = [conflict_counts_line(conflict_counts(listed))]
    for (a, b, kind), counts in sorted_outcomes(outcomes):
        lines.append(outcome_line(label(a), label(b), kind, counts))
    for decision, chosen, resolved in listed:
        outcome = decision.status.value
        category_of = audit_category(list(decision.tags))
        if category_of:
            outcome += f", {category_of}"
        lines += ["", f"• {decision.paper.title or ''}",
                  f"    {decision.paper.id}"]
        for c in chosen:
            lines += [f"    {c.kind} conflict",
                      _conflict_verdict(c.verdict_a, label(c.a)),
                      _conflict_verdict(c.verdict_b, label(c.b))]
        lines.append(
            f"    outcome: {outcome}, "
            + ("resolved by a human" if resolved else "unresolved")
        )
    return lines


def conflicts_data(listed, outcomes, profiles) -> dict:
    """The JSON of `sessions conflicts`."""
    from scholar.agreement import (
        ScreenerProfile, conflict_outcome, screener_data, screener_spec,
        verdict_value,
    )
    from scholar.review import audit_category

    def side(screener, record):
        profile = profiles.get(screener) or ScreenerProfile(screener)
        return {**screener_data(profile),
                "status": record.get("status"),
                "category": verdict_value(record, "category"),
                "reason": record.get("reason")}

    return {
        "conflicts": [
            {
                "paper_id": decision.paper.id,
                "title": decision.paper.title,
                "kind": c.kind,
                "a": side(c.a, c.verdict_a),
                "b": side(c.b, c.verdict_b),
                "outcome_status": decision.status.value,
                "outcome_category": audit_category(list(decision.tags)),
                "resolved": resolved,
                "outcome_equals": (
                    conflict_outcome(decision, c) if resolved else None
                ),
            }
            for decision, chosen, resolved in listed
            for c in chosen
        ],
        "outcomes": [
            {"a": screener_spec(a), "b": screener_spec(b),
             "kind": kind, **counts}
            for (a, b, kind), counts in outcomes.items()
        ],
    }
@

