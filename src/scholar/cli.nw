\paragraph{The comment lines, tested.}
These tests read the output with the recipe the help gives
(\cref{sec:search-csv-comments}): parse it whole with
[[csv.reader(f, delimiter="\t")]], take the rows up to an empty row as
a block's comments, then the header, then the paper rows up to the next
empty row.  Queries holding a tab or a line break before a quote mark
used to open a quoted field in the comment line that swallowed the
header and every row; a query in quote marks must stay a comment; an
error reason with a line break, in a [[# Results:]] and a [[# Search:]]
line, must too.  Several blocks are read back, with titles that begin
with [[#]] or hold a line break and then [[#]], which a reader that
drops the lines starting with [[#]] before parsing would lose.  The data
is invented.

<<test functions>>=
class TestSearchCsvComments:
  def _output(self, capsys, results):
    CSVFormatter().format(results)
    return capsys.readouterr().out

  def _blocks(self, text):
    """Read `search -f csv` output by the recipe the help gives."""
    import csv as _csv
    import io as _io
    rows = iter(_csv.reader(_io.StringIO(text, newline=""), delimiter="\t"))
    blocks = []
    for row in rows:
      comments = []
      while row != []:
        assert len(row) == 1 and row[0].startswith("# "), row
        comments.append(row[0])
        row = next(rows)
      header = next(rows)
      assert header == TestSearchCsvRows.COLUMNS
      papers = []
      for row in rows:
        if row == []:
          break
        papers.append(row)
      blocks.append((comments, papers))
    return blocks

  def _result(self, query, papers, provider="openalex", error=None):
    from scholar.scholar import SearchResult
    return SearchResult(query=query, provider=provider,
                        timestamp="2026-11-20T00:00:00", papers=papers,
                        error=error)

  def test_queries_that_broke_the_reader(self, capsys):
    paper = Paper(title="Kept whole", authors=["Ada Example"], year=2021)
    for query, shown in [('x\t"y', 'x "y'), ('a\n"b', 'a "b'),
                         ('"a b"', '"a b"'), ('c\r\n"d', 'c  "d')]:
      [(comments, papers)] = self._blocks(
        self._output(capsys, [self._result(query, [paper])]))
      assert comments[0] == f"# Query: {shown}", query
      assert papers == [["Kept whole", "Ada Example", "2021", "", "", ""]]

  def test_several_blocks_read_back(self, capsys):
    hashtag = Paper(title="#hashtag studies", authors=["Bo Sample"],
                    year=2020, doi="10.5555/comments-1")
    broken = Paper(title='x\n# Query: "not a comment', authors=["Cy"])
    merged = self._result("m", [hashtag], provider="openalex, dead")
    merged.parts = [
      self._result("m", [hashtag]),
      self._result("m", [], provider="dead", error='bad\n"gateway\tx'),
    ]
    results = [
      self._result('q\t"one', [hashtag, broken]),
      self._result("q2", [], provider="dblp", error='HTTP 503\n"busy'),
      merged,
    ]
    blocks = self._blocks(self._output(capsys, results))
    assert [papers for _, papers in blocks] == [
      [["#hashtag studies", "Bo Sample", "2020", "10.5555/comments-1",
        "", ""],
       ['x\n# Query: "not a comment', "Cy", "", "", "", ""]],
      [],
      [["#hashtag studies", "Bo Sample", "2020", "10.5555/comments-1",
        "", ""]],
    ]
    assert blocks[0][0][0] == '# Query: q "one'
    assert '# Results: failed (HTTP 503 "busy)' in blocks[1][0]
    assert any(line.startswith("# Search: dead: ")
               and 'bad "gateway x' in line for line in blocks[2][0])

  def test_help_gives_the_recipe(self):
    import re
    result = runner.invoke(app, ["search", "--help"], env={"COLUMNS": "200"})
    text = " ".join(re.sub(r"[^\x00-\x7f]", " ", result.output).split())
    assert "parse the whole output with it" in text
    assert "do not drop the lines starting with # before parsing" in text
