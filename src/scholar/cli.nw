class TestSessionsShowRetired:
  """sessions show numbers the records and marks the retired ones."""

  def _save(self, tmp_path, monkeypatch, retired):
    from scholar.review import ReviewSession, SearchRecord, save_session

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    draft = SearchRecord("draft", "openalex", None, 50, hits=0)
    draft.retired = retired
    save_session(ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime.now(),
      name="rs-show",
      search_records=[draft, SearchRecord("q", "openalex", None, 50,
                                          hits=4)],
    ))

  def test_listing_and_json(self, tmp_path, monkeypatch):
    mark = {"at": "2026-11-20T10:00:00+00:00", "by": None,
            "note": "first version"}
    self._save(tmp_path, monkeypatch, mark)
    result = runner.invoke(app, ["sessions", "show", "rs-show"])
    assert result.exit_code == 0, result.output
    from scholar.review import SearchRecord
    draft = SearchRecord("draft", "openalex").record_id
    final = SearchRecord("q", "openalex").record_id
    flat = " ".join(result.output.split())
    assert "Queries by provider: 1 current, 1 retired" in flat
    assert (f"[{draft}] openalex: draft --limit 50 — hits: 0 "
            "(retired 2026-11-20: first version)") in flat
    assert f"[{final}] openalex: q --limit 50 — hits: 4" in flat

    data = json.loads(runner.invoke(
      app, ["sessions", "show", "rs-show", "-f", "json"]
    ).output)
    assert [(r["id"], r.get("retired"))
            for r in data["search_records"]] == [(draft, mark), (final, None)]
    assert all("index" not in r for r in data["search_records"])

  def test_without_retired_searches(self, tmp_path, monkeypatch):
    self._save(tmp_path, monkeypatch, None)
    result = runner.invoke(app, ["sessions", "show", "rs-show"])
    assert "Queries by provider:\n" in result.output
    assert "retired" not in result.output
    data = json.loads(runner.invoke(
      app, ["sessions", "show", "rs-show", "-f", "json"]
    ).output)
    assert all("retired" not in r for r in data["search_records"])
