    one.write_text("@article{smith2020,\n  title = {Agent kept},\n"
                   "  author = {Ash, Ann},\n  year = {2020},\n}\n")
    two.write_text("@article{smith2020,\n  title = {Human kept},\n"
                   "  author = {Berg, Bo},\n  year = {2021},\n}\n")
