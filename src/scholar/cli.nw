@

An id is matched as a prefix, in any case, so that the seven
characters [[sessions show]] prints, or fewer, select the record.  A
prefix that no record has exits with status~1, like a [[--query]]
that matches nothing; one that two records share exits with status~2
and lists them, since picking one would be a guess.  All ids are
checked before anything is reported, so one run names every problem.

<<select the search records by id>>=
unknown, ambiguous, selected = [], [], []
for value in record_ids:
    matches = records_with_id_prefix(session.search_records, value)
    if not matches:
        unknown.append(value)
    elif len(matches) > 1:
        ambiguous.append((value, matches))
    else:
        selected += [r for r in matches if r not in selected]
for value, matches in ambiguous:
    console.print(
        f"[red]--record {escape(value)} fits {len(matches)} "
        "records:[/red]"
    )
    for r in matches:
        console.print(f"[red]  {_record_line(r)}[/red]")
for value in unknown:
    console.print(
        f"[red]No search record has an id starting with "
        f"{escape(value)} (see `scholar sessions show`).[/red]"
    )
if ambiguous or unknown:
    console.print("[yellow]No changes saved.[/yellow]")
    raise typer.Exit(2 if ambiguous else 1)
