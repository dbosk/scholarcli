A paper reset after the draw ([[sessions reset]],
\cref{sec:sessions-reset}) is counted apart in both forms of the
report, and is not listed as one to review:

<<test functions>>=
class TestLLMSampleReportAfterReset:
  """`llm sample --report` on a sample whose paper was reset (#248)."""

  def test_reset_since_draw_is_reported(self):
    from datetime import datetime
    from scholar import review

    session = review.ReviewSession(
      query="cli-reset-sample", providers=["p"],
      timestamp=datetime(2026, 11, 19), name="cli-reset-sample",
    )
