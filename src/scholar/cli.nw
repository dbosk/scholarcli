class TestSessionsShowOrder:
  """sessions show names the order of each recorded answer."""

  def test_listing_and_json(self, tmp_path, monkeypatch):
    from scholar.review import ReviewSession, SearchRecord, save_session

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    records = [
      SearchRecord("a", "scopus", None, 25, hits=4, order="relevance"),
      SearchRecord("b", "s2", None, 100, hits=7, order="citations"),
      SearchRecord("c", "ieee", None, 100, hits=3, order="unknown"),
      SearchRecord("d", "scopus", None, 25, hits=4),
    ]
    save_session(ReviewSession(
      query="q", providers=["scopus", "s2", "ieee"],
      timestamp=datetime.now(), name="order-show",
      search_records=records,
    ))

    result = runner.invoke(app, ["sessions", "show", "order-show"])
    assert result.exit_code == 0
    lines = result.output.splitlines()
    shown = [
      next(line for line in lines if f"[{r.record_id}]" in line)
      for r in records
    ]
    assert shown[0].endswith(": a --limit 25 — hits: 4 — order: relevance")
    assert shown[1].endswith(": b --limit 100 — hits: 7 — order: citations")
    assert shown[2].endswith("— hits: 3 — order: unknown")
    assert shown[3].endswith(": d --limit 25 — hits: 4")

    data = json.loads(runner.invoke(
      app, ["sessions", "show", "order-show", "-f", "json"]
    ).output)
    assert [r.get("order") for r in data["search_records"]] \
      == ["relevance", "citations", "unknown", None]
    assert "order" not in data["search_records"][3]
