    content = (tmp_path / "tab.tex").read_text()
    assert r"Agent kept & 2020 & OA & \emph{cited}" in content
    assert r"Human kept & 2021 & OA & \emph{cited}" in content
    assert "2 entries, 0 matched by DOI, 2 by title" \
