class TestTierLeftovers:
  """No stale tier counts, no misleading empty tier (#302)."""

  def test_a_sheet_without_a_tier_removes_old_counts(
    self, tmp_path, monkeypatch,
  ):
    sheets = TestSheetTier()
    sheets._save(tmp_path, monkeypatch)
    sheets._export(tmp_path, "--top", "10")
    assert (tmp_path / "sheet-tier.json").exists()
    with monkeypatch.context() as patched:
      patched.setattr("scholar.cli.screen_sheet_rows",
                      lambda decisions: 1 / 0)
      failed, _ = sheets._export(tmp_path)
    assert failed.exit_code == 1
    assert (tmp_path / "sheet-tier.json").exists()
    result, _ = sheets._export(tmp_path)
    assert result.exit_code == 0, result.output
    assert not (tmp_path / "sheet-tier.json").exists()
    assert "Removed" in result.output

  def test_a_file_of_another_shape_is_left(self, tmp_path, monkeypatch):
    sheets = TestSheetTier()
    sheets._save(tmp_path, monkeypatch)
    for text in ('{"rule": "my own notes"}', "not JSON at all"):
      (tmp_path / "sheet-tier.json").write_text(text)
      result, _ = sheets._export(tmp_path)
      assert result.exit_code == 0, result.output
      assert (tmp_path / "sheet-tier.json").read_text() == text
      assert "Left" in result.output

