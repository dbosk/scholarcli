def test_unknown_ids_and_clashes_abort(self, tmp_path, monkeypatch):
  session, path = self._make_session(tmp_path, monkeypatch)
  self._content = path.read_bytes()
  keep = ("--keep", "--tag", "ml", "--source", "agent")
  unknown = self._file(tmp_path, (
    "10.1/one\tFine.\n10.1/nowhere\tLost.\nhash:0000\tLost too.\n"
  ))
