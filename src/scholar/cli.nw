def test_completion_of_first_word_imports_nothing(self):
    """Completing `scholar ` lists the submodules from the placeholders."""
    env = {**os.environ, "_SCHOLAR_COMPLETE": "complete_bash",
           "COMP_WORDS": "scholar ", "COMP_CWORD": "1"}
    _, stdout, loaded = run_cli_in_child(env=env)
    assert {"snowball", "tuxedo", "search"} <= set(stdout.split())
    assert loaded == []

