The point of the failure marker (\cref{sec:search-result-error}) is the
whole path from a provider that did not answer to the views a reviewer
reads.  So we follow it end to end: a provider reporting a failure
yields [[failed]] in the CSV count line, in the session record, and
under \enquote{Queries by provider:} in [[sessions show]]---never a 0:

<<test functions>>=
class TestSearchFailureRecorded:
    """A provider failure reads as failed, not as zero hits."""

    def _failing_provider(self, monkeypatch):
        from scholar import providers

        mock_provider = Mock()
        mock_provider.name = "mock"
        mock_provider.MAX_LIMIT = None
        mock_provider.search.return_value = []
        mock_provider.last_error = "non-JSON response (HTTP 200, text/html)"
        mock_provider.last_retries = 0
        monkeypatch.setattr(
            providers, "PROVIDERS", {"mock": mock_provider}
        )

    def test_csv_count_says_failed(self, monkeypatch):
        self._failing_provider(monkeypatch)
        result = runner.invoke(app, ["search", "q", "-f", "csv"])
        assert result.exit_code == 0
        assert (
            "# Results: failed (non-JSON response (HTTP 200, text/html))"
            in result.stdout
        )

    def test_json_carries_error(self, monkeypatch):
        import json as _json

        self._failing_provider(monkeypatch)
        result = runner.invoke(app, ["search", "q", "-f", "json"])
        data = _json.loads(result.stdout)
        assert data[0]["error"].startswith("non-JSON response")
        assert data[0]["retries"] == 0

    def test_session_records_and_shows_failure(self, tmp_path, monkeypatch):
        from scholar.review import load_session

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        self._failing_provider(monkeypatch)
        runner.invoke(app, ["search", "q", "-n", "dead", "-f", "json"])

        record = load_session("dead").search_records[0]
        assert record.error.startswith("non-JSON response")
        assert record.hits == 0

        shown = runner.invoke(app, ["sessions", "show", "dead"])
        assert "failed (non-JSON response" in shown.stdout
