CHECK_FORMATS = ["table", "csv", "json"]
CHECK_MAX_LIMIT = 50   # the most a semantic search returns


def complete_check_format(incomplete: str) -> list[str]:
    """Complete the output format of `sessions check`."""
    return [f for f in CHECK_FORMATS if f.startswith(incomplete)]


CHECK_BACKENDS = ["openalex", "s2-snippets"]


def complete_check_backend(incomplete: str) -> list[str]:
    """Complete the backend of `sessions check`."""
    return [b for b in CHECK_BACKENDS if b.startswith(incomplete)]
@

The arguments are checked before anything is loaded or sent; each
mistake is a usage error (exit 2), like a malformed option.

<<validate the check arguments>>=
from scholar.providers import OPENALEX_SEMANTIC_MAX_CHARS

err = Console(stderr=True)
usage_error = None
if not semantic:
    usage_error = "Give at least one question with --semantic."
elif known and any(not item.strip() for item in known):
    usage_error = (
        "A --known value is empty; give a DOI or a part of a title."
    )
elif output_format not in CHECK_FORMATS:
    usage_error = (
        f"Unknown format {output_format!r}; use "
        f"{', '.join(CHECK_FORMATS)}."
    )
elif backend not in CHECK_BACKENDS:
    usage_error = (
        f"Unknown backend {backend!r}; use "
        f"{', '.join(CHECK_BACKENDS)}."
    )
elif backend == "openalex":
    too_long = [q for q in semantic if len(q) > OPENALEX_SEMANTIC_MAX_CHARS]
    if too_long:
        usage_error = (
            f"A question has {len(too_long[0])} characters; the semantic "
            f"search matches at most {OPENALEX_SEMANTIC_MAX_CHARS}."
        )
if usage_error:
    err.print(f"[red]{escape(usage_error)}[/red]")
    raise typer.Exit(2)
@

Loading is strict, so an unreadable file is an error and not a missing
session, and nothing is saved afterwards.

<<load the sessions to check, read-only>>=
from scholar.review import SessionFileError, session_file_path

sessions = []
for session_name in names:
    try:
        loaded = open_session_argument(session_name, strict=True)
    except SessionFileError as error:
        err.print(f"[red]{escape(str(error))}[/red]")
        raise typer.Exit(1)
    if loaded is None:
        err.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)
    if all(session_file_path(loaded) != session_file_path(s)
           for s in sessions):
        sessions.append(loaded)
@

A session can be named twice, by its name and by its file name
([[x x.json]]); it is checked once, as [[llm sample]] samples it once,
since two copies of one file would count its papers twice.

Each question is one search.  A provider blocked by its quota is
skipped by [[Search.execute]] with a warning; here, where each question
is reported on its own, the block is the question's failure, with the
limiter's reason.  The works are cleaned as [[Search.execute]] cleans
them, so titles compare as they do in the sessions.

<<run each semantic check>>=
from scholar.providers import get_provider
from scholar.ratelimit import limiter_for
from scholar.review import (
    CHECK_NOT_IN_SESSIONS, check_against_sessions, check_tally,
)
from scholar.scholar import provider_outcome
from scholar.utils import clean_paper_text

if backend == "s2-snippets":
    from scholar.providers import SemanticScholarSnippetSearch

    provider = SemanticScholarSnippetSearch()
else:
    provider = get_provider("openalex-semantic")
results = []
works_by_question = []
for number, question in enumerate(semantic, start=1):
    availability = limiter_for(provider).check_available()
    if availability.ok:
        papers = provider.search(question, limit=limit)
        error, retries = provider_outcome(provider)
    else:
        papers, error, retries = [], availability.reason, 0
    for paper in papers:
        clean_paper_text(paper)
    rows, known_rows = check_against_sessions(papers, sessions, known or [])
    scores = check_scores(papers)
    works_by_question.append((papers, scores))
    results.append({
        "number": number,
        "question": question,
        "provider": provider.name,
        "limit": limit,
        "check_date": datetime.now().isoformat(timespec="seconds"),
        "source": check_source(provider, papers, error),
        "sessions": [s.name or s.query for s in sessions],
        "error": error,
        "retries": retries,
        "note": check_note(provider),
        "returned": len(rows),
        "tally": check_tally(rows),
        "not_in_any_session": sum(
            1 for row in rows if row.bucket == CHECK_NOT_IN_SESSIONS
        ),
        "rows": [
            {**dataclasses.asdict(row), "relevance_score": score}
            for row, score in zip(rows, scores)
        ],
        "known": [dataclasses.asdict(row) for row in known_rows],
    })
@

The scores and the source are read with [[getattr]], since the
provider's answer is only promised to be a list: the semantic provider
returns a [[RankedPapers]] that carries them, any other answer reads
as \enquote{unknown}.  [[last_from_cache]] counts only when it is
literally [[True]], so a stand-in whose every attribute is a [[Mock]]
is not mistaken for a cache hit.

<<session check helpers>>=
def check_note(provider) -> str | None:
    """What the backend adds about its answer, if it says anything."""
    note = getattr(provider, "last_note", None)
    return note if isinstance(note, str) and note else None


def check_scores(papers: list) -> list:
    """The relevance score of each paper, or None where unknown."""
    scores = list(getattr(papers, "scores", None) or [])
    return [
        scores[i] if i < len(scores) else None for i in range(len(papers))
    ]


def check_source(provider, papers: list, error: str | None) -> dict:
    """Where a question's answer came from: cache or fetch, and when."""
    from_cache = getattr(provider, "last_from_cache", False) is True
    fetched_at = getattr(papers, "fetched_at", None)
    if not isinstance(fetched_at, str):
        fetched_at = None
    if error:
        label = "not fetched"
    elif from_cache:
        label = (
            f"cached, fetched {fetched_at}" if fetched_at
            else "cached (date unknown)"
        )
    else:
        label = (
            f"fetched {fetched_at}" if fetched_at
            else "fetched (date unknown)"
        )
    return {"from_cache": from_cache, "fetched_at": fetched_at,
            "label": label}
