\paragraph{The rows of a search, tested.}
\label{sec:search-csv-rows-tests}
The rows of [[search -f csv]] are written by [[csv.writer]]
(\cref{sec:search-csv-rows}), and these tests read them back the way a
script should, with [[csv.reader(f, delimiter="\t")]].  A fixture of
ordinary rows, with commas, semicolons, colons, apostrophes,
parentheses, empty fields and a missing year, must come out byte for
byte as the old [[print]] wrote it, comment lines and blank lines
included; in an invented sample of twenty titles, the three that hold
a quote mark, and only those, change.  Fields holding a tab, a line
break, a Windows line break, a quote mark at the start, in the middle
or alone, a comma or a semicolon come back exactly as stored.  With
[[--spreadsheet-safe]] a cell that begins with a tab, a carriage
return or a line feed keeps its prefix and stays one field, so the text
after the tab never begins a cell of its own, and a year stored as text
gets the prefix like any text cell, while a year that is a number,
negative too, does not.  The data is invented.

<<test functions>>=
class TestSearchCsvRows:
  COLUMNS = ["title", "authors", "year", "doi", "venue", "url"]

  def _output(self, capsys, papers, **options):
    from scholar.scholar import SearchResult
    CSVFormatter(**options).format([SearchResult(
      query="q", provider="openalex", timestamp="2026-11-20T00:00:00",
      papers=papers,
    )])
    return capsys.readouterr().out

  def _rows(self, text):
    import csv as _csv
    import io as _io
    rows = list(_csv.reader(_io.StringIO(text, newline=""), delimiter="\t"))
    start = rows.index(self.COLUMNS) + 1
    return rows[start:rows.index([], start)]

  def _stored(self, paper):
    return [paper.title, "; ".join(paper.authors),
            str(paper.year) if paper.year else "", paper.doi or "",
            paper.venue or "", paper.url or ""]

  def test_ordinary_rows_are_byte_identical(self, capsys):
    papers = [
      Paper(title="Sum of parts, revisited; again",
            authors=["Ada Example", "Bo Sample"], year=2021,
            doi="10.5555/rows-a1", venue="Journal of Examples",
            url="https://example.org/a1"),
      Paper(title="Sets (and why) it's fine", authors=["Cy Instance"]),
      Paper(title="A third: title", authors=[], year=1999,
            doi="10.5555/rows-a3", venue="Proc. X"),
    ]
    assert self._output(capsys, papers) == (
      "# Query: q\n# Provider: openalex\n"
      "# Timestamp: 2026-11-20T00:00:00\n# Results: 3\n\n"
      "title\tauthors\tyear\tdoi\tvenue\turl\n"
      "Sum of parts, revisited; again\tAda Example; Bo Sample\t2021\t"
      "10.5555/rows-a1\tJournal of Examples\thttps://example.org/a1\n"
      "Sets (and why) it's fine\tCy Instance\t\t\t\t\n"
      "A third: title\t\t1999\t10.5555/rows-a3\tProc. X\t\n"
      "\n"
    )

  def test_only_rows_with_a_quote_mark_change(self, capsys):
    titles = [f"Study number {n} of the sample" for n in range(17)] + [
      '"Quoted" opening words', 'A title with a "quoted" word',
      'Ends with a quote mark"']
    papers = [Paper(title=title, authors=["Ada Example"], year=2020,
                    doi=f"10.5555/rows-s{n}")
              for n, title in enumerate(titles)]
    lines = self._output(capsys, papers).split("\n")
    start = lines.index("\t".join(self.COLUMNS)) + 1
    old = [f"{p.title}\tAda Example\t2020\t{p.doi}\t\t" for p in papers]
    changed = [p.title for p, line, before
               in zip(papers, lines[start:], old) if line != before]
    assert changed == titles[17:]

  def test_fields_round_trip(self, capsys):
    papers = [
      Paper(title="Tab\tinside", authors=["Ada\tExample", "Bo Sample"],
            year=2021, doi="10.5555/rows-r1", venue="Venue\nline",
            url='https://example.org/?q="x"'),
      Paper(title="Line\nbreak", authors=['Cy "C" Instance']),
      Paper(title="Windows\r\nbreak", authors=["Di, Dee; Example"]),
      Paper(title='"Quoted" at the start', authors=["E"]),
      Paper(title='In the "middle" here', authors=["F"]),
      Paper(title='"', authors=["G"]),
      Paper(title="Comma, and; semicolon", authors=["H"],
            venue="Proc.; of, things"),
    ]
    assert self._rows(self._output(capsys, papers)) == [
      self._stored(p) for p in papers]

  def test_safe_cells_with_a_tab_or_break_stay_whole(self, capsys):
    titles = ["\t=1+2", "x\t=3+4", "\n=1+2", "\r\n=1+2", "\r=1+2"]
    papers = [Paper(title=title, authors=["Ada Example"], year=2021)
              for title in titles]
    rows = self._rows(self._output(capsys, papers, spreadsheet_safe=True))
    assert [row[0] for row in rows] == [
      "'\t=1+2", "x\t=3+4", "'\n=1+2", "'\r\n=1+2", "'\r=1+2"]
    assert all(row[1:3] == ["Ada Example", "2021"] for row in rows)

  def test_a_text_year_gets_the_prefix(self, capsys):
    papers = [Paper(title="T", authors=["A"], year="=1+2"),
              Paper(title="U", authors=["B"], year="'1999"),
              Paper(title="V", authors=["C"], year=2021),
              Paper(title="W", authors=["D"], year=-44)]
    raw = self._rows(self._output(capsys, papers))
    safe = self._rows(self._output(capsys, papers, spreadsheet_safe=True))
    assert [row[2] for row in raw] == ["=1+2", "'1999", "2021", "-44"]
    assert [row[2] for row in safe] == ["'=1+2", "''1999", "2021", "-44"]

  def test_help_states_the_format(self):
    import re
    result = runner.invoke(app, ["search", "--help"], env={"COLUMNS": "200"})
    text = " ".join(re.sub(r"[^\x00-\x7f]", " ", result.output).split())
    assert "tab-separated, written by Python's csv module" in text
    assert 'csv.reader(f, delimiter="\\t")' in text
