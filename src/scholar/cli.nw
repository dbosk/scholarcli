<<cli imports>>=
import csv
from datetime import datetime
<<session check helpers>>=
CHECK_CSV_COLUMNS = [
    "question_number", "question", "kind", "known", "rank", "title",
    "year", "doi", "paper_id", "bucket", "sessions", "error",
]


def write_check_csv(results: list[dict], stream) -> None:
    """Write the check results as CSV: one line per work or known study."""
    writer = csv.DictWriter(stream, fieldnames=CHECK_CSV_COLUMNS)
    writer.writeheader()
    for result in results:
        base = {
            "question_number": result["number"],
            "question": result["question"],
        }
        if result["error"]:
            writer.writerow({**base, "kind": "failed",
                             "error": result["error"]})
        for kind, rows in (("returned", result["rows"]),
                           ("known", result["known"])):
            for row in rows:
                writer.writerow({
                    **base,
                    "kind": kind,
                    "known": row.get("known", ""),
                    "rank": row["rank"] or "",
                    "title": row["title"] or "",
                    "year": row.get("year") or "",
                    "doi": row["doi"] or "",
                    "paper_id": row.get("paper_id", ""),
                    "bucket": row["bucket"],
                    "sessions": "; ".join(
                        _check_match_text(m) for m in row["matches"]
                    ),
                })
