Let's verify it through the real command and the real enrichment, with
one provider whose answer is a real-looking abstract (an invented one)
at the network's edge.
The session holds three pending papers: one whose abstract is a
conflict-of-interest statement, one whose abstract is equally short
but was given by hand, and one with a real abstract.
Only the first is asked about and replaced, and its decision records
where the new abstract came from and what it replaced.
The saved session is read in a registry of its own: this process still
holds the papers as they were loaded, and [[Paper.from_dict]] would hand
those back.

<<test functions>>=
class TestEnrichDoubtfulAbstracts:
  """`scholar enrich` replaces a doubtful abstract it can (#287)."""

  STATEMENT = ("Conflict of interest The authors declare that they have no "
               "conflict of interest with regard to this invented work.")
  REAL = ("Students often treat recursion as a loop. We report an invented "
          "study of 120 novices and describe what helped them.")

  def _session(self, tmp_path, monkeypatch):
    from scholar import Paper
    from scholar.review import (
      ReviewDecision, ReviewSession, save_session, set_abstract,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = ReviewSession(query="q", providers=["m"],
                            timestamp=datetime(2026, 11, 20),
                            name="doubtful")
    session.decisions = [
      ReviewDecision(
        paper=Paper(title=f"Paper {n}", authors=["a"],
                    doi=f"10.5555/doubtful-{n}", abstract=abstract),
        provider="m",
      )
      for n, abstract in ((0, self.STATEMENT), (1, None), (2, self.REAL))
    ]
    set_abstract(session.decisions[1:2], "Keywords: given by hand.",
                 "Crossref", "2026-11-20T10:00:00+00:00")
    save_session(session)

  def test_replaced_recorded_and_tallied(self, tmp_path, monkeypatch):
    from scholar import Paper
    from scholar.review import fetched_abstract_source, load_session

    self._session(tmp_path, monkeypatch)
    asked = []

    class Provider:
      def get_paper_by_doi(self, doi):
        asked.append(doi)
        return Paper(title="Paper 0", authors=["a"], doi=doi,
                     abstract=TestEnrichDoubtfulAbstracts.REAL)

    with patch(
      "scholar.enrich.get_provider",
      lambda name: Provider() if name == "s2" else None,
    ), patch("scholar.enrich.abstract_source", lambda name: None), patch(
      "scholar.crossref.annotate_papers",
      side_effect=lambda papers, **kw: list(papers),
    ):
      result = runner.invoke(app, ["enrich", "doubtful",
                                   "--fields", "abstract"])
    assert result.exit_code == 0, result.output
    assert asked == ["10.5555/doubtful-0"]
    out = " ".join(result.output.split())
    assert ("Doubtful abstracts (text that looks like something other "
            "than an abstract): 1 paper.") in out
    assert ("conflict-of-interest statement: 1 replaced by a later "
            "source's abstract") in out
    from scholar import isolated_registry

    with isolated_registry():
      replaced, hand, real = load_session("doubtful").decisions
    assert replaced.paper.abstract == self.REAL
    assert fetched_abstract_source(replaced) == "s2"
    [record] = replaced.abstract_fetched
    assert record["replaced"] == {
      "text": self.STATEMENT, "reason": "conflict-of-interest statement",
      "from": None,
    }
    assert hand.paper.abstract == "Keywords: given by hand."
    assert hand.abstract_fetched == []
    assert real.paper.abstract == self.REAL
    assert real.abstract_fetched == []
@

A doubtful abstract the run judged is a lookup like a missing one: the
paper whose doubtful abstract a source replaced keeps the outcome
[[found]], one whose doubtful abstract no source could replace keeps
what the sources answered, and a text given by hand, which is never
judged, is not looked up and gets no record.

<<test functions>>=
class TestEnrichLookupOfDoubtfulAbstracts:
  """The lookup record of a judged doubtful abstract (#293, #287)."""

  STATEMENT = TestEnrichDoubtfulAbstracts.STATEMENT
  REAL = TestEnrichDoubtfulAbstracts.REAL

  def _run(self, tmp_path, monkeypatch, answer):
    from scholar import Paper, isolated_registry
    from scholar.review import load_session

    TestEnrichDoubtfulAbstracts._session(self, tmp_path, monkeypatch)

    class Provider:
      def get_paper_by_doi(self, doi):
        return (Paper(title="Paper 0", authors=["a"], doi=doi,
                      abstract=answer) if answer else None)

    with patch(
      "scholar.enrich.get_provider",
      lambda name: Provider() if name == "s2" else None,
    ), patch("scholar.enrich.abstract_source", lambda name: None), patch(
      "scholar.crossref.annotate_papers",
      side_effect=lambda papers, **kw: list(papers),
    ):
      result = runner.invoke(app, ["enrich", "doubtful",
                                   "--fields", "abstract"])
    assert result.exit_code == 0, result.output
    with isolated_registry():
      return load_session("doubtful").decisions

  def test_replaced(self, tmp_path, monkeypatch):
    doubtful, hand, real = self._run(
      tmp_path, monkeypatch, TestEnrichDoubtfulAbstracts.REAL)
    assert doubtful.abstract_lookup["outcome"] == "found"
    assert hand.abstract_lookup is None
    assert real.abstract_lookup is None

  def test_kept(self, tmp_path, monkeypatch):
    doubtful, hand, _ = self._run(tmp_path, monkeypatch, None)
    assert doubtful.paper.abstract == TestEnrichDoubtfulAbstracts.STATEMENT
    assert doubtful.abstract_lookup["outcome"] == "none-found"
    assert doubtful.abstract_lookup["asked"] == ["s2"]
    assert hand.abstract_lookup is None
