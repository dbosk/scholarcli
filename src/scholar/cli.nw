  def _setup(self, tmp_path, monkeypatch, batch=(200, None)):
    import requests
    import requests.adapters
    from scholar.review import (
      ReviewSession, ReviewDecision, DecisionStatus, save_session,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = ReviewSession(query="q", providers=["openalex"],
