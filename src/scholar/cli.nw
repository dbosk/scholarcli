  def test_numbered_sheets_and_a_manifest(self, tmp_path, monkeypatch):
    out = self._sheets(tmp_path, monkeypatch)
    assert self._export(out / "one.tsv").exit_code == 0
    single = (out / "one.tsv").read_text(encoding="utf-8").splitlines()
    result = self._export(out / "b.tsv", "--batch-size", "2")
    assert result.exit_code == 0, result.output
    assert "3 paper(s) on 2 screen sheet(s) of at most 2." in result.output
    assert sorted(p.name for p in out.iterdir()) == [
      ".scholar-outputs.lock", "b-001.tsv", "b-002.tsv", "b-manifest.tsv",
      "one.tsv"]
    first = (out / "b-001.tsv").read_text(encoding="utf-8").splitlines()
    second = (out / "b-002.tsv").read_text(encoding="utf-8").splitlines()
    batch = first[0].removeprefix("# batch: ")
