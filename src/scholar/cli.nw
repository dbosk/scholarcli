def test_llm_classify_decides_a_reset_paper_again(
  self, tmp_path, monkeypatch
):
  import json
  import scholar.llm_review as llm_review
  from scholar.llm_review import apply_llm_decisions, classify_papers_with_llm
  from scholar.review import DecisionStatus, ReviewSource, load_session

  self._make_session(tmp_path, monkeypatch)
  assert self._reset("--source", "llm").exit_code == 0
  session = load_session("reset")
  session.research_context = "Does the claim hold?"

  class FakeResponse:
    def text(self):
      return json.dumps({"classifications": [
        {"paper_index": i, "decision": "kept", "tags": ["supports-claim"],
         "confidence": 0.9, "reasoning": "On topic."}
        for i in range(2)
      ]})

  class FakeModel:
    model_id = "fake-2"

    def __init__(self):
      self.prompts = []

    def prompt(self, prompt):
      self.prompts.append(prompt)
      return FakeResponse()

  model = FakeModel()

  class FakeLLMModule:
    def get_model(self, _model_id=None):
      return model

  monkeypatch.setattr(llm_review, "llm", FakeLLMModule(), raising=False)
  result = classify_papers_with_llm(
    session, model_id="fake-2", enrich_missing=False,
    require_examples=False,
  )
  assert "Classified" in model.prompts[0]
  apply_llm_decisions(session, result)
  classified = session.decisions[0]
  assert classified.status is DecisionStatus.KEPT
  assert classified.source is ReviewSource.LLM_UNREVIEWED
  assert classified.llm_model == "fake-2"
  assert classified.resets[0]["trace"]["llm_model"] == "m-1"
