def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from datetime import timezone
  import scholar.review as review
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    save_session, session_file_path,
  )

  monkeypatch.setattr(
    review, "_utcnow",
    lambda: datetime(2026, 11, 19, 10, 0, tzinfo=timezone.utc),
  )
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 19),
    name="relabel",
  )
  session.decisions.extend([
    ReviewDecision(
      paper=Paper(title="Human", authors=["A"], doi="10.1/human"),
      provider="openalex", status=DecisionStatus.KEPT,
      tags=["supports-claim", "ml"], found_by=[("q", "openalex", "")],
    ),
    ReviewDecision(
      paper=Paper(title="Reviewed", authors=["B"], doi="10.1/reviewed"),
      provider="openalex", status=DecisionStatus.DISCARDED,
      tags=["off-topic-false-hit"], source=ReviewSource.LLM_REVIEWED,
      is_example=True, llm_confidence=0.8, llm_model="m-1",
      llm_decided_at="2026-11-01T09:00:00+00:00",
      llm_prompt_version="0123456789abcdef", llm_reason="Off topic.",
      llm_abstract_truncated=False,
    ),
    ReviewDecision(
      paper=Paper(title="Pending", authors=["C"], doi="10.1/pending"),
      provider="openalex",
    ),
    ReviewDecision(
      paper=Paper(title="Unreviewed", authors=["D"], doi="10.1/llm"),
      provider="openalex", status=DecisionStatus.KEPT,
      tags=["ml"], source=ReviewSource.LLM_UNREVIEWED, llm_confidence=0.6,
    ),
  ])
  save_session(session)
  return session_file_path(session)

def _relabel(self, *args):
  return runner.invoke(app, ["sessions", "relabel", "relabel", *args])

def _fields(self, decision):
  from dataclasses import asdict

  fields = asdict(decision)
  for name in ("source", "relabelled", "paper", "is_example"):
    del fields[name]
  return fields

def test_human_to_agent_keeps_the_decision(self, tmp_path, monkeypatch):
  from scholar.review import ReviewSource, load_session

  path = self._make_session(tmp_path, monkeypatch)
  before = self._fields(load_session("relabel").decisions[0])
  result = self._relabel("--from", "human", "--to", "agent",
                         "--doi", "10.1/HUMAN", "--note", "an agent decided",
                         "--by", "the author")
  assert result.exit_code == 0, result.output
  assert "human -> agent: 1" in result.output
  decision = load_session("relabel").decisions[0]
  assert decision.source is ReviewSource.AGENT_UNREVIEWED
  assert self._fields(decision) == before
  assert decision.relabelled == [{
    "from": "human", "to": "agent", "at": self.AT,
    "note": "an agent decided", "by": "the author", "is_example": False,
  }]
  assert path.with_name(
    "relabel.json.pre-relabel-20261119T100000Z.bak"
  ).exists()

def test_reviewed_llm_call_keeps_its_trace(self, tmp_path, monkeypatch):
  from scholar.review import (
    LLM_AUDIT_FIELDS, ReviewSource, llm_audit_of, load_session,
  )

  self._make_session(tmp_path, monkeypatch)
  before = load_session("relabel").decisions[1]
  trace = (llm_audit_of(before), before.llm_confidence)
  result = self._relabel("--from", "llm_reviewed", "--to", "agent", "--all")
  assert result.exit_code == 0, result.output
  assert "llm_reviewed -> agent: 1" in result.output
  after = load_session("relabel").decisions[1]
  assert after.source is ReviewSource.AGENT_UNREVIEWED
  assert (llm_audit_of(after), after.llm_confidence) == trace
  assert after.llm_model == "m-1"
  assert after.is_example is False
  assert after.relabelled[0]["is_example"] is True

@pytest.mark.parametrize("target",
                         ["human", "llm_reviewed", "agent_reviewed"])
def test_a_confirmed_target_is_refused(self, tmp_path, monkeypatch, target):
  path = self._make_session(tmp_path, monkeypatch)
  content = path.read_bytes()
  result = self._relabel("--from", "llm", "--to", target, "--all")
  assert result.exit_code == 2
  flat = " ".join(result.output.split())
  assert "A human confirmation must be made by the human" in flat
  assert path.read_bytes() == content
  assert list(path.parent.glob("*.pre-relabel-*")) == []

def test_dry_run_writes_nothing(self, tmp_path, monkeypatch):
