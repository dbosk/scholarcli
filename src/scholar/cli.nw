    f"{s['path'].name} holds {s['name']!r}"
    for s in sessions if s.get("name_mismatch")
]
if foreign:
    Console(stderr=True).print(
        f"[yellow]Warning:[/yellow] {len(foreign)} session file(s) hold a "
        f"session under another name: {escape('; '.join(foreign))}. "
        "Open them by their file name (without .json); they are saved "
