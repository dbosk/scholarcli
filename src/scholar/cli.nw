Let's verify the draw through the export on an invented session: five
pending papers, one decided, and a tier of the head of a relevance
answer.  The sheet lists the drawn papers, none of the tier and none
decided; the session records the draw with the rule, a copy of the
file is kept, and the tier file names the draw.  Two exports with the
same seed draw the same papers as two records; a later search that adds
papers leaves the stored ids as drawn.  A rest smaller than asked for
is a census; batches work; a dry run writes nothing; the refusals come
before the session is read; and an export of the tier without the
option leaves the session file as it was.

<<test functions>>=
class TestRestSampleSheet:
  """`--rest-sample N --seed S` lists and records a sample (#315)."""

  <<rest sample sheet test methods>>

<<rest sample sheet test methods>>=
def _save(self, tmp_path, monkeypatch):
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, SearchRecord,
    save_session,
  )

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  def decision(name, rank, status=DecisionStatus.PENDING):
    d = ReviewDecision(
      paper=Paper(title=f"Paper {name}", authors=["Ada Lovelace"],
                  year=2021, doi=f"10.5555/rest-sheet-{name}"),
      provider="openalex", status=status,
      tags=[] if status == DecisionStatus.PENDING else ["off-topic"],
    )
    d.record_search("q", "openalex", "", rank)
    return d
  save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 23),
    name="rest-sheet",
    search_records=[
      SearchRecord("q", "openalex", {}, 50, hits=50, order="relevance"),
    ],
    decisions=[
      decision("head", 1),
      decision("decided", 2, DecisionStatus.DISCARDED),
      *(decision(n, 10 + i) for i, n in enumerate("abcde")),
    ],
  ))

def _export(self, tmp_path, *options):
  out = tmp_path / "rest"
  return runner.invoke(app, [
    "sessions", "export", "rest-sheet", "-f", "screen-sheet", "--pending",
    "--top", "1", "-o", str(out), *options,
  ])

def _ids(self, path):
  return TestSheetTier()._ids(path)

def _session(self):
  from scholar.review import load_session
  from scholar.scholar import isolated_registry

  with isolated_registry():
    return load_session("rest-sheet")

def test_the_sheet_lists_the_recorded_draw(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  result = self._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  assert result.exit_code == 0, result.output
  ids = self._ids(tmp_path / "rest.tsv")
  rest = {f"doi:10.5555/rest-sheet-{n}" for n in "abcde"}
  assert len(ids) == 3 and set(ids) <= rest
  [draw] = self._session().tier_samples
  assert draw.papers == ids
  assert (draw.rest, draw.seed, draw.census) == (5, 315, False)
  assert draw.rule["top"] == 1
  tier = json.loads((tmp_path / "rest-tier.json").read_text())
  assert tier["rest_sample"]["sample_id"] == draw.sample_id
  assert tier["selected"] == 1
  assert list((tmp_path / "review_sessions").glob(
    "rest-sheet.json.pre-rest-sample-*.bak"))
  assert "The draw is recorded in the session." in result.output

def test_the_same_seed_draws_the_same_papers(self, tmp_path, monkeypatch):
  from scholar.review import ReviewDecision, save_session
  from scholar.scholar import isolated_registry

  self._save(tmp_path, monkeypatch)
  self._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  first = self._ids(tmp_path / "rest.tsv")
  with isolated_registry():
    session = self._session()
    session.decisions.append(ReviewDecision(
      paper=Paper(title="Paper later", authors=["Ada Lovelace"],
                  doi="10.5555/rest-sheet-later"),
      provider="openalex",
    ))
    save_session(session)
  self._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  old, new = self._session().tier_samples
  assert old.papers == first
  assert (old.rest, new.rest) == (5, 6)
  assert old.sample_id != new.sample_id

def test_a_small_rest_is_a_census_in_batches(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  result = self._export(tmp_path, "--rest-sample", "9", "--seed", "1",
                        "--batch-size", "2")
  assert result.exit_code == 0, result.output
  ids = self._ids(tmp_path / "rest-001.tsv") \
    + self._ids(tmp_path / "rest-002.tsv") \
    + self._ids(tmp_path / "rest-003.tsv")
  [draw] = self._session().tier_samples
  assert draw.census is True and ids == draw.papers and len(ids) == 5
  assert "(a census)" in result.output

def test_a_dry_run_writes_nothing(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  path = tmp_path / "review_sessions" / "rest-sheet.json"
  before = path.read_bytes()
  result = self._export(tmp_path, "--rest-sample", "3", "--seed", "315",
                        "--dry-run")
  assert result.exit_code == 0, result.output
  assert "nothing written" in result.output
  assert "Sample of the rest" not in result.output
  assert "assigned when the draw is recorded" in result.output
  assert path.read_bytes() == before
  assert not list(tmp_path.glob("rest*"))

HOLDER = """
  import sys
  from scholar.review import load_session, session_file_path
  from scholar.utils import file_lock
  session = load_session("rest-sheet")
  with file_lock(session_file_path(session)):
    print("holding", flush=True)
    sys.stdin.readline()
"""

def test_a_refused_save_writes_nothing_and_recover_adds_the_draw(
  self, tmp_path, monkeypatch,
):
  """Another process holds the lock from the pre-run copy to the save."""
  import subprocess
  import sys
  import textwrap
  import scholar.review as review
  from scholar.review import (
    SessionNotSaved, recover_unsaved_session, unsaved_session_files,
  )

  self._save(tmp_path, monkeypatch)
  path = tmp_path / "review_sessions" / "rest-sheet.json"
  before = path.read_bytes()
  holders = []
  real_copy = review.keep_copy_before_run

  def copy_then_hold(session, label, keep=None):
    made = real_copy(session, label, keep)
    holder = subprocess.Popen(
      [sys.executable, "-c", textwrap.dedent(self.HOLDER)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    holders.append(holder)
    assert holder.stdout.readline().strip() == "holding"
    return made

  monkeypatch.setattr(review, "keep_copy_before_run", copy_then_hold)
  monkeypatch.setattr(review, "SESSION_LOCK_TIMEOUT", 0.6)
  monkeypatch.setattr(review, "SESSION_LOCK_NOTICE", 0.2)
  try:
    result = self._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  finally:
    for holder in holders:
      holder.communicate("go\n", timeout=60)
  assert result.exit_code == 1
  assert isinstance(result.exception, SessionNotSaved)
  assert "recorded" not in result.output
  assert path.read_bytes() == before
  assert not (tmp_path / "rest.tsv").exists()
  assert not (tmp_path / "rest-tier.json").exists()
  [kept] = unsaved_session_files()
  recover_unsaved_session(kept)
  [draw] = self._session().tier_samples
  assert (draw.rest, len(draw.papers)) == (5, 3)

def test_a_failure_after_the_save_says_the_draw_is_recorded(
  self, tmp_path, monkeypatch,
):
  import os

  self._save(tmp_path, monkeypatch)
  real_replace = os.replace

  def failing_move(source, target, *args, **kwargs):
    if ".scholar-staging-" in str(source):
      raise OSError("no space left on the device")
    return real_replace(source, target, *args, **kwargs)

  with monkeypatch.context() as patched:
    patched.setattr(os, "replace", failing_move)
    result = self._export(tmp_path, "--rest-sample", "3", "--seed", "315")
  assert result.exit_code == 1
  [draw] = self._session().tier_samples
  text = " ".join(result.output.split())
  assert "no files were written or changed" not in text
  assert f"The draw {draw.sample_id} is recorded in the session" in text
  assert "scholar sessions tier-sample rest-sheet" in text
  assert not (tmp_path / "rest.tsv").exists()

def test_without_the_option_the_session_is_not_written(
  self, tmp_path, monkeypatch,
):
  self._save(tmp_path, monkeypatch)
  path = tmp_path / "review_sessions" / "rest-sheet.json"
  before = path.read_bytes()
  result = self._export(tmp_path)
  assert result.exit_code == 0, result.output
  assert path.read_bytes() == before
  tier = json.loads((tmp_path / "rest-tier.json").read_text())
  assert "rest_sample" not in tier
  assert self._ids(tmp_path / "rest.tsv") == ["doi:10.5555/rest-sheet-head"]

def test_refusals(self, tmp_path, monkeypatch):
  self._save(tmp_path, monkeypatch)
  path = tmp_path / "review_sessions" / "rest-sheet.json"
  before = path.read_bytes()
  base = ["sessions", "export", "rest-sheet", "-o", str(tmp_path / "x")]
  for options in (
    ["-f", "screen-sheet", "--pending", "--top", "1",
     "--rest-sample", "3"],
    ["-f", "screen-sheet", "--pending", "--rest-sample", "3",
     "--seed", "1"],
    ["-f", "screen-sheet", "--top", "1", "--rest-sample", "3",
     "--seed", "1"],
    ["-f", "screen-sheet", "--pending", "--top", "1",
     "--rest-sample", "0", "--seed", "1"],
    ["-f", "screen-sheet", "--pending", "--seed", "1"],
    ["-f", "screen-sheet", "--pending", "--dry-run"],
    ["-f", "csv", "--rest-sample", "3", "--seed", "1"],
  ):
    result = runner.invoke(app, base + options)
    assert result.exit_code == 2, (options, result.output)
  assert path.read_bytes() == before
