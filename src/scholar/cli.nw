    ] = None,
    <<screen sheet tier options>>
    <<screen sheet rest sample options>>
    <<sessions export spreadsheet option>>
) -> None:
    """
    Export a saved session to file(s).

    Generates CSV and/or LaTeX reports from a saved review session.
    Use --format to select specific formats. The LaTeX report is a
    compilable document by default; with --no-standalone it becomes a
    fragment for \\input, with the bibliography in a sibling .bib.
    The table format writes an audit table (one row per paper with the
    reason it was kept or excluded) meant for a backing appendix; it is
    always a fragment and takes --lang, --label, --track and --theme;
    --bearing-only keeps only the rows that bear on the claim and states
    the other counts in the caption; --truncate-titles shortens long
    titles, which are otherwise printed whole. With --cited-from refs.bib
    a row is cited when the text cites its work, whoever decided, and
    the works the session excludes or lacks are listed on stderr.
    The screen-sheet format writes a tab-separated sheet for a blind
    second screen: a header, then id, title, year, venue and abstract,
    no verdict. It lists decided papers, since a second screen is
    compared with a first verdict and a pending paper has none;
    --pending lists the pending papers instead, for a first screen;
    --sample ID keeps a review sample's papers (and says on stderr what
    the sample gives away, e.g. that it holds discards only);
    --undecided-by NAME leaves out the papers NAME already has a verdict
    on (a screening of theirs, or the decision they made or confirmed).
    --batch-size N splits the sheet into numbered sheets of at most N
    records, BASE-001.tsv, BASE-002.tsv, ..., each starting with the
    comment lines `# batch: ID`, `# session: FILE` and `# records: N`,
    and writes BASE-manifest.tsv (batch, file, records, first and last
    id). The id is the same for the same session file, selection and
    size; a reasons or verdicts file that keeps the `# batch:` line has
    its verdicts stored with it. Scholar sets no batch size. The
    screening protocol this was written for recommends batches of about
    100 records, and that is only a recommendation: in the runs behind
    it, defaulted rows were frequent in batches of several hundred, rare
    at 100 or fewer, and in one run still came back in batches of 100.
    A batch id lets a bad batch be found and redone.
    --top K, --min-providers N and --provider P (repeatable, with
    --query-like TEXT) list only a first tier of these papers: those
    at place K or better in a relevance-ordered answer (a semantic
    search's answer holds at most 50, all taken by K >= 50), returned
    by at least N databases (providers sharing a quota group, such as
    OpenAlex and its preprint servers, are one), or returned by a
    search of P (whose query holds TEXT); any one condition suffices. The counts of what is
    and is not selected are printed and written to BASE-tier.json.
    Retired searches do not count.
    --rest-sample N --seed S, with --pending and a tier option, lists
    instead a seeded random sample of N of the pending papers the tier
    leaves out (all of them, a census, when no more are left), drawn as
    `llm sample` draws, and RECORDS THE DRAW IN THE SESSION: this export
    then saves the session, after keeping a copy of its file. Once the
    sample is screened, `scholar sessions tier-sample S --report` gives
    the share of the sampled records that bear on the question, with an
    interval: an estimate of that share among all the records the tier
    left out, as judged by whoever screened the sample. It does not say
    which records they are, and a sample with none bearing does not show
    that none does. --dry-run prints the counts and writes nothing.
    With --spreadsheet-safe the CSV (-f csv or -f all) is written for
    opening in a spreadsheet program: a text cell that could be read as
    a formula gets one ' in front (see the option's help); scripts
    should read the default CSV, which holds the stored text.

    Examples:
        scholar sessions export "my review" -f all
        scholar sessions export "my review" -f latex --no-standalone -o review
        scholar sessions export "my review" -f table --lang sv --label sok-A \\
            --track "sökspår 1" --theme ml=maskininlärning -o review-full
    """
    from scholar.review import (
        generate_latex_report,
        generate_csv_report,
        generate_audit_table,
        machine_review_rows,
    )

    if format_type not in EXPORT_FORMATS:
        console = Console()
        console.print(
            f"[red]Invalid format: {escape(format_type)}. "
            f"Use one of {', '.join(EXPORT_FORMATS)}.[/red]"
        )
        raise typer.Exit(1)
    if lang not in TABLE_LANGUAGES:
        console = Console()
        console.print(
            f"[red]Invalid --lang: {escape(lang)}. "
            f"Use one of {', '.join(TABLE_LANGUAGES)}.[/red]"
        )
        raise typer.Exit(1)
    theme_names: dict[str, str] = {}
    for item in theme or []:
        tag, sep, readable = item.partition("=")
        if not sep or not tag:
            Console().print(
                f"[red]Invalid --theme {escape(item)}: expected TAG=NAME[/red]"
            )
            raise typer.Exit(1)
        theme_names[tag] = readable
    <<refuse [[--cited-from]] without the audit table>>
    <<refuse the screen sheet's options with other formats>>
    <<refuse [[--spreadsheet-safe]] without the CSV>>

    console = Console()
    session = open_session_argument(name)

    if session is None:
        console.print(f"[red]Session not found: {escape(name)}[/red]")
        raise typer.Exit(1)
    <<match the works the text cites>>
    <<refuse a sample the session does not hold>>
    <<refuse a tier provider the session does not hold>>

    # Use session query as default output name (sanitized)
    if output is None:
        # Sanitize query for filename
        safe_name = "".join(
            c if c.isalnum() or c in "-_" else "_"
            for c in session.query[:30]
        )
        output = f"review_{safe_name}"

    <<draw the rest of the tier on a dry run>>
    <<write the export files all or nothing>>
    <<say that the tier counts of an earlier sheet were removed>>

    console.print("[green]Exported:[/green]")
    for f in files_created:
        console.print(f"  - {escape(str(f))}")
    <<say how many papers the screen sheet lists>>

    if format_type in ("latex", "all") and not standalone:
        _print_fragment_hint(console, tex_path.with_suffix(".bib").name)
    if cited_entries is not None:
        _warn_cited_disagreements(
            session, cited_entries, theme_names=theme_names, lang=lang
        )

    # If an LLM or an agent decided, report agreement/change counts.
    review_rows = machine_review_rows(session.decisions)
    if review_rows:
        table = Table(title="LLM and agent review", box=box.HORIZONTALS)
        table.add_column("Category", style="cyan")
        table.add_column("Count", justify="right")
        for category, count in review_rows:
            table.add_row(category, str(count))
        console.print(table)
