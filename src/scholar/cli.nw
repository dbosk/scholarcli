class TestSessionsDecideUntag:
    """`sessions decide --untag`, and one category per record.

    Also pins that an untag is a decision: it reviews and it clears.
    """

    DOI = "10.1/withdoi"

    def _make_session(self, tmp_path, monkeypatch):
        return TestSessionsDecideCommand()._make_session(
            tmp_path, monkeypatch
        )

    def _decide(self, *args, source="human"):
        return runner.invoke(app, [
            "sessions", "decide", "headless", "--source", source,
            "--doi", self.DOI, *args,
        ])

    def _tags(self):
        from scholar.review import load_session
        return load_session("headless").decisions[0].tags

    def test_untag_removes_a_criterion_on_keep(self, tmp_path, monkeypatch):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--discard", "--tag", "no-abstract")
        self._decide("--keep", "--tag", "ml")
        assert self._tags() == ["no-abstract", "ml"]
        result = self._decide("--keep", "--untag", "no-abstract")
        assert result.exit_code == 0, result.output
        assert self._tags() == ["ml"]

    def test_untag_goes_before_tag(self, tmp_path, monkeypatch):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--discard", "--tag", "no-abstract")
        self._decide(
            "--keep", "--untag", "no-abstract", "--tag", "no-abstract",
        )
        assert self._tags() == ["no-abstract"]

    def test_same_status_category_replaces_the_old_one(
        self, tmp_path, monkeypatch
    ):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--keep", "--tag", "supports-claim", "-t", "ml")
        self._decide("--keep", "--tag", "qualifies-claim")
        assert self._tags() == ["ml", "qualifies-claim"]

    def test_same_status_without_category_still_adds(
        self, tmp_path, monkeypatch
    ):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--keep", "--tag", "supports-claim")
        self._decide("--keep", "--tag", "ml")
        assert self._tags() == ["supports-claim", "ml"]

    def test_a_missing_tag_is_noted_once_and_is_no_error(
        self, tmp_path, monkeypatch
    ):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--keep", "--tag", "ml")
        result = self._decide(
            "--keep", "--untag", "typo", "--untag", "typo",
            "--untag", "ml",
        )
        assert result.exit_code == 0, result.output
        assert result.output.count("No selected paper had the tag typo") == 1
        assert "tag ml" not in result.output
        assert self._tags() == []

    def test_a_discard_still_needs_a_tag_on_the_command(
        self, tmp_path, monkeypatch
    ):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--keep", "--tag", "ml")
        result = self._decide("--discard", "--untag", "ml")
        assert result.exit_code == 1
        assert "requires at least one --tag" in result.output
        assert self._tags() == ["ml"]

    def test_a_machine_may_untag(self, tmp_path, monkeypatch):
        self._make_session(tmp_path, monkeypatch)
        self._decide("--keep", "--tag", "ml", "-t", "no-abstract",
