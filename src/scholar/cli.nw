  assert [d.status for d in copies] == [DecisionStatus.PENDING] * 2
  assert [d.resets[0]["source"] for d in copies] == ["llm", "agent"]

def test_sessions_show_names_the_reset(self, tmp_path, monkeypatch):
  import json

  self._make_session(tmp_path, monkeypatch)
  relabel = runner.invoke(app, [
    "sessions", "relabel", "reset", "--from", "agent", "--to", "llm",
    "--doi", "10.1/agent",
  ])
  assert relabel.exit_code == 0, relabel.output
  self._reset("--source", "llm")
  flat = " ".join(runner.invoke(
