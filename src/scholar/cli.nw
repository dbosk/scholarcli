    saving = True
    <<check the quotes of the agent's reasons>>

    status = DecisionStatus.KEPT if keep else DecisionStatus.DISCARDED
    untag_seen: set[str] = set()
    decided_at = utc_now_iso()
    for decision in selected.values():
        <<record one decision with its source>>

    <<note the tags no paper had>>
    save_session(session)
    word = "kept" if keep else "discarded"
    papers = len({d.paper.id for d in selected.values()})
    copies = (f" ({len(selected)} decisions)"
