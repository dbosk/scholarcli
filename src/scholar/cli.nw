def test_pending_only_leaves_decided_papers_alone(
  self, tmp_path, monkeypatch
):
  from scholar.review import DecisionStatus, load_session, save_session

  name = self._session(tmp_path, monkeypatch, 3)
  session = load_session(name)
  session.decisions[0].status = DecisionStatus.KEPT
  session.decisions[0].tags = ["theme"]
  session.decisions[1].status = DecisionStatus.DISCARDED
  session.decisions[1].tags = ["off-topic"]
  save_session(session)
  enriched, annotated = [], []

  def enrich(papers, **kwargs):
    enriched.append(([p.doi for p in papers], kwargs["fields"]))
    return self._enriched(papers)

  def annotate(papers, progress_callback=None):
    annotated.append([p.doi for p in papers])
    return list(papers)

  result = self._invoke([name, "--pending-only"], enrich, annotate)
  assert result.exit_code == 0, result.stdout
  assert enriched == [(["10.1/c137-2"], ["abstract", "pdf_url", "keywords"])]
  assert annotated == [["10.1/c137-2"]]
  assert "of 1 pending papers" in result.stdout

  saved = self._saved(name)
  assert saved["10.1/c137-0"].status == DecisionStatus.KEPT
  assert saved["10.1/c137-0"].tags == ["theme"]
  assert saved["10.1/c137-0"].paper.abstract is None
  assert saved["10.1/c137-1"].status == DecisionStatus.DISCARDED
  assert saved["10.1/c137-1"].paper.abstract is None
  assert saved["10.1/c137-2"].paper.abstract == "Enriched."
