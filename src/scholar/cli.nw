class TestSessionsShowVia:
  """sessions show names the endpoint that answered a search."""

  def test_listing_and_json(self, tmp_path, monkeypatch):
    from scholar.review import ReviewSession, SearchRecord, save_session

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    save_session(ReviewSession(
      query="q", providers=["s2"], timestamp=datetime.now(),
      name="via-show",
      search_records=[
        SearchRecord("a AND b", "s2", None, 0, hits=784, via="bulk"),
        SearchRecord("plain", "s2", None, 100, hits=3),
      ],
    ))

    result = runner.invoke(app, ["sessions", "show", "via-show"])
    assert result.exit_code == 0
