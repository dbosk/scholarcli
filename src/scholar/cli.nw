ABSTRACTS = {
  "10.1/one": "Most students treated recursion as a loop.",
  "10.1/two": "A compiler course with automated feedback on assignments.",
}

def _make_session(self, tmp_path, monkeypatch, extra=0):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    ReviewDecision, ReviewSession, save_session, session_file_path,
  )

  papers = [
    Paper(title=f"Paper {doi}", authors=["A"], doi=doi, abstract=abstract)
    for doi, abstract in self.ABSTRACTS.items()
  ] + [
    Paper(title=f"Extra {n}", authors=["A"], doi=f"10.1/extra-{n}",
          abstract="Nothing quoted here.")
    for n in range(extra)
  ]
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="quotes", decisions=[
      ReviewDecision(paper=paper, provider="openalex") for paper in papers
    ],
  )
  save_session(session)
  return session_file_path(session)

def _decide(self, *args, name="quotes"):
  return runner.invoke(app, [
    "sessions", "decide", name, "--source", "agent", "--discard",
    "--tag", "off-topic-false-hit", "-c", "0.8", *args,
  ])

def _file(self, tmp_path, text):
  path = tmp_path / "reasons.tsv"
  path.write_text(text, encoding="utf-8")
  return str(path)

def test_a_quote_from_another_record_is_reported_with_its_line(
  self, tmp_path, monkeypatch
):
  from scholar.review import load_session

  self._make_session(tmp_path, monkeypatch)
  reasons = self._file(tmp_path, (
    "doi:10.1/one\tSays “treated recursion as a loop”.\n"
    "doi:10.1/two\tSays \"most students treated recursion\"; "
    "\"automated feedback\" is short.\n"
  ))
  result = self._decide("--reasons-file", reasons)
  assert result.exit_code == 0, result.output
  assert "Quotes not found in the record's title or abstract (1):" \
    in result.stderr
  assert 'line 2, doi:10.1/two: "most students treated recursion"' \
    in result.stderr
  assert "line 1" not in result.stderr
  assert "automated feedback" not in result.stderr
  stored = {d.paper.doi: d.agent_reason
            for d in load_session("quotes").decisions}
  assert stored["10.1/two"].startswith("Says \"most students")

def test_one_reason_is_checked_for_every_record(
  self, tmp_path, monkeypatch
):
  self._make_session(tmp_path, monkeypatch)
  result = self._decide(
    "--doi", "10.1/one", "--doi", "10.1/two",
    "--reason", 'Reports that "students see recursion as loops".',
  )
  assert result.exit_code == 0, result.output
  for doi in ("10.1/one", "10.1/two"):
    assert f'doi:{doi}: "students see recursion as loops"' in result.stderr

def test_strict_quotes_refuses_the_batch_unsaved(
  self, tmp_path, monkeypatch
):
  path = self._make_session(tmp_path, monkeypatch)
  before = path.read_bytes()
  reasons = self._file(
