for batch_id, group in rows_by_batch(rows).items():
    if len(group) < len(rows):
        parts.append((batch_id, len(group), batch_findings(group)))
<<sessions command>>=
def without_repeated_reasons(findings: list, parts: list) -> tuple:
    """The file's and the batches' findings, each shared reason once.

    `parts` holds `(batch id, rows, findings)`. A file finding whose
    reason one batch reports with the same count is dropped; otherwise
    it names the batches' counts and their findings are dropped.
    """
    in_batches: dict[str, list] = {}
    for batch_id, _, part in parts:
        for finding in part:
            if finding.kind == "shared-reason":
                in_batches.setdefault(finding.reason, []).append(
                    (batch_id, finding))
    kept, folded = [], set()
    for finding in findings:
        held = (in_batches.get(finding.reason)
                if finding.kind == "shared-reason" else None)
        if not held:
            kept.append(finding)
        elif len(held) == 1 and held[0][1].count == finding.count:
            continue
        else:
            kept.append(dataclasses.replace(finding, detail=finding.detail
                + "".join(f", {part_finding.count} of them in batch "
                          f"{batch_id}" for batch_id, part_finding in held)))
            folded.update(id(part_finding) for _, part_finding in held)
    return kept, [
        (batch_id, size, [f for f in part if id(f) not in folded])
        for batch_id, size, part in parts
    ]


def rows_by_batch(rows) -> dict[str, list]:
    """The rows that name a batch, grouped by it, in the order met."""
    groups: dict[str, list] = {}
    for row in rows:
        if row.batch is not None:
            groups.setdefault(row.batch, []).append(row)
    return groups
