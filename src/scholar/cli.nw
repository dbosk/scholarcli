def test_each_line_gets_its_reason_and_confidence(
  self, tmp_path, monkeypatch
):
  from scholar.review import ReviewSource, load_session

  session, _ = self._make_session(tmp_path, monkeypatch)
  hashed = session.decisions[2].paper.id
  reasons = self._file(tmp_path, (
    "# discards of the first pass\n"
    "doi:10.1/one\tAbout compilers, not learners.\n"
    "\n"
    f"{hashed}\t  No abstract; title only.  \t0.4\n"
    "10.1/TWO\tTeaching material without evaluation.\t\n"
  ))
  result = self._decide("--source", "agent", "--discard",
                        "--tag", "off-topic-false-hit", "-c", "0.9",
                        "--by", "agent-7", "--reasons-file", reasons)
  assert result.exit_code == 0, result.output
  decisions = {d.paper.title: d for d in load_session("reasons").decisions}
  assert {t: (d.agent_reason, d.llm_confidence)
          for t, d in decisions.items()} == {
    "One": ("About compilers, not learners.", 0.9),
    "Two": ("Teaching material without evaluation.", 0.9),
    "Three": ("No abstract; title only.", 0.4),
    "Four": (None, None),
