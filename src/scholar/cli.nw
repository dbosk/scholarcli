where it is made as well as where it is read.  Before the links existed
the command named the second query, the session's latest search on the
provider.

<<prov test methods>>=
@staticmethod
def _search_into(session_name, query, provider, papers, limit=None):
    """Append one search to ``session_name`` as ``search -n`` does."""
    from scholar.review import create_review_session, save_session
    from scholar.scholar import SearchResult
    result = SearchResult(
        query=query, provider=provider, timestamp="t", papers=papers,
        limit=limit,
    )
    save_session(
        create_review_session([result], query, session_name=session_name)
    )

def test_found_via_names_the_search_that_returned_the_paper(
    self, tmp_path, monkeypatch
):
    """Not the provider's latest search in the session (#128)."""
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    paper = Paper(title="P", authors=["Alice"], year=2024, doi="10.1/s2")
    other = Paper(title="O", authors=["Bob"], year=2024, doi="10.1/m4")
    self._search_into("w45", "round-trip query", "openalex", [paper], 40)
    self._search_into("w45", "differential query", "openalex", [other], 40)

    result = runner.invoke(app, ["prov", "found-via", paper.id])

    assert result.exit_code == 0
    assert (
        "FOUND-VIA: scholar search 'round-trip query' -p openalex "
        "--limit 40"
    ) in result.output
    assert "differential" not in result.output
