def test_options_that_do_not_fit_are_refused(self, tmp_path,
                                             monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  saved = path.read_bytes()
  prompts = self._fake(monkeypatch)
  for args, message in (
    (["--second-screen", "--include-llm-examples"],
     "--include-llm-examples is refused"),
    (["--sample", "s1"], "add --second-screen"),
    (["--over", "machine"], "add --second-screen"),
    (["--rescreen"], "add --second-screen"),
    (["--second-screen", "--over", "machine", "--sample", "s1"],
     "not both"),
    (["--second-screen", "--over", "most"], "Invalid --over"),
    (["--second-screen", "--sample", "s1"], "names no review sample"),
    (["--second-screen"], "needs --over all|machine or --sample ID"),
  ):
    result = self._classify(*args)
    assert result.exit_code == 2, (args, result.output)
    assert message in " ".join(result.output.split()), args
  assert prompts == []
  assert path.read_bytes() == saved

def test_a_dry_run_and_a_withheld_answer_store_nothing(self, tmp_path,
                                                       monkeypatch):
  path = self._make_session(tmp_path, monkeypatch)
  saved = path.read_bytes()
  prompts = self._fake(monkeypatch, bad_index=1)
  result = self._classify("--second-screen", "--over", "all", "--dry-run",
                          "--no-enrich")
  assert result.exit_code == 0, result.output
  assert "Prompt (dry run):" in result.output
  assert prompts == []
  assert path.read_bytes() == saved
  result = self._classify("--second-screen", "--over", "all",
                          "--no-enrich")
  assert result.exit_code == 0, result.output
  flat = " ".join(result.output.split())
  assert "No screening stored, no usable answer (1)" in flat
  assert "Recorded 1 second-screen verdict(s)" in flat
  after = self._saved(path)
  assert "screenings" not in after["10.5555/cs-human"]
  assert len(after["10.5555/cs-machine"]["screenings"]) == 2
