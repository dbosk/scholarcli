def _make_session(self, tmp_path, monkeypatch):
  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  from scholar.review import (
    DecisionStatus, ReviewDecision, ReviewSession, ReviewSource,
    record_human_decision, save_session,
  )

  machine = ReviewDecision(
    paper=Paper(title="Compilers for Beginners", authors=["A"],
                doi="10.5555/cs-machine",
                abstract="We describe a compiler course for beginners."),
    provider="openalex", status=DecisionStatus.DISCARDED,
    tags=["off-topic"], source=ReviewSource.LLM_UNREVIEWED,
    llm_confidence=0.7, llm_model="model-a", llm_reason="About compilers.",
    llm_decided_at="2026-11-01T09:00:00+00:00",
  )
  human = ReviewDecision(
    paper=Paper(title="Recursion Misconceptions", authors=["B"],
                doi="10.5555/cs-human",
                abstract="Most students treated recursion as a loop."),
    provider="openalex", status=DecisionStatus.KEPT, tags=["recursion"],
    source=ReviewSource.HUMAN,
  )
  record_human_decision(human, "tui", by="the author",
                        at="2026-11-01T09:00:00+00:00")
  pending = ReviewDecision(
    paper=Paper(title="Loops in Practice", authors=["C"],
                doi="10.5555/cs-pending", abstract="A study of loops."),
    provider="openalex",
  )
  return save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="second", research_context="Do novices misread recursion?",
    decisions=[machine, human, pending],
  ))

def _fake(self, monkeypatch, bad_index=None):
  import re
  from types import SimpleNamespace
  import scholar.llm_review as llm_review

  class FakeModel:
    model_id = "model-a"
    prompts: list = []

    def prompt(self, prompt):
      FakeModel.prompts.append(prompt)
      indices = sorted({int(i) for i in re.findall(r"\[Paper (\d+)\]",
                                                   prompt)})
      text = json.dumps({"classifications": [
        {"paper_index": i,
         "decision": "maybe" if bad_index in (i, "all") else "kept",
         "tags": ["recursion"], "confidence": 0.8,
         "reasoning": "On recursion."}
        for i in indices
      ]})
      return SimpleNamespace(text=lambda: text)

  FakeModel.prompts = []
  monkeypatch.setattr(llm_review, "llm",
                      SimpleNamespace(get_model=lambda *_: FakeModel()),
                      raising=False)
  return FakeModel.prompts

def _saved(self, path):
  return {d["paper"]["doi"]: d
          for d in json.loads(path.read_text())["decisions"]}

def _classify(self, *args):
  return runner.invoke(app, ["llm", "classify", "second", *args])
