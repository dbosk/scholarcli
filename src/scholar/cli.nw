  _, path = self._make_session(tmp_path, monkeypatch)
  self._content = path.read_bytes()
  reasons = self._file(tmp_path, (
    "10.1/one\tFine.\n"
    "10.1/two no tab here\n"
    "\tNo id.\n"
    "10.1/four\t \n"
    "10.1/one\tWith\ta tab\t0.5\n"
    "10.1/two\tFine.\t1.5\n"
    "10.1/two\tFine.\tsure\n"
    f"10.1/four\t{'y' * 2001}\n"
  ))
  result = self._decide("--keep", "--tag", "ml", "--source", "agent",
                        "--reasons-file", reasons)
  output = " ".join(result.output.split())
  for expected in (
    "line 2: no tab between the id and the reason",
    "line 3: empty id",
    "line 4: empty reason",
    "line 6: confidence 1.5 is not between 0 and 1",
    "line 7: confidence 'sure' is not a number",
    "line 8: reason of 2001 characters",
  ):
    assert expected in output, expected
  self._refused(path, result, 2, "line 5: extra column 4 ('0.5')")
  empty = self._file(tmp_path, "# nothing yet\n\n")
  result = self._decide("--keep", "--tag", "ml", "--source", "agent",
