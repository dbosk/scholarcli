class TestShowDoubtfulAbstracts:
  """`sessions show` marks a doubtful abstract (#287)."""

  REAL = ("Students often treat recursion as a loop. We report an invented "
          "study of 120 novices and describe what helped them.")

  def _make_session(self, tmp_path, monkeypatch):
    from scholar.review import (
      ReviewDecision, ReviewSession, note_fetched_abstract, save_session,
      set_abstract,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))

    def pending(n, abstract):
      return ReviewDecision(
        paper=Paper(title=f"Paper {n}", authors=["A"],
                    doi=f"10.5555/show-doubt-{n}", abstract=abstract),
        provider="openalex",
      )

    decisions = [
      pending(0, "Keywords: recursion; novices; notional machines"),
      pending(1, "Too short."),
      pending(2, None),
      pending(3, self.REAL),
    ]
    note_fetched_abstract(decisions[0], "openalex",
                          "2026-11-20T10:00:00+00:00")
    set_abstract(decisions[2:3], "Too short.", "Crossref",
                 "2026-11-20T10:00:00+00:00")
    save_session(ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
      name="doubts", decisions=decisions,
    ))

  def test_marks_count_and_json(self, tmp_path, monkeypatch):
    import json

    self._make_session(tmp_path, monkeypatch)
    shown = runner.invoke(app, ["sessions", "show", "doubts"])
    assert shown.exit_code == 0, shown.output
    flat = " ".join(shown.output.split())
    assert ("Doubtful abstracts: 2 papers have an abstract that looks like "
            "something other than an abstract (marked below); replace one "
            "with `scholar sessions set-abstract --replace`.") in flat
    assert "(doubtful abstract: keywords line, from openalex)" in flat
    assert "(doubtful abstract: fewer than 100 characters)" in flat
    assert flat.count("doubtful abstract:") == 2
    data = json.loads(runner.invoke(
      app, ["sessions", "show", "doubts", "-f", "json"],
    ).output)
    keyed, short, hand, real = data["decisions"]
    assert keyed["abstract_doubtful"] == "keywords line"
    assert keyed["abstract_fetched_from"] == "openalex"
    assert short["abstract_doubtful"] == "fewer than 100 characters"
    assert "abstract_fetched_from" not in short
    for entry in (hand, real):
      assert "abstract_doubtful" not in entry
      assert "abstract_fetched_from" not in entry

  def test_no_line_without_doubtful_abstracts(self, tmp_path, monkeypatch):
    from scholar.review import ReviewDecision, ReviewSession, save_session

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    save_session(ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
      name="clean", decisions=[ReviewDecision(
        paper=Paper(title="Paper", authors=["A"], doi="10.5555/clean",
                    abstract=self.REAL),
        provider="openalex",
      )],
    ))
    shown = runner.invoke(app, ["sessions", "show", "clean"])
    assert "oubtful abstract" not in shown.output
