<<sessions command>>=
def possible_twins(session, groups: list[list]) -> list[list]:
    """For each group of decisions (one paper), its copies in `session`.

    A copy is the other side of a foldable pair (`foldable_copies`) or
    of a possible copy (`possible_copies`: a DOI-less decision and the
    DOI decisions sharing its `audit_work_key`).
    """
    from scholar.review import (
        audit_work_key, foldable_copies, possible_copies,
    )

    pairs = foldable_copies(session)
    possible = possible_copies(session)
    possible_ids = {id(d) for d in possible}
    result = []
    for group in groups:
        mine = {id(d) for d in group}
        keys = {audit_work_key(d.paper) for d in group}
        others = [b if id(a) in mine else a for a, b in pairs
                  if id(a) in mine or id(b) in mine]
        others += [d for d in possible
                   if id(d) not in mine and audit_work_key(d.paper) in keys]
        if mine & possible_ids:
            others += [d for d in session.decisions
                       if d.paper.doi and id(d) not in mine
                       and audit_work_key(d.paper) in keys]
        result.append(list({id(d): d for d in others}.values()))
    return result
@

