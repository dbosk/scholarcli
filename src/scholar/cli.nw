The text lists every returned work with its place, bucket, year, DOI
and title, and under it one line per session that holds it.  A ranked
list is labelled as one ([[hits_label]], \cref{sec:search-result-error}),
and a failed question says why.

<<session check helpers>>=
def _check_match_text(match: dict) -> str:
    """One session's verdict on a work: name, status, category, how."""
    category = f", {match['category']}" if match["category"] else ""
    return (
        f"{match['session']}: {match['status']}{category} "
        f"({match['matched_by']})"
    )


def check_text_lines(result: dict) -> list[str]:
    """The plain-text listing of one question's check."""
    lines = [f"== Question {result['number']}: {result['question']}"]
    label = hits_label(
        result["returned"], result["error"], result["retries"],
        ranked=True,
    )
    lines.append(
        f"   {result['provider']}: {label}; checked "
        f"{result['check_date']}; {result['source']['label']}"
    )
    if result.get("note"):
        lines.append(f"   note: {result['note']}")
    if result["error"] and not result["returned"]:
        return lines
    lines.append(
        f"   {result['returned']} works: "
        + ", ".join(f"{n} {bucket}" for bucket, n in result["tally"].items())
    )
    for row in result["rows"]:
        lines.append(
            f"{row['rank']:4d}  {row['bucket']:<18}  "
            f"{row['year'] or '':<4}  {row['doi'] or '-':<30}  "
            f"{row['title']}"
        )
        for match in row["matches"]:
            lines.append(f"{'':8}{_check_match_text(match)}")
    lines.append(
        f"   {result['not_in_any_session']} of {result['returned']} "
        f"in no session"
    )
    for known in result["known"]:
        place = (
            f"place {known['rank']}" if known["rank"] else "not returned"
        )
        sessions = "; ".join(
            _check_match_text(m) for m in known["matches"]
        )
        lines.append(
            f"   known {known['known']!r}: {place}, {known['bucket']}"
            + (f" ({sessions})" if sessions else "")
        )
    return lines
