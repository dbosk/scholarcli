                       **kwargs)

def test_an_abstract_is_set_with_its_origin(self, tmp_path, monkeypatch):
  from scholar.review import load_session

  path = self._make_session(tmp_path, monkeypatch)
  text = tmp_path / "abstract.txt"
  text.write_text("﻿We study <i>things</i>\nin  depth.\n",
                  encoding="utf-8")
