class TestSessionsDecideSameIdCopies:
    """`sessions decide` on an id that names several decisions."""

    def _make_session(self, tmp_path, monkeypatch, second, doi=None):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        from scholar.review import (
            DecisionStatus, ReviewDecision, ReviewSession, save_session,
        )
        from scholar.scholar import isolated_registry

        with isolated_registry():
            session = ReviewSession(
                query="q", providers=["mock"],
                timestamp=datetime(2026, 11, 19, 12, 0), name="pair",
            )
            session.decisions = [
                ReviewDecision(
                    paper=Paper(title="A Study", authors=["Ada Lovelace"],
                                year=2014, doi=doi),
                    provider="openalex", status=DecisionStatus.DISCARDED,
                    tags=["off-topic"],
                ),
                ReviewDecision(
                    paper=Paper(title="A Study", authors=["A. Lovelace"],
                                year=2014, doi=doi),
                    provider="scopus", status=second[0], tags=second[1],
                ),
            ]
            save_session(session)
            return session.decisions[0].paper.id

    @staticmethod
    def _states():
        from scholar.review import load_session
        from scholar.scholar import isolated_registry

        with isolated_registry():
            return [(d.status.value, d.tags)
                    for d in load_session("pair").decisions]

    @staticmethod
    def _decide(*args):
        return runner.invoke(app, [
            "sessions", "decide", "pair", "--source", "human", "--keep",
            "--tag", "ml", *args,
        ])

    def test_copies_decided_apart_are_refused(self, tmp_path, monkeypatch):
        from scholar.review import DecisionStatus

        paper_id = self._make_session(
            tmp_path, monkeypatch, (DecisionStatus.KEPT, ["theme"]))
        before = self._states()
        result = self._decide("--paper-id", paper_id)
        assert result.exit_code == 2, result.output
        assert "discarded (openalex) [off-topic]" in result.output
        assert "kept (scopus) [theme]" in result.output
        assert self._states() == before

    def test_all_copies_decides_every_copy(self, tmp_path, monkeypatch):
        from scholar.review import DecisionStatus

        paper_id = self._make_session(
            tmp_path, monkeypatch, (DecisionStatus.KEPT, ["theme"]))
        result = self._decide("--paper-id", paper_id, "--all-copies")
        assert result.exit_code == 0, result.output
        assert "1 paper(s) marked kept (2 decisions)" in result.output
        assert self._states() == [
            ("kept", ["off-topic", "ml"]), ("kept", ["theme", "ml"])]

    def test_copies_that_agree_are_both_decided(self, tmp_path, monkeypatch):
        from scholar.review import DecisionStatus

        paper_id = self._make_session(
            tmp_path, monkeypatch, (DecisionStatus.DISCARDED, ["off-topic"]))
        result = self._decide("--paper-id", paper_id)
        assert result.exit_code == 0, result.output
        assert self._states() == [("kept", ["off-topic", "ml"])] * 2

    def test_a_doi_selects_every_copy(self, tmp_path, monkeypatch):
        from scholar.review import DecisionStatus

        self._make_session(tmp_path, monkeypatch,
                           (DecisionStatus.KEPT, ["theme"]), doi="10.1/pair")
        assert self._decide("--doi", "10.1/PAIR").exit_code == 2
        result = self._decide("--doi", "10.1/PAIR", "--all-copies")
        assert result.exit_code == 0, result.output
        assert self._states() == [
            ("kept", ["off-topic", "ml"]), ("kept", ["theme", "ml"])]
