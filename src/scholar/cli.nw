  def _export(self, tmp_path, *bibs, fmt="table"):
    args = ["sessions", "export", "cit", "-f", fmt, "-o",
            str(tmp_path / "tab")]
    for bib in bibs:
      args += ["--cited-from", str(bib)]
    return runner.invoke(app, args)

