                title="Test Paper",
                authors=["Alice"],
                year=2024,
                doi="10.1234/test",
                abstract="Abstract.",
                sources=["mock"],
            )
        ]
        monkeypatch.setattr(providers, "PROVIDERS", {"mock": mock_provider})

        class DummyResponse:
            def __init__(self, text: str):
                self._text = text

            def text(self) -> str:
                return self._text

        class DummyModel:
            model_id = "dummy"

            def __init__(self):
                self._calls = 0

            def prompt(self, prompt: str):
                self._calls += 1
                if "Papers to Classify" in prompt:
