def test_missing_submodule_is_not_listed(self, monkeypatch):
    """A subcommand whose module cannot be found is left out of help."""
    monkeypatch.setitem(LAZY_SUBCOMMANDS, "nosuchsubmodule", "Never here.")
    result = CliRunner().invoke(app, ["--help"])
    assert result.exit_code == 0
    assert "nosuchsubmodule" not in result.output
    assert "snowball" in result.output

def test_broken_submodule_fails_with_one_line(self, tmp_path, monkeypatch):
    """A module that fails to import gives exit 2 and its reason."""
    (tmp_path / "brokensubmodule.py").write_text(
        'raise ImportError("needs the frobnicate package")\n'
    )
    monkeypatch.syspath_prepend(str(tmp_path))
    monkeypatch.setitem(LAZY_SUBCOMMANDS, "brokensubmodule", "Broken.")
    listed = CliRunner().invoke(app, ["--help"])
    assert "brokensubmodule" in listed.output
    result = CliRunner().invoke(app, ["brokensubmodule", "--help"])
    assert result.exit_code == 2
    assert isinstance(result.exception, SystemExit)
    message = ("brokensubmodule is unavailable: "
               "needs the frobnicate package")
    assert message in result.output

def test_submodule_without_hook_fails_with_one_line(
        self, tmp_path, monkeypatch):
    """A found module lacking register_commands is a usage error too."""
    (tmp_path / "hooklesssubmodule").mkdir()  # a namespace package
    monkeypatch.syspath_prepend(str(tmp_path))
    monkeypatch.setitem(LAZY_SUBCOMMANDS, "hooklesssubmodule", "No hook.")
    result = CliRunner().invoke(app, ["hooklesssubmodule", "--help"])
    assert result.exit_code == 2
    assert isinstance(result.exception, SystemExit)
    assert "has no register_commands" in result.output
