Bounds, bands and census from the command line (\#254).  Contradictory
criteria are usage errors that name the problem and record nothing; an
upper bound and a census are recorded in the criteria; and a stratified
sample is drawn, reviewed with [[sessions decide]] and reported band by
band, with the estimate once every band is reviewed.  The JSON of a
sample drawn without the new options keeps exactly the keys it always
had.

<<test functions>>=
class TestLLMSampleBands:
    <<llm sample bands test methods>>

<<llm sample bands test methods>>=
def _save(self, name, confidences):
    from datetime import datetime
    from scholar import review

    session = review.ReviewSession(
        query=name, providers=["p"], timestamp=datetime(2026, 11, 20),
        name=name,
    )
    session.decisions = [
        review.ReviewDecision(
            paper=Paper(title=f"{name} {i}", authors=["A"],
                        doi=f"10.5555/{name}-{i}"),
            provider="p", status=review.DecisionStatus.DISCARDED,
            tags=["off-topic"], source=review.ReviewSource.LLM_UNREVIEWED,
            llm_confidence=confidence,
        )
        for i, confidence in enumerate(confidences)
    ]
    review.save_session(session)

def test_help_says_the_upper_bound_is_exclusive(self):
    result = runner.invoke(app, ["llm", "sample", "--help"])
    flat = " ".join(result.stdout.split())
    assert "exclusive" in flat and "--bands" in flat and "--census" in flat

def test_contradictory_criteria_are_usage_errors(self):
    from scholar.review import load_session

    self._save("cli-bands-bad", [0.2, 0.6, None])
    cases = [
        (["--no-confidence", "--min-confidence", "0.5"],
         "--no-confidence cannot be combined"),
        (["--bands", "0.5", "--max-confidence", "0.7"],
         "--bands cannot be combined"),
        (["--bands", "0.7,0.5"], "--bands takes cut points"),
        (["--bands", "0.5,x"], "--bands takes cut points"),
        (["--min-confidence", "0.7", "--max-confidence", "0.5"],
         "must be below --max-confidence"),
        (["--census", "-n", "2"], "-n cannot be combined with --census"),
        (["--max-confidence", "1.5"], "--max-confidence must be between"),
    ]
    for options, message in cases:
        result = runner.invoke(app, [
            "llm", "sample", "cli-bands-bad", "--discarded", "-n", "1",
            "--seed", "1", *options,
        ] if "--census" not in options else [
            "llm", "sample", "cli-bands-bad", "--discarded", *options,
        ])
        assert result.exit_code == 2, (options, result.output)
        assert message in " ".join(result.output.split()), options
    assert load_session("cli-bands-bad").llm_samples == []

def test_upper_bound_and_census_are_recorded(self):
    from scholar.review import load_session

    self._save("cli-bands-max", [0.2, 0.6, 0.7, None])
    drawn = runner.invoke(app, [
        "llm", "sample", "cli-bands-max", "--discarded",
        "--max-confidence", "0.7", "-n", "5", "--seed", "1",
    ])
    assert drawn.exit_code == 0, drawn.output
    taken = runner.invoke(app, [
        "llm", "sample", "cli-bands-max", "--discarded", "--no-confidence",
        "--census",
    ])
    assert taken.exit_code == 0, taken.output
    assert "took 1 of 1 eligible decisions" \
        in " ".join(taken.output.split())
    bounded, census = load_session("cli-bands-max").llm_samples
    assert bounded.criteria["max_confidence"] == 0.7
    assert bounded.population == 2
    assert census.criteria["census"] is True and census.seed is None
    assert census.criteria["no_confidence"] is True

