def test_stratified_draw_review_and_report(self):
    from scholar.review import load_session

    self._save("cli-bands", [0.1] * 4 + [0.6] * 2 + [0.9] * 6 + [None])
    drawn = runner.invoke(app, [
        "llm", "sample", "cli-bands", "--discarded", "--bands", "0.5,0.7",
        "-n", "2", "--seed", "11",
    ])
    assert drawn.exit_code == 0, drawn.output
    flat = " ".join(drawn.output.split())
    assert "drew 7 of 13 eligible decisions" in flat
    assert "band below 0.5: 2 of 4" in flat
    assert "band 0.5 to below 0.7: all 2 (census)" in flat
    assert "band without a confidence: all 1 (census)" in flat

    samples = load_session("cli-bands").llm_samples
    low = [p["paper_id"] for p in samples[0].papers]
    others = [p["paper_id"] for s in samples[1:] for p in s.papers]
    for paper_id, flag in [(low[0], "--keep"), (low[1], "--discard")] \
            + [(pid, "--discard") for pid in others]:
        decided = runner.invoke(app, [
            "sessions", "decide", "cli-bands", flag, "--paper-id",
            paper_id, "--tag", "off-topic", "--source", "human",
        ])
        assert decided.exit_code == 0, decided.output

    reported = runner.invoke(
        app, ["llm", "sample", "cli-bands", "--report", "-f", "json"])
    assert reported.exit_code == 0, reported.output
    (report,) = json.loads(reported.output)
    assert report["stratified"] is True
    assert [b["band"] for b in report["bands"]] == [
        "below 0.5", "0.5 to below 0.7", "at least 0.7",
        "without a confidence"]
    assert [(b["population"], b["size"], b["reviewed"], b["changed"],
             b["census"]) for b in report["bands"]] == [
        (4, 2, 2, 1, False), (2, 2, 2, 0, True), (6, 2, 2, 0, False),
        (1, 1, 1, 0, True)]
    assert report["bands"][1]["interval"] is None
    assert report["bands"][0]["interval"] is not None
    estimate = report["estimate"]
    assert estimate["rate"] == pytest.approx(4 * 0.5 / 13)
    assert estimate["changed_not_reviewed"] == pytest.approx(1.0)
    assert estimate["interval"] is None
    assert report["estimate_withheld"] is None

    text = runner.invoke(app, ["llm", "sample", "cli-bands", "--report"])
    flat = " ".join(text.output.split())
    assert "0.5 to below 0.7 2 2 2 0 0.0% all 2 reviewed" in flat
    assert "below 0.5 4 2 2 1 50.0%" in flat
    assert "estimates that 15.4% of all 13 would be changed" in flat

def test_a_lost_pooled_session_withholds_the_estimate(self):
    """The other session's file is gone: its papers are not found."""
    from scholar.review import load_session, session_file_path

    self._save("cli-bands-kept", [0.1, 0.9])
    self._save("cli-bands-gone", [0.1, 0.9])
    drawn = runner.invoke(app, [
        "llm", "sample", "cli-bands-kept", "cli-bands-gone", "--discarded",
        "--bands", "0.5", "-n", "2", "--seed", "5",
