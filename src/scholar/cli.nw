class TestBatchIdsInFiles:
  """A `# batch: ID` line names the batch of the lines after it (#292)."""

  def test_lines_carry_the_batch_before_them(self):
    entries, problems = parse_reasons_file(
      "doi:10.1/a\tBefore any batch.\n"
      "# batch: 1a2b3c4d-001\n"
      "# session: invented.json\n"
      "# records: 2\n"
      "doi:10.1/b\tFirst batch, first line.\n"
      "doi:10.1/c\tFirst batch, second line.\n"
      "#Batch :  sheet \t 2  \n"
      "# batch size: 100\n"
      "doi:10.1/d\tSecond batch.\t0.4\n"
    )
    assert problems == []
    assert [(e.paper, e.batch) for e in entries] == [
      ("doi:10.1/a", None), ("doi:10.1/b", "1a2b3c4d-001"),
      ("doi:10.1/c", "1a2b3c4d-001"), ("doi:10.1/d", "sheet 2"),
    ]

  def test_verdicts_files_carry_it_too(self):
    entries, problems = parse_verdicts_file(
      "# batch: b-7\ndoi:10.1/a\tkept\tt\tOn topic.\n"
    )
    assert problems == []
    assert entries[0].batch == "b-7"

  def test_a_bad_batch_line_is_a_bad_line(self):
    entries, problems = parse_reasons_file(
      "# batch:   \n"
      "doi:10.1/a\tA reason.\n"
      f"# batch: {'x' * 101}\n"
      "doi:10.1/b\tAnother reason.\n"
    )
    assert problems == [
      "line 1: # batch: empty batch id",
      "line 3: # batch: batch id of 101 characters, over the limit of 100",
    ]
    assert [e.batch for e in entries] == [None, None]

  def test_the_batch_option(self):
    plain, _ = parse_reasons_file("doi:10.1/a\tA reason.\n")
    given, problems = lines_with_batch(plain, "b-1", "f.tsv")
    assert problems == [] and given[0].batch == "b-1"
    named, _ = parse_reasons_file(
      "doi:10.1/a\tA reason.\n# batch: b-2\ndoi:10.1/b\tOther.\n")
    kept, problems = lines_with_batch(named, "b-1", "f.tsv")
    assert kept == named
    assert problems == [
      "f.tsv: names its batches (# batch: b-2, before line 3); --batch is "
      "for a file without # batch: lines"
    ]
    assert read_batch_id("  a \n b ") == ("a b", None)
