  self._refused(path, result, 1, "reasons-file line 2: 10.1/nowhere")
  assert "reasons-file line 3: hash:0000" in result.output
  for text in ("10.1/one\tFine.\ndoi:10.1/ONE\tOther.\n",
               "10.1/one\tFine.\n10.1/one\tFine.\t0.3\n"):
    result = self._decide(*keep, "--reasons-file",
                          self._file(tmp_path, text))
    self._refused(path, result, 2, "lines 1 and 2 give doi:10.1/one")
  same = self._file(tmp_path, "10.1/one\tFine.\ndoi:10.1/one\tFine.\n")
  result = self._decide(*keep, "--reasons-file", same)
  assert result.exit_code == 0, result.output
