class TestRelayedVerdictFitsItsDecision:
    def test_a_relayed_contradiction_is_refused(self, tmp_path, monkeypatch):
        from scholar.review import DecisionStatus, load_session

        TestSessionsDecideCommand()._make_session(tmp_path, monkeypatch)
        for args in (["--discard", "--tag", "supports-claim"],
                     ["--discard", "--tag", "qualifies-claim", "-t", "ml"],
                     ["--keep", "--tag", "off-topic-false-hit"]):
            result = runner.invoke(app, [
                "sessions", "decide", "headless", "--source", "llm",
                "--doi", "10.1/withdoi", *args,
            ])
            assert result.exit_code == 2, args
            assert "must fit its decision" in result.output
        assert {d.status for d in load_session("headless").decisions} \
            == {DecisionStatus.PENDING}
        result = runner.invoke(app, [
            "sessions", "decide", "no-such-session", "--source", "llm",
            "--discard", "--doi", "10.1/x", "--tag", "supports-claim",
        ])
        assert result.exit_code == 2

    def test_fitting_verdicts_and_other_sources_are_recorded(
        self, tmp_path, monkeypatch
    ):
        from scholar.review import load_session

        TestSessionsDecideCommand()._make_session(tmp_path, monkeypatch)
        for source, args in (
            ("llm", ["--discard", "--tag", "adjacent-subtopic"]),
            ("llm", ["--keep", "--tag", "adjacent-subtopic"]),
            ("agent", ["--discard", "--tag", "supports-claim"]),
            ("human", ["--discard", "--tag", "qualifies-claim"]),
        ):
            result = runner.invoke(app, [
                "sessions", "decide", "headless", "--source", source,
                "--doi", "10.1/withdoi", *args,
            ])
            assert result.exit_code == 0, (source, result.output)
        decision = load_session("headless").discarded_papers()[0]
        assert decision.tags[-1] == "qualifies-claim"
