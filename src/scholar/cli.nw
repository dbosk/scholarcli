A run is named by what it stored, who and when, and an unnamed agent as
such, since a name is never guessed.  The text says the session-wide
counts before the findings, so that a reader sees how many reasons the
findings are drawn from.

<<sessions command>>=
STORED_RUN_MEANING = (
    "A stored run is one `sessions decide` or `sessions screen` command; "
    "it is not a screener's batch: a batch is split over runs by verdict "
    "and tags, and several batches can be merged into one run."
)
ONE_REASON_RUN_NOTE = (
    "Each such run counts as one record in the session-wide count. A "
    "screener's file with one reason on every line, given to `sessions "
    "decide` or `sessions screen`, is reported there as a shared reason, "
    "and --strict refuses it."
)
FLAT_NOT_JUDGED = (
    "One confidence on every row is not judged from stored runs; it is "
    "judged per stored batch, for rows recorded with a batch id "
    "(`# batch:` or --batch)."
)
BATCH_CONFIDENCE_NOTE = (
    "A -c given to a whole `sessions decide` run is stored on every row "
    "like a confidence of the row's own, so a batch recorded in one run "
    "with -c shows one confidence on every row."
)


def stored_batch_label(stored) -> str:
    """`agent screener-1, batch 5be0c1d2-001 (100 agent decisions)`."""
    who = (f"{stored.kind} {stored.name}" if stored.name
           else f"{stored.kind} (no name)")
    return (f"{who}, batch {stored.batch} ({len(stored.rows)} "
            f"{stored.what})")


def stored_run_label(run) -> str:
    """`agent screener-1, <time> (365 agent decisions)` for a stored run."""
    who = f"{run.kind} {run.name}" if run.name else f"{run.kind} (no name)"
    return (f"{who}, {run.at or 'time not recorded'} "
            f"({len(run.rows)} {run.what})")


def check_batches_lines(check, name: str) -> list[str]:
    """The text of `sessions check-batches`."""
    rows = {what: sum(len(run.rows) for run in check.runs if run.what == what)
            for what in check.shared}
    lines = [
        f"Session '{name}': {rows['agent decisions']} agent reasons and "
        f"{rows['screenings']} screenings in {len(check.runs)} stored "
        "run(s)."
    ]
    for what, findings in check.shared.items():
        if not findings:
            continue
        lines.append(
            f"Reasons shared by records with different titles, across the "
            f"session ({what}): {len(findings)}"
        )
        lines.extend(f"  {line}" for line in batch_finding_lines(findings))
    if not any(check.shared.values()):
        from scholar.review import SHARED_REASON_MIN_RECORDS

        lines.append(
            f"No reason is shared by {SHARED_REASON_MIN_RECORDS} or more "
            "records with different titles."
        )
    noted = [run for run in check.runs if run.findings]
    if noted:
        lines.append("Stored runs with one reason on every row:")
        for run in noted:
            lines.append(f"  {stored_run_label(run)}:")
            lines.extend(
                f"    {line}" for line in batch_finding_lines(run.findings)
            )
        lines.append(ONE_REASON_RUN_NOTE)
    <<list the stored batches>>
    if check.runs:
        lines.extend([STORED_RUN_MEANING, FLAT_NOT_JUDGED])
    return lines


def _finding_data(finding) -> dict:
    return {"kind": finding.kind, "count": finding.count,
            "rows": finding.rows, "papers": list(finding.papers),
            "detail": finding.detail, "information": finding.information}


def check_batches_data(check) -> dict:
    """The JSON of `sessions check-batches`."""
    return {
        "shared_reasons": {
            what: [_finding_data(f) for f in findings]
            for what, findings in check.shared.items()
        },
        "runs": [
            {
                "what": run.what, "kind": run.kind, "name": run.name,
                "at": run.at, "rows": len(run.rows),
                "findings": [_finding_data(f) for f in run.findings],
            }
            for run in check.runs
        ],
        "batches": [
            {
                "what": stored.what, "kind": stored.kind,
                "name": stored.name, "batch": stored.batch,
                "rows": len(stored.rows),
                "findings": [_finding_data(f) for f in stored.findings],
            }
            for stored in check.batches
        ],
        "flat_confidence": "judged per stored batch, not from stored runs",
    }
