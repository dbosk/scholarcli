The abstract services take part in a real run like any database
(\url{https://github.com/dbosk/scholarcli/issues/260}).
In the next test no search provider is configured, so the default order
reaches Crossref and Europe PMC, whose real clients run with empty
caches and with their HTTP requests answered at the session:
Crossref with a record holding an abstract for the first paper and a
failed connection for the second, Europe PMC with \enquote{no record}.
The Crossref check of the same run is the real one too.
So the command must fill the first abstract from Crossref and read the
record once for both the abstract and the currency check, ask Europe
PMC for the second paper only, and count the second paper's Crossref
failure in the tally, by name.

<<test functions>>=
class TestEnrichAbstractServices:
  """`scholar enrich` asks Crossref and Europe PMC for abstracts (#260)."""

  def test_run_fills_counts_and_shares_the_request(
    self, tmp_path, monkeypatch,
  ):
    import requests
    from scholar import crossref, europepmc

    name = TestEnrichSelectionAndSaving._session(tmp_path, monkeypatch, 2)
    monkeypatch.setattr(crossref._client, "_cache", {})
    monkeypatch.setattr(europepmc._client, "_cache", {})
    crossref_urls = []

    def crossref_get(url, **kwargs):
      crossref_urls.append(url)
      if url.endswith("c137-1"):
        raise requests.exceptions.ConnectionError("down")
      response = Mock(status_code=200, headers={})
      response.json.return_value = {"message": {
        "DOI": "10.1/c137-0",
        "abstract": "<jats:p>Found at <jats:italic>Crossref</jats:italic>."
                    "</jats:p>",
      }}
      return response

    def europepmc_get(url, params=None, **kwargs):
      response = Mock(status_code=200, headers={})
      response.json.return_value = {
        "hitCount": 0, "resultList": {"result": []},
      }
      europepmc_queries.append(params["query"])
      return response

    europepmc_queries = []
    with patch("scholar.enrich.get_provider", lambda name: None), \
        patch.object(crossref._client._session, "get", crossref_get), \
        patch.object(europepmc._client._session, "get", europepmc_get):
      result = runner.invoke(app, ["enrich", name, "--fields", "abstract"])
    assert result.exit_code == 0, result.stdout
    out = result.stdout
    saved = TestEnrichSelectionAndSaving._saved(name)
    first = saved["10.1/c137-0"].paper
    assert first.abstract == "Found at Crossref."
    assert "crossref" in first.sources
    assert saved["10.1/c137-1"].paper.abstract is None
    # one record read for the abstract and the currency check of c137-0;
    # c137-1 failed, and the currency check asked again
    assert sum(url.endswith("c137-0") for url in crossref_urls) == 1
    assert europepmc_queries == ['DOI:"10.1/c137-1"']
    assert "Still without an abstract: 1 of 2 papers." in out
    assert "crossref: connection failed (ConnectionError) (1)" in out
    assert "Run again to retry the failed lookups." in out
