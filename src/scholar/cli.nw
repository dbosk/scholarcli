    assert result.exit_code == 0, result.output
    stderr = " ".join(result.stderr.split())
    assert ("sheet.tsv (batch b-1): returned 7 of 10; 3 missing: "
            "doi:10.1/batch-7, doi:10.1/batch-8, doi:10.1/batch-9.") \
      in stderr
    assert ("sheet.tsv (batch b-1): 1 id(s) not on the sheet: "
