def test_terminal_styles_come_from_the_markup(self, tmp_path, monkeypatch):
  self._make_session(tmp_path, monkeypatch)
  result = self._shown(80, FORCE_COLOR="1", TERM="xterm-256color",
                       COLORTERM=None)
  assert result.exit_code == 0, result.output
  dim, magenta, yellow, end = "\x1b[2m", "\x1b[35m", "\x1b[33m", "\x1b[0m"
  assert f"{dim}doi:10.5555/pin-1{end}" in result.output
  assert f"{magenta}(LLM, unreviewed){end}" in result.output
  assert f"{yellow}(quote not in title or abstract){end}" in result.output
  assert f"{dim}(reset from discarded by llm){end}" in result.output
  assert "first-year students in 2019 and" in result.output
  assert f"{dim}[x[bold, plain, a]b[c]{end}" in result.output
  assert "\n  • Ends in a backslash \\ " in result.output
  assert "\x1b[1m  •" not in result.output
  assert "\x1b[8m" not in result.output
  assert "\x1b[1;2m[\x1b[0m\x1b[2ma34825a\x1b[0m\x1b[1;2m]\x1b[0m" \
    in result.output
  assert "\x1b[33m— \x1b[0m\x1b[1;33m1\x1b[0m" in result.output
