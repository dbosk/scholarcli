Let's verify the message against the moves, over the files of an
earlier export with the same seed (whose draw has another id, so its
tier file differs from the new one): a directory where the sheet goes
stops the export before the tier file moves, and a failure to move the
sheet after the tier file was moved puts the earlier tier file back.
Either way the earlier files are as they were, the draw is recorded,
and the message says that the sheet was not written.

<<test functions>>=
class TestRestSampleSheetMoves:
  """A failed move after the draw leaves the earlier sheet (#320)."""

  <<rest sample sheet moves test methods>>

<<rest sample sheet moves test methods>>=
def _earlier_export(self, tmp_path, monkeypatch):
  sheets = TestRestSampleSheet()
  sheets._save(tmp_path, monkeypatch)
  result = sheets._export(tmp_path, "--rest-sample", "3", "--seed", "320")
  assert result.exit_code == 0, result.output
  return sheets

def _files(self, tmp_path):
  return {
    p.name: "dir" if p.is_dir() else p.read_bytes()
    for p in tmp_path.iterdir() if p.name.startswith("rest")
  }

def _check(self, sheets, tmp_path, before, result, rolled_back):
  assert result.exit_code == 1
  assert self._files(tmp_path) == before
  assert not [p for p in tmp_path.iterdir()
              if p.name.startswith(".scholar-")
              and p.name != ".scholar-outputs.lock"]
  first, second = sheets._session().tier_samples
  text = " ".join(result.output.split())
  assert ("None of the exported files was written or changed"
          + ("; the moves were rolled back." if rolled_back else ".")
          ) in text
  assert (f"The draw {second.sample_id} is recorded in the session, but "
          "the screen sheet was not written") in text

def test_a_directory_at_the_sheet(self, tmp_path, monkeypatch):
  sheets = self._earlier_export(tmp_path, monkeypatch)
  (tmp_path / "rest.tsv").unlink()
  (tmp_path / "rest.tsv").mkdir()
  before = self._files(tmp_path)
  result = sheets._export(tmp_path, "--rest-sample", "3", "--seed", "320")
  self._check(sheets, tmp_path, before, result, rolled_back=False)
  assert "rest.tsv is a directory" in " ".join(result.output.split())

def test_a_failed_move_of_the_sheet(self, tmp_path, monkeypatch):
  import os
  from scholar.utils import STAGING_PREFIX

  sheets = self._earlier_export(tmp_path, monkeypatch)
  before = self._files(tmp_path)
  real_replace = os.replace

  def failing_move(source, target, *args, **kwargs):
    if STAGING_PREFIX in str(source) and Path(target).name == "rest.tsv":
      raise OSError(28, "No space left on device")
    return real_replace(source, target, *args, **kwargs)

  monkeypatch.setattr(os, "replace", failing_move)
  result = sheets._export(tmp_path, "--rest-sample", "3", "--seed", "320")
  self._check(sheets, tmp_path, before, result, rolled_back=True)
