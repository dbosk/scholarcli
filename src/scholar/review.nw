def load_own_session(name: str | None, query: str) -> ReviewSession | None:
    """Load the session file a session `name` (or `query`) is saved to.

    Unlike `load_session`, the name is never tried as a query nor the
    query as a name. When the file that lookup would also have tried
    exists, one log line names it and how to continue it.

    Returns None when the file does not exist.

    Raises:
        SessionFileError: The file exists but cannot be read.
    """
    sessions_dir = _get_sessions_dir()
    own = sessions_dir / own_session_file_name(name, query)
    <<point at the session file the append does not load>>
    if not own.exists():
        logger.debug("Session not found: %s", own.name)
        return None
    return read_session_file(own)
