class TestAppendKeepsStoredPaper:
    """A re-run adds to the stored paper, never replaces it (#192)."""

    DOI = "10.1109/ipdps.2014.73"

    def _save_first_run(self, paper):
        from scholar.scholar import isolated_registry
        with isolated_registry():
            session = ReviewSession(
                query="q1", providers=["openalex"],
                timestamp=datetime.now(), name="append-192",
            )
            session.decisions = [ReviewDecision(
                paper=paper, provider="openalex",
                status=DecisionStatus.DISCARDED, tags=["off-topic"],
                source=ReviewSource.HUMAN,
            )]
            save_session(session)

    def _rerun(self, returned):
        from scholar.scholar import SearchResult, isolated_registry
        result = SearchResult(
            query="a AND b", provider="s2", timestamp=datetime.now(),
            papers=[returned], limit=10,
        )
        with isolated_registry():
            session = create_review_session([result], "a AND b",
                                            "append-192")
            save_session(session)
        with isolated_registry():
            return load_session("append-192").decisions

    def test_s2_copy_keeps_abstract_and_sources(self):
        self._save_first_run(Paper(
            title="A Study", authors=["Ada Lovelace"], year=2014,
            doi=self.DOI, abstract="x" * 1141, sources=["openalex"],
            keywords=["hpc"], pdf_url="https://example.org/a.pdf",
            updated_by=[],
        ))
        decisions = self._rerun(Paper(
            title="A Study", authors=["Ada Lovelace"], year=2014,
            doi=self.DOI, abstract=None, sources=["s2"],
            citation_count=7,
