def test_a_namesake_pair_is_refused_naming_both(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    named = self._save("foo", "bar")
    unnamed = self._save(None, "foo")
    with pytest.raises(AmbiguousSessionError) as caught:
        resolve_session_argument("foo")
    message = str(caught.value)
    assert f"foo.json (session 'foo')" in message
    assert f"{unnamed.name} (unnamed session of query 'foo')" in message
    assert f"foo.json or {unnamed.name}" in message
    assert caught.value.paths == [named, unnamed]
    with pytest.raises(AmbiguousSessionError):
        load_session_argument("foo")

def test_file_names_pick_each(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    named = self._save("foo", "bar")
    unnamed = self._save(None, "foo")
    assert resolve_session_argument("foo.json") == named
    assert resolve_session_argument(unnamed.name) == unnamed
    with pytest.raises(SessionArgumentError, match="give a file name in"):
        resolve_session_argument("../elsewhere/foo.json")
