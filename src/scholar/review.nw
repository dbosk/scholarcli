class TestCheckBucketsAcrossSessions:
  """The most relevant bucket wins; a cited keep is bearing."""

  def _session(self, name, status, tags, source=ReviewSource.HUMAN):
    session = ReviewSession(query=name, providers=["openalex"],
                            timestamp=datetime.now(), name=name)
    session.decisions = [ReviewDecision(
      paper=Paper(title="Shared work", authors=["Ann Smith"],
                  doi="10.1/shared"),
      provider="openalex", status=status, tags=tags, source=source,
    )]
    return session

  def _bucket(self, *sessions):
    rows, _ = check_against_sessions(
      [Paper(title="Shared work", authors=["Ann Smith"],
             doi="10.1/shared")],
      list(sessions),
    )
    return rows[0].bucket

  def test_cited_keep_beats_a_discard(self):
    assert self._bucket(
      self._session("a", DecisionStatus.KEPT, ["usability"]),
      self._session("b", DecisionStatus.DISCARDED,
                    ["off-topic-false-hit"]),
    ) == "bearing"

  def test_pending_beats_a_discard(self):
    assert self._bucket(
      self._session("a", DecisionStatus.PENDING, []),
      self._session("b", DecisionStatus.DISCARDED, ["recorded-not-cited"]),
    ) == "unclassified"

  def test_llm_keep_without_category_is_unclassified(self):
    assert self._bucket(self._session(
      "a", DecisionStatus.KEPT, ["usability"],
      source=ReviewSource.LLM_UNREVIEWED,
    )) == "unclassified"
