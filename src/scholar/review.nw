class TestBuiltBaselineRecordKeys:
    """A session saved into a file it did not load keeps its records."""

    @staticmethod
    def _other_record(name, query="foo"):
        """Another process saves a record of (foo, openalex) first.

        Its filters give it a key of its own: a record of the same key
        would replace ours by rank, whatever the baseline.
        """
        other = ReviewSession(
            query=query, providers=["openalex"],
            timestamp=datetime(2026, 11, 19), name=name,
        )
        other.add_query_provider_pair(
            "foo", "openalex", {"year": "2020"}, 100, hits=1
        )
        return save_session(other)

    @staticmethod
    def _records(path):
        return {
            (r["query"], r["provider"], r["limit"])
            for r in json.loads(path.read_text())["search_records"]
        }

    def _legacy_result(self):
        return TestAppendBaselineFollowsTheFile._result(
            "foo", [Paper(title="New", authors=["B"],
                          doi="10.5555/wp207-legacy")],
        )

    def test_a_new_session_keeps_its_legacy_record(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        session = create_review_session(
            [self._legacy_result()], "foo", "fresh"
        )
        assert session.search_records[0].is_legacy
        path = self._other_record("fresh")

        assert save_session(session) == path
        assert self._records(path) == {
            ("foo", "openalex", None), ("foo", "openalex", 100),
        }

    def test_an_append_into_another_file_keeps_its_legacy_record(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        save_session(ReviewSession(
            query="bar", providers=["openalex"],
            timestamp=datetime(2026, 11, 19), name="foo",
        ))
        session = create_review_session([self._legacy_result()], "foo")
        path = self._other_record(None)

        assert save_session(session) == path
        assert ("foo", "openalex", None) in self._records(path)
