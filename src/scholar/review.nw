        )
        assert label == "supports the claim (0.93)"
        assert order == 1
        assert self._reason(DecisionStatus.KEPT, ["qualifies-claim"]) \
            == ("qualifies or contradicts the claim", 2)
        assert self._reason(DecisionStatus.DISCARDED, ["adjacent-subtopic"]) \
            == ("adjacent subtopic", 3)
        assert self._reason(
            DecisionStatus.DISCARDED, ["off-topic-false-hit"]
        ) == ("other topic (false hit)", 4)

    def test_confirmed_llm_decision_keeps_confidence(self):
        label, _ = self._reason(
            DecisionStatus.KEPT, ["supports-claim"],
            source=ReviewSource.LLM_REVIEWED, conf=0.93,
        )
        assert label == "supports the claim (0.93)"

