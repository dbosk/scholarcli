@staticmethod
@contextlib.contextmanager
def _notes_lock_held_elsewhere():
  """Hold the notes file's lock in another process during the block."""
  import subprocess
  import sys
  from scholar.notes import NOTES_FILE, get_data_dir
  from scholar.utils import lock_path

  holder = subprocess.Popen(
    [sys.executable, "-c",
     "import sys\n"
     "from filelock import FileLock\n"
     "lock = FileLock(sys.argv[1])\n"
     "lock.acquire()\n"
     "print('held', flush=True)\n"
     "sys.stdin.read()\n",
     str(lock_path(get_data_dir() / NOTES_FILE))],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
  )
  try:
    assert holder.stdout.readline().strip() == "held"
    yield
  finally:
    holder.stdin.close()
    holder.wait(10)

def test_reconcile_moves_a_note_the_lock_kept_back(self, monkeypatch,
                                                    caplog):
  import scholar.notes as notes
  from scholar import SearchResult
  from scholar.notes import get_note, save_note
  from scholar.scholar import isolated_registry

  monkeypatch.setattr(notes, "NOTES_LOCK_TIMEOUT", 0.3)
  save_session(ReviewSession(
    query="q", providers=["dblp"], timestamp=datetime(2026, 11, 23),
    name="note-race", decisions=[ReviewDecision(
      paper=self.OLD, provider="dblp")],
  ))
  save_note(self.OLD, "Read the numbered copy.")
  with self._notes_lock_held_elsewhere():
    with isolated_registry():
      save_session(create_review_session([SearchResult(
        query="q", provider="dblp", timestamp="t", papers=[self.NEW])],
        "q", "note-race"))
  assert "scholar sessions reconcile" in caplog.text
  notes.invalidate_notes_cache()
  assert get_note(self.OLD).note == "Read the numbered copy."
  assert get_note(self.NEW) is None
  reconcile_session("note-race")
  notes.invalidate_notes_cache()
  assert get_note(self.NEW).note == "Read the numbered copy."
  assert get_note(self.OLD) is None
