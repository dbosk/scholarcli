AUDIT_VERSION_NOTES: frozenset[str] = frozenset({
    "duplicate-record-of-cited-source",
    "duplicate-reprint-of-cited-source",
    "extended-tech-report",
    "earlier-version-of-cited-source",
    "superseded-by-journal-version",
    "thesis-of-cited-source",
    "erratum-to-cited-source",
})


def audit_exclusion_criterion(
    decision: ReviewDecision,
    *,
    theme_names: dict[str, str],
    notes: dict[str, str],
) -> str | None:
    """Return the exclusion-criterion tag a discard was made under.

    That is the last tag of a discarded decision that has neither an
    audit category nor a note tag, unless it is one of `theme_names`
    (tags accumulate, so the last is the reviewer's latest).
    """
    tags = decision.tags
    if decision.status != DecisionStatus.DISCARDED:
        return None
    if audit_category(tags) is not None or any(t in notes for t in tags):
        return None
    return next((t for t in reversed(tags) if t not in theme_names), None)


def audit_version_note(decision: ReviewDecision) -> bool:
    """Tell whether `decision` is noted as another version of a source."""
    return any(t in AUDIT_VERSION_NOTES for t in decision.tags)
