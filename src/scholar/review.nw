def test_list_sessions_flags_records_without_decisions(tmp_path, monkeypatch):
    """needs_check marks searched sessions with no decisions or context."""
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))

    def make(name, *, decided=False, context=None, searched=True):
        session = ReviewSession(
            query="q", providers=["openalex"], timestamp=datetime.now(),
            name=name, research_context=context,
        )
        if searched:
            session.add_query_provider_pair("q", "openalex")
        session.decisions = [ReviewDecision(
            paper=Paper(title=name, authors=["A"], doi=f"10.1/wp1-{name}"),
            provider="openalex",
            status=DecisionStatus.KEPT if decided else DecisionStatus.PENDING,
        )]
        save_session(session)

    make("reset")
    make("decided", decided=True)
    make("context", context="Why?")
    make("unsearched", searched=False)
    flags = {s["name"]: s["needs_check"] for s in list_sessions()}
    assert flags == {
        "reset": True, "decided": False, "context": False,
        "unsearched": False,
    }
