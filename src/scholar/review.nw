    def test_list_valued_venue_is_joined(self):
        paper = Paper(title="T", authors=["A"], year=2020,
                      venue=["IIH-MSP", "Smart Innovation"])
        entry = format_bibtex_entry(paper, "a2020")
        assert "  journal = {IIH-MSP; Smart Innovation}," in entry

    def test_build_report_bibtex_joins_entries(self):
