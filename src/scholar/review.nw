def test_the_thresholds(self):
  def kinds(rows, **options):
    return [f.kind for f in batch_findings(rows, **options)]

  shared = lambda n: (lambda i: "One reason." if i % 2 == 0 and i < 2 * n
                      else f"Reason {i} about record {i}.")
  for size in (20, 4000):
    assert kinds(batch_rows(size, reason=shared(9))) == []
    assert kinds(batch_rows(size, reason=shared(10))) == ["shared-reason"]
  assert kinds(batch_rows(19, confidence=lambda i: 0.9)) == []
  assert kinds(batch_rows(20, confidence=lambda i: 0.9)) == [
    "flat-confidence",
  ]
