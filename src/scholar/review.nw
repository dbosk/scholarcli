NONLATIN_SEP_MACRO = r"\scholarnonlatinsep"
NONLATIN_SEP = NONLATIN_SEP_MACRO + "{}"


def _touches_text(
    pieces: list[tuple[str, str, list[bool]]], index: int, position: int
) -> bool:
    """Whether `pieces[index]` is plain text with a letter or digit at
    `position` (0 or -1), next to the run beside it."""
    if not 0 <= index < len(pieces):
        return False
    kind, piece, _ = pieces[index]
    return kind == PLAIN_TEXT and piece[position].isalnum()
