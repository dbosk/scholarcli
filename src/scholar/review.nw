def _stored_run_rows(session) -> dict[tuple, list[BatchRow]]:
    groups: dict[tuple, list[BatchRow]] = {}
    for decision in session.decisions:
        paper = decision.paper
        if decision.agent_reason:
            groups.setdefault(
                ("agent decisions", "agent", decision.agent_by,
                 decision.agent_decided_at), [],
            ).append(BatchRow(
                paper=paper.id, title=paper.title,
                reason=decision.agent_reason,
                confidence=decision.llm_confidence,
                status=decision.status.value, tags=tuple(decision.tags),
                batch=decision.agent_batch,
            ))
        for screening in decision.screenings:
            if (not isinstance(screening, dict)
                    or screening.get("origin") != "screen"):
                continue
            groups.setdefault(
                ("screenings", screening.get("kind"), screening.get("name"),
                 screening.get("recorded_at")), [],
            ).append(BatchRow(
                paper=paper.id, title=paper.title,
                reason=screening.get("reason"),
                confidence=screening.get("confidence"),
                status=screening.get("status"),
                tags=tuple(screening.get("tags") or ()),
                batch=screening.get("batch"),
            ))
    return groups
