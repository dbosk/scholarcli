The confidence sentence follows the rows that show a confidence: the
model's for LLM rows, the agent's for agent rows, one sentence for
both, and none when no listed row shows one.  A confirmed row counts
by its machine origin, and a row without a recorded number counts by
its placeholder.  The [[--bearing-only]] caption judges only the rows
it lists.

<<test functions>>=
class TestAuditConfidenceSentence:
  RECORDS = [SearchRecord("q", "openalex", hits=2)]
  LLM = "; for machine-classified rows the model's confidence is given. "
  AGENT = "; for rows decided by an agent the agent's confidence is given. "
  BOTH = ("; for machine-classified rows the model's confidence is "
          "given, and for rows decided by an agent the agent's. ")

  def _row(self, source, conf=0.8, tags=("supports-claim",),
           status=DecisionStatus.KEPT, title=None):
    return _caption_decision(title or source.value, status, list(tags),
                             source=source, conf=conf)

  def _caption(self, *decisions, **options):
    return _caption(
      _caption_session(*decisions, records=self.RECORDS), **options
    )

  def test_llm_rows_keep_the_model_sentence(self):
    caption = self._caption(self._row(ReviewSource.LLM_UNREVIEWED))
    assert "inclusion or exclusion" + self.LLM + "Databases" in caption

  def test_agent_rows_name_the_agent(self):
    caption = self._caption(self._row(ReviewSource.AGENT_UNREVIEWED))
    assert "inclusion or exclusion" + self.AGENT + "Databases" in caption
    assert "model" not in caption
    sv = _caption(_caption_session(
      self._row(ReviewSource.AGENT_UNREVIEWED), records=self.RECORDS
    ), lang="sv")
    assert "kolumnen; för rader som en agent beslutat om anges " \
      "agentens konfidens. Sökta databaser" in sv

  def test_both_get_one_sentence(self):
    caption = self._caption(
      self._row(ReviewSource.LLM_UNREVIEWED, title="Model"),
      self._row(ReviewSource.AGENT_UNREVIEWED, title="Agent"),
    )
    assert "inclusion or exclusion" + self.BOTH + "Databases" in caption
    sv = _caption(_caption_session(
      self._row(ReviewSource.LLM_UNREVIEWED, title="Model"),
      self._row(ReviewSource.AGENT_UNREVIEWED, title="Agent"),
      records=self.RECORDS,
    ), lang="sv")
    assert "kolumnen; för rader som en modell klassat anges modellens " \
      "konfidens och för rader som en agent beslutat om agentens. " in sv

  def test_no_confidence_no_sentence(self):
    caption = self._caption(
      self._row(ReviewSource.HUMAN, conf=None, tags=["ml"])
    )
    assert "inclusion or exclusion. Databases searched:" in caption
    assert "confidence" not in caption
    sv = _caption(_caption_session(
      self._row(ReviewSource.HUMAN, conf=None, tags=["ml"]),
      records=self.RECORDS,
    ), lang="sv")
    assert "står i sista kolumnen. Sökta databaser:" in sv

  def test_confirmed_rows_count_by_their_machine_origin(self):
    assert self.AGENT in self._caption(
      self._row(ReviewSource.AGENT_REVIEWED)
    )
    assert self.LLM in self._caption(self._row(ReviewSource.LLM_REVIEWED))

  def test_the_placeholder_counts_too(self):
    session = _caption_session(
      self._row(ReviewSource.AGENT_UNREVIEWED, conf=None),
      records=self.RECORDS,
    )
    text = "\n".join(build_audit_table_latex(session, label="x"))
    assert "& supports the claim (n/a) \\\\" in text
    assert self.AGENT in _caption(session)

  def test_bearing_only_judges_the_listed_rows(self):
    hidden = self._row(ReviewSource.LLM_UNREVIEWED, title="Hidden",
                       tags=["off-topic-false-hit"],
                       status=DecisionStatus.DISCARDED)
    caption = self._caption(
      self._row(ReviewSource.AGENT_UNREVIEWED, title="Listed"), hidden,
      bearing_only=True,
    )
    assert "reason for each inclusion" + self.AGENT + "Databases" \
      in caption
    caption = self._caption(
      self._row(ReviewSource.HUMAN, conf=None, tags=["ml"]), hidden,
      bearing_only=True,
    )
    assert "reason for each inclusion. Databases searched:" in caption
