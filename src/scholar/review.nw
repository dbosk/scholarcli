def test_malformed_entries_survive_with_one_warning(
  self, tmp_path, monkeypatch, caplog,
):
  import json
  import logging

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  path = save_session(self._session("screen-bad"))
  data = json.loads(path.read_text())
  data["decisions"][0]["screenings"] = [{"status": "kept"}, "a note"]
  path.write_text(json.dumps(data))
  with caplog.at_level(logging.WARNING, logger="scholar.review"):
    session = self._load_apart("screen-bad")
