@contextmanager
def paused_garbage_collection() -> Iterator[None]:
    """Hold off the cyclic garbage collector, then restore its state."""
    was_enabled = gc.isenabled()
    gc.disable()
    try:
        yield
    finally:
        if was_enabled:
            gc.enable()
