before_fold = [
    (get_paper_id(d.paper), d.paper.abstract, d.abstract_set)
    for d in (survivor, absorbed)
]
survivor.paper = merge_version_of(with_doi.paper, bare.paper)
survivor.abstract_set = abstract_records_after_fold(survivor.paper, before_fold)
survivor.abstract_lookup = with_doi.abstract_lookup
for record in absorbed.abstract_fetched:
    survivor.add_fetched_abstract(record)
for link in absorbed.found_by:
    survivor.record_link(link)
for copy in absorbed.same_id_copies:
    survivor.add_same_id_copy(copy)
unite_screenings(survivor, absorbed.screenings)
survivor.provider = united_providers(survivor.provider, absorbed.provider)
for name, value in human_record_of(
    newer_human_record(survivor, absorbed)
).items():
    setattr(survivor, name, value)
