for group in PAPER_FIELD_GROUPS:
    mine = {name: getattr(ours, name) for name in group}
    their = {name: getattr(theirs, name) for name in group}
    loaded = tuple(base[name] for name in group) if base else None
    unchanged_here = loaded == frozen_value(tuple(mine.values()))
    if (unchanged_here and their[group[0]] is not None
            and frozen_value(tuple(their.values())) != loaded):
        changed_there.update(their)
    elif mine[group[0]] is not None or (base and not unchanged_here):
        ours_whole.update(mine)
