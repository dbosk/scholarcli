class TestRecordDates:
    """Search records keep their dates through a save (#167)."""

    def test_round_trip_and_old_records(self):
        import json
        from scholar.review import _get_sessions_dir
        from scholar.scholar import SearchResult
        result = SearchResult(
            query="q", provider="openalex", timestamp="t", papers=[],
            limit=5, searched_at="2026-11-18T09:00:00+00:00",
            fetched_at="2026-10-02T08:00:00+00:00", from_cache=True,
        )
        save_session(create_review_session([result], "q",
                                           session_name="dated"))
        record = load_session("dated").search_records[0]
        assert (record.searched_at, record.fetched_at, record.from_cache) \
            == ("2026-11-18T09:00:00+00:00", "2026-10-02T08:00:00+00:00",
                True)
        path = _get_sessions_dir() / "dated.json"
        data = json.loads(path.read_text())
        for rec in data["search_records"]:
            for field_name in ("searched_at", "fetched_at", "from_cache"):
                del rec[field_name]
        path.write_text(json.dumps(data))
        record = load_session("dated").search_records[0]
        assert (record.searched_at, record.fetched_at, record.from_cache) \
            == (None, None, None)
        assert search_dates_label(record) == ""
