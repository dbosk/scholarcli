def reference_pair_with_file(session, on_disk):
  """The pairing before #316, kept as a reference: do not change."""
  base = session._baseline
  base_states = base.decisions if base else {}
  base_ids = base.decision_ids if base else {}
  ours_by_id = {}
  for decision in session.decisions:
    ours_by_id.setdefault(get_paper_id(decision.paper), []).append(decision)
  disk_by_id = {}
  for theirs in on_disk.decisions:
    disk_by_id.setdefault(get_paper_id(theirs.paper), []).append(theirs)
  paired = {}
  additions = []
  for paper_id, copies in disk_by_id.items():
    ours = ours_by_id.get(paper_id, [])
    free = list(copies)
    for decision in ours:
      key = base_key_of(decision, base)
      if decision.baseline_key != key or key not in base_states:
        continue
      same = [i for i, theirs in enumerate(free)
              if decision_state(theirs) == base_states[key]]
      if same:
        best = min(same, key=lambda i: (
          set(free[i].found_by) != set(decision.found_by),
          free[i].provider != decision.provider,
          i,
        ))
        paired[id(decision)] = free.pop(best)
    rest = [d for d in ours if id(d) not in paired]
    for decision, theirs in zip(rest, free):
      paired[id(decision)] = theirs
    free = free[len(rest):]
    carried = {base_key_of(d, base) for d in ours}
    gone = [key for key, i in base_ids.items()
            if i == paper_id and key not in carried]
    unmatched = []
    for theirs in free:
      match = [key for key in gone
               if base_states[key] == decision_state(theirs)]
      if match:
        gone.remove(match[0])
      else:
        unmatched.append(theirs)
    additions.extend(unmatched[len(gone):])
  return paired, additions


def pairing_by_identity(pairing):
  """A pairing's pairs and additions, by the identity of the decisions."""
  paired, additions = pairing
  return ({ours: id(theirs) for ours, theirs in paired.items()},
          [id(theirs) for theirs in additions])


def assert_pairing_matches_reference(session, on_disk):
  """Pair with both and compare; return the new pairing."""
  pairing = pair_with_file(session, on_disk)
  assert pairing_by_identity(pairing) == pairing_by_identity(
    reference_pair_with_file(session, on_disk))
  return pairing


