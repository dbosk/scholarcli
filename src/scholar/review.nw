class TestAgentSourcePersistence:
    def _session(self, sources):
        session = ReviewSession(
            query="q", providers=["p"], timestamp=datetime(2026, 11, 18),
            name="agent-src",
        )
        session.decisions = [
            ReviewDecision(
                paper=Paper(title=f"Paper {i}", authors=["A"], year=2024,
                            doi=f"10.1/agent-src-{i}"),
                provider="p", status=DecisionStatus.KEPT, source=source,
                llm_confidence=0.6 if source.is_machine else None,
            )
            for i, source in enumerate(sources)
        ]
        return session

    def test_round_trip(self, tmp_path, monkeypatch):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        sources = list(ReviewSource)
        save_session(self._session(sources))
        loaded = load_session("agent-src")
        assert [d.source for d in loaded.decisions] == sources
        assert loaded.llm_review_statistics()["agent_unreviewed"] == 1
        assert loaded.llm_review_statistics()["agent_reviewed"] == 1

    def test_old_session_file_loads_unchanged(self, tmp_path, monkeypatch):
        import json

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        path = save_session(self._session([
            ReviewSource.HUMAN, ReviewSource.LLM_UNREVIEWED,
            ReviewSource.LLM_REVIEWED, ReviewSource.HUMAN,
        ]))
        data = json.loads(path.read_text())
        del data["decisions"][3]["source"]
        path.write_text(json.dumps(data))
        loaded = load_session("agent-src")
        assert [d.source for d in loaded.decisions] == [
            ReviewSource.HUMAN, ReviewSource.LLM_UNREVIEWED,
            ReviewSource.LLM_REVIEWED, ReviewSource.HUMAN,
        ]

    def test_concurrent_save_keeps_a_confirmation(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        save_session(self._session([ReviewSource.AGENT_UNREVIEWED]))
        enrich = load_session("agent-src")
        review_ = load_session("agent-src")
        review_.decisions[0].source = ReviewSource.AGENT_REVIEWED
        save_session(review_)
        enrich.decisions[0].paper.abstract = "Enriched."
        save_session(enrich)
        assert load_session("agent-src").decisions[0].source \
            is ReviewSource.AGENT_REVIEWED
