    withheld = (DecisionStatus.PENDING, [])
    bare, with_doi = self._two_copies(withheld, (DecisionStatus.KEPT, ["ml"]))
    session = load_session("copies")
    bare_decision = next(d for d in session.decisions if not d.paper.doi)
    bare_decision.source = ReviewSource.AGENT_UNREVIEWED
    assert reconcile_copies(session) == []
    bare_decision.source = ReviewSource.HUMAN
    bare_decision.llm_reason = "no usable answer"
    assert reconcile_copies(session) == []
    bare_decision.source = ReviewSource.LLM_UNREVIEWED
    for decision in session.decisions:
      decision.status, decision.tags = DecisionStatus.KEPT, ["ml"]
    assert reconcile_copies(session) == []
    [alike] = alike_copies(session)
    assert copy_conflict_line(alike) == (
      f"A Work: {bare.id} kept by llm (dblp) [ml], doi:10.1145/race kept "
      "(openalex) [ml]"
    )
    assert [d.source for d in session.decisions] \
      == [ReviewSource.LLM_UNREVIEWED, ReviewSource.HUMAN]

  def test_a_work_key_match_without_a_pair_is_a_possible_copy(self):
    bare = Paper(title="A Work.", authors=["Ada Lovelace"], year=2021)
    with_doi = Paper(title="A work", authors=["Ada Lovelace"], year=2021,
                     doi="10.1145/key")
    session = create_review_session(
      [self._result("dblp", [bare]), self._result("openalex", [with_doi])],
      "q",
    )
    assert len(session.decisions) == 2
    assert [d.paper.id for d in possible_copies(session)] == [bare.id]

  def test_old_sessions_load_without_copy_notes(self):
    import json
    from scholar.review import _get_sessions_dir
    a = Paper(title="Editorial", authors=["J. Smith"], year=2018)
    b = Paper(title="Editorial", authors=["J. Smith"], year=2023)
    save_session(create_review_session(
      [self._result("dblp", [a]), self._result("hal", [b])], "q",
      session_name="copies",
    ))
    path = _get_sessions_dir() / "copies.json"
    data = json.loads(path.read_text())
    assert data["decisions"][0]["same_id_copies"] == [
      {"year": 2023, "venue": None, "provider": "hal"},
    ]
    del data["decisions"][0]["same_id_copies"]
    path.write_text(json.dumps(data))
    session = load_session("copies")
    assert session.decisions[0].same_id_copies == []
    assert conflicting_copies(session) == []
    assert session.folded == {}
    assert "folded" not in data
