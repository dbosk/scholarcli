class TestPreferredRecord:
    """The one order of two records of a search."""

    @staticmethod
    def _r(limit=100, hits=None, error=None, searched_at=None, **kw):
        return SearchRecord("q", "p", None, limit, hits=hits, error=error,
                            searched_at=searched_at, **kw)

    def test_order(self):
        answer = self._r(hits=12)
        failed = self._r(hits=0, error="HTTP 503")
        assert preferred_record(failed, answer) is answer
        assert preferred_record(answer, failed) is answer
        wide = self._r(limit=10_000, hits=50)
        narrow = self._r(limit=5, hits=5)
        assert preferred_record(narrow, wide) is wide
        assert preferred_record(wide, narrow) is wide
        partial = self._r(hits=20, error="cut short")
        assert preferred_record(answer, partial) is partial
        assert preferred_record(partial, self._r(hits=30)).hits == 30
        old = self._r(hits=3, searched_at="2026-10-01T00:00:00+00:00")
        new = self._r(hits=3, searched_at="2026-11-01T00:00:00+00:00")
        assert preferred_record(old, new) is new
        assert preferred_record(new, old) is new
        tie, same = self._r(hits=1), self._r(hits=1)
        assert preferred_record(tie, same) is tie
        assert preferred_record(same, tie) is same

    def test_dated_beats_undated_in_both_orders(self):
        undated = self._r(hits=5)
        dated = self._r(hits=5, searched_at="2026-11-18T09:00:00+00:00")
        assert preferred_record(undated, dated) is dated
        assert preferred_record(dated, undated) is dated

    def test_former_cycle_is_ordered(self):
        ten = self._r(hits=10, searched_at="2026-11-18T00:00:00+00:00")
        twenty = self._r(hits=20, error="cut short",
                         searched_at="2026-11-10T00:00:00+00:00")
        thirty = self._r(hits=30, searched_at="2026-11-01T00:00:00+00:00")
        for a, b in [(ten, twenty), (twenty, thirty), (thirty, ten)]:
            assert preferred_record(a, b) is preferred_record(b, a)
        import functools
        import itertools
        winners = {
            id(functools.reduce(preferred_record, order))
            for order in itertools.permutations([ten, twenty, thirty])
        }
        assert winners == {id(ten)}

    def test_newer_complete_answer_beats_older_with_more_hits(self):
        older = self._r(hits=30, searched_at="2026-11-01T00:00:00+00:00")
        newer = self._r(hits=10, searched_at="2026-11-18T00:00:00+00:00")
        assert preferred_record(older, newer) is newer
        assert preferred_record(newer, older) is newer
        partial = self._r(hits=3, error="cut short",
                          searched_at="2026-11-18T00:00:00+00:00")
        assert preferred_record(older, partial) is partial

    def test_symmetric_and_transitive_on_a_generated_set(self):
        import itertools
        records = [
            self._r(limit=limit, hits=hits, error=error, searched_at=when)
            for limit in (5, 100, None)
            for hits, error in ((None, None), (0, None), (0, "HTTP 503"),
                                (5, None), (5, "cut"), (20, "cut"))
            for when in (None, "2026-10-01T00:00:00+00:00",
                         "2026-11-01T00:00:00+00:00")
        ] + [SearchRecord("q", "p", hits=None)]
        for a, b in itertools.product(records, repeat=2):
            if record_rank(a) != record_rank(b):
                assert preferred_record(a, b) is preferred_record(b, a)
        for a, b, c in itertools.product(records[::3], repeat=3):
            if (preferred_record(a, b) is a
                    and preferred_record(b, c) is b):
                assert record_rank(a) >= record_rank(c)

    def test_legacy_limit_is_unknown(self):
        legacy = SearchRecord("q", "p", hits=None)
        current = self._r(limit=5, hits=5)
        assert preferred_record(current, legacy) is current
        failed = self._r(limit=5, hits=0, error="HTTP 503")
        assert preferred_record(failed, legacy) is legacy
