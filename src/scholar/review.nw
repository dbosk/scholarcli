The same order must hold when a save meets the other process's record
of the same search (\cref{sec:session-integrity}).  The reviewer's
case: the session is at [[-l 5]]; process~B re-runs with [[-l 0]] and
saves fifty hits; process~A, still holding the [[-l 5]] record, saves
a decision.  The file must keep B's wide record with its dates.  And the
mirror: A holds the wide re-run when B saves its narrow copy, and A's
wide record must survive A's save.

<<test functions>>=
class TestConcurrentRecordOrder:
    """A save keeps the preferred record of a shared search."""

    WIDE = 10_000

    @staticmethod
    def _result(papers, limit, when):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="q", provider="openalex", timestamp="t", papers=papers,
            limit=limit, total=50, searched_at=when, fetched_at=when,
            from_cache=False,
        )

    @staticmethod
    def _papers(n):
        return [Paper(title=f"P{i}", authors=["A"], doi=f"10.1/cro-{i}")
                for i in range(n)]

    def _narrow_session(self, name):
        save_session(create_review_session(
            [self._result(self._papers(5), 5, "2026-10-01T00:00:00+00:00")],
            "q", session_name=name,
        ))

    def test_stale_narrow_save_keeps_the_wide_record(self):
        self._narrow_session("cro")
        stale = load_session("cro")
        save_session(create_review_session(
            [self._result(self._papers(50), self.WIDE,
                          "2026-11-18T09:00:00+00:00")],
            "q", session_name="cro",
        ))
        stale.decisions[0].status = DecisionStatus.KEPT
        save_session(stale)
        session = load_session("cro")
        assert [(r.limit, r.hits, r.searched_at)
                for r in session.search_records] == [
            (self.WIDE, 50, "2026-11-18T09:00:00+00:00"),
        ]
        assert len(session.decisions) == 50
        assert session.decisions[0].status == DecisionStatus.KEPT

    def test_own_wide_record_survives_a_narrow_file(self):
        self._narrow_session("cro-mirror")
        wide = create_review_session(
            [self._result(self._papers(50), self.WIDE,
                          "2026-11-18T09:00:00+00:00")],
            "q", session_name="cro-mirror",
        )
        other = load_session("cro-mirror")
        other.decisions[0].status = DecisionStatus.KEPT
        save_session(other)
        save_session(wide)
        session = load_session("cro-mirror")
        assert [(r.limit, r.hits) for r in session.search_records] == [
            (self.WIDE, 50),
        ]
        assert session.decisions[0].status == DecisionStatus.KEPT
