                    if d.paper.doi == "10.5555/wp207-shared"]
        shared.status = DecisionStatus.DISCARDED
        shared.tags = ["off-topic"]
        save_session(other)

        assert save_session(session) == path
        statuses, _ = self._saved(path)
        assert statuses["doi:10.5555/wp207-shared"] == (
            "discarded", ["off-topic"])
        assert old_id not in statuses
        assert statuses[get_paper_id(self._homonym(number=""))] == (
            "kept", ["t1"])
