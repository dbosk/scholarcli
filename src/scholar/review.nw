class TestCopiesOfStoreRecords:
  """The copies a decision-store re-run leaves are listed (#215)."""

  ARXIV = "10.48550/arXiv.1301.00001"
  HASH = legacy_hash_paper_id("A Study", ["Ada Lovelace"])
  NUMBERED = legacy_hash_paper_id("A Study", ["Ada Lovelace 0001"])

  @staticmethod
  def _store(records):
    from scholar.notes import ReviewDecisionRecord, save_search_decisions
    save_search_decisions("old query", {
      key: ReviewDecisionRecord(title="A Study", year=2014, **fields)
      for key, fields in records.items()
    })

  @staticmethod
  def _discarded():
    return {"status": "discarded", "tags": ["off-topic"],
            "authors": ["Ada Lovelace"], "provider": "openalex"}

  @staticmethod
  def _session(*decisions):
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime.now())
    session.decisions = list(decisions)
    return session

  @staticmethod
  def _decision(authors, status, tags, provider="openalex"):
    return ReviewDecision(
      paper=Paper(title="A Study", authors=authors, year=2014),
      provider=provider, status=status, tags=tags)

