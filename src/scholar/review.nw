@dataclass(frozen=True)
class StoredBatch:
    """One stored batch: rows of one screener under one batch id.

    `what`, `kind` and `name` are as for `StoredRun`; `batch` is the
    id; `findings` are `batch_findings` of its rows.
    """

    what: str
    kind: str
    name: str | None
    batch: str
    rows: tuple[BatchRow, ...]
    findings: tuple[BatchFinding, ...]


def stored_batches(groups: dict[tuple, list[BatchRow]]) -> list[StoredBatch]:
    """Check the rows of `groups` (runs) that carry a batch id, per batch."""
    by_batch: dict[tuple, list[BatchRow]] = {}
    for (what, kind, name, _at), rows in groups.items():
        for row in rows:
            if row.batch is not None:
                by_batch.setdefault((what, kind, name, row.batch), []) \
                    .append(row)
    return [
        StoredBatch(what, kind, name, batch, tuple(rows),
                    tuple(stored_batch_findings(batch, rows)))
        for (what, kind, name, batch), rows in by_batch.items()
    ]
