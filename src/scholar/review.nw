    assert {d.paper.id for d in possible_copies(session)} \
      == {yearless.id, authorless.id}
    assert report_work_items(session)[-1] \
      == r"\item[Possible copies, not reconciled] 2"
    for decision in session.decisions:
      decision.status = (DecisionStatus.KEPT if decision.paper.doi
                         else DecisionStatus.DISCARDED)
    assert conflicting_copies(session) == []
    assert len(possible_copies(session)) == 2

  def test_differently_decided_copies_are_kept_and_listed(self):
    bare, with_doi = self._two_copies(
      (DecisionStatus.DISCARDED, ["no-abstract"]),
      (DecisionStatus.KEPT, ["ml"]),
