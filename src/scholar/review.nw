class TestRecordIdAndNote:
  """A record's id follows its key; a note is kept on one line."""

  def test_id_is_the_key_digest(self):
    import hashlib
    first = SearchRecord("q", "dblp", {"year": "2020"}, 100, hits=3)
    rerun = SearchRecord("q", "dblp", {"year": "2020"}, 1000, hits=9,
                         searched_at="2026-11-21T00:00:00+00:00")
    other = SearchRecord("q", "dblp", {"year": "2021"}, 100, hits=3)
    assert first.record_id == rerun.record_id
    assert first.record_id != other.record_id
    assert first.record_id == hashlib.sha256(
      "\x1f".join(first.key).encode("utf-8")
    ).hexdigest()[:7]

  def test_prefix_lookup(self):
    records = [SearchRecord("q", "dblp"), SearchRecord("r", "dblp")]
    full = records[0].record_id
    assert records_with_id_prefix(records, full[:4]) == [records[0]]
    assert records_with_id_prefix(records, full.upper()) == [records[0]]
    assert records_with_id_prefix(records, "zzzz") == []

  def test_note_white_space_is_collapsed(self):
    record = SearchRecord("q", "dblp")
    retire_record(record, "2026-11-20T10:00:00+00:00",
                  "  first\n  version\t of q ")
    assert record.retired["note"] == "first version of q"
    retire_record(record, "2026-11-20T10:00:00+00:00", " \n ")
    assert record.retired["note"] is None
