The two races of the paper-metadata merge are played again in real
processes, in both save orders, since that is how they happen: a
[[set-abstract]] run and an enrichment that loaded the session before
it.  The test reads the saved file itself, so that no registry stands
between it and what was written.  Each process prints a line once it
has loaded the session and waits for one before it changes anything.

<<test functions>>=
class TestHandAbstractRaces:
  """Hand text and a provider's fill, saved in either order (#258)."""

  <<hand abstract race test methods>>

<<hand abstract race test methods>>=
NAME = "hand-race"
SET = """
  from scholar.review import load_session, save_session, set_abstract
  session = load_session("hand-race")
  WAIT
  set_abstract(session.decisions, "Found by hand.", "Crossref",
               "2026-11-20T10:00:00+00:00")
  save_session(session)
"""
FILL = """
  from scholar.review import load_session, save_session
  session = load_session("hand-race")
  WAIT
  session.decisions[0].paper.abstract = "A provider's abstract."
  save_session(session)
"""
WAIT = 'import sys; print("loaded", flush=True); sys.stdin.readline()'

def _first_save(self):
  from scholar.scholar import isolated_registry

  with isolated_registry():
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime(2026, 11, 20),
                            name=self.NAME)
    session.decisions = [ReviewDecision(
      paper=Paper(title="A Race", authors=["Ada Lovelace"], year=2021,
                  doi="10.5555/hand-race"),
      provider="openalex",
    )]
    save_session(session)

def _code(self, template, wait):
  import textwrap

  return textwrap.dedent(template).replace(
    "WAIT", self.WAIT if wait else "")

def _race(self, stale, other):
  """`stale` loads and waits; `other` runs whole; then `stale` saves."""
  import subprocess
  import sys

  self._first_save()
  first = subprocess.Popen(
    [sys.executable, "-c", self._code(stale, wait=True)],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
  )
  try:
    assert first.stdout.readline().strip() == "loaded"
    subprocess.run([sys.executable, "-c", self._code(other, wait=False)],
                   check=True, timeout=120)
    first.communicate("go\n", timeout=120)
  finally:
    if first.poll() is None:
      first.kill()
  assert first.returncode == 0
  import json
  from scholar.review import _get_sessions_dir

  path = _get_sessions_dir() / f"{self.NAME}.json"
  return json.loads(path.read_text())["decisions"][0]

def test_a_stale_fill_saved_last(self):
  saved = self._race(self.FILL, self.SET)
  assert saved["paper"]["abstract"] == "Found by hand."
  [record] = saved["abstract_set"]
  assert record["text"] == "Found by hand."
  assert "previous" not in record

def test_a_stale_set_abstract_saved_last(self):
  saved = self._race(self.SET, self.FILL)
  assert saved["paper"]["abstract"] == "Found by hand."
  [record] = saved["abstract_set"]
  assert record["previous"] == "A provider's abstract."
