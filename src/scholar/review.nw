class TestStoredBatches:
  """Stored rows with a batch id are checked per batch (#292)."""

  FILLED = "Not about the research question."

  def _decision(self, n, status, at, batch, reason, confidence):
    return ReviewDecision(
      paper=Paper(title=f"Batched Work {n}", authors=["A"],
                  doi=f"10.5555/batched-{n}"),
      provider="p", status=status, tags=["t"],
      source=ReviewSource.AGENT_UNREVIEWED, agent_by="loader",
      agent_decided_at=at, agent_reason=reason, agent_batch=batch,
      llm_confidence=confidence,
    )

  def _session(self):
    kept_at = "2026-11-20T10:00:00+00:00"
    discarded_at = "2026-11-20T10:05:00+00:00"
    decisions = []
    for n in range(30):
      status, at = ((DecisionStatus.KEPT, kept_at) if n % 2
                    else (DecisionStatus.DISCARDED, discarded_at))
      decisions.append(self._decision(
        n, status, at, "b-1",
        self.FILLED if n < 12 else f"Work {n} studies topic {n}.", 0.9))
      decisions.append(self._decision(
        100 + n, status, at, "b-2", f"Work {100 + n} is about {n}.",
        (0.6, 0.8, 0.95)[n % 3]))
    decisions += [self._decision(
      200 + n, DecisionStatus.DISCARDED, discarded_at, None,
      f"Unbatched work {n}.", 0.9) for n in range(25)]
    for n, decision in enumerate(decisions[:20]):
      record_screening(decision, new_screening(
        kind="agent", name="second", status="kept", tags=["r"],
        recorded_at="2026-11-21T10:00:00+00:00", batch="b-1",
        confidence=(0.5, 0.7)[n % 2], reason=f"Second look at {n}.",
      ))
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime(2026, 11, 20))
    session.decisions = decisions
    return session

  def test_each_batch_is_checked_whole(self):
    check = stored_batch_check(self._session())
    found = {(b.what, b.name, b.batch): b for b in check.batches}
    assert list(found) == [
      ("agent decisions", "loader", "b-1"),
      ("agent decisions", "loader", "b-2"),
      ("screenings", "second", "b-1"),
    ]
    filled = found[("agent decisions", "loader", "b-1")]
    assert len(filled.rows) == 30
    assert [(f.kind, f.count) for f in filled.findings] == [
      ("shared-reason", 12), ("flat-confidence", 30),
    ]
    assert found[("agent decisions", "loader", "b-2")].findings == ()
    assert found[("screenings", "second", "b-1")].findings == ()
    assert [len(run.rows) for run in check.runs] == [55, 20, 30]
    assert all(row.batch is None for row in check.runs[0].rows[30:])

  def test_rows_without_an_id_make_no_batch(self):
    session = self._session()
    for decision in session.decisions:
      decision.agent_batch = None
      decision.screenings = []
    assert stored_batch_check(session).batches == []
