def failed_outright(record: SearchRecord) -> bool:
    """Whether the search failed without a single paper."""
    return bool(record.error) and not record.hits


def record_rank(record: SearchRecord) -> tuple:
    """The sort key by which a session keeps one of two records.

    `(answered, width, searched_at, hits, complete)`: higher is better;
    a legacy record's width, an unknown run time and an unknown hit
    count rank lowest.
    """
    width = (
        float("-inf") if record.is_legacy else search_width(record.limit)
    )
    return (
        0 if failed_outright(record) else 1,
        width,
        record.searched_at or "",
        -1 if record.hits is None else record.hits,
        0 if record.error else 1,
    )


def preferred_record(a: SearchRecord, b: SearchRecord) -> SearchRecord:
    """Of two records of one search, the one a session keeps.

    The one with the higher `record_rank`; on equal ranks, `a`.
    """
    return a if record_rank(a) >= record_rank(b) else b
@

