def test_the_reported_shape_is_found(self):
  read = batch_rows(
    40, confidence=lambda i: (0.6, 0.75, 0.9)[i % 3],
    status="discarded", tags=["off-topic-false-hit"],
  )
  filled = [
    BatchRow(paper=f"doi:10.5555/filled-{i}", title=f"Filled {i}",
             reason="Not relevant to the research question.",
             confidence=0.85, status="discarded",
             tags=("off-topic-false-hit",))
    for i in range(325)
  ]
  [shared] = batch_findings(read + filled)
  assert shared.kind == "shared-reason"
  assert (shared.count, shared.rows) == (325, 365)
  assert shared.papers[0] == "doi:10.5555/filled-0"
  assert len(shared.papers) == 325
  assert shared.detail == (
    "shared by 325 records with different titles (325 rows): "
    "\"Not relevant to the research question.\""
  )
  assert not shared.information

