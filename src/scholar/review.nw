        october = "2026-10-02T08:00:00+00:00"
        assert search_source_date(SearchRecord(
            "q", "p", searched_at=run, fetched_at=october, from_cache=True,
        )) == "2026-10-02"
        assert search_source_date(SearchRecord(
            "q", "p", searched_at=run, from_cache=True,
        )) is None
        assert search_source_date(SearchRecord(
