class TestDecisionStoreNamesake:
  """A namesake of a decision-store record does not get its decision."""

  DOI = "10.1109/ipdps.2014.73"
  HASH = legacy_hash_paper_id("A Study", ["Ada Lovelace"])

  @staticmethod
  def _rerun(returned):
    from scholar.scholar import SearchResult, isolated_registry
    result = SearchResult(
      query="old query", provider="s2", timestamp=datetime.now(),
      papers=[returned], limit=10,
    )
    with isolated_registry():
      return create_review_session([result], "old query")

  def test_doi_paper_does_not_take_an_older_works_decision(self):
    TestDecisionStoreKeepsStoredPaper._store(
      self.HASH, year=1994, abstract="the older work")
    session = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.DOI, sources=["s2"],
    ))
    [new] = [d for d in session.decisions if d.paper.doi]
    assert new.status == DecisionStatus.PENDING
    assert new.tags == []
    assert new.provider == "s2"
    assert [link[:2] for link in new.found_by] == [("old query", "s2")]
    [old] = [d for d in session.decisions if not d.paper.doi]
    assert old.paper.year == 1994
    assert old.status == DecisionStatus.DISCARDED
    assert old.tags == ["off-topic"]
    assert old.found_by == []

  @pytest.mark.parametrize("fields", [{}, {"doi": "10.1/stored-203"}])
  def test_doi_less_namesake_is_noted_beside_the_record(self, fields):
    TestDecisionStoreKeepsStoredPaper._store(
      self.HASH, year=1994, abstract="the older work", **fields)
    session = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      venue="Talk", sources=["s2"],
    ))
    [decision] = session.decisions
    assert decision.status == DecisionStatus.DISCARDED
    assert decision.tags == ["off-topic"]
    assert (decision.paper.year, decision.paper.abstract) == (
      1994, "the older work")
    assert decision.provider == "openalex"
    assert decision.same_id_copies == [
      {"year": 2014, "venue": "Talk", "provider": "s2"}]
    assert decision.found_by == []

  @pytest.mark.parametrize("doi", [DOI, None])
  def test_one_work_still_takes_the_decision(self, doi):
    TestDecisionStoreKeepsStoredPaper._store(self.HASH, year=2014)
    session = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2015,
      doi=doi, sources=["s2"],
    ))
    [decision] = session.decisions
    assert decision.paper.doi == doi
    assert decision.status == DecisionStatus.DISCARDED
    assert decision.tags == ["off-topic"]
    assert [link[:2] for link in decision.found_by] == [
      ("old query", "s2")]

  def test_a_preprint_record_goes_to_its_published_version(self):
    TestDecisionStoreKeepsStoredPaper._store(
      self.HASH, year=2014, url="https://arxiv.org/abs/1301.00001")
    session = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.DOI, sources=["s2"],
    ))
    [decision] = session.decisions
    assert decision.paper.doi == self.DOI
    assert decision.status == DecisionStatus.DISCARDED
    assert decision.tags == ["off-topic"]
    assert [link[:2] for link in decision.found_by] == [
      ("old query", "s2")]

  def test_a_doi_is_one_work_whatever_the_years(self):
    TestDecisionStoreKeepsStoredPaper._store(
      f"doi:{self.DOI}", doi=self.DOI, year=1994,
      abstract="the older work")
    session = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.DOI, sources=["s2"],
    ))
    [decision] = session.decisions
    assert decision.status == DecisionStatus.DISCARDED
    assert decision.same_id_copies == []
    assert [link[:2] for link in decision.found_by] == [
      ("old query", "s2")]
    assert (decision.paper.year, decision.paper.abstract) == (2014, None)
