class TestRecordsPerProvider:
    """A merged result is recorded as one search per provider (#164)."""

    @staticmethod
    def _merged():
        from scholar.scholar import SearchResult
        both = Paper(title="Both", authors=["A"], doi="10.1/pp-both")
        only = Paper(title="Only OA", authors=["B"], doi="10.1/pp-oa")
        openalex = SearchResult(
            query="q", provider="openalex", timestamp="t",
            papers=[both, only], limit=100,
        )
        dblp = SearchResult(
            query="q", provider="dblp", timestamp="t", papers=[both],
            limit=100, error="non-JSON response",
        )
        return openalex.merge(dblp)

    def test_one_record_per_provider(self):
        session = create_review_session(
            [self._merged()], "q", session_name="per-provider",
        )
        outcomes = {
            r.provider: (r.query, r.hits, r.error)
            for r in session.search_records
        }
        assert outcomes == {
            "openalex": ("q", 2, None),
            "dblp": ("q", 1, "non-JSON response"),
        }
        assert session.providers == ["openalex", "dblp"]

    def test_papers_link_to_the_providers_that_returned_them(self):
        session = create_review_session(
            [self._merged()], "q", session_name="per-provider",
        )
        found = {
            d.paper.doi: (d.provider, d.found_by) for d in session.decisions
        }
        assert found["10.1/pp-oa"] == ("openalex", [("q", "openalex", "")])
        assert found["10.1/pp-both"] == (
            "openalex, dblp", [("q", "openalex", ""), ("q", "dblp", "")],
        )

    def test_old_merged_record_loads_unchanged(self):
        # A merged record of providers this run does not all cover
        # (scopus was not re-run), so it is not superseded
        # (sec:superseded-merged) and must stay as it was.
        import json
        from scholar.review import _get_sessions_dir
        old = {"query": "q | q", "provider": "openalex, scopus",
               "filters": None, "limit": 100, "hits": 25,
               "error": "scopus: HTTP 500", "retries": 0}
        path = _get_sessions_dir() / "merged-old.json"
        path.write_text(json.dumps({
            "query": "q", "name": "merged-old",
            "providers": ["openalex, scopus"],
            "timestamp": datetime.now().isoformat(),
            "search_records": [old], "decisions": [],
        }))
        session = create_review_session(
            [self._merged()], "q", session_name="merged-old",
        )
        save_session(session)
        records = json.loads(path.read_text())["search_records"]
        assert [r["provider"] for r in records] == [
            "openalex", "dblp", "openalex, scopus",
        ]
        merged = records[2]
        assert {k: merged[k] for k in old} == old
