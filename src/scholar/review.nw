def _latex_children(walker_module, node) -> list:
    """The nodes inside `node`: arguments of a macro, else its content."""
    if node.isNodeType(walker_module.LatexMacroNode):
        return [arg for arg in (node.nodeargd.argnlist
                                if node.nodeargd else []) if arg]
    return list(getattr(node, "nodelist", None) or [])


def _allowed_macro_starts(walker_module, nodes, math_allowed) -> set | None:
    """Where the macros under `nodes` begin; None if one is not allowed."""
    starts, stack = set(), [(node, 1, False) for node in nodes]
    while stack:
        node, depth, in_math = stack.pop()
        if node is None:
            continue
        if depth > LATEX_DECODE_MAX_DEPTH:
            return None
        if node.isNodeType(walker_module.LatexMathNode):
            in_math = True
        if node.isNodeType(walker_module.LatexMacroNode):
            allowed = math_allowed if in_math else LATEX_TEXT_ALLOWED
            if node.macroname not in allowed:
                return None
            starts.add(node.pos)
        stack.extend((child, depth + 1, in_math)
                     for child in _latex_children(walker_module, node))
    return starts
@

Decoding keeps everything that is no command as written.
A math node is decoded only when it holds a macro; [[$x^2$]] stays the
source text, which the escaper writes as before.
What a command decodes to is folded out of the mathematical alphabets
and must be settable, or the whole value is given up
([[_LatexUnsettable]], caught by [[latex_text_pieces]]).

<<review report generation>>=
class _LatexUnsettable(Exception):
    """A command decoded to a character the escaper cannot set."""


def _latex_pieces(walker_module, converter, nodes, source) -> list:
    """Decode the command nodes of `nodes`; keep the rest as written."""
    pieces: list = []
    for node in nodes:
        written = source[node.pos:node.pos + node.len]
        if node.isNodeType(walker_module.LatexGroupNode):
            pieces.append("{")
            pieces += _latex_pieces(walker_module, converter,
                                    node.nodelist, source)
            pieces.append("}")
        elif node.isNodeType(walker_module.LatexMacroNode) \
                and node.macroname in ("{", "}"):
            pieces.append(LatexBrace(node.macroname))
        elif node.isNodeType(walker_module.LatexMathNode) \
                and "\\" not in written:
            pieces.append(written)
        elif node.isNodeType(walker_module.LatexMacroNode) \
                or node.isNodeType(walker_module.LatexMathNode):
            pieces.append(_settable(converter.nodelist_to_text([node])))
        else:
            pieces.append(written)
    return pieces


def _settable(decoded: str) -> str:
    """Fold math letters to plain ones; raise if a character cannot be set."""
    low, high = MATH_ALPHANUMERICS
    decoded = "".join(
        unicodedata.normalize("NFKC", char)
        if low <= ord(char) <= high else char
        for char in unicodedata.normalize("NFC", decoded)
    )
    for char in decoded:
        mapped = _escape_char(char, BIBTEX_SPECIALS) != char
        latin = ord(char) <= LATEX_LATIN_CUTOFF and not _t1_unset(char)
        if not (mapped or latin):
            raise _LatexUnsettable(char)
    return decoded
