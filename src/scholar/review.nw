class TestAuditReason:
    def _reason(self, status, tags, source=ReviewSource.HUMAN, conf=None,
                theme_names=None, is_example=False):
        decision = ReviewDecision(
            paper=Paper(title="P", authors=["A"], year=2024),
            provider="p", status=status, tags=tags, source=source,
            llm_confidence=conf, is_example=is_example,
        )
        return audit_reason(
            decision, theme_names=theme_names or {},
            strings=AUDIT_STRINGS["en"],
        )

    def test_kept_theme_is_cited_with_readable_name(self):
        label, order = self._reason(
            DecisionStatus.KEPT, ["ml"], theme_names={"ml": "machine learning"}
        )
        assert label == r"\emph{cited}: machine learning"
        assert order == AUDIT_ORDER_CITED

    def test_kept_without_tags(self):
        assert self._reason(DecisionStatus.KEPT, []) == (r"\emph{cited}", 0)

    def test_human_keep_over_llm_category_is_cited(self):
        label, order = self._reason(
            DecisionStatus.KEPT, ["supports-claim", "ml"],
            source=ReviewSource.LLM_REVIEWED, conf=0.9,
        )
        assert (label, order) == (r"\emph{cited}: ml", AUDIT_ORDER_CITED)

    def test_llm_keep_is_a_candidate_not_a_citation(self):
        assert self._reason(
            DecisionStatus.KEPT, ["supports-claim"],
            source=ReviewSource.LLM_UNREVIEWED, conf=0.9,
        ) == ("supports the claim (0.90)", 1)
        assert self._reason(
            DecisionStatus.KEPT, ["ml"],
            source=ReviewSource.LLM_UNREVIEWED, conf=0.8,
        ) == ("ml (0.80)", AUDIT_ORDER_OTHER)

    def test_note_tags_are_notes_not_themes(self):
        assert self._reason(DecisionStatus.KEPT, ["recorded-not-cited"]) \
            == ("recorded, not cited", AUDIT_ORDER_OTHER)
        label, order = self._reason(
            DecisionStatus.KEPT, ["ml", "extended-tech-report"],
            theme_names={"ml": "ML"},
        )
        assert label == r"\emph{cited}: ML (extended report version of " \
            "a cited source)"
        assert order == AUDIT_ORDER_CITED
        assert self._reason(
            DecisionStatus.KEPT,
            ["supports-claim", "no-abstract-title-only"],
        ) == (
            "supports the claim (judged on title, no abstract available)", 1
        )

    def test_theme_list_is_an_allowlist(self):
        assert self._reason(
            DecisionStatus.KEPT, ["stray-tag"], theme_names={"ml": "ML"}
