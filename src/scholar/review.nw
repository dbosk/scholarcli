<<review report generation>>=
def collect_audit_rows(
    session: ReviewSession,
    *,
    theme_names: dict[str, str],
    strings: dict[str, str],
    title_limit: int | None = None,
    cited_works: Collection[tuple[str, str]] | None = None,
) -> list[AuditRow]:
    """Merge the session's decisions into sorted audit rows.

    `cited_works` are the `audit_work_key`s of the works the text cites
    (`--cited-from`); given, they decide which rows are cited.
    """
    def cited(key: tuple[str, str]) -> bool | None:
        return None if cited_works is None else key in cited_works

    rows: dict[tuple[str, str], AuditRow] = {}
    copies: dict[tuple[str, str], list[ReviewDecision]] = {}
    best: dict[tuple[str, str], ReviewDecision] = {}
    best_rank: dict[tuple[str, str], tuple[int, int, int]] = {}
    rank_rules = {"theme_names": theme_names, "notes": strings["notes"]}
    for decision in session.decisions:
        paper = decision.paper
        year = str(paper.year) if paper.year else ""
        key = audit_work_key(paper)
        providers = provider_short_names(
            ", ".join(decision_provider_evidence(decision))
        )
        reason, order, confidence_by = audit_reason_and_confidence(
            decision, theme_names=theme_names, strings=strings,
            cited=cited(key),
        )
        <<rank the copy on the screening's order>>
        uncited = audit_uncited_keep(decision, cited(key))
        excluded = audit_excluded(decision)
        criterion = audit_exclusion_criterion(
            decision, theme_names=theme_names, notes=strings["notes"]
        )
        version = audit_version_note(decision)
        copies.setdefault(key, []).append(decision)
        row = rows.get(key)
        if row is None:
            best[key], best_rank[key] = decision, rank
            title, nonlatin_title = audit_title_cell(paper, title_limit)
            rows[key] = AuditRow(
                title=title,
                year=year,
                providers=providers,
                status=decision.status,
                reason=reason,
                order=order,
                excluded=excluded,
                criterion=criterion,
                version=version,
                work=key,
                uncited=uncited,
                nonlatin_title=nonlatin_title,
                confidence_by=confidence_by,
            )
            continue
        for provider in providers:
            if provider not in row.providers:
                row.providers.append(provider)
        if not row.year:
            row.year = year
        if rank < best_rank[key]:
            row.status, row.reason, row.order = decision.status, reason, order
            row.excluded, row.criterion = excluded, criterion
            row.version, row.uncited = version, uncited
            row.confidence_by = confidence_by
            best[key], best_rank[key] = decision, rank
    for key, row in rows.items():
        <<unite the notes of the row's copies>>
    return sorted(rows.values(), key=lambda r: (r.order, r.title.lower()))
@

With [[--cited-from]] (\cref{sec:audit-cited-from}) the citation
changes how a row reads, never which copy gives it: each copy is ranked
on the order the screening gave it, as without the option.  Ranked on
the cited order instead, every kept or pending copy of a cited work
would be order~0 and beat a discard of the same work, so a pending
record could give the row of a work an agent had discarded as off
topic; the row read \enquote{cited, pending, unclassified}, and the
export's warning about a cited work the session excludes never came.
The screening's choice is the one that says what the session decided
about the work, and the text's citation is then written on it.

<<rank the copy on the screening's order>>=
if cited_works is None:
    screening_order = order
else:
    _, screening_order = audit_reason(
        decision, theme_names=theme_names, strings=strings
    )
rank = audit_copy_rank(decision, screening_order, **rank_rules)
