  def test_authors_and_year(self, char):
    paper = self._paper("authors", [f"A{char}B", "C D"])
    paper.year = f"20{char}20"
    key = cite_key_base(paper)
    assert key.isalnum() and key.endswith("2020")
    entry = self._read(format_bibtex_entry(paper, key))
