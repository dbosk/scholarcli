    def test_a_new_search_records_it_and_keeps_the_old(self):
        from scholar.scholar import SearchResult

        bulk = SearchResult(query="a AND b", provider="s2", timestamp="t",
                            papers=[], limit=1000, via="bulk")
        first = create_review_session([bulk], "a AND b",
                                      session_name="via-run")
        save_session(first)
        plain = SearchResult(query="c", provider="s2", timestamp="t",
                             papers=[], limit=100)
        second = create_review_session([plain], "c",
                                       session_name="via-run")
        assert {r.query: r.via for r in second.search_records} \
            == {"c": None, "a AND b": "bulk"}
