AT = "2026-11-20T10:00:00+00:00"
LATER = "2026-11-20T11:00:00+00:00"

def _llm_call(self, doi="10.5555/screen", **kwargs):
  values = dict(
    status=DecisionStatus.DISCARDED, tags=["off-topic-false-hit"],
    source=ReviewSource.LLM_UNREVIEWED, llm_confidence=0.8,
    llm_model="m-1", llm_decided_at="2026-11-01T09:00:00+00:00",
    llm_prompt_version="0123456789abcdef", llm_reason="Off topic.",
    llm_abstract_truncated=False,
  )
  values.update(kwargs)
  return ReviewDecision(
    paper=Paper(title="Screened", authors=["Ada Lovelace"], year=2021,
                doi=doi),
    provider="openalex", **values,
  )

def _agent_verdict(self, status="kept", recorded_at=AT, **kwargs):
  return new_screening(kind="agent", name="agent-2", status=status,
                       tags=["adjacent-subtopic"], recorded_at=recorded_at,
                       reason="Background only.", **kwargs)

def test_a_screening_brings_a_snapshot_once(self):
  decision = self._llm_call()
  state, verdict = decision_state(decision), decision_verdict(decision)
  first = self._agent_verdict()
  snapshot = record_screening(decision, first)
  assert decision.screenings == [snapshot, first]
  assert snapshot == {
    "id": snapshot["id"], "origin": "decision", "kind": "llm",
    "name": "m-1", "confirmed_from": None, "confirmed_name": None,
    "status": "discarded", "tags": ["off-topic-false-hit"],
    "confidence": 0.8, "reason": "Off topic.",
    "at": "2026-11-01T09:00:00+00:00", "recorded_at": self.AT,
    "prompt_version": "0123456789abcdef", "abstract_truncated": False,
    "blind": None, "blind_basis": None, "sample_id": None, "batch": None,
    "via": "snapshot",
  }
  assert list(first) == list(SCREENING_KEYS)
  assert (first["origin"], first["at"], first["via"]) \
    == ("screen", self.AT, "screen")
  second = new_screening(kind="human", status="discarded",
                         tags=["off-topic-false-hit"],
                         recorded_at=self.LATER)
  assert record_screening(decision, second) is None
  assert decision.screenings == [snapshot, first, second]
  assert decision_state(decision) == state
  assert decision_verdict(decision) == verdict
  assert decision.status is DecisionStatus.DISCARDED
  assert decision.tags == ["off-topic-false-hit"]

def test_a_changed_decision_gets_a_new_snapshot(self):
  decision = self._llm_call()
  record_screening(decision, self._agent_verdict())
  decision.status, decision.tags = DecisionStatus.KEPT, ["adjacent-subtopic"]
  decision.llm_decided_at = "2026-11-02T09:00:00+00:00"
  snapshot = record_screening(decision, self._agent_verdict(
    recorded_at=self.LATER))
  assert snapshot["status"] == "kept"
  assert [r["origin"] for r in decision.screenings] \
    == ["decision", "screen", "decision", "screen"]

def test_a_pending_paper_has_no_snapshot(self):
  decision = ReviewDecision(paper=Paper(title="Open", authors=["A"]),
                            provider="p")
  verdict = self._agent_verdict()
  assert record_screening(decision, verdict) is None
  assert decision.screenings == [verdict]
  assert decision.status is DecisionStatus.PENDING

def test_each_source_gives_its_screener(self):
  human = self._llm_call(source=ReviewSource.HUMAN)
  record_human_decision(human, "decide", by="the author", at=self.AT)
  agent = self._llm_call(source=ReviewSource.AGENT_UNREVIEWED,
                         agent_reason="Not about it.", agent_by="agent-1",
                         agent_decided_at=self.AT)
  unknown = self._llm_call(source=ReviewSource("manual"))
  screeners = {
    name: verdict_screener(d)
    for name, d in (("human", human), ("agent", agent),
                    ("unknown", unknown))
  }
  assert screeners["human"] == {
    **dict.fromkeys(SNAPSHOT_FIELDS),
    "kind": "human", "name": "the author", "at": self.AT,
  }
  assert screeners["agent"] == {
    **dict.fromkeys(SNAPSHOT_FIELDS),
    "kind": "agent", "name": "agent-1", "confidence": 0.8,
    "reason": "Not about it.", "at": self.AT,
  }
  assert screeners["unknown"] == dict.fromkeys(SNAPSHOT_FIELDS)

def test_a_confirmed_classifier_call_is_the_humans_verdict(self):
  decision = self._llm_call(source=ReviewSource.LLM_REVIEWED)
  record_human_decision(decision, "tui", by="the author", at=self.AT)
  snapshot = record_screening(decision, self._agent_verdict(
    recorded_at=self.LATER))
  assert (snapshot["kind"], snapshot["name"], snapshot["at"]) \
    == ("human", "the author", self.AT)
  assert (snapshot["confirmed_from"], snapshot["confirmed_name"]) \
    == ("llm", "m-1")
  assert (snapshot["confidence"], snapshot["reason"],
          snapshot["prompt_version"]) == (None, None, None)
  agent = self._llm_call(source=ReviewSource.AGENT_REVIEWED,
                         agent_by="agent-1")
  assert verdict_screener(agent)["confirmed_from"] == "agent"
  assert verdict_screener(agent)["confirmed_name"] == "agent-1"

def test_bad_values_are_refused(self):
  from scholar.review import _screening_record

  for kwargs, message in (
    ({"kind": "robot"}, "kind"),
    ({"status": "pending"}, "kept or discarded"),
    ({"via": "snapshot"}, "channel"),
    ({"blind_basis": "hope"}, "blindness"),
    ({"confidence": 1.5}, "between 0 and 1"),
    ({"reason": "x" * (MAX_AGENT_REASON_CHARS + 1)}, "over the limit"),
  ):
    values = dict(kind="agent", status="kept", tags=[],
                  recorded_at=self.AT)
    values.update(kwargs)
    with pytest.raises(ValueError, match=message):
      new_screening(**values)
  with pytest.raises(ValueError, match="not a screening key"):
    _screening_record(score=1)
