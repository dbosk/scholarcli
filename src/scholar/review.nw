def test_ten_thousand_reasons_are_checked_quickly(self):
    import time

    words = " ".join(f"word{i}" for i in range(400))
    decisions = [
        ReviewDecision(
            paper=Paper(title=f"Title {n}", authors=["A"],
                        doi=f"10.5555/quote-speed-{n}",
                        abstract=f"Intro &amp; \u2013 \u201cq\u201d "
                                 f"{words} end {n}."),
            provider="p", status=DecisionStatus.DISCARDED,
            source=ReviewSource.AGENT_UNREVIEWED,
            agent_reason=f'Says "word10 word11 word12" and "not in {n} it".',
        )
        for n in range(10_000)
    ]
    started = time.process_time()
    tally = quote_check_tally(reason_quote_checks(d) for d in decisions)
    elapsed = time.process_time() - started
    assert tally["agent"] == {
        "reasons": 10_000, "checked": 10_000, "unmatched": 10_000,
        "short_quotes": 0,
    }
    assert elapsed < 8.0, f"{elapsed:.2f} s for 10,000 reasons"
