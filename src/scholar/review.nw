UNSAVED_MARK = ".unsaved-"
UNSAVED_KEY = "scholar_unsaved"
<<review session functions>>=
def keep_unsaved_session(session: ReviewSession, session_path: Path) -> Path:
    """Write `session` beside `session_path` for `recover_unsaved_session`.

    Returns the new file, `<name>.json.unsaved-<UTC time>-<random>`.
    """
    text = json.dumps({
        **session_file_data(session),
        UNSAVED_KEY: {
            "target": session_path.name,
            "baseline": baseline_data(session._baseline),
            "baseline_keys": [d.baseline_key for d in session.decisions],
        },
    }, indent=2, ensure_ascii=False)
    written = _utcnow().strftime("%Y%m%dT%H%M%SZ")
    fd, name = tempfile.mkstemp(
        dir=session_path.parent,
        prefix=f"{session_path.name}{UNSAVED_MARK}{written}-",
    )
    unsaved = Path(name)
    try:
        os.close(fd)
        atomic_write_text(unsaved, text)
    except BaseException:
        unsaved.unlink(missing_ok=True)
        raise
    return unsaved


def unsaved_session_files() -> list[Path]:
    """The files of refused saves in the sessions directory, oldest first."""
    return sorted(_get_sessions_dir().glob(f"*.json{UNSAVED_MARK}*"))
