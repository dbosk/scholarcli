                lines.append(paper_item_latex(decision, cite_key))
            lines.append(r"\end{enumerate}")
            lines.append("")
    else:
        lines.append(r"\begin{enumerate}")
        for decision in session.kept_papers():
            lines.append(paper_item_latex(decision, cite_key))
        lines.append(r"\end{enumerate}")
        lines.append("")
