@functools.cache
def _latex_reader():
    """Return pylatexenc's parser module, contexts, converter and the
    macros allowed inside math."""
    from pylatexenc import latex2text, latexwalker, macrospec

    walker_db = latexwalker.get_default_latex_context_db()
    walker_db.add_context_category(
        "scholar-fonts", prepend=True,
        macros=[macrospec.MacroSpec(name, "") for name in LATEX_FONT_SWITCHES]
        + [macrospec.MacroSpec(name, "{") for name in LATEX_FONT_COMMANDS
           if walker_db.get_macro_spec(name) is None],
    )
    text_db = latex2text.get_default_latex_context_db()
    text_db.add_context_category(
        "scholar-fonts", prepend=True,
        macros=[latex2text.MacroTextSpec(name, discard=True)
                for name in LATEX_FONT_SWITCHES]
        + [latex2text.MacroTextSpec(name, "%s")
           for name in LATEX_FONT_COMMANDS
           if text_db.get_macro_spec(name) is None],
    )
    converter = latex2text.LatexNodes2Text(latex_context=text_db)
    return latexwalker, walker_db, converter, _math_allowed(
        walker_db, text_db
    )


def _math_allowed(walker_db, text_db) -> frozenset:
    """The decoder's one-character symbol macros, and the math alphabets."""
    def takes_no_argument(name):
        spec = walker_db.get_macro_spec(name)
        return spec is None or getattr(spec.args_parser, "argspec", "") == ""

    return frozenset(
        spec.macroname for spec in text_db.iter_macro_specs()
        if isinstance(spec.simplify_repl, str)
        and len(spec.simplify_repl) == 1
        and takes_no_argument(spec.macroname)
    ) | frozenset(LATEX_MATH_ALPHABETS)
