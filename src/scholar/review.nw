@dataclass(frozen=True)
class StoredRun:
    """One stored run of agent reasons or screenings, and its notes.

    `what` is `agent decisions` or `screenings`; `kind` and `name` say
    who (`name` None when not recorded); `at` is the run's time;
    `findings` holds at most the `one-reason` note.
    """

    what: str
    kind: str
    name: str | None
    at: str | None
    rows: tuple[BatchRow, ...]
    findings: tuple[BatchFinding, ...]


@dataclass(frozen=True)
class StoredBatchCheck:
    """The batch check of a stored session.

    `shared` maps `agent decisions` and `screenings` to their
    session-wide shared-reason findings; `runs` lists every stored run.
    """

    shared: dict[str, list[BatchFinding]]
    runs: list[StoredRun]
    batches: list["StoredBatch"] = field(default_factory=list)


def stored_batch_check(session: "ReviewSession") -> StoredBatchCheck:
    """Check a session's stored agent reasons and screenings.

    Shared reasons are looked for across the session; a run of two or
    more works that all carry one reason is noted and counts as one
    record there. Runs come in the order of their first row.
    """
    groups = _stored_run_rows(session)
    runs: list[StoredRun] = []
    pooled: dict[str, list[BatchRow]] = {
        "agent decisions": [], "screenings": [],
    }
    for (what, kind, name, at), rows in groups.items():
        reasons = {batch_reason_key(row.reason) for row in rows}
        works = {batch_title_key(row) for row in rows}
        one_reason = (len(reasons) == 1 and None not in reasons
                      and len(works) > 1)
        findings = [
            replace(finding, detail=(
                f"one reason for all {finding.count} records of the run "
                "(one --reason, or the same reason on every line): "
                f"{_shown_reason(rows[0].reason)}"
            ))
            for finding in batch_findings(rows, one_reason=True)
        ] if one_reason else []
        if one_reason:
            pooled[what].append(BatchRow(
                paper=(f"run of {len(works)} ({kind} {name or '(no name)'},"
                       f" {at or 'time not recorded'})"),
                title=None, reason=rows[0].reason,
            ))
        else:
            pooled[what].extend(rows)
        runs.append(StoredRun(what, kind, name, at, tuple(rows),
                              tuple(findings)))
    return StoredBatchCheck(
        {what: shared_reason_findings(rows) for what, rows in pooled.items()},
        runs, stored_batches(groups),
    )
