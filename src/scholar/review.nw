class TestDecisionStoreRecordsKept:
  """No decided store record vanishes from a re-run."""

  ARXIV = "10.48550/arXiv.1301.00001"
  PUBLISHED = "10.1109/ipdps.2014.73"
  HASH = legacy_hash_paper_id("A Study", ["Ada Lovelace"])

  @staticmethod
  def _store(records):
    from scholar.notes import ReviewDecisionRecord, save_search_decisions
    save_search_decisions("old query", {
      key: ReviewDecisionRecord(title="A Study", year=2014, **fields)
      for key, fields in records.items()
    })

  def _discarded(self):
    return {"status": "discarded", "tags": ["off-topic"],
            "authors": ["Ada Lovelace"], "provider": "openalex"}

  @staticmethod
  def _states(session):
    return sorted((d.status.value, d.paper.doi or "", tuple(d.tags))
                  for d in session.decisions)

  def test_record_beside_a_merged_copy(self):
    self._store({
      self.HASH: self._discarded(),
      legacy_hash_paper_id("A Study", ["Ada Lovelace 0001"]): {
        "status": "kept", "tags": ["theme"],
        "authors": ["Ada Lovelace 0001"], "provider": "dblp",
        "url": "https://arxiv.org/abs/1301.00001"},
    })
    session = TestDecisionStoreNamesake._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.ARXIV, sources=["s2"],
    ))
    assert self._states(session) == [
      ("discarded", "", ("off-topic",)),
      ("kept", self.ARXIV, ("theme",)),
    ]

  def test_record_beside_a_replaced_version(self):
    self._store({
      self.HASH: self._discarded(),
      f"doi:{self.PUBLISHED}": {
        "status": "kept", "tags": ["theme"], "authors": ["Ada Lovelace"],
        "provider": "openalex", "doi": self.PUBLISHED},
    })
    session = TestDecisionStoreNamesake._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.ARXIV, sources=["s2"],
      published_versions=[{"doi": self.PUBLISHED,
                           "relation": "preprint-of"}],
    ))
    assert self._states(session) == [
      ("discarded", "", ("off-topic",)),
      ("kept", self.ARXIV, ("theme",)),
    ]

  def test_homonym_number_is_dropped_before_the_lookup(self):
    self._store({self.HASH: self._discarded()})
    session = TestDecisionStoreNamesake._rerun(Paper(
      title="A Study", authors=["Ada Lovelace 0001"], year=2014,
      doi=self.PUBLISHED, sources=["dblp"],
    ))
    assert self._states(session) == [
      ("discarded", self.PUBLISHED, ("off-topic",)),
    ]
