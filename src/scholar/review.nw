class TestConcurrentSaveTakesTheirUpdates:
  """A paper field changed only on disk is the file's after our save."""

  NAME = "conc-206"
  DOI = "10.1/conc-206"
  RETRACTION = [{"doi": "10.1/retraction-206", "type": "retraction",
                 "label": "Retraction", "date": "2026-11-01",
                 "source": "retraction-watch"}]
  CORRECTION = {"doi": "10.1/erratum-206", "type": "correction",
                "label": "Erratum", "date": "2026-11-02",
                "source": "publisher"}

  def _first_save(self, **paper_fields):
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = ReviewSession(query="q", providers=["openalex"],
                              timestamp=datetime.now(), name=self.NAME)
      session.decisions = [ReviewDecision(
        paper=Paper(title="A Study", authors=["Ada Lovelace"], year=2014,
                    doi=self.DOI, sources=["openalex"], **paper_fields),
        provider="openalex", status=DecisionStatus.PENDING,
      )]
      save_session(session)

  def _saved(self):
    import json
    from scholar.review import _get_sessions_dir
    path = _get_sessions_dir() / f"{self.NAME}.json"
    [decision] = json.loads(path.read_text())["decisions"]
    return decision

  def _other_process_sets(self, **changes):
    from dataclasses import replace
    from scholar.scholar import isolated_registry
    with isolated_registry():
      theirs = load_session(self.NAME)
      [decision] = theirs.decisions
      decision.paper = replace(decision.paper, **changes)
      save_session(theirs)

  @staticmethod
  def _decide_and_save(session):
    session.decisions[0].status = DecisionStatus.KEPT
    session.decisions[0].tags = ["ml"]
    save_session(session)
