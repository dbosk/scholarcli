Filters are part of a search's key (\cref{sec:search-record-key}).
Let's verify it with the two runs of
\url{https://github.com/dbosk/scholar/issues/140}: one query on one
provider, once per year range, appended to one session.  Both records
must survive with their own filters and hits, each paper must link to
the run that returned it, and the failed re-run rule must still apply
within one filter set---and only there: a failed run with new filters
is a failed search, which an answer of other filters cannot stand in
for.  Everything goes through the real
[[create_review_session]], [[save_session]] and [[load_session]].

<<test functions>>=
class TestFiltersInSearchKey:
    """A query run with other filters is a search of its own (#140)."""

    OLD = {"year": "2010-2019"}
    NEW = {"year": "2020-2024"}

    @staticmethod
    def _result(papers, filters, error=None):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="Q", provider="openalex", timestamp="t", papers=papers,
            filters=filters, error=error,
        )

    def _two_runs(self):
        old = Paper(title="Old", authors=["A"], doi="10.1/fk-old")
        new = Paper(title="New", authors=["B"], doi="10.1/fk-new")
        both = Paper(title="Both", authors=["C"], doi="10.1/fk-both")
        save_session(create_review_session(
            [self._result([old, both], self.OLD)], "Q", session_name="fk",
        ))
        save_session(create_review_session(
            [self._result([new, both], self.NEW)], "Q", session_name="fk",
        ))
        return load_session("fk")

    def test_both_runs_keep_their_record(self):
        session = self._two_runs()
        records = {
            r.filters["year"]: r.hits for r in session.search_records
        }
        assert records == {"2010-2019": 2, "2020-2024": 2}

    def test_each_paper_links_to_its_run(self):
        links = {d.paper.doi: d.found_by for d in self._two_runs().decisions}
        old_key, new_key = filters_key(self.OLD), filters_key(self.NEW)
        assert links["10.1/fk-old"] == [("Q", "openalex", old_key)]
        assert links["10.1/fk-new"] == [("Q", "openalex", new_key)]
        assert links["10.1/fk-both"] == [
            ("Q", "openalex", old_key), ("Q", "openalex", new_key),
        ]

    def test_links_resolve_to_their_own_record(self):
        session = self._two_runs()
        for decision in session.decisions:
            for query, provider, key in decision.found_by:
                record = session.search_record(query, provider, key)
                assert filters_key(record.filters) == key

    def test_failed_rerun_with_same_filters_keeps_the_answer(self):
        self._two_runs()
        session = create_review_session(
            [self._result([], self.OLD, error="HTTP 503")],
            "Q", session_name="fk",
        )
        old = [r for r in session.search_records if r.filters == self.OLD]
        assert [(r.hits, r.error) for r in old] == [(2, None)]
        assert len(session.search_records) == 2

    def test_failed_run_with_other_filters_stays_failed(self):
        paper = Paper(title="Old", authors=["A"], doi="10.1/fk-old")
        save_session(create_review_session(
            [self._result([paper], self.OLD)], "Q", session_name="fk",
        ))
        session = create_review_session(
            [self._result([], self.NEW, error="HTTP 503")],
            "Q", session_name="fk",
        )
        outcomes = {
            r.filters["year"]: (r.hits, r.error)
            for r in session.search_records
        }
        assert outcomes == {
            "2010-2019": (1, None), "2020-2024": (0, "HTTP 503"),
        }

    def test_concurrent_saves_keep_both_records(self):
        first = Paper(title="Old", authors=["A"], doi="10.1/fk-old")
        save_session(create_review_session(
            [self._result([first], self.OLD)], "Q", session_name="fk",
        ))
        stale = load_session("fk")
        save_session(create_review_session(
            [self._result([first], self.NEW)], "Q", session_name="fk",
        ))
        stale.decisions[0].status = DecisionStatus.KEPT
        save_session(stale)
        session = load_session("fk")
        assert sorted(r.filters["year"] for r in session.search_records) == [
            "2010-2019", "2020-2024",
        ]
        assert len(session.decisions[0].found_by) == 2
        assert session.decisions[0].status == DecisionStatus.KEPT
