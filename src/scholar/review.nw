A link is written as an object rather than a list, so that the two
forms tell themselves apart by the presence of [[filters]], not by
length or position: a resolved link carries its filters key (the empty
string for an unfiltered search), an unresolved old link carries none.
Reading applies the rule above, through [[search_record]], which answers
a link without filters only when one record has its query and provider.

<<review session functions>>=
def _found_by_link_data(link: tuple[str, str, str | None]) -> dict:
    """Serialise one `found_by` link; an unresolved link has no filters."""
    query, provider, key = link
    data = {"query": query, "provider": provider}
    if key is not None:
        data["filters"] = key
    return data


def _load_found_by_link(
    session: ReviewSession, data: dict
) -> tuple[str, str, str | None]:
    """Read one `found_by` link, resolving an old one if it is certain."""
    query, provider = data["query"], data["provider"]
    if "filters" in data:
        return (query, provider, data["filters"])
    record = session.search_record(query, provider)
    return (query, provider, record.key[2] if record else None)
@

The test makes the race happen on purpose.  Process~A's merge starts
process~B's save in a thread and gives it half a second.  Without the
lock, B writes its decision in that half second and A then replaces the
file with a merge of what it read before, so B's decision is gone.
With the lock, B waits, re-reads A's file and merges, and both
decisions survive.

<<test functions>>=
def test_simultaneous_saves_keep_both(tmp_path, monkeypatch):
    import threading
    import scholar.review as review

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    TestConcurrentSaves()._create()
    first = load_session("race")
    second = load_session("race")
    first.decisions[0].status = DecisionStatus.KEPT
    second.decisions[1].status = DecisionStatus.KEPT
    merge = review.merge_concurrent_changes
    threads = []

    def slow_merge(session, on_disk):
        if not threads:
            threads.append(threading.Thread(
                target=save_session, args=(second,)
            ))
            threads[0].start()
            threads[0].join(0.5)
        merge(session, on_disk)

    monkeypatch.setattr(review, "merge_concurrent_changes", slow_merge)
    save_session(first)
    threads[0].join(5)
    final = {d.paper.title: d.status for d in load_session("race").decisions}
    assert final["Paper 0"] == DecisionStatus.KEPT
    assert final["Paper 1"] == DecisionStatus.KEPT
