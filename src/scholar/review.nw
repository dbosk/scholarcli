class TestPairingMatchesTheReferenceAtRandom:
  """Random sessions pair as the reference pairs them (#316)."""

  TITLES = ["Work A", "Work B", "Work C", "Work D"]
  AUTHORS = ["Ada Example", "Example A."]
  CASES = 400

  def _decision(self, rng):
    return ReviewDecision(
      paper=Paper(title=rng.choice(self.TITLES),
                  authors=[self.AUTHORS[0]], year=2020),
      provider=rng.choice(["openalex", "dblp"]),
      status=rng.choice(list(DecisionStatus)),
      tags=list(rng.choice([[], ["a"], ["b"]])),
      found_by=list(rng.choice([[], [("q1", "openalex", "")],
                                [("q2", "dblp", "")]])),
    )

  def _change(self, rng, decisions, folded=None):
    kind = rng.choice(["rename", "drop", "insert", "swap", "decide",
                       "link", "provider", "fold"])
    if kind == "insert" or not decisions:
      decisions.insert(rng.randint(0, len(decisions)), self._decision(rng))
      return
    i = rng.randrange(len(decisions))
    decision = decisions[i]
    if kind == "rename":
      decision.paper = Paper(title=decision.paper.title,
                             authors=[rng.choice(self.AUTHORS)], year=2020)
    elif kind == "drop":
      del decisions[i]
    elif kind == "swap":
      j = rng.randrange(len(decisions))
      decisions[i], decisions[j] = decisions[j], decisions[i]
    elif kind == "decide":
      decision.status = rng.choice(list(DecisionStatus))
      decision.tags = list(rng.choice([[], ["a"], ["b"]]))
    elif kind == "link":
      decision.record_search(rng.choice(["q1", "q2"]), "openalex", "")
    elif kind == "provider":
      decision.provider = rng.choice(["openalex", "dblp", "s2"])
    elif folded is not None:
      del decisions[i]
      folded[get_paper_id(decision.paper)] = "doi:10.5555/target"

  def _case(self, rng):
    loaded = [self._decision(rng) for _ in range(rng.randint(0, 8))]
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime(2026, 11, 23))
    session.decisions = loaded
    if rng.random() < 0.9:
      session._baseline = SessionBaseline.of(session, from_file=True)
      assign_baseline_keys(session)
    on_disk = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime(2026, 11, 23))
    on_disk.decisions = [
      replace(d, tags=list(d.tags), found_by=list(d.found_by),
              baseline_key=None)
      for d in loaded
    ]
    session.decisions = list(loaded)
    for _ in range(rng.randint(0, 4)):
      self._change(rng, session.decisions)
    for _ in range(rng.randint(0, 4)):
      self._change(rng, on_disk.decisions, on_disk.folded)
    return session, on_disk

  def test_random_sessions(self):
    import random
    rng = random.Random(316)
    paired = additions = copies = 0
    for _ in range(self.CASES):
      session, on_disk = self._case(rng)
      pairs, added = assert_pairing_matches_reference(session, on_disk)
      paired += len(pairs)
      additions += len(added)
      ids = [get_paper_id(d.paper) for d in session.decisions]
      copies += len(ids) - len(set(ids))
    assert paired > 500 and additions > 50 and copies > 200, (
      paired, additions, copies)
