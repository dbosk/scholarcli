class TestSearchRecordOutcome:
    """create_review_session records what each search returned."""

    @staticmethod
    def _result(provider, papers, error=None, retries=0):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="q", provider=provider, timestamp="t", papers=papers,
            error=error, retries=retries,
        )

    def test_failure_recorded(self):
        paper = Paper(title="P", authors=["A"], sources=["openalex"])
        session = create_review_session([
            self._result("dblp", [], error="non-JSON response", retries=2),
            self._result("openalex", [paper]),
