ADOPTED = "doi:10.48550/race-pre"

def _rename_race(self, stale, other):
  """Both processes rename the drawn paper; return the saved file's
  renames, the held ids and the id the sample names."""
  import json
  import subprocess
  import sys
  import textwrap
  from scholar.review import _get_sessions_dir
  from scholar.scholar import isolated_registry

  with isolated_registry():
    save_session(ReviewSession(
      query="q", providers=["dblp"], timestamp=datetime(2026, 11, 23),
      name=self.RACE, decisions=[ReviewDecision(
        paper=self.OLD, provider="dblp", status=DecisionStatus.DISCARDED,
        tags=["off-topic-false-hit"], source=ReviewSource.LLM_UNREVIEWED,
      )],
      tier_samples=[TierSample(
        sample_id="r", drawn_at="2026-11-23T10:00:00+00:00", seed=1,
        size=1, rule={}, rest=1, rest_digest="d", papers=[self.OLD.id])],
    ))
  code = {
    wait: textwrap.dedent(template).replace("WAIT",
                                            self.WAIT if wait else "")
    for template, wait in ((stale, True), (other, False))
  }
  first = subprocess.Popen(
    [sys.executable, "-c", code[True]],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
  )
  try:
    assert first.stdout.readline().strip() == "loaded"
    subprocess.run([sys.executable, "-c", code[False]], check=True,
                   timeout=120)
    first.communicate("go\n", timeout=120)
  finally:
    if first.poll() is None:
      first.kill()
  assert first.returncode == 0
  data = json.loads((_get_sessions_dir() / f"{self.RACE}.json").read_text())
  with isolated_registry():
    session = load_session(self.RACE)
  decided = sorted((d.paper.id, d.status.value) for d in session.decisions)
  [draw] = session.tier_samples
  return data["renamed"], decided, draw.papers[0]

def test_the_adopting_process_saves_last(self):
  renamed, decided, drawn = self._rename_race(self.ADOPT, self.RENAME)
  assert renamed == {self.OLD.id: self.ADOPTED}
  assert decided == sorted([(self.ADOPTED, "discarded"),
                            (self.NEW.id, "discarded")])
  assert drawn == self.ADOPTED

def test_the_appending_process_saves_last(self):
  renamed, decided, drawn = self._rename_race(self.RENAME, self.ADOPT)
  assert renamed == {self.OLD.id: self.NEW.id}
  assert decided == sorted([(self.ADOPTED, "discarded"),
                            (self.NEW.id, "discarded")])
  assert drawn == self.ADOPTED
