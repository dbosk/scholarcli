class TestSupersededMergedRecords:
    """Per-provider re-runs supersede an old merged record."""

    MERGED = SearchRecord("q | q", "openalex, dblp", None, 100, hits=7)

    def _covered(self, dblp, merged=None):
        openalex = SearchRecord("q", "openalex", None, 100, hits=4)
        return merged_record_cover(merged or self.MERGED, [openalex, dblp])

    def test_answered_cover(self):
        dblp = SearchRecord("q", "dblp", None, 100, hits=3)
        assert self._covered(dblp) is not None
        assert self._covered(SearchRecord("q", "dblp", None, 1000, hits=3))

    def test_failed_or_skipped_cover_does_not_count(self):
        for error in ("HTTP 500", "skipped: daily quota spent; resets 01:00"):
            dblp = SearchRecord("q", "dblp", None, 100, hits=0, error=error)
            assert self._covered(dblp) is None
        partial = SearchRecord("q", "dblp", None, 100, hits=2, error="cut")
        assert self._covered(partial) is not None

    def test_narrower_cover_does_not_count(self):
        dblp = SearchRecord("q", "dblp", None, 5, hits=3)
        assert self._covered(dblp) is None
        unknown = SearchRecord("q | q", "openalex, dblp", {"year": "2020"},
                               None, hits=7)
        assert merged_record_cover(unknown, [
            SearchRecord("q", "openalex", {"year": "2020"}, 5, hits=4),
            SearchRecord("q", "dblp", {"year": "2020"}, 5, hits=3),
        ]) is not None

    def test_other_filters_or_query_do_not_count(self):
        dblp = SearchRecord("q", "dblp", {"year": "2020"}, 100, hits=3)
        assert self._covered(dblp) is None
        merged = SearchRecord("q | r", "openalex, dblp", None, 100, hits=7)
        dblp = SearchRecord("q", "dblp", None, 100, hits=3)
        assert self._covered(dblp, merged) is None
        assert self._covered(SearchRecord("r", "dblp", None, 100, hits=3),
                             merged) is not None

    @staticmethod
    def _old_session(name):
        import json
        from scholar.review import _get_sessions_dir
        merged_link = {"query": "q | q", "provider": "openalex, dblp",
                       "filters": ""}

        def decision(doi):
            return {
                "paper_id": f"doi:{doi}", "provider": "openalex, dblp",
                "status": "kept", "tags": [], "source": "human",
                "found_by": [merged_link],
                "paper": {"title": doi, "authors": ["A"], "doi": doi,
                          "sources": ["openalex"]},
            }

        path = _get_sessions_dir() / f"{name}.json"
        path.write_text(json.dumps({
            "query": "q", "name": name, "providers": ["openalex, dblp"],
            "timestamp": datetime.now().isoformat(),
            "search_records": [{
                "query": "q | q", "provider": "openalex, dblp",
                "filters": None, "limit": 100, "hits": 2, "error": None,
                "retries": 0,
            }],
            "decisions": [decision("10.1/sm-again"), decision("10.1/sm-old")],
        }))
        return path

    @staticmethod
    def _result(provider, dois):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="q", provider=provider, timestamp="t", limit=100,
            papers=[Paper(title=d, authors=["A"], doi=d) for d in dois],
        )

    def test_full_cover_replaces_and_repoints(self):
        self._old_session("sm-full")
        merged = self._result("openalex", ["10.1/sm-again"]).merge(
            self._result("dblp", [])
        )
        created = create_review_session([merged], "q",
                                        session_name="sm-full")
        assert [r.provider for r in created.search_records] == [
            "openalex", "dblp",
        ]
        save_session(created)
        session = load_session("sm-full")
        assert [r.provider for r in session.search_records] == [
            "openalex", "dblp",
        ]
        links = {d.paper.doi: d.found_by for d in session.decisions}
        assert links["10.1/sm-again"] == [("q", "openalex", "")]
        assert links["10.1/sm-old"] == [
            ("q", "openalex", ""), ("q", "dblp", ""),
        ]

    def test_failed_cover_keeps_record_and_links(self):
        self._old_session("sm-failed")
        merged = self._result("openalex", ["10.1/sm-again"]).merge(
            self._result("dblp", [])
        )
        merged.parts[1].error = "HTTP 500"
        save_session(create_review_session([merged], "q",
                                           session_name="sm-failed"))
        session = load_session("sm-failed")
        assert sorted(r.provider for r in session.search_records) == [
            "dblp", "openalex", "openalex, dblp",
        ]
        old = next(d for d in session.decisions
                   if d.paper.doi == "10.1/sm-old")
        assert old.found_by == [("q | q", "openalex, dblp", "")]

    def test_partial_cover_keeps_the_merged_record(self):
        self._old_session("sm-part")
        save_session(create_review_session(
            [self._result("openalex", ["10.1/sm-again"])], "q",
            session_name="sm-part",
        ))
        session = load_session("sm-part")
        assert sorted(r.provider for r in session.search_records) == [
            "openalex", "openalex, dblp",
        ]
        old = next(d for d in session.decisions
                   if d.paper.doi == "10.1/sm-old")
        assert old.found_by == [("q | q", "openalex, dblp", "")]

    def test_a_save_drops_it_from_the_file_too(self):
        self._old_session("sm-save")
        stale = load_session("sm-save")
        merged = self._result("openalex", ["10.1/sm-again"]).merge(
            self._result("dblp", [])
        )
        save_session(create_review_session([merged], "q",
                                           session_name="sm-save"))
        stale.decisions[0].status = DecisionStatus.DISCARDED
        stale.decisions[0].tags = ["off-topic"]
        save_session(stale)
        session = load_session("sm-save")
        assert [r.provider for r in session.search_records] == [
            "openalex", "dblp",
        ]
        assert all(
            link[1] != "openalex, dblp"
            for d in session.decisions for link in d.found_by
        )
