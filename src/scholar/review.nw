def outcome_unknown(record: SearchRecord) -> bool:
    """Whether the record cannot tell if its search answered.

    True for records written before outcomes were kept: no hit count
    and no error.
    """
    return record.hits is None and not record.error


def decision_provider_names(session: ReviewSession) -> set[str]:
    """The providers, lower-cased, that some decision of the session names.

    Each decision's names are read through `decision_provider_evidence`.
    """
    return {
        name.lower()
        for decision in session.decisions
        for name in decision_provider_evidence(decision)
    }


def unrecorded_providers(session: ReviewSession) -> list[str]:
    """The providers known only from searches without an outcome."""
    answered = set(searched_providers(session))
    return list(dict.fromkeys(
        name
        for record in session.search_records
        if outcome_unknown(record)
        for name in record.merged_providers
        if name not in answered
    ))


def unrecorded_text(session: ReviewSession) -> str:
    """`unrecorded_providers` as a comma-separated list for the report."""
    return ", ".join(unrecorded_providers(session))
