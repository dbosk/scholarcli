<<review session functions>>=
def save_refusal_cause(error: BaseException) -> tuple[str, str]:
    """The cause (a key of `SAVE_REFUSALS`) and reason of a refusal."""
    if isinstance(error, KeyboardInterrupt):
        return "interrupted", "interrupted while waiting for the lock"
    return ("held" if error.held else "lock-file"), error.reason


def lock_refusal(error: LockNotTaken) -> SessionNotSaved:
    """The error of a command refused its lock before changing anything."""
    cause, reason = save_refusal_cause(error)
    return SessionNotSaved(error.path, None, reason, cause=cause)


def refused_save(
    session: ReviewSession, session_path: Path, error: BaseException
) -> SessionNotSaved:
    """Keep `session` beside `session_path` where possible; return the
    `SessionNotSaved` to raise for `error` (a `LockNotTaken` or a
    `KeyboardInterrupt` during the wait)."""
    cause, reason = save_refusal_cause(error)
    directory = session_path.parent
    if not os.access(directory, os.W_OK):
        return SessionNotSaved(
            session_path, None, reason, cause=cause,
            keep_error=f"the directory {directory} is not writable",
        )
    interrupt = InterruptHeldBack()
    try:
        with interrupt:
            unsaved = keep_unsaved_session(session, session_path)
    except OSError as write_error:
        return SessionNotSaved(
            session_path, None, reason, cause=cause,
            keep_error=str(write_error),
        )
    except KeyboardInterrupt:
        refusal = SessionNotSaved(
            session_path, None, reason, cause=cause,
            keep_error="interrupted while it was being kept",
        )
        refusal.interrupted = True
        return refusal
    refusal = SessionNotSaved(session_path, unsaved, reason, cause=cause)
    refusal.interrupted = refusal.interrupted or interrupt.arrived
    return refusal
