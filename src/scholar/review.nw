  appended = create_review_session([SearchResult(
    query="q", provider="openalex", timestamp="t", papers=[paper],
  )], "q", session_name="screen-copy")
  [previous] = loaded
  copied = appended.decisions[0].screenings
  assert copied == previous.decisions[0].screenings
  assert copied is not previous.decisions[0].screenings

