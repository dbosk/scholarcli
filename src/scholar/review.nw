class TestSameIdDecisions:
  """Two decisions under one id survive appends and saves (#228)."""

  HASH = legacy_hash_paper_id("A Study", ["Ada Lovelace"])
  LINK = ("q", "scopus", "")

  def _save_pair(self):
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = ReviewSession(query="q", providers=["openalex", "scopus"],
                              timestamp=datetime.now(), name="pair")
      session.decisions = [
        ReviewDecision(
          paper=Paper(title="A Study", authors=["Ada Lovelace"], year=2014),
          provider="openalex", status=DecisionStatus.DISCARDED,
          tags=["off-topic"]),
        ReviewDecision(
          paper=Paper(title="A Study", authors=["A. Lovelace"], year=2014),
          provider="scopus", status=DecisionStatus.KEPT, tags=["theme"],
          found_by=[self.LINK]),
      ]
      save_session(session)

  def _copies(self):
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = load_session("pair")
    return session, [
      (d.status.value, d.provider, d.tags, d.found_by)
      for d in session.decisions if d.paper.id == self.HASH
    ]

  def _append(self, paper):
    from scholar.scholar import SearchResult, isolated_registry
    result = SearchResult(query="q", provider="s2", timestamp=datetime.now(),
                          papers=[paper], limit=10)
    with isolated_registry():
      save_session(create_review_session([result], "q", session_name="pair"))

  def test_an_append_keeps_both_copies(self):
    self._save_pair()
    self._append(Paper(title="Another Study", authors=["Bo Ek"], year=2020))
    session, copies = self._copies()
    assert copies == [
      ("discarded", "openalex", ["off-topic"], []),
      ("kept", "scopus", ["theme"], [self.LINK]),
    ]
    [conflict] = conflicting_copies(session)
    assert len(conflict.decisions) == 2

  def test_the_returned_paper_attaches_to_the_first_copy(self):
    self._save_pair()
    self._append(Paper(title="A Study", authors=["Ada Lovelace"], year=2014))
    _, copies = self._copies()
    assert copies == [
      ("discarded", "openalex, s2", ["off-topic"], [("q", "s2", "")]),
      ("kept", "scopus", ["theme"], [self.LINK]),
    ]

  @pytest.mark.parametrize("changed", [0, 1])
  def test_a_concurrent_save_keeps_each_copys_change(self, changed):
    self._save_pair()
    mine = load_session("pair")
    other = load_session("pair")
    copy = other.decisions[changed]
    copy.status, copy.tags = DecisionStatus.KEPT, ["changed"]
    save_session(other)
    save_session(mine)
    _, copies = self._copies()
    expected = [
      ("discarded", "openalex", ["off-topic"], []),
      ("kept", "scopus", ["theme"], [self.LINK]),
    ]
    expected[changed] = ("kept",) + expected[changed][1:2] + (
      ["changed"], expected[changed][3])
    assert copies == expected

  def test_resetting_a_copy_is_not_taken_for_a_loss(self, caplog):
    self._save_pair()
    session = load_session("pair")
    session.decisions[0].status = DecisionStatus.PENDING
    session.decisions[0].tags = []
    save_session(session)
    session = load_session("pair")
    session.decisions[1].status = DecisionStatus.PENDING
    with caplog.at_level("WARNING"):
      save_session(session)
    assert "reduces the decided papers" not in caplog.text
@

The order of the copies is not a safe guide on its own: it changes
under the save's feet.  This process can rename a copy, so that the
copy after it becomes the first of its id; another process can drop a
copy (a Scholar from before this change does, at its next append),
swap two, put a new copy first, or fold one away
(\url{https://github.com/dbosk/scholarcli/pull/238}, review).  Each
time, pairing the copies by their places paired each with the wrong
one, and statuses, providers and links passed between them.  The tests
play each case with the pair of a Scopus name written surname first, so
that a re-run renames the first copy, and check every copy by its
provider: each keeps its own status, tags and links, a change the other
process made reaches the copy it was made on, and a fold is not undone.
Three more pin the keys: a copy renamed away stays away also when the
other process changed it in the file; the keys follow the order a save
wrote, not the order loaded; and a pair that a session without a file
built from the decision store (\cref{sec:decision-store-fallback})
has its keys from the build.  For that one, the other process is a
copy of the built session, since the build migrates the store's ids
and a second build would see another store.  Copies in one state that
another process swapped keep their own links, whether the copies differ
in provider and links, in links only, or in provider only once this
process has added a link to both, so that neither copy's links are as
the file holds them.

