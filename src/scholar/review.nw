VERSION_LINK_FIELDS = ("preprint_versions", "published_versions")
ACCUMULATED_PAPER_FIELDS = frozenset(
    {"sources", "keywords", "tags", "citation_count", *VERSION_LINK_FIELDS}
)


def paper_merged_from(
    ours: Paper, theirs: Paper, base_state: tuple | None
) -> Paper:
    """`ours`, with the fields that only `theirs` changed taken from it.

    `base_state` is the paper's `paper_state` as loaded from or last
    saved to the file `theirs` comes from. A field `ours` still has as
    there, and `theirs` holds otherwise and not as None, takes the value
    of `theirs`; a group of fields (`PAPER_FIELD_GROUPS`) is decided as
    a whole, by its first field. The accumulated fields
    (`ACCUMULATED_PAPER_FIELDS`) are never taken: version links are
    united (`united_version_links`), the others left to
    `Paper.merge_with`. The Crossref notices (`CROSSREF_NOTICE_FIELDS`)
    are united (`united_crossref_notices`) when there is no baseline or
    both copies changed them. Gaps are then filled (`paper_filled_from`),
    except in a group that ours holds. Without a baseline no field is
    taken. Returns `ours` itself when nothing changes, or when `theirs`
    is another work. Neither argument is modified.
    """
    if theirs is ours or not plausibly_same_work(ours, theirs):
        return ours
    base = dict(zip(PAPER_STATE_FIELDS, base_state or ()))
    changed_there, ours_whole = {}, {}
    <<decide each group of paper fields whole>>
    <<take the single paper fields only the file changed>>
    <<unite the Crossref notices both copies found>>
    for name in VERSION_LINK_FIELDS:
        links = united_version_links(getattr(ours, name), getattr(theirs, name))
        if frozen_value(links) != frozen_value(getattr(ours, name)):
            changed_there[name] = links
    resolved = replace(ours, **changed_there) if changed_there else ours
    merged = paper_filled_from(resolved, theirs)
    if any(getattr(merged, name) != value
           for name, value in ours_whole.items()):
        merged = replace(merged, **ours_whole)
    return merged
