def hand_abstracts_sentence(decisions) -> str:
    """One sentence counting the papers whose abstract was given by hand.

    Empty when there are none.
    """
    papers = {
        get_paper_id(d.paper) for d in decisions
        if d.abstract_set and not hand_abstract_replaced(d)
    }
    if not papers:
        return ""
    if len(papers) == 1:
        return ("1 paper has an abstract added by hand, with where it "
                "was found recorded in the session.")
    return (f"{len(papers)} papers have abstracts added by hand, with "
            "where each was found recorded in the session.")
