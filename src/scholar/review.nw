def abstract_gap_parts(gap: AbstractGap) -> list[str]:
    """The parts of `gap.without`, e.g. `3 every source asked had none`."""
    return [
        f"{count} {what}"
        for count, what in (
            (gap.none_found, "every source asked had none"),
            (gap.not_asked, "not asked (no DOI, or no source available)"),
            (gap.failed, "a lookup failed"),
            (gap.no_record, "no record of a lookup"),
        )
        if count
    ]
