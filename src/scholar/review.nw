class TestSessionCopies:
  @staticmethod
  def _result(provider, papers, query="q"):
    from scholar.scholar import SearchResult
    return SearchResult(
      query=query, provider=provider, timestamp="t", papers=papers,
    )

  def _append(self, provider, papers, query="q"):
    session = create_review_session(
      [self._result(provider, papers, query)], query,
      session_name="copies",
    )
    save_session(session)
    return load_session("copies")

  @staticmethod
  def _saved_papers():
    """The papers as saved: this process's registry hands a load the
    `Paper` objects it already holds, with their old metadata."""
    import json
    from scholar.review import _get_sessions_dir
    data = json.loads((_get_sessions_dir() / "copies.json").read_text())
    return [d["paper"] for d in data["decisions"]]

  @staticmethod
  def _noted_ids():
    from scholar.notes import list_papers_with_notes
    return {note.paper_id for note in list_papers_with_notes()}

  def _two_copies(self, bare_decision, doi_decision, doi="10.1145/race",
                  bare_year=2021):
    """Save a session holding a DOI-less and a DOI copy of one work."""
    bare = Paper(title="A Work", authors=["Ada Lovelace"], year=bare_year)
    with_doi = Paper(title="A Work", authors=["Ada Lovelace"], year=2021,
                     doi=doi)
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime.now(), name="copies")
    session.decisions = [
      ReviewDecision(paper=bare, provider="dblp", status=bare_decision[0],
                     tags=list(bare_decision[1])),
      ReviewDecision(paper=with_doi, provider="openalex",
                     status=doi_decision[0], tags=list(doi_decision[1])),
    ]
    save_session(session)
    return bare, with_doi

  @staticmethod
  def _decide_copy(with_doi, status, tags):
    """Another process decides one copy and saves."""
    other = load_session("copies")
    for decision in other.decisions:
      if bool(decision.paper.doi) == with_doi:
        decision.status, decision.tags = status, list(tags)
    save_session(other)

  @staticmethod
  def _states():
    return {
      d.paper.id: (d.status, d.tags) for d in load_session("copies").decisions
    }

  def _decide(self, session, status, tags=()):
    for decision in session.decisions:
      decision.status, decision.tags = status, list(tags)
    save_session(session)

  def test_a_namesake_years_apart_is_noted_not_merged(self):
    old = Paper(title="Editorial", authors=["J. Smith"], year=2018,
                venue="CACM")
    session = self._append("dblp", [old])
    self._decide(session, DecisionStatus.KEPT, ["ml"])
    new = Paper(title="Editorial", authors=["J. Smith"], year=2023,
                venue="IEEE Software", abstract="Other text.")
    session = self._append("openalex", [new], query="q2")
    [decision] = session.decisions
    [saved] = self._saved_papers()
    assert (saved["year"], saved["venue"]) == (2018, "CACM")
    assert saved.get("abstract") is None
    assert decision.status == DecisionStatus.KEPT
    assert decision.same_id_copies == [
      {"year": 2023, "venue": "IEEE Software", "provider": "openalex"},
    ]
    assert all(link[0] != "q2" for link in decision.found_by)
    [conflict] = conflicting_copies(session)
    assert copy_conflict_line(conflict) == (
      f"Editorial ({decision.paper.id}): kept as 2018, CACM; also "
      "returned as 2023, IEEE Software (openalex); probably different "
      "works sharing one id"
    )

  def test_the_note_survives_later_appends_and_concurrent_saves(self):
    old = Paper(title="Editorial", authors=["J. Smith"], year=2018)
    new = Paper(title="Editorial", authors=["J. Smith"], year=2023)
    self._append("dblp", [old])
    stale = load_session("copies")
    self._append("openalex", [new], query="q2")
    session = create_review_session(
      [self._result("dblp", [old])], "q", session_name="copies",
    )
    assert session.decisions[0].same_id_copies == [
      {"year": 2023, "venue": None, "provider": "openalex"},
    ]
    save_session(session)
    stale.decisions[0].status = DecisionStatus.KEPT
    save_session(stale)
    session = load_session("copies")
    assert session.decisions[0].status == DecisionStatus.KEPT
    assert len(session.decisions[0].same_id_copies) == 1

  def test_a_namesake_in_one_run_is_noted(self):
    a = Paper(title="Editorial", authors=["J. Smith"], year=2018)
    b = Paper(title="Editorial", authors=["J. Smith"], year=2023)
    session = create_review_session(
      [self._result("dblp", [a]), self._result("hal", [b])], "q",
    )
    [decision] = session.decisions
    assert decision.paper.year == 2018
    assert decision.same_id_copies == [
      {"year": 2023, "venue": None, "provider": "hal"},
    ]
    assert copy_conflict_line(conflicting_copies(session)[0]).endswith(
      "pending as 2018; also returned as 2023 (hal); probably different "
