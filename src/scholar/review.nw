        provider="dblp", status=DecisionStatus.DISCARDED,
        tags=["adjacent-subtopic"],
      ),
      ReviewDecision(
        paper=Paper(title="", authors=["Cy Untitled"]),
        provider="dblp", status=DecisionStatus.PENDING,
      ),
    ]
    two = ReviewSession(query="q2", providers=["openalex"],
                        timestamp=datetime.now(), name="two")
    two.decisions = [
      ReviewDecision(
        paper=Paper(title="Preprint version", authors=["Di Do"],
                    doi="10.48550/arXiv.2401.00001",
                    published_versions=[{"doi": "10.1/PUB",
                                         "relation": "preprint-of"}]),
        provider="arxiv", status=DecisionStatus.KEPT,
        tags=["qualifies-claim"],
      ),
      ReviewDecision(
        paper=Paper(title="Rejected", authors=["Ed Ek"], doi="10.1/rej"),
        provider="openalex", status=DecisionStatus.DISCARDED,
        tags=["supports-claim"],
      ),
      ReviewDecision(
        paper=Paper(title="Supporting", authors=["Ann Smith"],
                    doi="10.1/sup"),
        provider="openalex", status=DecisionStatus.PENDING,
      ),
    ]
    return [one, two]

  def _returned(self):
    return [
      Paper(title="Supporting", authors=["A. Smith"],
            doi="https://doi.org/10.1/sup"),
      Paper(title="No DOI Here", authors=["Berg, Bo"], doi="10.9/other"),
      Paper(title="Published version", authors=["Di Do"], doi="10.1/pub"),
      Paper(title="Rejected", authors=["Ed Ek"], doi="10.1/REJ"),
      Paper(title="", authors=["Cy Untitled"]),
      Paper(title="Brand new", authors=["Fy Fa"], doi="10.9/new"),
    ]

  def test_buckets_and_how_works_matched(self):
    rows, _ = check_against_sessions(self._returned(), self._sessions())
    assert [r.rank for r in rows] == [1, 2, 3, 4, 5, 6]
    assert [r.bucket for r in rows] == [
      "bearing", "adjacent", "bearing", "excluded",
      "not in any session", "not in any session",
    ]
    by_doi = rows[0].matches
    assert {(m.session, m.status, m.category, m.matched_by)
            for m in by_doi} == {
      ("one", "kept", "supports-claim", "doi"),
      ("two", "pending", None, "doi"),
    }
    assert [(m.matched_by, m.bucket) for m in rows[1].matches] \
      == [("title+author", "adjacent")]
    assert [(m.session, m.matched_by) for m in rows[2].matches] \
      == [("two", "doi")]
    assert rows[4].matches == []
    assert check_tally(rows) == {
      "bearing": 2, "adjacent": 1, "excluded": 1, "not in any session": 2,
    }

  def test_known_studies(self):
    _, known = check_against_sessions(
      self._returned(), self._sessions(),
      known=["https://doi.org/10.1/PUB", "brand NEW", "10.1/rej",
             "10.7/absent", "preprint VERSION"],
    )
    placed = [(k.known, k.rank, k.bucket) for k in known]
    assert placed == [
      ("https://doi.org/10.1/PUB", 3, "bearing"),
      ("brand NEW", 6, "not in any session"),
      ("10.1/rej", 4, "excluded"),
      ("10.7/absent", None, "not in any session"),
      ("preprint VERSION", None, "bearing"),
    ]
    assert known[4].matches[0].session == "two"
    assert known[4].matches[0].matched_by == "title"

  def test_a_doi_is_not_a_title_part(self):
    _, known = check_against_sessions(
      [Paper(title="About 10.1/sup", authors=["X"], doi="10.5/x")],
      self._sessions(), known=["10.1/sup"],
    )
    assert known[0].rank is None
    assert known[0].bucket == "bearing"
