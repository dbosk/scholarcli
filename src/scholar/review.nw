  session = self._session("screen-copy")
  record_screening(session.decisions[0], self._verdict())
  save_session(session)
  loaded = []
  own = scholar.review.load_own_session

  def keep_loaded(*args, **kwargs):
    loaded.append(own(*args, **kwargs))
    return loaded[-1]

  monkeypatch.setattr(scholar.review, "load_own_session", keep_loaded)
  paper = Paper(title="Screened", authors=["Ada Lovelace"], year=2021,
