    )

  def test_a_doi_paper_does_not_take_a_distant_doi_less_decision(self):
    old = Paper(title="A Work", authors=["Ada Lovelace"], year=2010)
    session = self._append("dblp", [old])
    self._decide(session, DecisionStatus.DISCARDED, ["off-topic-false-hit"])
    new = Paper(title="A Work", authors=["Ada Lovelace"], year=2020,
                doi="10.1145/far")
    session = self._append("openalex", [new])
    statuses = {d.paper.id: d.status for d in session.decisions}
    assert statuses["doi:10.1145/far"] == DecisionStatus.PENDING

  def test_an_append_never_folds(self):
    pending, kept = (DecisionStatus.PENDING, []), (DecisionStatus.KEPT, ["ml"])
    bare, with_doi = self._two_copies(pending, kept)
    session = self._append("dblp", [bare], query="q2")
    assert len(session.decisions) == 2
    assert len(foldable_copies(session)) == 1
    assert possible_copies(session) == []
    assert r"\item[Foldable copies] 1, see \texttt{scholar sessions " \
      "reconcile}" in report_work_items(session)

  def test_reconcile_folds_and_then_moves_the_note(self):
    from scholar.notes import save_note, get_note
    pending, kept = (DecisionStatus.PENDING, []), (DecisionStatus.KEPT, ["ml"])
    bare, with_doi = self._two_copies(pending, kept, doi="10.1145/fold")
    save_note(bare, "read the DBLP copy")
    assert reconcile_session("copies") == [(bare.id, "doi:10.1145/fold")]
    session = load_session("copies")
    [decision] = session.decisions
    assert decision.paper.doi == "10.1145/fold"
    assert (decision.status, decision.tags) == (DecisionStatus.KEPT, ["ml"])
    assert decision.provider == "openalex, dblp"
