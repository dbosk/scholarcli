AUDIT_RECORD_CRITERIA: frozenset[str] = frozenset({
    "no-abstract",
    "insufficient-information",
})


def audit_copy_rank(
    decision: ReviewDecision,
    order: int,
    *,
    theme_names: dict[str, str],
    notes: dict[str, str],
) -> tuple[int, int, int]:
    """Rank a copy of a work for representing its audit row; lower wins.

    A confirmed (not unreviewed) keep or discard of the work comes first;
    a discard of only the record (another version, or a criterion in
    `AUDIT_RECORD_CRITERIA`) does not.  Then `order`, the place `audit_reason` gave
    the copy, then confirmed before unreviewed.
    """
    unreviewed = decision.source.is_unreviewed
    about_record = decision.status == DecisionStatus.DISCARDED and (
        audit_version_note(decision)
        or audit_exclusion_criterion(
            decision, theme_names=theme_names, notes=notes
        ) in AUDIT_RECORD_CRITERIA
    )
    about_work = decision.status in (
        DecisionStatus.KEPT, DecisionStatus.DISCARDED,
    ) and not about_record
    tier = 0 if about_work and not unreviewed else 1
    return (tier, order, 1 if unreviewed else 0)
