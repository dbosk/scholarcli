                paper=Paper(title="Spacing", authors=["A"], year=2020,
                            doi="10.1234/unrecorded-188"),
                provider="scopus", status=DecisionStatus.PENDING,
            ),
        ]
        return session

    def test_providers(self):
        session = self._session()
        assert searched_providers(session) == ["scopus", "openalex"]
        assert unrecorded_providers(session) == ["dblp"]
        assert unsearched_providers(session) == []

    def test_items_and_abstract(self):
        session = self._session()
        items = dict(search_parameter_items(session))
        assert items["Providers"] == "scopus, openalex"
        assert items["Outcome not recorded"] == "dblp"
        assert "Not searched" not in items
        abstract = build_review_report_abstract(session)
        assert "The search covered scopus, openalex and" in abstract
        assert "Outcome not recorded: dblp." in abstract

    def test_joined_provider_string_counts(self):
        for joined in ("scopus, dblp", "scopus; DBLP", "scopus | dblp"):
            session = self._session()
            session.decisions[0].provider = joined
            assert searched_providers(session) == [
                "dblp", "scopus", "openalex",
            ], joined
            assert unrecorded_providers(session) == [], joined
