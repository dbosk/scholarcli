The relabel and the reset.  A relabel corrects the snapshot of the
relabelled verdict, and only that one: a verdict a command recorded
stays as it was, and so does a snapshot of an earlier verdict.  A reset
keeps the list, sets its records aside and says how many in its own
record; after it, the paper decided anew gets a new snapshot.

<<screening record test methods>>=
def test_a_relabel_corrects_the_snapshot(self):
  decision = self._llm_call(source=ReviewSource.HUMAN)
  record_human_decision(decision, "decide", by="the author", at=self.AT)
  verdict = new_screening(kind="human", name="the author",
                          status="discarded", tags=["off-topic-false-hit"],
                          recorded_at=self.AT)
  snapshot = record_screening(decision, verdict)
  record = relabel_source(decision, ReviewSource.AGENT_UNREVIEWED,
                          self.LATER)
  corrected = decision.screenings[0]
  assert corrected["id"] == snapshot["id"]
  assert (corrected["kind"], corrected["name"], corrected["at"]) \
    == ("agent", None, None)
  assert corrected["relabelled_at"] == self.LATER
  assert record["screenings_kind"] == "human"
  assert record["human"]["human_by"] == "the author"
  assert decision.screenings[1] == verdict
  assert record_screening(decision, self._agent_verdict(
    recorded_at=self.LATER)) is None

def test_a_relabel_keeps_what_the_snapshot_claimed(self):
  decision = self._llm_call()
  snapshot = record_screening(decision, self._agent_verdict())
  relabel_source(decision, ReviewSource.AGENT_UNREVIEWED, self.LATER)
  relabel_source(decision, ReviewSource.LLM_UNREVIEWED,
                 "2026-11-20T12:00:00+00:00")
  corrected = decision.screenings[0]
  assert corrected["before_relabel"] == {
    name: snapshot[name] for name in SNAPSHOT_FIELDS
  }
  assert corrected["before_relabel"]["reason"] == "Off topic."
  assert corrected["before_relabel"]["prompt_version"] \
    == "0123456789abcdef"
  assert corrected["kind"] == "llm"
  assert corrected["relabelled_at"] == "2026-11-20T12:00:00+00:00"

def test_two_versions_of_a_record_keep_both_corrections(self):
  decision = self._llm_call()
  snapshot = record_screening(decision, self._agent_verdict())
  marked = {**snapshot, "set_aside_at": self.LATER}
  relabelled = {**snapshot, "kind": "agent",
                "relabelled_at": "2026-11-20T12:00:00+00:00"}
  decision.add_screening(marked)
  decision.add_screening(snapshot)
  assert decision.screenings[0] == marked
  decision.add_screening(relabelled)
  assert decision.screenings[0] == {**relabelled,
                                    "set_aside_at": self.LATER}
  assert counted_screenings(decision) == [decision.screenings[1]]

def test_a_relabel_without_a_snapshot_writes_the_old_record(self):
  decision = self._llm_call(source=ReviewSource.HUMAN)
  record = relabel_source(decision, ReviewSource.AGENT_UNREVIEWED, self.AT)
  assert "screenings_kind" not in record

def test_a_reset_sets_the_screenings_aside(self):
  decision = self._llm_call()
  record_screening(decision, self._agent_verdict())
  before = list(decision.screenings)
  assert len(counted_screenings(decision)) == 2
  record = reset_decision(decision, self.LATER)
  assert record["screenings"] == 2
  assert decision.screenings == before
  assert counted_screenings(decision) == []
  decision.status, decision.tags = DecisionStatus.DISCARDED, ["off-topic"]
  decision.source = ReviewSource.LLM_UNREVIEWED
  decision.llm_model = "m-1"
  snapshot = record_screening(decision, self._agent_verdict(
    recorded_at="2026-11-20T12:00:00+00:00"))
  assert snapshot is not None
  assert len(counted_screenings(decision)) == 2
  assert "screenings" not in reset_decision(self._llm_call(), self.AT)

def test_malformed_entries_are_kept_and_skipped(self):
  decision = self._llm_call()
  verdict = self._agent_verdict()
  decision.screenings = [{"status": "kept"}, "a note", verdict]
  assert counted_screenings(decision) == [verdict]
  decision.add_screening({"status": "kept"})
  assert len(decision.screenings) == 3
