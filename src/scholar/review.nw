                                "filters": None, "limit": 100,
                                "hits": 3, "error": None, "retries": 0}],
            "decisions": [],
        }
        (_get_sessions_dir() / "via-old.json").write_text(json.dumps(old))
        [record] = load_session("via-old").search_records
