class TestStoredOneReasonRuns:
  """One-reason runs count once each in the session-wide pool (#291)."""

  REASON = "No abstract; the title shows an unrelated subject."

  def _decision(self, n, at, reason=None):
    return ReviewDecision(
      paper=Paper(title=f"Rule Work {n}", authors=["A"],
                  doi=f"10.5555/rule-{n}"),
      provider="p", status=DecisionStatus.DISCARDED, tags=["t"],
      source=ReviewSource.AGENT_UNREVIEWED, agent_by="agent",
      agent_decided_at=at, agent_reason=reason or self.REASON,
    )

  def _check(self, decisions):
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime(2026, 11, 20))
    session.decisions = decisions
    return stored_batch_check(session)

  def test_one_record_per_call_adds_up(self):
    check = self._check([
      self._decision(n, f"2026-11-20T10:{n:02d}:00+00:00")
      for n in range(15)
    ])
    [shared] = check.shared["agent decisions"]
    assert shared.count == 15
    assert shared.papers[:2] == ("doi:10.5555/rule-0", "doi:10.5555/rule-1")
    assert all(run.findings == () for run in check.runs)

  def test_each_rule_run_counts_once(self):
    def runs(count):
      return [
        self._decision(100 * r + n, f"2026-11-20T{10 + r:02d}:00:00+00:00")
        for r in range(count) for n in range(8)
      ]

    three = self._check(runs(3))
    assert three.shared["agent decisions"] == []
    assert [len(run.findings) for run in three.runs] == [1, 1, 1]
    twelve = self._check(runs(12))
    [shared] = twelve.shared["agent decisions"]
    assert shared.count == 12
    assert "(12 rows)" in shared.detail

  def test_a_large_rule_run_and_nine_more(self):
    rule = [self._decision(n, "2026-11-20T10:00:00+00:00")
            for n in range(300)]
    other = [self._decision(
      1000 + n, "2026-11-20T11:00:00+00:00",
      self.REASON if n < 9 else f"Work {n} is about topic {n}.",
    ) for n in range(30)]
    check = self._check(rule + other)
    [shared] = check.shared["agent decisions"]
    assert shared.count == 10
    assert check.runs[0].findings[0].kind == "one-reason"
