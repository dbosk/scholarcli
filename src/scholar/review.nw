The label is the one place that decides how a record's outcome reads,
for [[sessions show]] and the report alike; for a record of one search
it is [[hits_label]] (\cref{sec:search-result-error} in the
[[scholar]] module).

<<review data structures>>=
def search_outcome_label(record: SearchRecord) -> str:
    """Describe a search record's outcome; "" when nothing is known.

    A merged record (see `SearchRecord.is_merged`) is labelled as such,
    since its count and errors cannot be attributed to its providers.
    """
    if record.is_merged:
        details = []
        if record.hits is not None:
            details.append(f"{record.hits} papers in total")
        if record.error:
            details.append(f"errors: {record.error}")
        label = (
            f"merged record (providers {', '.join(record.merged_providers)})"
            ": outcome cannot be split"
        )
        return label + (f" ({'; '.join(details)})" if details else "")
    return hits_label(
        record.hits, record.error, record.retries,
        ranked=is_ranked_provider(record.provider),
        total=record.total, limit=record.limit,
        estimated=record.total_estimated,
    )
