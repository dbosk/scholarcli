The label is the one place that decides how a record's outcome reads,
for [[sessions show]] and the report alike; for a record of one search
it is [[hits_label]] (\cref{sec:search-result-error} in the
[[scholar]] module).

<<review data structures>>=
def search_outcome_label(record: SearchRecord) -> str:
    """Describe a search record's outcome; "" when nothing is known.

    A merged record (see `SearchRecord.is_merged`) is labelled as such,
    since its count and errors cannot be attributed to its providers.
    """
    if record.is_merged:
        details = []
        if record.hits is not None:
            details.append(f"{record.hits} papers in total")
        if record.error:
            details.append(f"errors: {record.error}")
        label = (
            f"merged record (providers {', '.join(record.merged_providers)})"
            ": outcome cannot be split"
        )
        return label + (f" ({'; '.join(details)})" if details else "")
    return hits_label(
        record.hits, record.error, record.retries,
        ranked=is_ranked_provider(record.provider),
        total=record.total, limit=record.limit,
        estimated=record.total_estimated,
    )
@

A record's dates are described in words for the same views.  An
answer fetched during the run needs only the run's date; a cached one
names the date it was fetched, or says that the cache does not know it
(an answer cached before fetch dates were kept), never the run's date
in its place (\url{https://github.com/dbosk/scholar/issues/167}).
[[search_source_date]] is the one date a coverage statement can use,
the date the database itself was asked: the fetch date when known,
otherwise the run's date unless the answer came from the cache.  A
provider that does not say whether it answered from a cache (one from
outside scholar) is taken to have been asked when the search ran, the
only date there is.  A search that failed outright, or was skipped,
has no such date: the database answered nothing, and a date would let
the coverage statement count it as searched.  The caption and the
report leave such records out of their period
([[answered_records]]).

<<review data structures>>=
def search_dates_label(record: SearchRecord) -> str:
    """Describe when a search ran and its answer was fetched; "" if unknown."""
    searched = (record.searched_at or "")[:10]
    fetched = (record.fetched_at or "")[:10]
    if not searched and not fetched:
        return ""
    if record.from_cache:
        cached = (
            f"cached answer fetched {fetched}" if fetched
            else "cached answer, fetch date unknown"
        )
        return f"searched {searched}, {cached}" if searched else cached
    if not searched:
        return f"fetched {fetched}"
    if fetched and fetched != searched:
        return f"searched {searched}, fetched {fetched}"
    return f"searched {searched}"


def search_source_date(record: SearchRecord) -> str | None:
    """The date (YYYY-MM-DD) the database answered the search, if known.

    None for a search that failed outright or was skipped, since the
    database answered nothing.
    """
    if record.error and not record.hits:
        return None
    if record.fetched_at:
        return record.fetched_at[:10]
    if record.from_cache or not record.searched_at:
        return None
    return record.searched_at[:10]


def answered_records(records: list[SearchRecord]) -> list[SearchRecord]:
    """The records whose search did not fail outright (or was skipped)."""
    return [r for r in records if not (r.error and not r.hits)]
@

<<test functions>>=
class TestSearchDatesLabel:
    """Dates of a search, worded for display (#167)."""

    def test_labels(self):
        def record(**dates):
            return SearchRecord("q", "openalex", None, 100, hits=1, **dates)

        run = "2026-11-18T09:00:00+00:00"
        october = "2026-10-02T08:00:00+00:00"
        assert search_dates_label(record()) == ""
        assert search_dates_label(record(
            searched_at=run, fetched_at=run, from_cache=False,
        )) == "searched 2026-11-18"
        assert search_dates_label(record(
            searched_at=run, fetched_at=october, from_cache=True,
        )) == "searched 2026-11-18, cached answer fetched 2026-10-02"
        assert search_dates_label(record(
            searched_at=run, from_cache=True,
        )) == "searched 2026-11-18, cached answer, fetch date unknown"

    def test_source_date(self):
        run = "2026-11-18T09:00:00+00:00"
        october = "2026-10-02T08:00:00+00:00"
        assert search_source_date(SearchRecord(
            "q", "p", searched_at=run, fetched_at=october, from_cache=True,
        )) == "2026-10-02"
        assert search_source_date(SearchRecord(
            "q", "p", searched_at=run, from_cache=True,
        )) is None
        assert search_source_date(SearchRecord(
            "q", "p", searched_at=run,
        )) == "2026-11-18"
        assert search_source_date(SearchRecord("q", "p")) is None

    def test_failed_or_skipped_search_has_no_date(self):
        run = "2026-11-18T09:00:00+00:00"
        skipped = SearchRecord(
            "q", "ieee", hits=0, searched_at=run,
            error="skipped: daily quota spent; resets 01:00",
        )
        assert search_source_date(skipped) is None
        partial = SearchRecord("q", "dblp", hits=3, error="cut short",
                               searched_at=run, fetched_at=run,
                               from_cache=False)
        assert search_source_date(partial) == "2026-11-18"
        answered = SearchRecord("q", "openalex", hits=2,
                                fetched_at="2026-10-02T08:00:00+00:00")
        assert audit_dates_sentence(
            AUDIT_STRINGS["en"], [skipped, answered]
        ) == "Searched 2026-10-02."
