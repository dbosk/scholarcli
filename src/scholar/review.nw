\paragraph{Kept files pile up.}
Every refused save keeps a whole copy of its session: a command tried
three times while the lock stays held leaves three kept files, each a
full session.  (A refused recovery adds none: it removes the copy its
save made, since the file it recovers already holds that session.)
They are not removed automatically, since each holds the changes of
its own run, which the others may lack, and only the user knows which
to merge: the newest run of a TUI review holds that review, but a
second run of [[sessions decide]] holds only its own decisions.  So
[[sessions list]] names them, and [[sessions recover --discard]]
deletes one ([[discard_unsaved_session]]), after checking that it is a
kept file: its name has the kept files' mark and it reads as one.

<<review session functions>>=
def discard_unsaved_session(path: str | os.PathLike) -> Path:
    """Delete the kept file `path` (a path, or a name in the sessions
    directory); return it.

    Raises `SessionFileError`, deleting nothing, unless its name holds
    `.json` + `UNSAVED_MARK` and it reads as a kept file.
    """
    path = Path(path)
    if not path.exists() and not path.is_absolute():
        path = _get_sessions_dir() / path
    if f".json{UNSAVED_MARK}" not in path.name:
        raise SessionFileError(
            path, ValueError("not the name of a kept session")
        )
    read_kept_file(path)
    path.unlink()
    return path
@

Let's verify it with real processes: another process loads the
session, saves a decision of its own and keeps holding the lock, as a
process stuck in mid-save would.  Our save, with a short timeout set
through the module's constants, must say that it waits, then leave the
session file byte for byte as it was, keep our session beside it and
name both files.  A recovery while the lock is still held changes
nothing and leaves one kept file; once the other process has let go, it
merges: both decisions are in the file, and the kept file is gone.

<<test functions>>=
class TestSaveWhenTheLockIsHeld:
  """A save that cannot take the lock writes nothing to the file (#316)."""

  HOLDER = """
    import sys
    from scholar.review import (
      DecisionStatus, load_session, save_session, session_file_path,
    )
    from scholar.utils import file_lock
    session = load_session("held")
    with file_lock(session_file_path(session)):
      session.decisions[1].status = DecisionStatus.KEPT
      session.decisions[1].tags = ["theirs"]
      save_session(session)
      print("holding", flush=True)
      sys.stdin.readline()
  """

  @staticmethod
  def _make(tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime(2026, 11, 23), name="held")
    session.decisions = [
      ReviewDecision(paper=Paper(title=f"Held {i}", authors=["A"],
                                 doi=f"10.5555/held-{i}"),
                     provider="openalex")
      for i in range(3)
    ]
    return save_session(session)

  def _hold(self):
    import subprocess
    import sys
    import textwrap
    holder = subprocess.Popen(
      [sys.executable, "-c", textwrap.dedent(self.HOLDER)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    assert holder.stdout.readline().strip() == "holding"
    return holder

  @staticmethod
  def _release(holder):
    holder.communicate("go\n", timeout=60)
    assert holder.returncode == 0

  @staticmethod
  def _short_wait(monkeypatch):
    import scholar.review as review
    monkeypatch.setattr(review, "SESSION_LOCK_TIMEOUT", 0.6)
    monkeypatch.setattr(review, "SESSION_LOCK_NOTICE", 0.2)

  def test_nothing_is_written_and_the_session_is_kept(
    self, tmp_path, monkeypatch, caplog
  ):
    import json
    path = self._make(tmp_path, monkeypatch)
    ours = load_session("held")
    ours.decisions[0].status = DecisionStatus.KEPT
    ours.decisions[0].tags = ["ours"]
    holder = self._hold()
    try:
      before = path.read_bytes()
      self._short_wait(monkeypatch)
      with caplog.at_level("WARNING"):
        with pytest.raises(SessionNotSaved) as raised:
          save_session(ours)
      assert path.read_bytes() == before
    finally:
      if holder.poll() is None:
        holder.kill()
    error = raised.value
    assert error.path == path and error.unsaved.parent == path.parent
    assert error.unsaved.name.startswith("held.json.unsaved-")
    assert str(path) in str(error) and str(error.unsaved) in str(error)
    assert "\n" not in str(error)
    kept = json.loads(error.unsaved.read_text())
    assert kept.pop(UNSAVED_KEY)["target"] == "held.json"
    assert kept == json.loads(json.dumps(session_file_data(ours)))
    assert [r.message for r in caplog.records].count(
      f"{path} is locked by another scholar process; waited 0.2 s, "
      f"waiting up to 0.4 s more{KEEP_SESSION_HINT}") == 1
    assert unsaved_session_files() == [error.unsaved]

  def test_recovery_merges_once_the_lock_is_free(
    self, tmp_path, monkeypatch
  ):
    from scholar.scholar import isolated_registry
    path = self._make(tmp_path, monkeypatch)
    ours = load_session("held")
    ours.decisions[0].status = DecisionStatus.KEPT
    ours.decisions[0].tags = ["ours"]
    holder = self._hold()
    try:
      self._short_wait(monkeypatch)
      with pytest.raises(SessionNotSaved) as raised:
        save_session(ours)
      unsaved = raised.value.unsaved
      before = path.read_bytes()
      with isolated_registry(), pytest.raises(SessionNotSaved) as again:
        recover_unsaved_session(unsaved)
      assert again.value.unsaved == unsaved
      assert path.read_bytes() == before
      assert unsaved_session_files() == [unsaved]
      self._release(holder)
    finally:
      if holder.poll() is None:
        holder.kill()
    with isolated_registry():
      assert recover_unsaved_session(unsaved.name) == path
    assert unsaved_session_files() == []
    with isolated_registry():
      saved = load_session("held")
    assert [(d.status.value, d.tags) for d in saved.decisions] == [
      ("kept", ["ours"]), ("kept", ["theirs"]), ("pending", []),
    ]

  def test_a_session_file_is_not_a_kept_one(self, tmp_path, monkeypatch):
    path = self._make(tmp_path, monkeypatch)
    with pytest.raises(SessionFileError):
      recover_unsaved_session(path)
