class TestNewPaperOfASameFileAppend:
    """A paper new in a same-file append yields to the file (#214)."""

    BUILD = """
        import sys
        from scholar.scholar import Paper, SearchResult
        from scholar.review import (
            DecisionStatus, create_review_session, save_session,
        )
        result = SearchResult(
            query="foo", provider="openalex", timestamp="t",
            papers=[Paper(title="New", authors=["B"],
                          doi="10.5555/wp214-new")],
        )
        session = create_review_session([result], "foo", "foo")
        [new] = [d for d in session.decisions
                 if d.paper.doi == "10.5555/wp214-new"]
    """

    def test_another_processs_decision_on_a_new_paper_wins(
        self, tmp_path, monkeypatch
    ):
        import subprocess
        import sys
        import textwrap
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        session = ReviewSession(
            query="foo", providers=["openalex"],
            timestamp=datetime(2026, 11, 19), name="foo",
        )
        session.decisions = [ReviewDecision(
            paper=Paper(title="Old", authors=["A"], doi="10.5555/wp214-old"),
            provider="openalex",
        )]
        path = save_session(session)

        first = subprocess.Popen(
            [sys.executable, "-c", textwrap.dedent(self.BUILD)
             + textwrap.dedent("""
                print("built", flush=True)
                sys.stdin.readline()
                save_session(session)
             """)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
        )
        try:
            assert first.stdout.readline().strip() == "built"
            subprocess.run(
                [sys.executable, "-c", textwrap.dedent(self.BUILD)
                 + textwrap.dedent("""
                    new.status, new.tags = DecisionStatus.KEPT, ["t1"]
                    save_session(session)
                 """)],
                check=True, timeout=120,
            )
            first.communicate("go\n", timeout=120)
        finally:
            if first.poll() is None:
                first.kill()
        assert first.returncode == 0
        saved = {
            d["paper"]["doi"]: (d["status"], d["tags"])
            for d in json.loads(path.read_text())["decisions"]
        }
        assert saved == {
            "10.5555/wp214-old": ("pending", []),
            "10.5555/wp214-new": ("kept", ["t1"]),
        }
@

\paragraph{A session that loaded nothing.}
The same race has a third form, with no file at all to begin with.  Two
processes run [[search foo -n new]] at the same time: both find no
session, both build one from the same results, and the second decides a
paper and saves first, creating the file.  The first process then saves
a session that loaded nothing, so it had no baseline, and every decision
it holds counted as its own: its pending decision replaced the second
process's.  A brand-new session is no different from a session saved
into another file than it loaded: what it holds when
[[create_review_session]] returns it is what it built, not what the
user decided, so it takes that state as its baseline as well.  The same
goes for a session rebuilt from the old per-query decision store
(\cref{sec:decision-store-fallback}), which loaded no session file
either.

Nothing else depended on such a session having no baseline.  Its built
baseline holds only papers that the session holds, so the papers only
the file has are still added; its research context is empty unless the
caller sets one after the build, and an unchanged empty context then
takes the file's, as the rule for a missing baseline did, while a
context set after the build is a change and wins, as a non-empty one
did; it holds no legacy records, since every search records its limit
(\cref{sec:search-record-key}), so the legacy-record rule finds nothing
to drop; and [[warn_if_decisions_dropped]] reads the baseline only to
count the decisions this process reset to pending, which with a built
baseline are those decided at the build (restored from the decision
store) and pending at the save.  A session constructed in code, not
through [[create_review_session]], still has no baseline.

Let's verify it with real processes, as for the same-file append.

<<test functions>>=
class TestNewSessionRace:
    """Two processes creating one new session: the decision wins."""

    BUILD = """
        import sys
        from scholar.scholar import Paper, SearchResult
        from scholar.review import (
            DecisionStatus, create_review_session, save_session,
        )
        result = SearchResult(
            query="foo", provider="openalex", timestamp="t",
            papers=[Paper(title="New", authors=["B"],
                          doi="10.5555/wp214-fresh")],
        )
        session = create_review_session([result], "foo", "fresh")
        [new] = session.decisions
    """

    def test_the_first_saved_decision_survives(self, tmp_path, monkeypatch):
        import subprocess
        import sys
        import textwrap
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        path = tmp_path / "review_sessions" / "fresh.json"

        first = subprocess.Popen(
            [sys.executable, "-c", textwrap.dedent(self.BUILD)
             + textwrap.dedent("""
                print("built", flush=True)
                sys.stdin.readline()
                save_session(session)
             """)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
        )
        try:
            assert first.stdout.readline().strip() == "built"
            assert not path.exists()
            subprocess.run(
                [sys.executable, "-c", textwrap.dedent(self.BUILD)
                 + textwrap.dedent("""
                    new.status, new.tags = DecisionStatus.KEPT, ["t1"]
                    save_session(session)
                 """)],
                check=True, timeout=120,
            )
            first.communicate("go\n", timeout=120)
        finally:
            if first.poll() is None:
                first.kill()
        assert first.returncode == 0
        [saved] = json.loads(path.read_text())["decisions"]
        assert (saved["status"], saved["tags"]) == ("kept", ["t1"])

    def test_a_decision_after_the_build_still_wins(
        self, tmp_path, monkeypatch
    ):
        """The other order: the first process decides after its build."""
        import subprocess
        import sys
        import textwrap
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        path = tmp_path / "review_sessions" / "fresh.json"

        first = subprocess.Popen(
            [sys.executable, "-c", textwrap.dedent(self.BUILD)
             + textwrap.dedent("""
                print("built", flush=True)
                sys.stdin.readline()
                new.status, new.tags = DecisionStatus.DISCARDED, ["p1"]
                save_session(session)
             """)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
        )
        try:
            assert first.stdout.readline().strip() == "built"
            subprocess.run(
                [sys.executable, "-c", textwrap.dedent(self.BUILD)
                 + textwrap.dedent("""
                    new.status, new.tags = DecisionStatus.KEPT, ["t1"]
                    save_session(session)
                 """)],
                check=True, timeout=120,
            )
            first.communicate("go\n", timeout=120)
        finally:
            if first.poll() is None:
                first.kill()
        assert first.returncode == 0
        [saved] = json.loads(path.read_text())["decisions"]
        assert (saved["status"], saved["tags"]) == ("discarded", ["p1"])
