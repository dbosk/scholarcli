class TestCheckAuthorlessMatch:
  """A match between two papers without authors is a title match."""

  @pytest.mark.parametrize("found_doi", [None, "10.1/found"],
                           ids=["no-doi", "doi"])
  def test_authorless_pair_matches_by_title(self, found_doi):
    held = Paper(title="Account recovery study", authors=[], year=2020)
