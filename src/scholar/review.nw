    work = audit_work_key(session.decisions[0].paper)
    rows = collect_audit_rows(
      session, theme_names={}, strings=AUDIT_STRINGS["en"],
      cited_works=set(),
    )
    assert rows[0].reason == "kept, not cited in the text: ml " \
      "(duplicate record of a cited source)"
