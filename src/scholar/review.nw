        )) == "searched 2026-11-18"
        assert search_dates_label(record(
            searched_at=run, fetched_at=october, from_cache=True,
        )) == "searched 2026-11-18, cached answer fetched 2026-10-02"
        assert search_dates_label(record(
            searched_at=run, from_cache=True,
        )) == "searched 2026-11-18, cached answer, fetch date unknown"

    def test_source_date(self):
