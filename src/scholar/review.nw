  session = self._session("screen-relabel")
  session.decisions[0].source = ReviewSource.HUMAN
  record_screening(session.decisions[0], self._verdict())
  save_session(session)
  stale = self._load_apart("screen-relabel")
  relabeller = self._load_apart("screen-relabel")
  relabel_source(relabeller.decisions[0], ReviewSource.AGENT_UNREVIEWED,
                 "2026-11-20T11:00:00+00:00")
  save_session(relabeller)
  record_screening(stale.decisions[0], self._verdict(
    "agent-3", at="2026-11-20T12:00:00+00:00"))
  save_session(stale)
  saved = self._load_apart("screen-relabel").decisions[0]
  assert saved.source is ReviewSource.AGENT_UNREVIEWED
  kinds = [(r["origin"], r["kind"]) for r in saved.screenings]
  assert kinds == [("decision", "agent"), ("screen", "agent"),
                   ("screen", "agent")]
@

The races are played in real processes, in both save orders, since
that is how they happen: a [[sessions screen]] and a reset, or a
relabel, that both loaded the session before either saved.  The
screening is recorded an hour after the reset's time, so that only the
mark, not the time rule, can set it aside.  Each process prints a line
once it has loaded the session and waits for one before it changes
anything; the test reads the saved file itself.

<<test functions>>=
class TestScreeningRaces:
  """A screening and a reset or a relabel, saved in either order (#253)."""

  <<screening race test methods>>

<<screening race test methods>>=
NAME = "screen-race"
SCREEN = """
  from scholar.review import (
    load_session, new_screening, record_screening, save_session,
  )
  session = load_session("screen-race")
  WAIT
  record_screening(session.decisions[0], new_screening(
    kind="agent", name="agent-2", status="kept", tags=["t"],
    recorded_at="2026-11-20T11:00:00+00:00"))
  save_session(session)
"""
RESET = """
  from scholar.review import load_session, reset_decision, save_session
  session = load_session("screen-race")
  WAIT
  reset_decision(session.decisions[0], "2026-11-20T10:00:00+00:00")
  save_session(session)
"""
RELABEL = """
  from scholar.review import (
    ReviewSource, load_session, relabel_source, save_session,
  )
  session = load_session("screen-race")
  WAIT
  relabel_source(session.decisions[0], ReviewSource.AGENT_UNREVIEWED,
                 "2026-11-20T10:00:00+00:00")
  save_session(session)
"""
WAIT = 'import sys; print("loaded", flush=True); sys.stdin.readline()'

def _first_save(self, source):
  from scholar.scholar import isolated_registry

  with isolated_registry():
    decision = ReviewDecision(
      paper=Paper(title="A Race", authors=["Ada Lovelace"], year=2021,
                  doi="10.5555/screen-race"),
      provider="openalex", status=DecisionStatus.DISCARDED,
      tags=["off-topic"], source=source, llm_model="m-1",
      llm_reason="Off topic.", llm_decided_at="2026-11-01T09:00:00+00:00",
    )
    if source is ReviewSource.HUMAN:
      record_human_decision(decision, "decide", by="the author",
                            at="2026-11-01T09:00:00+00:00")
    save_session(ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
      name=self.NAME, decisions=[decision],
    ))

def _code(self, template, wait):
  import textwrap

  return textwrap.dedent(template).replace(
    "WAIT", self.WAIT if wait else "")

def _race(self, source, stale, other):
  """`stale` loads and waits; `other` runs whole; then `stale` saves."""
  import json
  import subprocess
  import sys
  from scholar.review import _get_sessions_dir
  from scholar.scholar import isolated_registry

  self._first_save(source)
  first = subprocess.Popen(
    [sys.executable, "-c", self._code(stale, wait=True)],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
  )
  try:
    assert first.stdout.readline().strip() == "loaded"
    subprocess.run([sys.executable, "-c", self._code(other, wait=False)],
                   check=True, timeout=120)
    first.communicate("go\n", timeout=120)
  finally:
    if first.poll() is None:
      first.kill()
  assert first.returncode == 0
  path = _get_sessions_dir() / f"{self.NAME}.json"
  saved = json.loads(path.read_text())["decisions"][0]
  with isolated_registry():
    return saved, load_session(self.NAME).decisions[0]

def _assert_set_aside(self, saved, decision):
  assert saved["status"] == "pending"
  assert [r["origin"] for r in saved["screenings"]] \
    == ["decision", "screen"]
  assert all(r["set_aside_at"] == "2026-11-20T10:00:00+00:00"
             for r in saved["screenings"])
  assert counted_screenings(decision) == []

def test_a_screening_saved_before_a_concurrent_reset(self):
  saved, decision = self._race(ReviewSource.LLM_UNREVIEWED,
                               self.RESET, self.SCREEN)
  self._assert_set_aside(saved, decision)

def test_a_screening_saved_after_a_concurrent_reset(self):
  saved, decision = self._race(ReviewSource.LLM_UNREVIEWED,
                               self.SCREEN, self.RESET)
  self._assert_set_aside(saved, decision)

def _assert_corrected(self, saved):
  assert saved["source"] == "agent"
  snapshot, screening = saved["screenings"]
  assert (snapshot["origin"], snapshot["kind"], snapshot["name"]) \
    == ("decision", "agent", None)
  assert snapshot["relabelled_at"] == "2026-11-20T10:00:00+00:00"
  assert snapshot["before_relabel"]["kind"] == "human"
  assert snapshot["before_relabel"]["name"] == "the author"
  assert (screening["kind"], screening["name"]) == ("agent", "agent-2")
  assert "set_aside_at" not in snapshot

def test_a_screening_saved_before_a_concurrent_relabel(self):
  saved, _ = self._race(ReviewSource.HUMAN, self.RELABEL, self.SCREEN)
  self._assert_corrected(saved)

def test_a_screening_saved_after_a_concurrent_relabel(self):
  saved, _ = self._race(ReviewSource.HUMAN, self.SCREEN, self.RELABEL)
  self._assert_corrected(saved)
@

