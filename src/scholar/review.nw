      provider="wos", status=DecisionStatus.KEPT, tags=["ml"],
    ))
    readings = [
      Paper(title="Proust in Maceio", authors=["Natacha Lopez Gallucci"],
            year=2026),
      Paper(title="Proust in Maceio", authors=["Lopez Gallucci, Natacha"],
            year=2026),
    ]
    assert match_cited_entries([("lg", readings[:1])], session)[0].works \
      == []
    found = match_cited_entries([("lg", readings)], session)[0]
    assert (found.matched_by, found.works) \
      == ("title+author", [("proustinmaceio", "lopezgallucci")])

