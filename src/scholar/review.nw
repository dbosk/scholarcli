class TestAppendBaselineFollowsTheFile:
    """An append's baseline describes the file it is saved to (#207)."""

    @staticmethod
    def _session(name, query, decisions, context=None):
        session = ReviewSession(
            query=query, providers=["openalex"],
            timestamp=datetime(2026, 11, 19), name=name,
            research_context=context,
        )
        session.add_query_provider_pair(query, "openalex")
        session.decisions = decisions
        return session

    @staticmethod
    def _decision(paper, status=DecisionStatus.PENDING, tags=()):
        return ReviewDecision(
            paper=paper, provider="openalex", status=status, tags=list(tags),
        )

    @staticmethod
    def _paper(doi):
        return Paper(title=f"Paper {doi}", authors=["A"], doi=doi)

    @staticmethod
    def _result(query, papers):
        result = Mock()
        result.provider = "openalex"
        result.query = query
        result.filters = None
        result.limit = None
        result.papers = papers
        return result

    @staticmethod
    def _saved(path):
        data = json.loads(path.read_text())
        statuses = {
            d["paper_id"]: (d["status"], d["tags"]) for d in data["decisions"]
        }
        return statuses, data.get("research_context")

    def _target_decisions(self):
        """The target file's own decisions: both discarded."""
        return [
            self._decision(self._paper("10.5555/wp207-shared"),
                           DecisionStatus.DISCARDED, ["off-topic"]),
            self._decision(self._paper("10.5555/wp207-new"),
                           DecisionStatus.DISCARDED, ["off-topic"]),
        ]

    def _search(self):
        return self._result("foo", [self._paper("10.5555/wp207-new"),
                                    self._paper("10.5555/wp207-shared")])

    def _assert_target_kept(self, path):
        statuses, context = self._saved(path)
        assert statuses["doi:10.5555/wp207-new"] == (
            "discarded", ["off-topic"])
        assert statuses["doi:10.5555/wp207-shared"] == (
            "discarded", ["off-topic"])
        assert context == "target context"

    def test_unnamed_append_keeps_the_hash_files_decisions(
        self, tmp_path, monkeypatch
    ):
        """`search foo --review` beside foo.json saves the hash file."""
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        save_session(self._session("foo", "bar", [
            self._decision(self._paper("10.5555/wp207-shared"),
                           DecisionStatus.KEPT, ["t1"]),
        ], context="loaded context"))
        target = save_session(self._session(
            None, "foo", self._target_decisions(),
            context="target context",
        ))

        session = create_review_session([self._search()], "foo")
        assert save_session(session) == target
        self._assert_target_kept(target)

    def test_named_append_keeps_a_file_created_meanwhile(
        self, tmp_path, monkeypatch
    ):
        """`search bar -n foo` beside the hash file; foo.json appears."""
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        save_session(self._session(None, "foo", [
            self._decision(self._paper("10.5555/wp207-shared"),
                           DecisionStatus.KEPT, ["t1"]),
        ], context="loaded context"))

        session = create_review_session([self._search()], "bar", "foo")
        target = save_session(self._session(
            "foo", "bar", self._target_decisions(),
            context="target context",
        ))
        assert save_session(session) == target
        self._assert_target_kept(target)

    @staticmethod
    def _homonym(number=" 0001"):
