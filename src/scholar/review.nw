A record's dates are described in words for the same views.  An
answer fetched during the run needs only the run's date; a cached one
names the date it was fetched, or says that the cache does not know it
(an answer cached before fetch dates were kept), never the run's date
in its place (\url{https://github.com/dbosk/scholar/issues/167}).
[[search_source_date]] is the one date a coverage statement can use,
the date the database itself was asked: the fetch date when known,
otherwise the run's date unless the answer came from the cache.  A
provider that does not say whether it answered from a cache (one from
outside scholar) is taken to have been asked when the search ran, the
only date there is.  A search that failed outright, or was skipped,
has no such date: the database answered nothing, and a date would let
the coverage statement count it as searched.  The caption and the
report leave such records out of their period
([[answered_records]]).

<<review data structures>>=
def search_dates_label(record: SearchRecord) -> str:
    """Describe when a search ran and its answer was fetched; "" if unknown."""
    searched = (record.searched_at or "")[:10]
    fetched = (record.fetched_at or "")[:10]
    if not searched and not fetched:
        return ""
    if record.from_cache:
        cached = (
            f"cached answer fetched {fetched}" if fetched
            else "cached answer, fetch date unknown"
        )
        return f"searched {searched}, {cached}" if searched else cached
    if not searched:
        return f"fetched {fetched}"
    if fetched and fetched != searched:
        return f"searched {searched}, fetched {fetched}"
    return f"searched {searched}"


def search_source_date(record: SearchRecord) -> str | None:
    """The date (YYYY-MM-DD) the database answered the search, if known.

    None for a search that failed outright or was skipped, since the
    database answered nothing.
    """
    if record.error and not record.hits:
        return None
    if record.fetched_at:
        return record.fetched_at[:10]
    if record.from_cache or not record.searched_at:
        return None
    return record.searched_at[:10]


def answered_records(records: list[SearchRecord]) -> list[SearchRecord]:
    """The records whose search did not fail outright (or was skipped)."""
    return [r for r in records if not (r.error and not r.hits)]
