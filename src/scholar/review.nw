def _caption_decision(title, status, tags, source=ReviewSource.HUMAN,
                      conf=None):
  return ReviewDecision(
    paper=Paper(title=title, authors=["A. Author"], year=2020),
    provider="openalex", status=status, tags=tags, source=source,
    llm_confidence=conf,
  )


def _caption(session, lang="en", **options):
  lines = build_audit_table_latex(session, label="x", lang=lang, **options)
  caption = next(line for line in lines if line.startswith(r"\caption"))
  return " ".join(caption.split())


