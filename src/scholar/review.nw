class TestFailedRerunReplacesUnknownOutcome:
    """A failed re-run replaces a record without an outcome or evidence."""

    FAILURE = "non-JSON response (HTTP 200, text/html)"
    SKIPPED = "skipped: daily quota spent; resets 2026-11-20T00:00Z"

    @staticmethod
    def _unknown():
        return SearchRecord("q", "dblp", None, 40)

    @classmethod
    def _failed(cls):
        return SearchRecord("q", "dblp", None, 40, hits=0, error=cls.FAILURE)

    @staticmethod
    def _session(records, evidence=None, name=None):
        decision = ReviewDecision(
            paper=Paper(title="Spacing", authors=["A"], year=2020,
                        doi="10.1234/unknown-outcome-190"),
            provider="openalex",
        )
        decision.record_search("q", "openalex", "")
        if evidence == "linked":
            decision.record_search("q", "dblp", "")
        elif evidence == "named":
            decision.provider = "openalex, DBLP"
        session = ReviewSession(query="q", providers=["dblp", "openalex"],
                                timestamp=datetime.now(), name=name)
        session.search_records = list(records) + [
            SearchRecord("q", "openalex", None, 40, hits=1),
        ]
        session.decisions = [decision]
        return session

    def _rerun(self, name, provider="dblp", error=None):
        from scholar.scholar import SearchResult
        return create_review_session([SearchResult(
            query="q", provider=provider, timestamp="t", papers=[],
            limit=40, error=error or self.FAILURE,
        )], "q", session_name=name)

    @staticmethod
    def _dblp(session, provider="dblp"):
        return [(r.hits, r.error) for r in session.search_records
                if r.provider == provider]

    def test_failed_rerun_replaces_record_without_evidence(self):
        save_session(self._session([self._unknown()], name="unknown-190"))
