The case the legacy rule is for: a session saved before filters were
stored, with one record of [[Q]] on OpenAlex and a two-part link, then
searched again with [[--year 2020-2024]].  The new run replaces the
legacy record, and the old paper's link moves to it.  Without the rule
the session held two records and [[found-via]] printed, for the old
paper, an unfiltered command that may never have been run.  A run of
another query leaves the legacy record alone, and a resolved link
supersedes an unresolved one of the same query and provider.

<<test functions>>=
class TestLegacyRecords:
    """Records from before filters were stored behave as before #140."""

    @staticmethod
    def _old_session(records, decisions):
        import json
        from scholar.review import _get_sessions_dir
        data = {
            "query": "Q", "name": "legacy", "providers": ["openalex"],
            "timestamp": datetime.now().isoformat(),
            "query_provider_pairs": records,
            "decisions": [{
                "paper_id": f"doi:{doi}", "provider": "openalex",
                "status": "kept", "tags": [], "source": "human",
                "found_by": links,
                "paper": {"title": doi, "authors": ["A"], "doi": doi,
                          "sources": ["openalex"]},
            } for doi, links in decisions],
        }
        (_get_sessions_dir() / "legacy.json").write_text(json.dumps(data))

    @staticmethod
    def _rerun(papers, filters, query="Q"):
        from scholar.scholar import SearchResult
        return create_review_session([SearchResult(
            query=query, provider="openalex", timestamp="t",
            papers=papers, filters=filters, limit=1000,
        )], query, session_name="legacy")

    def test_a_rerun_replaces_the_legacy_record(self):
        self._old_session(
            [["Q", "openalex"]],
            [("10.1/legacy-old", [{"query": "Q", "provider": "openalex"}])],
        )
        new = Paper(title="New", authors=["B"], doi="10.1/legacy-new")
        session = self._rerun([new], {"year": "2020-2024"})
        save_session(session)
        session = load_session("legacy")
        year = filters_key({"year": "2020-2024"})
        assert [r.key for r in session.search_records] == [
            ("Q", "openalex", year)
        ]
        links = {d.paper.doi: d.found_by for d in session.decisions}
        assert links == {
            "10.1/legacy-old": [("Q", "openalex", year)],
            "10.1/legacy-new": [("Q", "openalex", year)],
        }

    def test_another_query_leaves_it_alone(self):
        self._old_session([["Q", "openalex"]], [])
        session = self._rerun([], {"year": "2020-2024"}, query="R")
        assert sorted(r.query for r in session.search_records) == ["Q", "R"]
        legacy = session.search_record("Q", "openalex")
        assert legacy.is_legacy

    def test_a_record_with_a_limit_is_not_legacy(self):
        assert SearchRecord("Q", "p", None, None).is_legacy
        assert not SearchRecord("Q", "p", None, 1000).is_legacy
        assert not SearchRecord("Q", "p", {"year": "2020"}, None).is_legacy


