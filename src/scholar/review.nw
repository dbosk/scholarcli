class TestSessionsMentioning:
    """sessions_mentioning decodes only the files that hold the id."""

    @staticmethod
    def _save(name, paper):
        session = ReviewSession(
            query=name, providers=["arxiv"], timestamp=datetime.now(),
            name=name,
        )
        session.decisions.append(ReviewDecision(paper=paper, provider="arxiv"))
        save_session(session)

    def test_finds_only_sessions_holding_the_paper(self):
        self._save("holds", Paper(title="T", authors=["A"], doi="10.1/Men"))
        self._save("other", Paper(title="U", authors=["B"], doi="10.1/oth"))
        found = sessions_mentioning("doi:10.1/men")
        assert [s.name for s in found] == ["holds"]

    def test_broken_files_warn_only_when_they_mention_the_paper(
        self, caplog
    ):
        from scholar.review import _get_sessions_dir
        self._save("holds", Paper(title="T", authors=["A"], doi="10.1/men"))
        sessions_dir = _get_sessions_dir()
        (sessions_dir / "unrelated.json").write_text('{"decisions": [')
        (sessions_dir / "related.json").write_text('{"x": "10.1/men", ')
        with caplog.at_level("WARNING"):
            found = sessions_mentioning("doi:10.1/men")
        assert [s.name for s in found] == ["holds"]
        assert "related.json" in caplog.text
        assert "unrelated.json" not in caplog.text

    def test_finds_arxiv_paper_stored_without_its_doi(self):
        from scholar.review import _get_sessions_dir
        paper = Paper(
            title="T", authors=["A"],
            url="https://arxiv.org/abs/2101.00001v2",
        )
        self._save("old", paper)
        assert "10.48550" not in (_get_sessions_dir() / "old.json").read_text()
        found = sessions_mentioning("doi:10.48550/arxiv.2101.00001")
        assert [s.name for s in found] == ["old"]

    def test_finds_an_id_the_file_stores_escaped(self):
        import json
        from scholar.review import _get_sessions_dir
        self._save("escaped", Paper(title="T", authors=["A"], doi="10.1/é"))
        path = _get_sessions_dir() / "escaped.json"
        path.write_text(json.dumps(json.loads(path.read_text())))
        assert "\\u00e9" in path.read_text()
        found = sessions_mentioning("doi:10.1/é")
        assert [s.name for s in found] == ["escaped"]
