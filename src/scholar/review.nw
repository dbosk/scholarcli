def pair_with_file(
    session: ReviewSession, on_disk: ReviewSession
) -> tuple[dict[int, ReviewDecision], list[ReviewDecision]]:
    """Pair the decisions of `session` with the copies in `on_disk`.

    Returns the file copy of each paired decision, keyed by `id()` of
    the decision, and the file's decisions to add to `session`.
    """
    base = session._baseline
    base_states = base.decisions if base else {}
    base_ids = base.decision_ids if base else {}
    ours_by_id: dict[str, list[ReviewDecision]] = {}
    for decision in session.decisions:
        ours_by_id.setdefault(get_paper_id(decision.paper), []).append(
            decision
        )
    disk_by_id: dict[str, list[ReviewDecision]] = {}
    for theirs in on_disk.decisions:
        disk_by_id.setdefault(get_paper_id(theirs.paper), []).append(
            theirs
        )
    <<group the baseline's keys by paper id>>
    paired: dict[int, ReviewDecision] = {}
    additions: list[ReviewDecision] = []
    for paper_id, copies in disk_by_id.items():
        ours = ours_by_id.get(paper_id, [])
        free = list(copies)
        <<pair our copies with file copies in their loaded state>>
        <<pair the other copies by place>>
        <<add the file copies this session never loaded>>
    return paired, additions
