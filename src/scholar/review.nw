Let's verify the links against the situation of
\url{https://github.com/dbosk/scholar/issues/128}: two queries on one
provider, appended to one session, with a paper that only the first
returned.  The second search returns another paper twice, once from each
of two providers, so the in-run duplicate branch is exercised too.  Every
step goes through the real [[create_review_session]] and a save and load,
because the links must survive exactly that.

<<test functions>>=
class TestFoundByLinks:
    """Decisions record the searches that returned their paper."""

    @staticmethod
    def _result(query, provider, papers):
        from scholar.scholar import SearchResult
        return SearchResult(
            query=query, provider=provider, timestamp="t", papers=papers,
        )

    @staticmethod
    def _links(session):
        return {d.paper.doi: d.found_by for d in session.decisions}

    def _two_searches(self):
        first = Paper(title="First", authors=["A"], doi="10.1/fb-first")
        both = Paper(title="Both", authors=["B"], doi="10.1/fb-both")
        save_session(create_review_session(
            [self._result("q1", "openalex", [first, both])],
            "q1", session_name="links",
        ))
        save_session(create_review_session(
            [
                self._result("q2", "openalex", [both]),
                self._result("q2", "arxiv", [both]),
            ],
            "q2", session_name="links",
        ))
        return load_session("links")

    def test_each_paper_names_the_searches_that_returned_it(self):
        links = self._links(self._two_searches())
        assert links["10.1/fb-first"] == [("q1", "openalex", "")]
        assert links["10.1/fb-both"] == [
            ("q1", "openalex", ""), ("q2", "openalex", ""),
            ("q2", "arxiv", ""),
        ]

    def test_old_files_load_without_links(self):
        import json
        from scholar.review import _get_sessions_dir
        self._two_searches()
        path = _get_sessions_dir() / "links.json"
        data = json.loads(path.read_text())
        for decision in data["decisions"]:
            del decision["found_by"]
        path.write_text(json.dumps(data))
        session = load_session("links")
        assert all(d.found_by == [] for d in session.decisions)

    def test_concurrent_save_keeps_links_from_disk(self):
        first = Paper(title="First", authors=["A"], doi="10.1/fb-first")
        save_session(create_review_session(
            [self._result("q1", "openalex", [first])],
            "q1", session_name="links",
        ))
        stale = load_session("links")
        save_session(create_review_session(
            [self._result("q2", "openalex", [first])],
            "q2", session_name="links",
        ))
        stale.decisions[0].status = DecisionStatus.KEPT
        save_session(stale)
        links = self._links(load_session("links"))
        assert set(links["10.1/fb-first"]) == {
            ("q1", "openalex", ""), ("q2", "openalex", ""),
        }
