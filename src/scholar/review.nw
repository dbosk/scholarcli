Let's verify both halves: a failed search is recorded as failed, with
its retries, and a failed re-run does not erase an earlier answer---while
an answered re-run does replace it:

<<test functions>>=
class TestSearchRecordOutcome:
    """create_review_session records what each search returned."""

    @staticmethod
    def _result(provider, papers, error=None, retries=0):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="q", provider=provider, timestamp="t", papers=papers,
            error=error, retries=retries,
        )

    def test_failure_recorded(self):
        paper = Paper(title="P", authors=["A"], sources=["openalex"])
        session = create_review_session([
            self._result("dblp", [], error="non-JSON response", retries=2),
            self._result("openalex", [paper]),
        ], "q", session_name="outcome")
        dblp = session.search_record_for("dblp")
        assert (dblp.hits, dblp.error, dblp.retries) == (
            0, "non-JSON response", 2
        )
        assert session.search_record_for("openalex").hits == 1

    def test_failed_rerun_keeps_earlier_answer(self):
        paper = Paper(title="P", authors=["A"], sources=["dblp"])
        save_session(create_review_session(
            [self._result("dblp", [paper])], "q", session_name="rerun"
        ))
        session = create_review_session(
            [self._result("dblp", [], error="HTTP 503")],
            "q", session_name="rerun",
        )
        record = session.search_record_for("dblp")
        assert (record.hits, record.error) == (1, None)
        assert len(session.decisions) == 1

    def test_answered_rerun_replaces_earlier_failure(self):
        save_session(create_review_session(
            [self._result("dblp", [], error="HTTP 503")],
            "q", session_name="recovered",
        ))
        paper = Paper(title="P", authors=["A"], sources=["dblp"])
        session = create_review_session(
            [self._result("dblp", [paper])], "q", session_name="recovered",
        )
        record = session.search_record_for("dblp")
        assert (record.hits, record.error) == (1, None)
