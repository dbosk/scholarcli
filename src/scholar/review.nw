class TestSaveCost:
  """A save grows with the session, not with its square (#316)."""

  @staticmethod
  def _session(n, name=None):
    records = [SearchRecord(f"q{i}", "openalex", None, 100, hits=n)
               for i in range(20)]
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime(2026, 11, 23), name=name)
    session.search_records = list(records)
    for k in range(n):
      decision = ReviewDecision(
        paper=Paper(title=f"Invented paper {k}", authors=["Ada Example"],
                    year=2020, doi=f"10.5555/cost-{k}",
                    abstract="An invented abstract. " * 20),
        provider="openalex",
        status=DecisionStatus.KEPT if k % 3 == 0 else DecisionStatus.PENDING,
        tags=["theme"] if k % 3 == 0 else [])
      for j in range(5):
        decision.record_link(records[(k + j) % 20].key)
      session.decisions.append(decision)
    return session

  def test_a_save_of_3000_decisions(self, tmp_path, monkeypatch):
    import time
    from scholar.scholar import isolated_registry
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    with isolated_registry():
      save_session(self._session(3000, "cost"))
    with isolated_registry():
      session = load_session("cost")
      session.decisions[1].status = DecisionStatus.DISCARDED
      session.decisions[1].tags = ["off-topic"]
      started = time.process_time()
      save_session(session)
      elapsed = time.process_time() - started
    assert elapsed < 10, f"a save of 3000 decisions took {elapsed:.1f} s"

  @staticmethod
  def _pairing_time(n):
    import copy
    import time
    session = TestSaveCost._session(n)
    session._baseline = SessionBaseline.of(session)
    assign_baseline_keys(session)
    on_disk = copy.copy(session)
    on_disk.decisions = [replace(d, baseline_key=None)
                         for d in session.decisions]
    best = None
    with paused_garbage_collection():
      for _ in range(5):
        started = time.process_time()
        pair_with_file(session, on_disk)
        elapsed = time.process_time() - started
        best = elapsed if best is None else min(best, elapsed)
    return best

  def test_pairing_grows_with_the_session(self):
    small, large = self._pairing_time(1500), self._pairing_time(6000)
    assert large < 9 * small, (small, large)
