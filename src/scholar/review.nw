            assert self._dblp(session) == [(0, self.FAILURE)], own

    def test_concurrent_merge_keeps_a_record_with_evidence_on_either_side(
            self):
        for own, disk in [(self._unknown(), self._failed()),
                          (self._failed(), self._unknown())]:
            for evidence in ("linked", "named"):
                for mine in (True, False):
                    session = self._session(
                        [own], evidence if mine else None)
                    on_disk = self._session(
                        [disk], None if mine else evidence)
                    merge_concurrent_changes(session, on_disk)
                    assert self._dblp(session) == [(None, None)], (
                        own, evidence, mine,
                    )

    def test_failed_rerun_replaces_legacy_record_without_evidence(self):
        save_session(self._session([SearchRecord("q", "dblp")],
                                   name="legacy-190"))
        session = self._rerun("legacy-190")
        assert self._dblp(session) == [(0, self.FAILURE)]
        save_session(session)
        assert self._dblp(load_session("legacy-190")) == [
            (0, self.FAILURE),
        ]

    def test_evidence_in_either_argument_order(self):
        unknown, failed = self._unknown(), self._failed()
        for links, names in (({("q", "dblp", None)}, set()),
                             ({("q", "dblp", "")}, set()),
                             (set(), {"dblp"})):
            for a, b in ((failed, unknown), (unknown, failed)):
                assert session_preferred_record(
                    a, b, links, names) is unknown
        links = {("q", "openalex", ""), ("other", "dblp", None)}
        names = {"openalex", "dblp-mirror"}
        for a, b in ((failed, unknown), (unknown, failed)):
            assert session_preferred_record(a, b, links, names) is failed

    def test_stale_save_keeps_the_failure(self):
        save_session(self._session([self._unknown()], name="stale-190"))
        stale = load_session("stale-190")
        save_session(self._rerun("stale-190"))
        stale.decisions[0].status = DecisionStatus.KEPT
        save_session(stale)
        session = load_session("stale-190")
        assert self._dblp(session) == [(0, self.FAILURE)]
        assert session.decisions[0].status == DecisionStatus.KEPT
