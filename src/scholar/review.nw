class TestKeptFilesAreData:
  """A kept file cannot run code or name another file (#316)."""

  @staticmethod
  def _kept(tmp_path, monkeypatch, target="held.json", baseline=None,
            name=None):
    import json
    path = TestSaveWhenTheLockIsHeld._make(tmp_path, monkeypatch)
    data = json.loads(path.read_text())
    data[UNSAVED_KEY] = {
      "target": target, "baseline": baseline,
      "baseline_keys": [None] * len(data["decisions"]),
    }
    kept = path.with_name(name or f"held.json{UNSAVED_MARK}20261123T0-x")
    kept.write_text(json.dumps(data))
    return path, kept

  def test_a_pickled_baseline_is_not_run(self, tmp_path, monkeypatch):
    import base64
    import pickle
    import scholar.review as review
    marker = tmp_path / "marker"

    class Payload:
      def __reduce__(self):
        return (open, (str(marker), "w"))

    path, kept = self._kept(
      tmp_path, monkeypatch,
      baseline=base64.b64encode(pickle.dumps(Payload())).decode())
    before = path.read_bytes()
    with pytest.raises(SessionFileError) as raised:
      recover_unsaved_session(kept)
    assert not marker.exists()
    assert "not a baseline" in str(raised.value)
    assert path.read_bytes() == before and kept.exists()
    assert not hasattr(review, "pickle")

  @pytest.mark.parametrize("target", [
    "../held.json", "/tmp/held.json", "other.json", ".held.json",
    "held.txt", 7,
  ])
  def test_only_its_own_session_file(self, tmp_path, monkeypatch, target):
    name = (f"{target}{UNSAVED_MARK}20261123T0-x"
            if target in (".held.json", "held.txt") else None)
    path, kept = self._kept(tmp_path, monkeypatch, target=target,
                            name=name)
    before = sorted(p.name for p in path.parent.iterdir())
    with pytest.raises(SessionFileError):
      recover_unsaved_session(kept)
    assert sorted(p.name for p in path.parent.iterdir()) == before
