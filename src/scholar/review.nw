class TestWiderRecordKept:
    """A narrower re-run never replaces a wider record (#166)."""

    WIDE = 10_000

    @staticmethod
    def _result(papers, limit, total=None, error=None):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="q", provider="openalex", timestamp="t", papers=papers,
            limit=limit, total=total, error=error,
        )

    @staticmethod
    def _papers(n):
        return [Paper(title=f"P{i}", authors=["A"], doi=f"10.1/wide-{i}")
                for i in range(n)]

    def test_narrow_rerun_keeps_wide_record(self):
        papers = self._papers(50)
        save_session(create_review_session(
            [self._result(papers, self.WIDE, total=50)], "q",
            session_name="wide",
        ))
        save_session(create_review_session(
            [self._result(papers[:5], 5, total=50)], "q",
            session_name="wide",
        ))
        session = load_session("wide")
        assert [(r.limit, r.hits, r.total)
                for r in session.search_records] == [(self.WIDE, 50, 50)]
        record = session.search_records[0]
        assert all(
            session.search_record(*link) is record
            for d in session.decisions for link in d.found_by
        )

    def test_wider_rerun_replaces_narrow_record(self):
        papers = self._papers(6)
        save_session(create_review_session(
            [self._result(papers[:5], 5, total=6)], "q",
            session_name="widen",
        ))
        session = create_review_session(
            [self._result(papers, self.WIDE, total=6)], "q",
            session_name="widen",
        )
        assert [(r.limit, r.hits) for r in session.search_records] == [
            (self.WIDE, 6),
        ]

    def test_failed_wide_record_does_not_displace_answer(self):
        papers = self._papers(3)
        save_session(create_review_session(
            [self._result([], self.WIDE, error="HTTP 503")], "q",
            session_name="failed-wide",
        ))
        session = create_review_session(
            [self._result(papers, 5, total=3)], "q",
            session_name="failed-wide",
        )
        assert [(r.limit, r.hits, r.error)
                for r in session.search_records] == [(5, 3, None)]

    def test_total_round_trip_and_old_records(self):
        import json
        from scholar.review import _get_sessions_dir
        save_session(create_review_session(
            [self._result(self._papers(5), 5, total=2130)], "q",
            session_name="totals",
        ))
        session = load_session("totals")
        record = session.search_records[0]
        assert (record.total, record.total_estimated) == (2130, False)
        assert search_outcome_label(record) == (
            "5 of 2,130 (capped at 5)"
        )
        path = _get_sessions_dir() / "totals.json"
        data = json.loads(path.read_text())
        for rec in data["search_records"]:
            del rec["total"], rec["total_estimated"]
        path.write_text(json.dumps(data))
        record = load_session("totals").search_records[0]
        assert (record.total, record.total_estimated) == (None, False)
        assert search_outcome_label(record) == "5 (capped at 5)"
