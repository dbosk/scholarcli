class TestSearchDatesLabel:
    """Dates of a search, worded for display (#167)."""

    def test_labels(self):
        def record(**dates):
            return SearchRecord("q", "openalex", None, 100, hits=1, **dates)

        run = "2026-11-18T09:00:00+00:00"
        october = "2026-10-02T08:00:00+00:00"
        assert search_dates_label(record()) == ""
        assert search_dates_label(record(
