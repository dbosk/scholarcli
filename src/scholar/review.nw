The records a decision's links name are looked up once per session, in
a [[LinkedRecords]], since every paper's links are read and a session
holds thousands of decisions.

<<review filtering functions>>=
class LinkedRecords:
    """The current search record each `found_by` link names."""

    def __init__(self, session: "ReviewSession"):
        self.session = session
        current = current_records(session.search_records)
        self.by_key = {record.key: record for record in current}
        self.pairs = {(record.query, record.provider) for record in current}

    def record_of(self, link) -> "SearchRecord | None":
        """The current record `link` names, `None` if none or retired."""
        query, provider, key = link
        if key is not None:
            return self.by_key.get((query, provider, key))
        record = self.session.search_record(query, provider)
        return record if record is not None and record.retired is None \
            else None

    def untold(self, link) -> bool:
        """Whether `link` is an old link that several current records fit."""
        return link[2] is None and self.record_of(link) is None \
            and tuple(link[:2]) in self.pairs

    def database_of(self, provider: str) -> str:
        """The database a provider name searches (see `provider_database`)."""
        return provider_database(provider)


def provider_database(provider: str) -> str:
    """The database a provider name searches: its quota group, by name.

    Read from `PROVIDER_DATABASES`; a name not listed is its own.
    """
    return PROVIDER_DATABASES.get(provider, provider)


def relevance_place(
    decision: ReviewDecision, records: LinkedRecords
) -> int | None:
    """The paper's best place in a current relevance-ordered answer."""
    places = [
        link_rank(link) for link in decision.found_by
        if link_rank(link) is not None
        and getattr(records.record_of(link), "order", None)
        == ORDER_RELEVANCE
    ]
    return min(places) if places else None


def returning_databases(
    decision: ReviewDecision, records: LinkedRecords
) -> set[str]:
    """The databases of the current, single-provider records linked."""
    found = set()
    for link in decision.found_by:
        record = records.record_of(link)
        if record is not None and not record.is_merged:
            found.add(records.database_of(record.provider))
    return found


def databases_unknown(
    decision: ReviewDecision, records: LinkedRecords
) -> bool:
    """Whether the links name only merged records or untold old links."""
    linked = [records.record_of(link) for link in decision.found_by]
    if any(r is not None and not r.is_merged for r in linked):
        return False
    return any(r is not None and r.is_merged for r in linked) or any(
        records.untold(link) for link in decision.found_by
    )


def has_place(decision: ReviewDecision, records: LinkedRecords) -> bool:
    """Whether a link to a current record holds the paper's place."""
    return any(
        link_rank(link) is not None and records.record_of(link) is not None
        for link in decision.found_by
    )
@

A tier is counted in papers.  A session can hold two decisions under
one paper id (\cref{sec:session-copies}), and the screen sheet lists
such a paper once, as [[sessions screen]] takes a verdict per id; the
counts that plan a screen must count the same way, or [[sessions
show]] would promise more papers than a sheet lists.  So the pending
papers are taken by one function, [[pending_papers]], the first
decision of each paper id, for the sheet, for the overview line and for
the classifier's tier alike.

<<review filtering functions>>=
def pending_papers(session: "ReviewSession") -> list[ReviewDecision]:
    """The pending decisions, the first of each paper id, in order."""
    chosen: dict[str, ReviewDecision] = {}
    for decision in session.decisions:
        if not decision.is_decided:
            chosen.setdefault(decision.paper.id, decision)
    return list(chosen.values())
@

[[screening_tier]] applies a rule to a list of decisions (the sheet's
papers, or the pending ones a classifier would take) and keeps their
order.  Its counts are built so that they add up, which is what a
method section needs: every paper is either selected or not; a selected
paper meets one condition only (counted under it) or several (counted
once, under \enquote{more than one}); and the papers that meet each
condition are given too, overlapping.  The papers missing a place or
their databases are counted over all the papers, selected or not, since
such a paper may still be selected by another condition.

<<review filtering functions>>=
@dataclass
class TierSelection:
    """The papers a `TierRule` selects from a list, and the counts."""

    rule: TierRule
    decisions: list
    total: int
    met: dict[str, int]
    only: dict[str, int]
    several: int
    place_unknown: int
    no_relevance_place: int
    databases_unknown: int = 0

    @property
    def not_selected(self) -> int:
        """How many papers the rule leaves out."""
        return self.total - len(self.decisions)

    def data(self) -> dict:
        """The rule and the counts as JSON data."""
        return {
            "rule": self.rule.data(),
            "total": self.total,
            "selected": len(self.decisions),
            "not_selected": self.not_selected,
            "met": dict(self.met),
            "only": dict(self.only),
            "more_than_one": self.several,
            "place_unknown": self.place_unknown,
            "placed_only_outside_relevance_order": self.no_relevance_place,
            "databases_unknown": self.databases_unknown,
        }


def screening_tier(
    decisions: list, session: "ReviewSession", rule: TierRule
) -> TierSelection:
    """The decisions that meet at least one condition of `rule`."""
    records = LinkedRecords(session)
    conditions = rule.conditions()
    wanted = {p.casefold() for p in rule.providers}
    like = (rule.query_like or "").casefold()
    selected, several = [], 0
    met = dict.fromkeys(conditions, 0)
    only = dict.fromkeys(conditions, 0)
    place_unknown = no_relevance_place = unknown_databases = 0
    for decision in decisions:
        place = relevance_place(decision, records)
        <<count the papers without a relevance place>>
        if databases_unknown(decision, records):
            unknown_databases += 1
        <<find the conditions [[decision]] meets>>
        for name in meets:
            met[name] += 1
        if len(meets) == 1:
            only[meets[0]] += 1
        elif meets:
            several += 1
        if meets:
            selected.append(decision)
    return TierSelection(rule, selected, len(decisions), met, only,
                         several, place_unknown, no_relevance_place,
                         unknown_databases)
<<count the papers without a relevance place>>=
if place is None:
    if has_place(decision, records):
        no_relevance_place += 1
    else:
        place_unknown += 1
<<find the conditions [[decision]] meets>>=
meets = []
if rule.top is not None and place is not None and place <= rule.top:
    meets.append("top")
if rule.min_providers is not None and len(
    returning_databases(decision, records)
) >= rule.min_providers:
    meets.append("min_providers")
if wanted and any(
    record is not None and not record.is_merged
    and record.provider.casefold() in wanted
    and like in record.query.casefold()
    for record in map(records.record_of, decision.found_by)
):
    meets.append("provider")
