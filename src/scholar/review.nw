@dataclass
class CitedEntry:
    """A bibliography entry the text cites, and the works it matched.

    `loose_titles` are the session titles an entry matched only once
    edition and chapter number were set aside; `ambiguous` the titles
    of the several works it would have matched that way, and did not.
    """

    key: str
    title: str
    matched_by: str | None
    works: list[tuple[str, str]]
    loose_titles: list[str] = field(default_factory=list)
    ambiguous: list[str] = field(default_factory=list)


def match_cited_entries(
    entries: Sequence[tuple], session: ReviewSession,
) -> list[CitedEntry]:
    """Find the session's works that the bibliography `entries` cite.

    `entries` are `(key, readings)` or `(key, readings, edition)`
    tuples, `readings` one or more papers read from the same entry and
    `edition` its `edition` field as written (or None).  Each
    `CitedEntry` lists the `audit_work_key`s of the decisions a reading
    matches, by DOI (version links included) or by title and first
    author, and failing both by the title without edition or chapter
    number (`CHECK_BY_LOOSE_TITLE`).
    """
    index = session_match_index([session])
    loose_index = None
    cited = []
    for key, readings, *edition in entries:
        paper = readings[0]
        found = [
            entry for reading in readings
            for entry in matching_entries(reading, index)
        ]
        <<prefer the record of the edition the entry names>>
        <<try the title without edition or chapter number>>
        if any(entry[2] == CHECK_BY_DOI for entry in found):
            matched_by = CHECK_BY_DOI
        else:
            matched_by = found[0][2] if found else None
        works = list(dict.fromkeys(
            audit_work_key(entry[1].paper) for entry in found
        ))
        cited.append(CitedEntry(key, paper.title or "", matched_by, works))
    return cited
