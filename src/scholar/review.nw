The parse and the checks.
The nodes are walked once, keeping the depth and whether a node is
inside math: each macro must be allowed where it stands, the depth
must stay within the bound, and the macros' starts must be exactly the
positions of the backslashes in the text.
That last check also refuses what is no macro: an environment begins
with a backslash but is no macro node, and after the bare [[%]] is
escaped no comment can hide a backslash.

<<review report generation>>=
def latex_text_pieces(text: str) -> list | None:
    """Read `text` as LaTeX into plain-text pieces, or None if unsafe.

    The pieces are strings and `LatexBrace`s. None when `text` holds no
    backslash, a command not on the allow-list, does not parse, is too
    long or too deep, decodes to what cannot be set, or to nothing.
    """
    if "\\" not in text or len(text) > LATEX_DECODE_MAX_CHARS:
        return None
    try:
        return _decoded_pieces(text)
    except Exception:
        return None


def _decoded_pieces(text: str) -> list | None:
    """The work of `latex_text_pieces`, which catches what it raises."""
    walker_module, walker_db, converter, math_allowed = _latex_reader()
    source = UNESCAPED_PERCENT.sub(lambda match: match[1] + "\\%", text)
    nodes, _, _ = walker_module.LatexWalker(
        source, latex_context=walker_db, tolerant_parsing=False
    ).get_latex_nodes()
    starts = _allowed_macro_starts(walker_module, nodes, math_allowed)
    backslashes = {m.start() for m in re.finditer(r"\\", source)}
    if starts is None or starts != backslashes:
        return None
    pieces = _latex_pieces(walker_module, converter, nodes, source)
    decoded = "".join(p for p in pieces if isinstance(p, str))
    if not decoded.strip() and not any(
        isinstance(p, LatexBrace) for p in pieces
    ):
        return None
    return pieces
