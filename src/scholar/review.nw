def load_own_session(name: str | None, query: str) -> ReviewSession | None:
    """Load the session file a session `name` (or `query`) is saved to.

    Unlike `load_session`, the name is never tried as a query nor the
    query as a name, with one exception: a named search whose name is
    its query (the `--review` default) continues the unnamed session of
    that query when it has no file of its own. When the file the old
    lookup would also have tried exists, one log line names it and how
    to continue it.

    Returns None when the file does not exist.

    Raises:
        SessionFileError: The file exists but cannot be read.
    """
    sessions_dir = _get_sessions_dir()
    own = sessions_dir / own_session_file_name(name, query)
    <<find the file the old lookup also tried>>
    <<continue the unnamed session of the query>>
    <<point at the session file the append does not load>>
    if not own.exists():
        logger.debug("Session not found: %s", own.name)
        return None
    return read_session_file(own)


def _stored_identity(path: Path) -> tuple[str | None, str | None] | None:
    """Return the `(name, query)` a session file stores, None if unreadable."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data.get("name") or None, data.get("query")
    except (OSError, ValueError, AttributeError):
        return None
