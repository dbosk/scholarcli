A save can also fail for want of space.  A review that ran with a full
temporary volume left three copied sessions with more search records
than before (73 became 85 in one), which did not happen again on a
clean run.  Let's verify what a full disk does to a save: the write
fails part-way (the temporary file is written, its [[fsync]] reports
[[ENOSPC]]), the error reaches the caller, the session file is
byte for byte what it was, no temporary file is left, and neither a
second save of the same session object nor a fresh append of the same
search adds a record or a paper that a clean run would not.  The
records are compared with what a clean run produces.

<<test functions>>=
class TestSaveOnAFullDisk:
    """A save that runs out of space changes nothing."""

    @staticmethod
    def _result(query, n, prefix):
        from scholar.scholar import SearchResult
        return SearchResult(
            query=query, provider="openalex", timestamp="t", limit=100,
            papers=[Paper(title=f"{prefix}{i}", authors=["A"],
                          doi=f"10.1/full-{prefix}-{i}") for i in range(n)],
        )

    @staticmethod
    def _full_disk(monkeypatch):
        import errno
        import os

        def fsync(fd):
            raise OSError(errno.ENOSPC, "No space left on device")

        monkeypatch.setattr(os, "fsync", fsync)

    def _records(self, name):
        session = load_session(name)
        return sorted((r.query, r.provider, r.hits)
                      for r in session.search_records), len(session.decisions)

    def test_failed_save_changes_nothing(self, monkeypatch):
        import errno
        from scholar.review import _get_sessions_dir

        for name in ("full", "clean"):
            save_session(create_review_session(
                [self._result("q1", 3, "a")], "q1", session_name=name,
            ))
        save_session(create_review_session(
            [self._result("q2", 2, "b")], "q2", session_name="clean",
        ))

        path = _get_sessions_dir() / "full.json"
        before = path.read_bytes()
        appended = create_review_session(
            [self._result("q2", 2, "b")], "q2", session_name="full",
        )
        with monkeypatch.context() as patched:
            self._full_disk(patched)
            with pytest.raises(OSError) as raised:
                save_session(appended)
        assert raised.value.errno == errno.ENOSPC
        assert path.read_bytes() == before
        assert not list(path.parent.glob(".full.json.*.tmp"))

        save_session(appended)
        save_session(create_review_session(
            [self._result("q2", 2, "b")], "q2", session_name="full",
        ))
        assert self._records("full") == self._records("clean")
