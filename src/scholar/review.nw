class TestStoredBatchCheck:
  """The batch check over the reasons a session stores (#291)."""

  AT = "2026-11-20T10:00:00+00:00"
  SPLIT = "Off topic; the title shows an unrelated subject."

  def _decision(self, n, status=DecisionStatus.DISCARDED, **fields):
    return ReviewDecision(
      paper=Paper(title=f"Stored Work {n}", authors=["A"],
                  doi=f"10.5555/stored-{n}"),
      provider="p", status=status, tags=["t"],
      source=ReviewSource.AGENT_UNREVIEWED, **fields,
    )

  def test_shared_reasons_are_looked_for_across_runs(self):
    def split(n, status, at):
      return self._decision(
        n, status=status, agent_by="loader", agent_decided_at=at,
        agent_reason=self.SPLIT if n % 5 == 0 else f"Work {n}, topic {n}.",
        llm_confidence=0.9,
      )

    kept = [split(n, DecisionStatus.KEPT, self.AT) for n in range(30)]
    discarded = [split(100 + n, DecisionStatus.DISCARDED,
                       "2026-11-20T10:05:00+00:00") for n in range(30)]
    rule = [self._decision(200 + n, agent_reason="No abstract; rule 3.",
                           agent_by="loader",
                           agent_decided_at="2026-11-20T11:00:00+00:00")
            for n in range(12)]
    screened = [self._decision(300 + n) for n in range(25)]
    for n, decision in enumerate(screened):
      record_screening(decision, new_screening(
        kind="agent", name="second", status="kept", tags=["r"],
        recorded_at=self.AT, confidence=0.9,
        reason=("Kept, on topic." if n < 11
                else f"Kept, record {n} is about it."),
      ))
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime(2026, 11, 20))
    session.decisions = kept + discarded + rule + screened
    check = stored_batch_check(session)
    [split_reason] = check.shared["agent decisions"]
    assert split_reason.count == 12
    assert split_reason.detail.startswith(
      "shared by 12 records with different titles (12 rows)")
    [screened_reason] = check.shared["screenings"]
    assert screened_reason.count == 11
    assert [(r.what, r.name, len(r.rows), [f.kind for f in r.findings])
            for r in check.runs] == [
      ("agent decisions", "loader", 30, []),
      ("agent decisions", "loader", 30, []),
      ("agent decisions", "loader", 12, ["one-reason"]),
      ("screenings", "second", 25, []),
    ]
    assert check.runs[2].findings[0].information
