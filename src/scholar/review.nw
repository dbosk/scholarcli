}
# Mathematical symbols; macros get \ensuremath, plain text does not.
LATEX_MATH_SYMBOLS: dict[str, str] = {
    "\u2264": r"\le", "\u2265": r"\ge", "\u2260": r"\ne",
    "\u2248": r"\approx", "\u221e": r"\infty", "\u221a": r"\surd",
    "\u2211": r"\sum", "\u220f": r"\prod", "\u2208": r"\in",
    "\u2192": r"\rightarrow", "\u2190": r"\leftarrow",
    "\u2194": r"\leftrightarrow",
    "\u21d2": r"\Rightarrow", "\u2200": r"\forall", "\u2203": r"\exists",
    "\u2205": r"\emptyset", "\u2212": "-", "\u2217": "*",
}

LATEX_SPECIALS: dict[str, str] = {
    "\\": r"\textbackslash{}",
    '"': r"\textquotedbl{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "{": r"\{",
    "}": r"\}",
    "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
}

BIBTEX_SPECIALS: dict[str, str] = {
    '"': r"\textquotedbl{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
}


def _escape_chars(text: str, specials: dict[str, str]) -> str:
    """Escape `text` for TeX in one pass using the `specials` map."""
    out: list[str] = []
    text = clean_metadata_text(text)
    for char in unicodedata.normalize("NFC", text):
        if char in specials:
            out.append(specials[char])
        elif char in LATEX_UNICODE_PUNCTUATION:
            out.append(LATEX_UNICODE_PUNCTUATION[char])
        elif char in GREEK_LETTER_NAMES:
            out.append(f"\\ensuremath{{\\{GREEK_LETTER_NAMES[char]}}}")
        elif char in GREEK_LATIN_LOOKALIKES:
            out.append(GREEK_LATIN_LOOKALIKES[char])
        elif char in LATEX_MATH_SYMBOLS:
            macro = LATEX_MATH_SYMBOLS[char]
            out.append(
                f"\\ensuremath{{{macro}}}" if macro.startswith("\\")
                else macro
            )
        elif ord(char) > LATEX_LATIN_CUTOFF:
            continue
        else:
            out.append(char)
    return "".join(out)


def escape_bibtex(text: str) -> str:
    """Escape special BibTeX characters and normalise Unicode punctuation."""
    return _escape_chars(text, BIBTEX_SPECIALS)


def escape_latex(text: str) -> str:
    """Escape special LaTeX characters and normalise Unicode punctuation."""
    return _escape_chars(text, LATEX_SPECIALS)
@

Let's verify the single pass: the backslash and braces of an inserted
[[\dots{}]] must survive, and a symbol beyond the cutoff must vanish
without taking its neighbours with it.

<<test functions>>=
class TestLatexEscaping:
    """Tests for the LaTeX and BibTeX escapers."""

    def test_escape_latex_specials(self):
        assert escape_latex("a & b_c 100%") == r"a \& b\_c 100\%"

    def test_escape_latex_backslash_single_pass(self):
        assert escape_latex("a\\b") == r"a\textbackslash{}b"

    def test_escape_latex_maps_unicode_punctuation(self):
        text = "“quoted” – dash…"
        assert escape_latex(text) == "``quoted'' -- dash\\dots{}"

    def test_escape_latex_drops_exotic_symbols(self):
        result = escape_latex("star \u2606 here")
        assert "\u2606" not in result
        assert result == "star  here"
        assert escape_latex("\u4e2d\u6587 title") == " title"

    def test_escape_latex_sets_greek_and_math_in_math_mode(self):
        assert escape_latex("\u03c0-ARL") == r"\ensuremath{\pi}-ARL"
        assert escape_latex("\u03a9(n)") == r"\ensuremath{\Omega}(n)"
        assert escape_latex("\u0391 and \u03bf") == "A and o"
        assert escape_latex("x \u2264 y \u2192 z") \
            == r"x \ensuremath{\le} y \ensuremath{\rightarrow} z"
        assert escape_latex("a \u2212 b") == "a - b"

    def test_escape_latex_decodes_entities_and_strips_markup(self):
        title = "Developers&apos; <i>Perceptions</i> &amp; &quot;XML&quot;"
        assert escape_latex(title) == (
            r"Developers' Perceptions \& \textquotedbl{}XML\textquotedbl{}"
        )
        assert escape_latex("x < y and a > b") == "x < y and a > b"

    def test_escape_latex_repairs_mojibake(self):
        latin1 = "Thinking \u00e2\u0080\u0093 Developing"
        cp1252 = "Thinking \u00e2\u20ac\u201c Developing"
        assert escape_latex(latin1) == "Thinking -- Developing"
        assert escape_latex(cp1252) == "Thinking -- Developing"
        assert escape_latex("Café résumé") \
            == "Café résumé"

    def test_escape_bibtex_neutralises_babel_quotes(self):
        assert escape_bibtex('"object"') \
            == r"\textquotedbl{}object\textquotedbl{}"

    def test_escape_latex_composes_combining_accents(self):
        assert escape_latex("Le\u0301on") == "L\u00e9on"
        assert escape_bibtex("L\u00e9on \u03bb") \
            == "L\u00e9on \\ensuremath{\\lambda}"

    def test_escape_bibtex_drops_exotic_symbols(self):
        result = escape_bibtex("A \u2606 B & C")
        assert result == r"A  B \& C"

    def test_escape_bibtex_keeps_braces(self):
        assert escape_bibtex("{DNA} & RNA") == r"{DNA} \& RNA"
