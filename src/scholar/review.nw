  def test_a_fresh_decision_on_the_doi_copy_survives_a_stale_process(self):
    """The re-review's sequence, in real processes: P loads, both copies
    unscreened; the reconcile folds them; Q discards the DOI copy and
    saves; P keeps the DOI-less copy and saves."""
    import subprocess
    import sys
    import textwrap
    pending = (DecisionStatus.PENDING, [])
    bare, with_doi = self._two_copies(pending, pending)
    stale = subprocess.Popen(
      [sys.executable, "-c", textwrap.dedent("""
        import sys
        from scholar.review import DecisionStatus, load_session, save_session
        session = load_session("copies")
        print("loaded", flush=True)
        sys.stdin.readline()
        for decision in session.decisions:
          if not decision.paper.doi:
            decision.status, decision.tags = DecisionStatus.KEPT, ["p"]
        save_session(session)
      """)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    try:
      assert stale.stdout.readline().strip() == "loaded"

      def run(code):
        subprocess.run([sys.executable, "-c", textwrap.dedent(code)],
                       check=True, timeout=120)

      run("""
        from scholar.review import reconcile_session
        assert len(reconcile_session("copies")) == 1
      """)
      run("""
        from scholar.review import DecisionStatus, load_session, save_session
        session = load_session("copies")
        [decision] = session.decisions
        decision.status, decision.tags = DecisionStatus.DISCARDED, ["q"]
        save_session(session)
      """)
      stale.communicate("go\n", timeout=120)
    finally:
      if stale.poll() is None:
        stale.kill()
    assert stale.returncode == 0
    assert self._states() == {
      "doi:10.1145/race": (DecisionStatus.DISCARDED, ["q"]),
      bare.id: (DecisionStatus.KEPT, ["p"]),
    }

  @staticmethod
  def _waiting_process(body):
    """A real process that loads the session, waits for a line on its
    standard input, then runs `body` on the session and saves it."""
    import subprocess
    import sys
    import textwrap
    code = textwrap.dedent("""
      import sys
      from scholar.review import DecisionStatus, load_session, save_session
      session = load_session("copies")
      print("loaded", flush=True)
      sys.stdin.readline()
    """) + textwrap.dedent(body) + "\nsave_session(session)\n"
    process = subprocess.Popen(
      [sys.executable, "-c", code],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    assert process.stdout.readline().strip() == "loaded"
    return process

  @staticmethod
  def _release(process):
    try:
      process.communicate("go\n", timeout=120)
    finally:
      if process.poll() is None:
        process.kill()
    assert process.returncode == 0

  @pytest.mark.parametrize("order", ["P then Q", "Q then P"])
  def test_a_stale_keep_and_a_fresh_discard_both_survive(self, order):
    """P and Q load; the reconcile folds the unscreened copies; P keeps
    the DOI-less copy, Q discards the DOI copy, in either order."""
    import subprocess
    import sys
    pending = (DecisionStatus.PENDING, [])
    bare, with_doi = self._two_copies(pending, pending)
    keep = self._waiting_process("""
      for decision in session.decisions:
        if not decision.paper.doi:
          decision.status, decision.tags = DecisionStatus.KEPT, ["p"]
    """)
    discard = self._waiting_process("""
      for decision in session.decisions:
        if decision.paper.doi:
          decision.status, decision.tags = DecisionStatus.DISCARDED, ["q"]
    """)
    subprocess.run([sys.executable, "-c",
                    "from scholar.review import reconcile_session; "
                    "assert len(reconcile_session('copies')) == 1"],
                   check=True, timeout=120)
    first, second = (keep, discard) if order == "P then Q" \
      else (discard, keep)
    self._release(first)
    self._release(second)
    expected = {
      bare.id: (DecisionStatus.KEPT, ["p"]),
      "doi:10.1145/race": (DecisionStatus.DISCARDED, ["q"]),
    }
    assert self._states() == expected
    assert len(conflicting_copies(load_session("copies"))) == 1
    assert reconcile_session("copies") == []
    assert self._states() == expected

