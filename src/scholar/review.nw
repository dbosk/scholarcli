\subsection{Compiling text in other scripts}
\label{sec:non-latin-compile}

The safety of [[\scholarnonlatin]] under pdf\LaTeX{} rests on a claim
about \TeX{}: that UTF-8 characters in an argument the macro discards
are never executed (\cref{sec:non-latin-text}). A string comparison
cannot test that, so these tests compile real output with the issue's
title: the standalone report, and the report and audit-table fragments
included in a minimal host with pdf\LaTeX{} and T1, the setting of the
decks and books. The fixture also carries what broke real tables: a
quoted query (OT1 has no [[\textquotedbl]]), a title that starts with
an opening bracket, a letter T1 cannot set, a subscript and a
ligature. A third test includes the audit table in a Xe\LaTeX{} and
in a Lua\LaTeX{} host with a font that has Cyrillic and checks,
through [[pdftotext]], that the title is printed and not the marker;
one run per engine, since each engine has its own line in the
definition.

These tests run external programs and take seconds rather than
milliseconds, so they carry the [[latex]] marker (registered in
[[pyproject.toml]]), and [[-m "not latex"]] leaves them out. They skip
themselves when [[latexmk]], [[biber]], the engine or [[pdftotext]] is
not installed, and the Xe\LaTeX{} one when the TeX tree has no DejaVu
Serif. [[latexmk]] runs non-interactively, so an error ends the run
instead of waiting at \TeX's prompt.

<<test functions>>=
import shutil
import subprocess


def _missing_tools(*tools):
  return [tool for tool in tools if shutil.which(tool) is None]


def _compile(directory, main, engine="-pdf"):
  """Compile `main` with latexmk; return (succeeded, log, text)."""
  run = subprocess.run(
    ["latexmk", engine, "-interaction=nonstopmode", "-halt-on-error",
     main],
    cwd=directory, capture_output=True, text=True, timeout=300,
  )
  stem = Path(main).stem
  log_path = directory / f"{stem}.log"
  log = log_path.read_text(errors="replace") if log_path.exists() else ""
  text = ""
  if run.returncode == 0:
    text = subprocess.run(
      ["pdftotext", f"{stem}.pdf", "-"], cwd=directory,
      capture_output=True, text=True, check=True,
    ).stdout
  return run.returncode == 0, log, text


def _nonlatin_session():
  session = ReviewSession(
    query='"federated authentication" AND cli', providers=["openalex"],
    timestamp=datetime(2026, 11, 19), name="nonlatin",
  )
  session.decisions = [
    ReviewDecision(
      paper=Paper(title=ISSUE_220_TITLE, authors=["A. Author"],
                  year=2018, doi="10.25682/niisi.2018.6.0011"),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
    ReviewDecision(
      paper=Paper(title="A Latin title", authors=["B. Writer"], year=2020),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
    ReviewDecision(
      paper=Paper(title="[conference paper] Bracketed", authors=["C. D"],
                  year=2021),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
    ReviewDecision(
      paper=Paper(title="CO\u2082 Work\ufb02ow in \u2113 x\u207b\u00b9",
                  authors=["I. J"], year=2023),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
    ReviewDecision(  # sorts before the bracket, so a row break precedes it
      paper=Paper(title="2021 overview", authors=["G. H"], year=2021),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
    ReviewDecision(
      paper=Paper(title="Locus 6q23 A\u0138 and \u0126al", authors=["E. F"],
                  year=2022),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    ),
  ]
  return session


T1_HOST = "\n".join([
  r"\documentclass{article}",
  r"\usepackage[T1]{fontenc}",
  r"\usepackage[utf8]{inputenc}",
  *[p for p in LATEX_PACKAGES if "inputenc" not in p],
  r"\addbibresource{report.bib}",
  r"\begin{document}",
  r"\input{table}",
  r"\input{report}",
  r"\end{document}",
])

XELATEX_HOST = "\n".join([
  r"\documentclass{article}",
  r"\usepackage{fontspec}",
  r"\setmainfont{DejaVuSerif}[Extension=.ttf]",
  *AUDIT_TABLE_PACKAGES,
  r"\begin{document}",
  r"\input{table}",
  r"\end{document}",
])


@pytest.mark.latex
class TestNonLatinCompiles:
  """Output with text in other scripts compiles (#220)."""

  def test_standalone_report_compiles_with_pdflatex(self, tmp_path):
    missing = _missing_tools("latexmk", "pdflatex", "biber", "pdftotext")
    if missing:
      pytest.skip(f"not installed: {', '.join(missing)}")
    generate_latex_report(_nonlatin_session(), tmp_path / "report.tex")
    ok, log, text = _compile(tmp_path, "report.tex")
    assert ok, log[-3000:]
    assert "[non-Latin text]" in text
    assert "A Latin title" in text
    assert "federated authentication" in text
    assert "CO2 Workflow in" in " ".join(text.split())

  def test_fragments_compile_in_a_t1_host(self, tmp_path):
    missing = _missing_tools("latexmk", "pdflatex", "biber", "pdftotext")
    if missing:
      pytest.skip(f"not installed: {', '.join(missing)}")
    session = _nonlatin_session()
    generate_latex_report(session, tmp_path / "report.tex", standalone=False)
    generate_audit_table(session, tmp_path / "table.tex", label="x")
    (tmp_path / "host.tex").write_text(T1_HOST)
    ok, log, text = _compile(tmp_path, "host.tex")
    assert ok, log[-3000:]
    assert "[non-Latin text]" in text
    assert "doi:10.25682/niisi.2018.6.0011" in text
    assert "[conference paper] Bracketed" in text
    assert "CO2 Workflow in" in " ".join(text.split())

  def test_t1_ranges_match_the_encoding_files(self):
    """T1_UNSET_RANGES is what the installed .dfu files leave out."""
    if _missing_tools("kpsewhich"):
      pytest.skip("not installed: kpsewhich")
    declared = set()
    for name in ["t1enc.dfu", "ts1enc.dfu", "omsenc.dfu", "utf8enc.dfu"]:
      path = subprocess.run(["kpsewhich", name], capture_output=True,
                            text=True).stdout.strip()
      if not path:
        pytest.skip(f"{name} is not in the TeX tree")
      text = Path(path).read_text(encoding="latin-1")
      declared |= {int(code, 16) for code in re.findall(
        r"DeclareUnicodeCharacter\{([0-9A-Fa-f]+)\}", text)}
    unset = {code for code in range(0x80, LATEX_LATIN_CUTOFF + 1)
             if any(low <= code <= high for low, high in T1_UNSET_RANGES)}
    assert unset == set(range(0x80, LATEX_LATIN_CUTOFF + 1)) - declared

  @pytest.mark.parametrize("engine", ["xelatex", "lualatex"])
  def test_unicode_engines_print_the_text(self, tmp_path, engine):
    missing = _missing_tools("latexmk", engine, "kpsewhich", "pdftotext")
    if missing:
      pytest.skip(f"not installed: {', '.join(missing)}")
    font = subprocess.run(
      ["kpsewhich", "DejaVuSerif.ttf"], capture_output=True, text=True,
    ).stdout.strip()
    if not font:
      pytest.skip("DejaVu Serif is not in the TeX tree")
    generate_audit_table(_nonlatin_session(), tmp_path / "table.tex",
                         label="x")
    (tmp_path / "host.tex").write_text(XELATEX_HOST)
    ok, log, text = _compile(tmp_path, "host.tex", engine=f"-{engine}")
    assert ok, log[-3000:]
    assert CYRILLIC_PHRASE in " ".join(text.split())
    assert "[non-Latin text]" not in text
