Let's verify that the endpoint of a search survives the round trip
through the file, that a session written before [[via]] existed loads
with [[None]], and that a new search's result carries it into its
record.

<<test functions>>=
class TestSearchRecordVia:
    """The endpoint that answered is kept in the session record."""

    def test_round_trip_and_old_files(self):
        import json
        from scholar.review import _get_sessions_dir

        session = ReviewSession(query="q", providers=["s2"],
                                timestamp=datetime.now(), name="via-new")
        session.add_query_provider_pair("q", "s2", None, 0, hits=3,
                                        via="bulk")
        save_session(session)
        assert load_session("via-new").search_records[0].via == "bulk"

        old = {
            "query": "q", "name": "via-old", "providers": ["s2"],
            "timestamp": datetime.now().isoformat(),
            "search_records": [{"query": "q", "provider": "s2",
                                "filters": None, "limit": 100,
                                "hits": 3, "error": None, "retries": 0}],
            "decisions": [],
        }
        (_get_sessions_dir() / "via-old.json").write_text(json.dumps(old))
        [record] = load_session("via-old").search_records
        assert (record.hits, record.via) == (3, None)

    def test_a_new_search_records_it_and_keeps_the_old(self):
        from scholar.scholar import SearchResult

        bulk = SearchResult(query="a AND b", provider="s2", timestamp="t",
                            papers=[], limit=1000, via="bulk")
        first = create_review_session([bulk], "a AND b",
                                      session_name="via-run")
        save_session(first)
        plain = SearchResult(query="c", provider="s2", timestamp="t",
                             papers=[], limit=100)
        second = create_review_session([plain], "c",
                                       session_name="via-run")
        assert {r.query: r.via for r in second.search_records} \
            == {"c": None, "a AND b": "bulk"}
