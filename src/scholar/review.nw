def is_record_namesake(paper: Paper, record: Any) -> bool:
    """Whether DOI-less `paper` shares a store record's key, not its work.

    `record` is the `notes.ReviewDecisionRecord` stored under `paper`'s
    own id (or `None`); `plausibly_same_work` rules out that the paper
    rebuilt from it is the same work.
    """
    return (
        record is not None
        and not paper.doi
        and not plausibly_same_work(paper, paper_from_decision_record(record))
    )
