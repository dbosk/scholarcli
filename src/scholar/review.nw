\subsection{The checks of a decision and their counts}

A decision can carry both kinds of reason, an agent's correction on top
of a kept classifier call ([[sessions decide --keep-trace]]), so each
reason is checked on its own and labelled with its kind.  The counts say,
per kind, how many reasons there are, how many hold at least one checked
quote, and how many hold a quote not found, and also how many quotes
went unchecked for being short (a count of quotes, not of reasons); [[sessions show]] and the
report compute them once per decision and share
[[reason_quote_checks]], so the two can never disagree.

<<review quote check>>=
MACHINE_REASON_FIELDS = (("agent", "agent_reason"), ("llm", "llm_reason"))


@dataclass(frozen=True)
class ReasonQuoteCheck:
    """The quote check of one machine reason of a decision."""

    kind: str
    checked: int
    unmatched: tuple[str, ...]
    short: int = 0


def reason_quote_checks(decision: ReviewDecision) -> list[ReasonQuoteCheck]:
    """Check each machine reason of `decision` against its record."""
    checks = []
    for kind, name in MACHINE_REASON_FIELDS:
        reason = getattr(decision, name, None)
        if not reason:
            continue
        checked = checked_quotes(reason)
        unmatched = _unmatched_among(checked, decision.paper)
        short = len(quotes_in_reason(reason)) - len(checked)
        checks.append(ReasonQuoteCheck(
            kind, len(checked), tuple(unmatched), short
        ))
    return checks


def unmatched_quotes_of(checks: Sequence[ReasonQuoteCheck]) -> list[str]:
    """The unmatched quotes of a decision's checks, each once."""
    return list(dict.fromkeys(q for check in checks for q in check.unmatched))


def quote_check_tally(checks_per_decision) -> dict[str, dict[str, int]]:
    """Count reasons, reasons with checked quotes and with unmatched ones.

    Takes one list of `ReasonQuoteCheck`s per decision; returns the
    counts per kind (`agent`, `llm`).
    """
    tally = {
        kind: {"reasons": 0, "checked": 0, "unmatched": 0,
               "short_quotes": 0}
        for kind, _ in MACHINE_REASON_FIELDS
    }
    for checks in checks_per_decision:
        for check in checks:
            counts = tally[check.kind]
            counts["reasons"] += 1
            counts["checked"] += bool(check.checked)
            counts["unmatched"] += bool(check.unmatched)
            counts["short_quotes"] += check.short
    return tally
