class TestRetiredMarkInConcurrentSaves:
  """A save keeps the retirement mark the other process set (#275)."""

  AT = "2026-11-20T10:00:00+00:00"
  OTHER = """
    import sys
    from scholar.review import (
      DecisionStatus, load_session, retire_record, save_session,
    )
    session = load_session("rm")
  """

  @staticmethod
  def _make(tmp_path, monkeypatch, retired=None):
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    session = ReviewSession(
      query="q", providers=["openalex"],
      timestamp=datetime(2026, 11, 20), name="rm",
    )
    record = SearchRecord("q", "openalex", None, 10, hits=1,
                          searched_at="2026-11-01T00:00:00+00:00")
    record.retired = retired
    session.search_records.append(record)
    session.decisions.append(ReviewDecision(
      paper=Paper(title="Only", authors=["A"], doi="10.5555/rm-1"),
      provider="openalex", found_by=[record.key],
    ))
    save_session(session)

  def _run_other(self, code):
    import subprocess
    import sys
    import textwrap
    subprocess.run(
      [sys.executable, "-c",
       textwrap.dedent(self.OTHER) + textwrap.dedent(code)],
      check=True, timeout=120,
    )

  def test_other_process_retires_while_this_one_holds(
    self, tmp_path, monkeypatch
  ):
    self._make(tmp_path, monkeypatch)
    stale = load_session("rm")
    self._run_other("""
      retire_record(session.search_records[0], "%s", "draft", "B")
      save_session(session)
    """ % self.AT)
    stale.decisions[0].status = DecisionStatus.KEPT
    save_session(stale)
    session = load_session("rm")
    assert session.search_records[0].retired == {
      "at": self.AT, "by": "B", "note": "draft",
    }
    assert session.decisions[0].status == DecisionStatus.KEPT

  def test_this_process_retires_while_another_holds(
    self, tmp_path, monkeypatch
  ):
    import subprocess
    import sys
    import textwrap
    self._make(tmp_path, monkeypatch)
    other = subprocess.Popen(
      [sys.executable, "-c", textwrap.dedent(self.OTHER)
       + textwrap.dedent("""
          print("loaded", flush=True)
          sys.stdin.readline()
          session.decisions[0].status = DecisionStatus.KEPT
          save_session(session)
       """)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    try:
      assert other.stdout.readline().strip() == "loaded"
      session = load_session("rm")
      retire_record(session.search_records[0], self.AT, "draft")
      save_session(session)
      other.communicate("go\n", timeout=120)
    finally:
      if other.poll() is None:
        other.kill()
    assert other.returncode == 0
    session = load_session("rm")
    assert session.search_records[0].retired["note"] == "draft"
    assert session.decisions[0].status == DecisionStatus.KEPT

  def test_an_undo_in_another_process_is_kept(self, tmp_path, monkeypatch):
    self._make(tmp_path, monkeypatch,
               retired={"at": self.AT, "by": None, "note": "draft"})
    stale = load_session("rm")
    self._run_other("""
      session.search_records[0].retired = None
      save_session(session)
    """)
    stale.decisions[0].status = DecisionStatus.KEPT
    save_session(stale)
