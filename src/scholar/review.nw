        )]
        path = save_session(session)

        first = subprocess.Popen(
            [sys.executable, "-c", textwrap.dedent(self.BUILD)
             + textwrap.dedent("""
                print("built", flush=True)
                sys.stdin.readline()
                save_session(session)
             """)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
        )
        try:
            assert first.stdout.readline().strip() == "built"
            subprocess.run(
                [sys.executable, "-c", textwrap.dedent(self.BUILD)
                 + textwrap.dedent("""
                    new.status, new.tags = DecisionStatus.KEPT, ["t1"]
                    save_session(session)
                 """)],
                check=True, timeout=120,
            )
            first.communicate("go\n", timeout=120)
        finally:
            if first.poll() is None:
                first.kill()
        assert first.returncode == 0
        saved = {
            d["paper"]["doi"]: (d["status"], d["tags"])
            for d in json.loads(path.read_text())["decisions"]
        }
        assert saved == {
            "10.5555/wp214-old": ("pending", []),
            "10.5555/wp214-new": ("kept", ["t1"]),
        }
