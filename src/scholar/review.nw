def decision_verdict(decision: ReviewDecision) -> tuple:
    """Return what `decision` decided, and who, comparably.

    The persisted decision fields except the human review record
    (`HUMAN_AUDIT_FIELDS`): two copies of a work a human decided alike
    at two moments have the same verdict.
    """
    return (
        decision.status,
        tuple(decision.tags),
        decision.source,
        decision.is_example,
        decision.llm_confidence,
        *llm_audit_of(decision).values(),
        *agent_audit_of(decision).values(),
        tuple(tuple(sorted(r.items())) for r in decision.relabelled),
        tuple(tuple(sorted(r.items())) for r in decision.resets),
    )


def decision_state(decision: ReviewDecision) -> tuple:
    """Return the persisted decision fields of `decision`, comparably."""
    return (*decision_verdict(decision), *human_record_of(decision).values())
