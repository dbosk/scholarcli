class TestBibtexFieldValues:
  """Every written field reads back whole (#304)."""

  CHARACTERS = ["{", "}", "%", "\\", '"', "#", "\n", "\t", "\x00", "\x1f"]

  @staticmethod
  def _read(entry):
    import bibtexparser

    library = bibtexparser.parse_string(entry)
    assert library.failed_blocks == []
    assert len(library.entries) == 1
    return library.entries[0]

  @classmethod
  def _text(cls, value, name="title"):
    """Write `value` into a text field, parse it back, return it."""
    entry = cls._read(f"@article{{k,\n{bibtex_field(name, value)}\n}}")
    return entry.fields_dict[name].value

  @staticmethod
  def _paper(field, value):
    fields = dict(title="T", authors=["A B"], year=2020,
                  venue="V", doi="10.5555/plain", url="https://x.example/p")
    fields[field] = value
    return Paper(**fields)

  @pytest.mark.parametrize("value", [
    "a{b", "a}b", "a\\b", "a\\", "a\\\\", "a\\\\\\", "a\\{b}", "a\\}b{",
    "a%b#c\"d", "a\nb\rc\x00d\x1fe", "{a}b", "a%7Db", "%",
  ])
  @pytest.mark.parametrize("field", ["doi", "url"])
  def test_verbatim_fields_read_back(self, field, value):
    prefix = "10.5555/" if field == "doi" else "https://x.example/"
    entry = self._read(
      format_bibtex_entry(self._paper(field, prefix + value), "k"))
    assert set(entry.fields_dict) \
      == {"title", "author", "year", "journal", "doi", "url"}
    written = entry.fields_dict[field].value
    assert written == bibtex_verbatim_value(prefix + value,
                                            exact=field == "doi")
    if field == "doi" or value != "a%7Db":
      assert read_bibtex_verbatim(written) == prefix + value

  def test_the_verbatim_encoding(self):
    assert bibtex_verbatim_value("10.1/a}b") == "10.1/a%7Db"
    assert bibtex_verbatim_value("10.1/{a}b") == "10.1/{a}b"
    assert bibtex_verbatim_value("10.1/a\\b\\") == "10.1/a\\b%5C"
    assert bibtex_verbatim_value("10.1/a\\{b}") == "10.1/a%5C{b}"
    assert bibtex_verbatim_value("10.1/a\nb\x00") == "10.1/a%0Ab%00"
    assert bibtex_verbatim_value("10.1/a%b#c") == "10.1/a%b#c"

  def test_decoding_reads_only_the_writers_codes(self):
    assert read_bibtex_verbatim("a%7B%7D%5C%0A%1F") == "a{}\\\n\x1f"
    assert read_bibtex_verbatim("a%7db%20c%2F") == "a%7db%20c%2F"

  @pytest.mark.parametrize("value, written", [
    ("a}b", "a%7Db"), ("a%7Db", "a%257Db"), ("a%257Db", "a%25257Db"),
    ("a%25b", "a%25b"), ("a%20b", "a%20b"),
  ])
  def test_the_table_of_escapes(self, value, written):
    assert bibtex_verbatim_value(value) == written
    assert read_bibtex_verbatim(written) == value

  def test_a_url_keeps_its_escapes(self):
    url = "https://x.example/?q=%7Bfoo%7D&r=%5C"
    assert bibtex_field("url", url) == f"  url = {{{url}}},"
    assert bibtex_field("doi", "10.5555/q%7Dr") \
      == "  doi = {10.5555/q%257Dr},"

  def test_reading_inverts_writing(self):
    codes = ["7B", "7D", "5C", "25"] + [f"{c:02X}" for c in range(32)]
    pieces = ["", "%", "{", "}", "\\", "\n", "a", "7B", "%2", "%%"]
    values = set()
    for code in codes:
      for run in range(4):
        escape = "%" + "25" * run + code
        for before in pieces:
          for after in pieces:
            values.add(before + escape + after)
            values.add(before + escape.lower() + after)
    for value in sorted(values):
      written = bibtex_verbatim_value(value)
      assert read_bibtex_verbatim(written) == value, (value, written)
      assert not unpaired_braces(written)
    assert len(values) > 10000

  @pytest.mark.parametrize("char", CHARACTERS)
  @pytest.mark.parametrize("field", ["title", "venue"])
