def test_saved_only_when_non_empty(self, tmp_path, monkeypatch):
  import json

  monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
  path = save_session(self._session("screen-file"))
  assert "screenings" not in json.loads(path.read_text())["decisions"][0]
  session = self._load_apart("screen-file")
  assert session.decisions[0].screenings == []
  record_screening(session.decisions[0], self._verdict())
