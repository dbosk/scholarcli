SESSION_LOCK_TIMEOUT = 300  # seconds a session save waits for its lock
SESSION_LOCK_NOTICE = LOCK_TIMEOUT  # after this many, it says it waits
SESSION_LOCK_REPEAT = 60  # and again after each of this many
KEEP_SESSION_HINT = (
    "; Ctrl-C stops waiting and keeps this process's session beside "
    "the file"
)
NOTHING_CHANGED_HINT = "; Ctrl-C stops waiting, nothing has been changed yet"
<<review session functions>>=
def session_lock(path: Path, hint: str = KEEP_SESSION_HINT):
    """The lock of the session file `path`: never skipped.

    Waits up to `SESSION_LOCK_TIMEOUT` seconds, saying so after
    `SESSION_LOCK_NOTICE` and every `SESSION_LOCK_REPEAT` seconds after
    that (with `hint`), and raises `LockNotTaken` if the lock cannot be
    taken.
    """
    return file_lock(
        path, timeout=SESSION_LOCK_TIMEOUT, required=True,
        notice_after=SESSION_LOCK_NOTICE, notice_every=SESSION_LOCK_REPEAT,
        notice_hint=hint,
    )
