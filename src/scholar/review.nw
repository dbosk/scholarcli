class TestRetiredCover:
  """Only a current search stands in for a current merged record."""

  AT = "2026-11-20T10:00:00+00:00"

  def _records(self):
    merged = SearchRecord("q | q", "openalex, dblp", None, 100, hits=7)
    openalex = SearchRecord("q", "openalex", None, 100, hits=4)
    dblp = SearchRecord("q", "dblp", None, 100, hits=3)
    return merged, openalex, dblp

  def test_retired_record_does_not_cover_a_current_one(self):
    merged, openalex, dblp = self._records()
    retire_record(dblp, self.AT)
    assert merged_record_cover(merged, [openalex, dblp]) is None

  def test_current_records_cover_a_retired_one(self):
    merged, openalex, dblp = self._records()
    retire_record(merged, self.AT)
    assert merged_record_cover(merged, [openalex, dblp]) == [openalex, dblp]
    retire_record(dblp, self.AT)
    assert merged_record_cover(merged, [openalex, dblp]) == [openalex, dblp]
