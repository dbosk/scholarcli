    assert escape_bibtex(value) == written

  def test_a_value_without_a_backslash_is_not_parsed(self, monkeypatch):
    import scholar.review as review_module

    monkeypatch.setattr(review_module, "_latex_reader",
                        lambda: pytest.fail("parsed"))
    for value in ("50% -- ~ ``q'' {DNA}", "R&D $5", "plain"):
      assert latex_text_pieces(value) is None
      assert escape_bibtex(value) == review_module._escape_chars(
        value, review_module.BIBTEX_SPECIALS)

  def test_long_or_deep_values_are_not_decoded(self):
    deep = "{" * 1000 + "\\textit{x}" + "}" * 1000
    nested = "\\textit{" * 1000 + "x" + "}" * 1000
    math = "$" + "\\mathcal{" * 1000 + "x" + "}" * 1000 + "$"
    long = "\\'e " + "a" * LATEX_DECODE_MAX_CHARS
    for value in (deep, nested, math, long):
      assert latex_text_pieces(value) is None
      field = bibtex_field("title", value)
      assert field.startswith("  title = {")
    assert latex_text_pieces("{" * 5 + "\\'e" + "}" * 5) is not None
    assert latex_text_pieces("{" * 12 + "\\'e" + "}" * 12) is None

  def test_a_decoder_that_raises_never_stops_the_writer(self, monkeypatch):
    import scholar.review as review_module

    def broken(*args, **kwargs):
      raise IndexError("inside the decoder")

    monkeypatch.setattr(review_module, "_latex_pieces", broken)
    assert latex_text_pieces("Caf\\'e") is None
    assert escape_bibtex("Caf\\'e") == "Caf\\textbackslash{}'e"
