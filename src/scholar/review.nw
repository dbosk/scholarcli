class TestDecisionStoreKeepsStoredPaper:
  """A re-run of a decision-store-only query keeps the stored paper."""

  DOI = "10.1109/ipdps.2014.73"

  @staticmethod
  def _store(paper_id, **fields):
    from scholar.notes import ReviewDecisionRecord, save_search_decisions
    save_search_decisions("old query", {paper_id: ReviewDecisionRecord(
      status="discarded", tags=["off-topic"], title="A Study",
      authors=["Ada Lovelace"], provider="openalex", **fields,
    )})

  @staticmethod
  def _rerun(returned):
    from scholar.scholar import SearchResult, isolated_registry
    result = SearchResult(
      query="old query", provider="s2", timestamp=datetime.now(),
      papers=[returned], limit=10,
    )
    with isolated_registry():
      session = create_review_session([result], "old query")
    [decision] = [d for d in session.decisions
                  if d.paper.doi == returned.doi]
    return decision

  def test_abstract_venue_and_links_are_kept(self):
    self._store(f"doi:{self.DOI}", year=2014, doi=self.DOI,
                abstract="stored abstract", venue="IPDPS 2014",
                url="https://example.org/a",
                pdf_url="https://example.org/a.pdf")
    decision = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2015,
      doi=self.DOI, venue="Proc. IPDPS", sources=["s2"],
      citation_count=7,
    ))
    paper = decision.paper
    assert paper.abstract == "stored abstract"
    assert (paper.year, paper.venue) == (2014, "IPDPS 2014")
    assert paper.url == "https://example.org/a"
    assert paper.pdf_url == "https://example.org/a.pdf"
    assert paper.citation_count == 7
    assert paper.sources == ["openalex", "s2"]
    assert decision.provider == "openalex, s2"
    assert decision.status == DecisionStatus.DISCARDED
    assert decision.tags == ["off-topic"]

  def test_paper_that_gained_a_doi_keeps_its_abstract(self):
    self._store(legacy_hash_paper_id("A Study", ["Ada Lovelace"]),
                year=2014, venue="ICSE", abstract="stored abstract")
    arxiv = "10.48550/arXiv.1301.00001"
    decision = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2013,
      doi=arxiv, venue="arXiv", sources=["s2"],
    ))
    paper = decision.paper
    assert paper.doi == arxiv
    assert (paper.year, paper.venue) == (2013, "arXiv")
    assert paper.abstract == "stored abstract"
    assert decision.status == DecisionStatus.DISCARDED

  def test_another_work_lends_nothing(self):
    self._store(legacy_hash_paper_id("A Study", ["Ada Lovelace"]),
                year=1994, abstract="the older work")
    decision = self._rerun(Paper(
      title="A Study", authors=["Ada Lovelace"], year=2014,
      doi=self.DOI, sources=["s2"],
    ))
    assert decision.paper.abstract is None
    assert decision.paper.year == 2014
