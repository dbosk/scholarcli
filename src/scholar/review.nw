class TestConcurrentSaveInOneProcess:
  DOI = TestConcurrentSaveKeepsPaperData.DOI

  def test_the_registry_does_not_hide_the_file(self):
    import subprocess
    import sys
    import textwrap
    from scholar.scholar import get_registry
    helper = TestConcurrentSaveKeepsPaperData()
    helper._first_save()
    session = load_session("conc-194")
    held = get_registry().get(f"doi:{self.DOI}")
    subprocess.run([sys.executable, "-c",
                    textwrap.dedent(helper.B_ENRICHES)],
                   check=True, timeout=120)
    session.decisions[0].status = DecisionStatus.KEPT
    session.decisions[0].tags = ["ml"]
    save_session(session)
    saved = helper._saved()[self.DOI]
    assert saved["paper"]["abstract"] == "from B"
    assert saved["paper"]["venue"] == "B venue"
    assert saved["status"] == "kept"
    assert held.abstract is None and held.venue is None

  def test_a_paper_new_on_disk_fills_the_held_copy(self):
    from scholar.scholar import isolated_registry
    other = "10.1/other-194"
    TestConcurrentSaveKeepsPaperData()._first_save()
    session = load_session("conc-194")
    held = Paper.from_dict({"title": "Other", "authors": ["B"],
                            "doi": other, "venue": "held venue"})
    with isolated_registry():
      theirs = load_session("conc-194")
      theirs.decisions.append(ReviewDecision(
        paper=Paper(title="Other", authors=["B"], doi=other,
                    abstract="from disk", venue="disk venue"),
        provider="s2", status=DecisionStatus.KEPT, tags=["ml"],
      ))
      save_session(theirs)
    save_session(session)
    [added] = [d for d in session.decisions if d.paper.doi == other]
    assert added.paper.abstract == "from disk"
    assert added.paper.venue == "held venue"
    assert held.abstract is None
    assert TestConcurrentSaveKeepsPaperData._saved()[other][
      "paper"]["abstract"] == "from disk"

  def test_nothing_to_fill_keeps_the_same_object(self):
    ours = Paper(title="A", authors=["B"], doi=self.DOI, abstract="x")
    theirs = Paper(title="A", authors=["B"], doi=self.DOI)
    assert paper_filled_from(ours, theirs) is ours
    filled = paper_filled_from(theirs, ours)
    assert filled is not theirs and filled.abstract == "x"
    assert theirs.abstract is None
@

Two works with the same title and first author share a hash id when
neither has a DOI, so the file's copy under our id may be another
work: here B keeps a 1994 paper under the id of our 2014 one.  Neither
lends the other anything, also when the file's decision is new to us
and the registry holds the other work: the file's decision keeps the
file's paper.

