A lock file that cannot be opened is no other process's doing.  With
the session's lock file made read-only (as another user's would be),
the save is refused at once, the error names the lock file and its
permissions, not another process, and the session is kept.  With the
sessions directory read-only and no lock file in it yet, the error
says in the same line that nothing could be kept, and no kept file is
tried.  (A lock file left there by an earlier save can still be locked
in a read-only directory; the write then fails as any write there does,
with the system's error.)

<<test functions>>=
class TestLockFileThatCannotBeOpened:
  """A lock file that cannot be opened is said so (#316)."""

  def _session(self, tmp_path, monkeypatch):
    path = TestSaveWhenTheLockIsHeld._make(tmp_path, monkeypatch)
    session = load_session("held")
    session.decisions[0].status = DecisionStatus.KEPT
    return path, session

  def test_a_read_only_lock_file(self, tmp_path, monkeypatch):
    from scholar.utils import lock_path
    path, session = self._session(tmp_path, monkeypatch)
    lock = lock_path(path)
    lock.touch()
    lock.chmod(0o400)
    before = path.read_bytes()
    try:
      with pytest.raises(SessionNotSaved) as raised:
        save_session(session)
    finally:
      lock.chmod(0o600)
    message = str(raised.value)
    assert f"cannot open the lock file {lock}" in message
    assert "check its permissions" in message
    assert "another scholar process" not in message
    assert "once its lock file can be opened" in message
    assert raised.value.unsaved.exists()
    assert path.read_bytes() == before

  def test_a_read_only_directory(self, tmp_path, monkeypatch):
    from scholar.utils import lock_path
    path, session = self._session(tmp_path, monkeypatch)
    before = path.read_bytes()
    lock_path(path).unlink(missing_ok=True)
    path.parent.chmod(0o500)
    try:
      with pytest.raises(SessionNotSaved) as raised:
        save_session(session)
      kept = list(path.parent.glob(f"*{UNSAVED_MARK}*"))
    finally:
      path.parent.chmod(0o700)
    message = str(raised.value)
    assert "check its permissions" in message
    assert f"the directory {path.parent} is not writable" in message
    assert "\n" not in message
    assert raised.value.unsaved is None and kept == []
    assert path.read_bytes() == before
