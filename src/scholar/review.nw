def linked_search_keys(decisions: list[ReviewDecision]) -> set[tuple]:
    """The search keys that some decision's `found_by` names."""
    return {link for decision in decisions for link in decision.found_by}


def record_may_have_answered(
    record: SearchRecord, links: set[tuple], provider_names: set[str]
) -> bool:
    """Whether the session has papers that `record`'s run may have returned.

    A link in `links` names its key, or only its query and provider (an
    old link, filters key `None`); or one of its providers is among
    `provider_names` (lower-cased, as `decision_provider_names` gives).
    """
    return (
        record.key in links
        or (record.query, record.provider, None) in links
        or any(
            name.lower() in provider_names
            for name in record.merged_providers
        )
    )


def session_preferred_record(
    a: SearchRecord,
    b: SearchRecord,
    links: set[tuple],
    provider_names: set[str],
) -> SearchRecord:
    """Of two records of one search, the one a session keeps.

    `preferred_record`, except that a run that failed outright replaces
    a record without a recorded outcome when the session has no papers
    that the record's run may have returned (`record_may_have_answered`
    with the session's `links` and `provider_names`).
    """
    kept = preferred_record(a, b)
    other = b if kept is a else a
    if (outcome_unknown(kept) and failed_outright(other)
            and not record_may_have_answered(kept, links, provider_names)):
        return other
    return kept
@

Let's verify the probe of the issue: a DBLP record without an outcome,
then a DBLP re-run that fails, in a session whose paper names OpenAlex.
The failure replaces the record, survives a save, and the report lists
DBLP as not searched, with the failure as the reason, instead of under
\enquote{Outcome not recorded}.  A link to the record keeps it, also an
old link without filters, and so does a paper naming DBLP without any
link, the case of the sessions written before links: an OpenAlex search
re-run with a spent budget keeps its old record, and the report still
counts OpenAlex as searched.  In the save's merge the same holds in
both orders, the own record without an outcome and the file's failure
or the other way round, and evidence on either side keeps the old
record.

