class TestCheckTitleMatchGuards:
  """A title match yields to different DOIs or distant years."""

  def _session(self, paper):
    session = ReviewSession(query="q", providers=["openalex"],
                            timestamp=datetime.now(), name="s")
    session.decisions = [ReviewDecision(
      paper=paper, provider="openalex", status=DecisionStatus.KEPT,
      tags=["supports-claim"],
    )]
    return [session]

  def _matched_by(self, found, held):
    rows, _ = check_against_sessions([found], self._session(held))
    return [m.matched_by for m in rows[0].matches]

  def test_editorials_do_not_match(self):
    held = Paper(title="Editorial", authors=["Wei Wang"],
                 doi="10.1/ed1", year=2010)
    found = Paper(title="Editorial", authors=["Li Wang"],
                  doi="10.9/ed2", year=2023)
    assert self._matched_by(found, held) == []

  def test_each_guard_alone(self):
    held = Paper(title="Editorial", authors=["Wei Wang"],
                 doi="10.1/ed1", year=2010)
    other_doi = Paper(title="Editorial", authors=["Li Wang"],
                      doi="10.9/ed2", year=2010)
    assert self._matched_by(other_doi, held) == []
    no_doi_far = Paper(title="Editorial", authors=["Li Wang"], year=2023)
    assert self._matched_by(no_doi_far, held) == []
    no_doi_near = Paper(title="Editorial", authors=["Li Wang"], year=2011)
    assert self._matched_by(no_doi_near, held) == ["title+author"]

  def test_authorless_session_paper_matches_on_title(self):
    held = Paper(title="Account recovery study", authors=[], year=2020)
    found = Paper(title="Account Recovery Study", authors=["Ann Smith"],
                  doi="10.1/acc", year=2021)
    assert self._matched_by(found, held) == ["title"]
    far = Paper(title="Account Recovery Study", authors=["Ann Smith"],
                doi="10.1/acc", year=2024)
    assert self._matched_by(far, held) == []
