        provider="p", status=DecisionStatus.DISCARDED, tags=["t"],
      )

    doubtful = decision(1, self.STATEMENT)
    hand = decision(2)
    set_abstract([hand], self.STATEMENT, "Crossref",
                 "2026-11-20T10:00:00+00:00")
    decisions = [doubtful, hand, decision(3), decision(4, REAL_ABSTRACT)]
    gap = abstract_gap(decisions)
    assert (gap.papers, gap.without, gap.doubtful) == (4, 1, 1)
    session = ReviewSession(query="q", providers=["p"],
                            timestamp=datetime(2026, 11, 20))
    session.decisions = decisions
    assert decided_without_abstract_sentence(decisions) == (
      "1 of the 4 decided papers was decided without an abstract (1 no "
      "record of a lookup), and 1 on a doubtful one."
    )
    assert decided_without_abstract_sentence([doubtful, hand]) == (
      "1 of the 2 decided papers was decided on a doubtful abstract."
