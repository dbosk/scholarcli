  def test_a_dropped_copy_s_links_follow_a_superseded_record(self):
    """A stale process holds the copies with links to an old merged
    record; meanwhile per-provider records superseded it and the copies
    were reconciled. The stale save drops the untouched copy, and its
    link ends on the per-provider records, not on the merged one."""
    merged = SearchRecord("q | q", "openalex, dblp", None, 100, hits=2)
    link = merged.key
    pending, kept = (DecisionStatus.PENDING, []), (DecisionStatus.KEPT, ["ml"])
    bare, with_doi = self._two_copies(pending, kept)
    session = load_session("copies")
    session.search_records = [merged]
    for decision in session.decisions:
      decision.found_by = [link]
    save_session(session)
    stale = load_session("copies")
    rerun = load_session("copies")
    rerun.search_records += [
      SearchRecord("q", provider, None, 100, hits=2)
      for provider in ("openalex", "dblp")
    ]
    save_session(rerun)
    reconcile_session("copies")
    stale.research_context = "edited meanwhile"
    save_session(stale)
    final = load_session("copies")
    [decision] = final.decisions
    assert decision.paper.doi == "10.1145/race"
    assert set(decision.found_by) == {
      ("q", "openalex", ""), ("q", "dblp", ""),
    }
    assert [r.provider for r in final.search_records] == ["openalex", "dblp"]

