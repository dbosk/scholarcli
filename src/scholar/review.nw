The window that remains, between reading the file and replacing it, is
milliseconds instead of hours, and [[save_session]] closes it by holding
[[file_lock]] across both.

Let's verify the paper merge with the race of
\url{https://github.com/dbosk/scholarcli/issues/194}, in real
processes, since a second process does not share our paper registry: A
loads the session (as [[sessions decide]] or a long [[search -n]]
would), B enriches the paper (an abstract, keywords and its own venue)
and saves, then A decides the paper, having meanwhile found another
venue, and saves.  The file must keep A's decision and venue and B's
abstract and keywords.  We read the saved file itself, not a load, so
that no registry stands between the test and what was written.

<<test functions>>=
class TestConcurrentSaveKeepsPaperData:
  """A save fills its paper's gaps from the file, never empties them."""

  DOI = "10.1109/ipdps.2014.73"

  def _first_save(self, **fields):
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = ReviewSession(
        query="q", providers=["openalex"], timestamp=datetime.now(),
        name="conc-194",
      )
      session.decisions = [ReviewDecision(
        paper=Paper(title="A Study", authors=["Ada Lovelace"],
                    year=2014, doi=self.DOI, sources=["openalex"],
                    **fields),
        provider="openalex", status=DecisionStatus.PENDING,
      )]
      save_session(session)

  @staticmethod
  def _saved():
    import json
    from scholar.review import _get_sessions_dir
    data = json.loads((_get_sessions_dir() / "conc-194.json").read_text())
    return {d["paper"]["doi"]: d for d in data["decisions"]}

  B_ENRICHES = """
    from dataclasses import replace
    from scholar.review import load_session, save_session
    session = load_session("conc-194")
    [decision] = session.decisions
    decision.paper = replace(decision.paper, abstract="from B",
                             keywords=["hpc"], venue="B venue")
    save_session(session)
  """

  def test_a_stale_save_keeps_the_other_enrichment(self):
    import subprocess
    import sys
    import textwrap
    self._first_save()
    a = subprocess.Popen(
      [sys.executable, "-c", textwrap.dedent("""
        import sys
        from dataclasses import replace
        from scholar.review import (
          DecisionStatus, load_session, save_session,
        )
        session = load_session("conc-194")
        print("loaded", flush=True)
        sys.stdin.readline()
        [decision] = session.decisions
        decision.status, decision.tags = DecisionStatus.KEPT, ["ml"]
        decision.paper = replace(decision.paper, venue="A venue")
        save_session(session)
      """)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    try:
      assert a.stdout.readline().strip() == "loaded"
      subprocess.run([sys.executable, "-c",
                      textwrap.dedent(self.B_ENRICHES)],
                     check=True, timeout=120)
      a.communicate("go\n", timeout=120)
    finally:
      if a.poll() is None:
        a.kill()
    assert a.returncode == 0
    saved = self._saved()[self.DOI]
    assert (saved["status"], saved["tags"]) == ("kept", ["ml"])
    assert saved["paper"]["abstract"] == "from B"
    assert saved["paper"]["keywords"] == ["hpc"]
    assert saved["paper"]["venue"] == "A venue"
@

In one process the registry is what hid the file's copies, so the same
race is played there too: A loads through the registry, B runs in its
own registry, A saves.  The object the registry holds is not changed by
the merge.  A paper that B added and this process already holds
(here as a search result's copy without an abstract) is ours, its gaps
filled from the file.

