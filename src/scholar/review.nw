for i, current in enumerate(session.search_records):
    same_search = current.key == record.key or (
        record.is_legacy
        and any(current is c for c in current_run)
        and (current.query, current.provider)
        == (record.query, record.provider)
    )
    if same_search and current.error and not record.error:
        session.search_records[i] = record
        if current.key != record.key:
            replaced_links[current.key] = record.key
