class TestSameIdDecisionsPaired:
  """Copies under one id pair with their own copy in the file (#228)."""

  SCOPUS = legacy_hash_paper_id("A Study", ["Lovelace A."])

  def _save(self, *extra):
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = ReviewSession(query="q", providers=["scopus", "openalex"],
                              timestamp=datetime.now(), name="pair")
      session.decisions = [
        ReviewDecision(
          paper=Paper(title="A Study", authors=["Lovelace A."], year=2014),
          provider="scopus", status=DecisionStatus.DISCARDED,
          tags=["off-topic"], found_by=[("q", "scopus", "")]),
        ReviewDecision(
          paper=Paper(title="A Study", authors=["Lovelace A."], year=2014),
          provider="openalex", status=DecisionStatus.KEPT, tags=["theme"],
          found_by=[("q", "openalex", "")]),
        *extra,
      ]
      save_session(session)

  @staticmethod
  def _by_provider():
    from scholar.scholar import isolated_registry
    with isolated_registry():
      session = load_session("pair")
    return {
      d.provider: (d.paper.id, d.status.value, d.tags, sorted(d.found_by))
      for d in session.decisions
    }

  def _untouched(self):
    return {
      "scopus": (self.SCOPUS, "discarded", ["off-topic"],
                 [("q", "scopus", "")]),
      "openalex": (self.SCOPUS, "kept", ["theme"], [("q", "openalex", "")]),
    }

