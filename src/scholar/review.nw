WAIT = 'import sys; print("loaded", flush=True); sys.stdin.readline()'

def _code(self, links, wait):
  import textwrap

  return textwrap.dedent(self.RACE).replace(
    "WAIT", self.WAIT if wait else "").replace("LINKS", repr(links))

def _race(self, stale, other):
  """`stale` loads and waits; `other` runs whole; then `stale` saves."""
  import subprocess
  import sys

  decision = ReviewDecision(paper=self._paper("r"), provider="openalex")
  decision.record_search("q", "openalex", "")
  save_session(ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 23),
    name="pl-race", decisions=[decision],
  ))
  first = subprocess.Popen(
    [sys.executable, "-c", self._code(stale, wait=True)],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
  )
  try:
    assert first.stdout.readline().strip() == "loaded"
    subprocess.run([sys.executable, "-c", self._code(other, wait=False)],
                   check=True, timeout=120)
    first.communicate("go\n", timeout=120)
  finally:
    if first.poll() is None:
      first.kill()
  assert first.returncode == 0
  return self._reload("pl-race")

EARLY_RUN = [("q", 7), ("q2", 4)]
LATE_RUN = [("q", 2)]
UNITED = {"Paper r": [("q", "openalex", 2), ("q2", "openalex", 4)]}

def test_concurrent_saves_keep_the_smaller_place(self):
  assert self._race(self.EARLY_RUN, self.LATE_RUN) == self.UNITED

def test_concurrent_saves_in_the_other_order(self):
  assert self._race(self.LATE_RUN, self.EARLY_RUN) == self.UNITED
