def merge_concurrent_changes(
    session: ReviewSession, on_disk: ReviewSession
) -> None:
    """Merge into `session` what another process saved in `on_disk`.

    Decisions and research context that `session` still has as loaded
    (its baseline) take the on-disk value; papers and search records
    that only the file has are added; a paper both hold takes the
    file's value of each field `session` still has as loaded, its
    empty fields filled from the file's copy (`paper_merged_from`).
    Changes made through `session` are kept.
    """
    base = session._baseline
    base_states = base.decisions if base else {}
    base_papers = base.papers if base else {}
    paired, additions = pair_with_file(session, on_disk)
    <<find the legacy records this session replaced>>

    for decision in session.decisions:
        paper_id = get_paper_id(decision.paper)
        theirs = paired.get(id(decision))
        mine = decision_state(decision)
        history = None
        if theirs is not None:
            history = ConcurrentHistory.of(decision, theirs)
            mine_new = [r for r in decision.abstract_set
                        if r not in theirs.abstract_set]
            their_new = [r for r in theirs.abstract_set
                         if r not in decision.abstract_set]
            decision.paper = paper_merged_from(
                decision.paper, theirs.paper, base_papers.get(paper_id)
            )
            <<settle the abstract against the file's hand records>>
            for link in theirs.found_by:
                decision.record_link(replaced.get(link, link))
            for copy in theirs.same_id_copies:
                decision.add_same_id_copy(copy)
            for record in theirs.relabelled:
                decision.add_relabel(record)
            for record in theirs.resets:
                decision.add_reset(record)
            for record in theirs.abstract_set:
                decision.add_abstract_record(record)
            decision.abstract_lookup = later_abstract_lookup(
                decision.abstract_lookup, theirs.abstract_lookup
            )
            for record in theirs.abstract_fetched:
                decision.add_fetched_abstract(record)
            unite_screenings(decision, theirs.screenings)
        base_state = base_states.get(base_key_of(decision, base))
        if (theirs is not None and base_state is not None
                and decision_state(theirs) not in (base_state, mine)):
            if mine == base_state:
                decision.status = theirs.status
                decision.tags = list(theirs.tags)
                decision.source = theirs.source
                decision.is_example = theirs.is_example
                decision.llm_confidence = theirs.llm_confidence
                for name, value in llm_audit_of(theirs).items():
                    setattr(decision, name, value)
                for name, value in agent_audit_of(theirs).items():
                    setattr(decision, name, value)
                for name, value in human_record_of(theirs).items():
                    setattr(decision, name, value)
            else:
                <<warn that both processes decided the paper>>
        if history is not None:
            settle_concurrent_screenings(decision, history)

    for theirs in additions:
        held = get_registry().register(theirs.paper)
        if plausibly_same_work(held, theirs.paper):
            theirs.paper = paper_filled_from(held, theirs.paper)
        session.decisions.append(theirs)
    session.folded = {**on_disk.folded, **session.folded}
    session.renamed = {**on_disk.renamed, **session.renamed}
    settle_rename_cycles(session)
    apply_tombstones(session, base, paired)

    <<merge research context from disk>>

    own_index = {r.key: i for i, r in enumerate(session.search_records)}
    links = linked_search_keys(session.decisions)
    provider_names = (
        decision_provider_names(session) | decision_provider_names(on_disk)
    )
    for record in on_disk.search_records:
        if record.key in own_index:
            i = own_index[record.key]
            ours = session.search_records[i]
            kept = session_preferred_record(
                ours, record, links, provider_names
            )
            <<settle the retirement mark of a search both hold>>
            session.search_records[i] = kept
        elif record.key not in replaced:
            session.search_records.append(record)
    own_rounds = {r.timestamp for r in session.snowball_rounds}
    for snowball_round in on_disk.snowball_rounds:
        if snowball_round.timestamp not in own_rounds:
            session.snowball_rounds.append(snowball_round)
    <<merge the LLM review samples from disk>>
    <<merge the samples of a tier's rest from disk>>
    supersede_merged_records(session)
    repoint_paper_ids(session)

    session._invalidate_cache()
