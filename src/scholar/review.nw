replaced: dict[tuple, tuple] = {}
own_keys_now = {r.key for r in session.search_records}
for record in on_disk.search_records:
    if not record.is_legacy or record.key in own_keys_now:
        continue
    successor = next(
        (r for r in session.search_records
         if (r.query, r.provider) == (record.query, record.provider)),
        None,
    )
    if successor is not None:
        replaced[record.key] = successor.key
<<drop our legacy records that the file replaced>>
<<drop our legacy records that the file replaced>>=
disk_keys = {r.key for r in on_disk.search_records}
base_keys = base.record_keys if base else frozenset()
for record in list(session.search_records):
    if (not record.is_legacy or record.key not in base_keys
            or record.key in disk_keys):
        continue
    same_pair = [
        r for r in on_disk.search_records
        if (r.query, r.provider) == (record.query, record.provider)
    ]
    if not same_pair:
        continue
    successor = next(
        (r for r in same_pair if r.key not in base_keys), same_pair[0]
    )
    session.search_records.remove(record)
    replaced[record.key] = successor.key
for decision in session.decisions:
    if any(link in replaced for link in decision.found_by):
        decision.found_by = without_superseded_links(list(dict.fromkeys(
            replaced.get(link, link) for link in decision.found_by
        )))
