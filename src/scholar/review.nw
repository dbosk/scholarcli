def _loose_session(*extra):
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime.now(),
    name="loose",
  )

  def decision(title, authors, year, doi=None):
    return ReviewDecision(
      paper=Paper(title=title, authors=authors, year=year, doi=doi),
      provider="openalex", status=DecisionStatus.KEPT, tags=["ml"],
    )

  session.decisions = [
    decision("7 THE QUIET LEDGER", [], 2019),
    decision("Gardening with Lichens, 3rd edition", ["Tove Rask"], 2015),
    decision("12 Angry Lighthouses", [], 2011),
  ] + [decision(*args) for args in extra]
  return session


def _loose_match(title, authors, year, edition=None, doi=None,
                 session=None):
  entry = ("k", [Paper(title=title, authors=authors, year=year, doi=doi)],
           edition)
  return match_cited_entries([entry], session or _loose_session())[0]


class TestCitedLooseTitles:
  """Cited entries matched without edition or chapter number (#272)."""

  def test_a_chapter_heading_without_authors(self):
    found = _loose_match("The Quiet Ledger", ["Mira Holt"], 2019,
                         doi="10.9/ledger")
    assert (found.matched_by, found.works, found.loose_titles) == (
      "title without edition or chapter number",
      [("7thequietledger", "")], ["7 THE QUIET LEDGER"],
    )

  def test_an_edition_in_the_title(self):
    for edition in ("3", "third", None):
      found = _loose_match("Gardening with {Lichens}", ["Rask, Tove"],
                           2015, edition)
      assert found.works == [("gardeningwithlichens3rdedition", "rask")], \
        edition
    found = _loose_match("Gardening with Lichens (3rd ed.)", ["Tove Rask"],
                         2016)
    assert found.works == [("gardeningwithlichens3rdedition", "rask")]

  def test_another_edition_is_another_work(self):
    for edition in ("4", "2nd", "Revised"):
      found = _loose_match("Gardening with Lichens", ["Tove Rask"], 2015,
                           edition)
      assert (found.matched_by, found.works) == (None, []), edition
    found = _loose_match("Gardening with Lichens, 2nd edition",
                         ["Tove Rask"], 2015)
    assert found.works == []

  def test_a_mixed_case_title_keeps_its_number(self):
    found = _loose_match("Angry Lighthouses", ["Ivo Lund"], 2011)
    assert (found.matched_by, found.works) == (None, [])

  def test_years_two_apart_are_two_works(self):
    assert _loose_match("The Quiet Ledger", ["Mira Holt"], 2021).works \
      == []
    assert _loose_match("The Quiet Ledger", ["Mira Holt"], 2020).works \
      == [("7thequietledger", "")]
    assert _loose_match("Gardening with Lichens", ["Tove Rask"], 2013,
                        "3").works == []

  def test_authors_on_both_sides_must_agree(self):
    assert _loose_match("Gardening with Lichens", ["Tove Rusk"], 2015,
                        "3").works == []
    assert _loose_match("Gardening with Lichens", [], 2015, "3").works \
      == []

  def test_two_works_under_one_loose_title_are_ambiguous(self):
    session = _loose_session(
      ("The Quiet Ledger, 2nd edition", ["Mira Holt"], 2019),
    )
    found = _loose_match("The Quiet Ledger", ["Mira Holt"], 2019,
                         session=session)
    assert (found.matched_by, found.works, found.ambiguous) == (
      None, [], ["7 THE QUIET LEDGER", "The Quiet Ledger, 2nd edition"],
    )
    copies = _loose_session(("7  THE QUIET LEDGER", [], 2019))
    found = _loose_match("The Quiet Ledger", ["Mira Holt"], 2019,
                         session=copies)
    assert (found.works, found.ambiguous) == ([("7thequietledger", "")], [])

  def test_a_numbered_heading_with_an_author_is_another_paper(self):
    session = _loose_session(
      ("2 NEW MOSSES FROM THE ANDES", ["Ines Varga"], 1995),
    )
    found = _loose_match("New Mosses from the Andes", ["Varga, Ines"], 1996,
                         session=session)
    assert (found.matched_by, found.works) == (None, [])

  def test_copies_of_one_edition_are_one_work(self):
    session = _loose_session(
      ("Gardening with lichens (3rd ed.)", ["Tove Rask"], 2015),
    )
    found = _loose_match("Gardening with Lichens", ["Tove Rask"], 2015, "3",
                         session=session)
    assert (found.matched_by, found.ambiguous) == (
      "title without edition or chapter number", [],
    )
    assert sorted(found.works) == [
      ("gardeningwithlichens3rded", "rask"),
