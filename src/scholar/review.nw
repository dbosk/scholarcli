A run starts at a flagged character and ends after the last flagged one
before the next Latin letter; what lies between flagged characters is a
bridge. Braces and the backslash never bridge: the BibTeX escaper
leaves them as they are, since they carry meaning in a field, and a
closing brace of the text inside the macro's argument would close the
argument early. Whether a run is text or decoration is decided by its
own flagged characters, by Unicode category: letters (L) and digits (N)
are text, marks and symbols are not.

<<review report generation>>=
NONLATIN_RUN_STOPS = "{}\\"
LATIN_LIGATURES = "".join(chr(code) for code in range(0xFB00, 0xFB07))


def _nonlatin_run_end(chars: str, flags: list[bool], start: int) -> int:
    end = index = start
    while index < len(chars):
        if flags[index]:
            end = index = index + 1
        elif chars[index].isalpha() or chars[index] in NONLATIN_RUN_STOPS:
            break
        else:
            index += 1
    return end


SPACING_MODIFIERS = (0x02B0, 0x02FF)


def _run_kind(chars: str, flags: list[bool]) -> str:
    low, high = SPACING_MODIFIERS
    for char, flagged in zip(chars, flags):
        if flagged and unicodedata.category(char)[0] in "LN" \
                and not low <= ord(char) <= high:
            return NONLATIN_TEXT
    return NONLATIN_SYMBOLS


def split_nonlatin(text: str) -> list[tuple[str, str, list[bool]]]:
    """Split `text` into plain pieces and runs pdfLaTeX cannot set.

    The text is cleaned and composed first, as the escapers see it.
    Each piece is a `(kind, piece, flags)` triple: `kind` is
    `PLAIN_TEXT`, `NONLATIN_TEXT` (a run with letters or digits) or
    `NONLATIN_SYMBOLS` (a run of symbols only), and `flags` marks the
    piece's characters beyond what pdfLaTeX can set.
    """
    chars = unicodedata.normalize("NFC", clean_metadata_text(text))
    chars = "".join(
        unicodedata.normalize("NFKC", char) if char in LATIN_LIGATURES
        else char
        for char in chars
    )
    flags = _beyond_latin_flags(chars)
    pieces: list[tuple[str, str, list[bool]]] = []
    start = index = 0
    while index < len(chars):
        if not flags[index]:
            index += 1
            continue
        end = _nonlatin_run_end(chars, flags, index)
        if start < index:
            pieces.append((PLAIN_TEXT, chars[start:index], flags[start:index]))
        pieces.append(
            (_run_kind(chars[index:end], flags[index:end]),
             chars[index:end], flags[index:end])
        )
        start = index = end
    if start < len(chars):
        pieces.append((PLAIN_TEXT, chars[start:], flags[start:]))
    return pieces


def only_nonlatin_letters(text: str) -> bool:
    """Whether `text` has letters and all of them are beyond pdfLaTeX.

    Such a text prints no letter under pdfLaTeX, only the marker of
    `\\scholarnonlatin`, so whatever shows it needs another identifier.
    """
    pieces = split_nonlatin(text)
    return any(kind == NONLATIN_TEXT for kind, _, _ in pieces) and not any(
        char.isalpha()
        for kind, piece, _ in pieces if kind == PLAIN_TEXT
        for char in piece
    )
@

\paragraph{A run that touches a letter}
Text in CJK scripts is written without spaces, also next to a Latin
word, so a title such as \enquote{\ldots{}Mac OS X\ldots} with Chinese
on both sides becomes a run, the Latin words and a run with nothing
between them.  Under Xe\LaTeX{} and Lua\LaTeX{} that is exactly the
title.  Under pdf\LaTeX{} the marker replaces the run, and the result
read \enquote{[non-Latin text]Mac OS X[non-Latin text]}
(\url{https://github.com/dbosk/scholarcli/issues/262}).  A space
belongs there only when the marker is printed, so the escapers cannot
write one: they write a second macro, [[\scholarnonlatinsep]], which the
document defines as a space where the marker is printed and as nothing
where the text is (\cref{sec:non-latin-definition}).  It is written
only where a run touches a letter or a digit of the source, before the
run or after it; a space or a punctuation mark between them already
separates the two, and the text is then written as before, byte for
byte.  It is followed by an empty group, so that a letter after it is
not read as part of its name and a space after it is not eaten.

Runs are maximal (\cref{sec:non-latin-text}): two runs always have a
plain piece between them, so the neighbour of a run is the last or
first character of a plain piece, never of another run.  A letter
there is one [[str.isalnum]] accepts, which includes the accented Latin
letters and a Greek letter set in math mode.

