# decomposition: "CO\u2082" becomes CO\\textsubscript{2}.
SCRIPT_BASES = "0123456789+-=()abcdefghijklmnopqrstuvwxyz"


def _script_base(char: str) -> str:
    """Return what a script `char` decomposes to; minus as a hyphen."""
    return unicodedata.normalize("NFKC", char).replace("\u2212", "-")


LATEX_SCRIPT_CHARS: dict[str, str] = {
    chr(code): (
        "\\textsuperscript{"
        if "SUPERSCRIPT" in unicodedata.name(chr(code), "")
        else "\\textsubscript{"
    ) + _script_base(chr(code)) + "}"
    for code in range(0x2070, 0x209D)
    if unicodedata.name(chr(code), "")
    and len(_script_base(chr(code))) == 1
    and _script_base(chr(code)) in SCRIPT_BASES
}

LATEX_SPECIALS: dict[str, str] = {
    "\\": r"\textbackslash{}",
    '"': r"\textquotedbl{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "{": r"\{",
    "}": r"\}",
    "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
}

BIBTEX_SPECIALS: dict[str, str] = {
    '"': r"\textquotedbl{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "\\": r"\textbackslash{}",
    "^": r"\textasciicircum{}",
}


def _escape_char(char: str, specials: dict[str, str]) -> str:
    """Escape one character pdfLaTeX can set, using the `specials` map."""
    if char in specials:
        return specials[char]
    if char in LATEX_UNICODE_PUNCTUATION:
        return LATEX_UNICODE_PUNCTUATION[char]
    if char in GREEK_LETTER_NAMES:
        return f"\\ensuremath{{\\{GREEK_LETTER_NAMES[char]}}}"
    if char in GREEK_LATIN_LOOKALIKES:
        return GREEK_LATIN_LOOKALIKES[char]
    if char in LATEX_MATH_SYMBOLS:
        macro = LATEX_MATH_SYMBOLS[char]
        return f"\\ensuremath{{{macro}}}" if macro.startswith("\\") else macro
    if char in LATEX_SCRIPT_CHARS:
        return LATEX_SCRIPT_CHARS[char]
    return char


def _escape_chars(text: str, specials: dict[str, str]) -> str:
    """Escape `text` for TeX in one pass using the `specials` map."""
    out: list[str] = []
    pieces = split_nonlatin(text)
    for index, (kind, piece, beyond) in enumerate(pieces):
        if kind == NONLATIN_TEXT:
            inner = "".join(
                (char if far else _escape_char(char, specials))
                for char, far in zip(piece, beyond)
                if unicodedata.category(char) != "Cc"
            )
            <<separate the run from a letter it touches>>
        else:
            out.extend(
                _escape_char(char, specials)
                for char, far in zip(piece, beyond) if not far
            )
    return "".join(out)


def escape_bibtex(text: str) -> str:
    """Escape special BibTeX characters and normalise Unicode punctuation.

    A value written in LaTeX the decoder knows is decoded first
    (`latex_text_pieces`); any other backslash becomes `\\textbackslash{}`.
    """
    pieces = latex_text_pieces(text)
    if pieces is None:
        return _escape_chars(text, BIBTEX_SPECIALS)
    return "".join(
        BIBTEX_TEXT_BRACES[piece.char] if isinstance(piece, LatexBrace)
        else _escape_chars(piece, BIBTEX_SPECIALS)
        for piece in pieces
    )


def escape_latex(text: str) -> str:
    """Escape special LaTeX characters and normalise Unicode punctuation."""
    return _escape_chars(text, LATEX_SPECIALS)
