class SessionNotSaved(Exception):
    """A session could not be saved: its file's lock was not taken.

    `path` is the session file, left as it was; `unsaved` the file that
    holds this process's session instead (None if there is none);
    `reason` why the lock was not taken; `cause` one of
    `SAVE_REFUSALS`; `keep_error` why no file could be kept, if one was
    tried and failed.
    """

    def __init__(
        self, path: Path, unsaved: Path | None, reason: str, *,
        cause: str = "held", keep_error: str | None = None,
    ) -> None:
        self.path = Path(path)
        self.unsaved = unsaved
        self.reason = reason
        self.cause = cause
        self.interrupted = cause == "interrupted"
        when = SAVE_RETRY_WHEN[cause]
        message = (
            f"Session file {path} "
            + SAVE_REFUSALS[cause].format(reason=reason)
            + ", so nothing was written to it."
        )
        if unsaved is not None:
            message += (
                f" This process's session is kept in {unsaved} (scholar "
                "sessions recover --discard deletes it); "
                f"{when}, merge it in with: scholar sessions recover "
                f"{shlex.quote(str(unsaved))}"
            )
        elif keep_error is not None:
            message += (
                " Keeping this process's session beside it failed too "
                f"({keep_error}), so its changes are lost."
            )
        else:
            message += f" Nothing was changed; run the command again {when}."
        super().__init__(message)
