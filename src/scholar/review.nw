class TestInterruptedKeep:
  """An interrupted keep leaves no empty kept file (#316)."""

  def test_no_file_before_the_text_is_ready(self, tmp_path, monkeypatch):
    import scholar.review as review
    path = TestSaveWhenTheLockIsHeld._make(tmp_path, monkeypatch)
    monkeypatch.setattr(review, "session_file_data",
                        Mock(side_effect=KeyboardInterrupt))
