def provider_failure(record: SearchRecord, name: str) -> str | None:
    """Why provider `name` answered nothing in `record`, or None.

    A merged record's error is split at its provider prefixes; a
    provider it names failed outright only if the record has no papers.
    """
    if not record.is_merged:
        return record.error if failed_outright(record) else None
    if record.hits or name not in merged_record_failures(record):
        return None
    for segment in (record.error or "").split("; "):
        prefix, _, reason = segment.partition(":")
        if prefix.strip() == name:
            return reason.strip()
    return record.error


def searched_providers(session: ReviewSession) -> list[str]:
    """The providers that answered at least one search, in order."""
    if not session.search_records:
        return list(session.providers)
    in_papers = decision_provider_names(session)
    names: list[str] = []
    for record in session.search_records:
        for name in record.merged_providers:
            if name in names or provider_failure(record, name) is not None:
                continue
            if outcome_unknown(record) and name.lower() not in in_papers:
                continue
            names.append(name)
    return names


def unsearched_providers(session: ReviewSession) -> list[tuple[str, str]]:
    """`(provider, reason)` for each provider that answered no search.

    Providers with a search whose outcome is unknown are left to
    `unrecorded_providers`.
    """
    answered = set(searched_providers(session))
    unrecorded = set(unrecorded_providers(session))
    reasons: dict[str, str] = {}
    for record in session.search_records:
        for name in record.merged_providers:
            if name in answered or name in unrecorded or name in reasons:
                continue
            reasons[name] = provider_failure(record, name) or ""
    return list(reasons.items())


def searched_providers_text(session: ReviewSession) -> str:
    """The providers searched, each failure in a merged record noted.

    A provider that a merged record with papers names as failed
    answered in part or not at all, which the record cannot tell;
    it is noted as the audit caption notes it.
    """
    noted = {
        name for record in session.search_records
        if record.hits for name in merged_record_failures(record)
    }
    return ", ".join(
        f"{name} (failed or incomplete in a merged record)"
        if name in noted else name
        for name in searched_providers(session)
    )


def unsearched_text(session: ReviewSession) -> str:
    """The providers that answered no search, each with its reason."""
    return ", ".join(
        f"{name} ({reason})" if reason else name
        for name, reason in unsearched_providers(session)
    )


def searched_queries(session: ReviewSession) -> list[str]:
    """The distinct queries of the session's search records, in order."""
    if not session.search_records:
        return [session.query]
    return list(dict.fromkeys(r.query for r in session.search_records))


def search_period(session: ReviewSession) -> str:
    """When the databases answered, "A to B", with unknown dates counted.

    "" when no record knows its date.
    """
    dates = [
        search_source_date(r)
        for r in answered_records(session.search_records)
    ]
    known = sorted(d for d in dates if d)
    if not known:
        return ""
    if known[0] == known[-1]:
        period = known[0]
    else:
        period = f"{known[0]} to {known[-1]}"
    unknown = len(dates) - len(known)
    if unknown:
        period += f" (date unknown for {unknown} of {len(dates)} searches)"
    return period


def search_parameter_items(session: ReviewSession) -> list[tuple[str, str]]:
    """The `(label, value)` items describing all of the session's searches."""
    queries = searched_queries(session)
    if len(queries) == 1:
        items = [("Query", queries[0])]
    else:
        items = [("Queries", f"{len(queries)}, see the table of searches")]
    items.append(
        ("Providers", searched_providers_text(session) or "none")
    )
    not_searched = unsearched_text(session)
    if not_searched:
        items.append(("Not searched", not_searched))
    unrecorded = unrecorded_text(session)
    if unrecorded:
        items.append(("Outcome not recorded", unrecorded))
    period = search_period(session)
    if period:
        items.append(("Searched", period))
    return items
