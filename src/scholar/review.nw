class TestAuditSemanticSearch:
  """Semantic searches are explained in the caption, not named."""

  def _session(self):
    session = _audit_session()
    session.decisions.append(ReviewDecision(
      paper=Paper(title="Found by meaning", authors=["E"], year=2022),
      provider="openalex-semantic", status=DecisionStatus.PENDING,
    ))
    session.search_records = [
      SearchRecord("q", "openalex", hits=3),
      SearchRecord("q", "dblp", hits=2),
      SearchRecord("a question", "openalex-semantic", limit=50, hits=50),
      SearchRecord("another", "openalex-semantic", limit=50, hits=0,
                   error="HTTP 400"),
    ]
    return session

  def test_databases_sentence_omits_the_semantic_search(self):
    for lang, databases, semantic in (
      ("en", "Databases searched: OpenAlex (OA; not open access), DBLP.",
       "Records marked OA-sem were returned by a semantic search of "
       "OpenAlex (the 50 works closest in meaning to each question)"),
      ("sv", "Sökta databaser: OpenAlex (OA; inte open access), DBLP.",
       "Poster märkta OA-sem kom från en semantisk sökning i OpenAlex "
