    assert reconcile_session("copies") == []
    session = load_session("copies")
    [conflict] = conflicting_copies(session)
    assert copy_conflict_line(conflict) == (
      f"A Work: {bare.id} discarded (dblp) [no-abstract], "
      "doi:10.1145/race kept (openalex) [ml]"
    )
    assert alike_copies(session) == []

