    session = _cited_session()
    entries = match_cited_entries(_cited_entries(), session)
    excluded, not_held = cited_text_disagreements(
      session, entries, theme_names={}, strings=AUDIT_STRINGS["en"],
    )
    assert [e.key for e in excluded] == ["dahl2019"]
    assert [e.key for e in not_held] == ["fors2010", "gran2020"]
@

The citation changes how a row reads, never which copy gives it.  A
work cited by the text whose copies are a pending record and an agent's
off-topic discard must still be represented by the discard, so the row
reads as excluded and the export warns; ranked on the cited order, the
pending copy (order~0) won and the disagreement went unseen.  A
confirmed keep's row lends its notes as without the option, and the
lent notes keep the citation: the row's reason is computed again with
the same [[cited]].  An uncited keep is counted under its own phrase,
not as a duplicate when a copy of it is noted as one, and the caption
states the rule even when the text cites none of the works.  An entry
that matches a kept row by DOI and a discarded copy by title is a
disagreement, since one of its rows is excluded.

<<test functions>>=
class TestAuditRowsCitedFromText:
  """Copies, notes and counts when the text decides (#218)."""

  def _session(self, *decisions):
    session = ReviewSession(
      query="q", providers=["openalex"], timestamp=datetime.now(),
    )
    session.decisions = list(decisions)
    return session

  def _copy(self, status, tags, source=ReviewSource.HUMAN, conf=None,
            doi=None, title="Recovery by Email"):
    return ReviewDecision(
      paper=Paper(title=title, authors=["Ada Lovelace"], year=2024,
                  doi=doi),
      provider="openalex", status=status, tags=tags, source=source,
      llm_confidence=conf,
    )

  def _keep_and_duplicate(self):
    return self._session(
      self._copy(DecisionStatus.KEPT, ["ml"], doi="10.1/keep"),
      self._copy(DecisionStatus.DISCARDED,
                 ["duplicate-record-of-cited-source"]),
    )

  def test_a_pending_copy_does_not_hide_a_discard(self):
    pending = self._copy(DecisionStatus.PENDING, [])
    discard = self._copy(DecisionStatus.DISCARDED, ["off-topic-false-hit"],
                         source=ReviewSource.AGENT_UNREVIEWED, conf=0.9,
                         doi="10.1/r")
    work = audit_work_key(pending.paper)
    for decisions in ((pending, discard), (discard, pending)):
      session = self._session(*decisions)
      rows = collect_audit_rows(
        session, theme_names={}, strings=AUDIT_STRINGS["en"],
        cited_works={work},
      )
      assert (rows[0].status, rows[0].reason) == (
        DecisionStatus.DISCARDED,
        "other topic (false hit) (0.90) (cited in the text)",
