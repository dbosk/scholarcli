  def test_the_new_session_race_keeps_our_values(
      self, tmp_path, monkeypatch):
    import subprocess
    import sys
    import textwrap
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    build = textwrap.dedent(f"""
      import sys
      from dataclasses import replace
      from scholar.scholar import Paper, SearchResult
      from scholar.review import create_review_session, save_session
      result = SearchResult(
        query="foo", provider="openalex", timestamp="t",
        papers=[Paper(title="P", authors=["A"], doi={self.DOI!r},
                      venue="V")],
      )
      session = create_review_session([result], "foo", "fresh")
      [new] = session.decisions
    """)
    first = subprocess.Popen(
      [sys.executable, "-c", build + textwrap.dedent("""
        print("built", flush=True)
        sys.stdin.readline()
        save_session(session)
      """)],
      stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    try:
      assert first.stdout.readline().strip() == "built"
      subprocess.run([sys.executable, "-c", build + textwrap.dedent("""
        new.paper = replace(new.paper, venue="B venue", abstract="from B",
                            updated_by=[])
        save_session(session)
      """)], check=True, timeout=120)
      first.communicate("go\n", timeout=120)
    finally:
      if first.poll() is None:
        first.kill()
    assert first.returncode == 0
    paper = self._saved_paper(
      tmp_path / "review_sessions" / "fresh.json", self.DOI)
    assert paper["venue"] == "V"
    assert (paper["abstract"], paper["updated_by"]) == ("from B", [])
