from collections.abc import Sequence
<<review report generation>>=
def audit_category(tags: list[str]) -> str | None:
    """Return the deciding (last) audit category among `tags`, if any."""
    return next((t for t in reversed(tags) if t in AUDIT_CATEGORIES), None)


def audit_excluded(decision: ReviewDecision) -> bool:
    """Tell whether a bearing category was overruled by a discard."""
    category = audit_category(decision.tags)
    return (
        decision.status == DecisionStatus.DISCARDED
        and category is not None
        and AUDIT_CATEGORIES[category] <= AUDIT_ORDER_BEARING
    )


def audit_note_tags(
    decision: ReviewDecision,
    *,
    theme_names: dict[str, str],
    notes: dict[str, str],
) -> list[str]:
    """Return the tags `decision`'s own row shows as notes, known first.

    Those are its note tags and, when the caller named its themes, every
    other tag that is neither a category nor a theme.  A discard under
    an exclusion criterion shows none: its reason is the criterion alone.
    """
    tags = decision.tags
    if audit_exclusion_criterion(
        decision, theme_names=theme_names, notes=notes
    ) is not None:
        return []
    noted = [t for t in tags if t in notes]
    if theme_names:
        noted += [
            t for t in tags
            if t not in AUDIT_CATEGORIES and t not in notes
            and t not in theme_names
        ]
    return noted


def audit_note_text(tag: str, notes: dict[str, str]) -> str:
    """Return how the audit table writes the note `tag`."""
    return notes[tag] if tag in notes else escape_latex(tag)


def audit_with_notes(label: str, texts: list[str]) -> str:
    """Append the note `texts` to `label` in parentheses, if any."""
    return f"{label} ({'; '.join(texts)})" if texts else label


def audit_reason(
    decision: ReviewDecision,
    *,
    theme_names: dict[str, str],
    strings: dict,
    also_notes: Sequence[str] = (),
) -> tuple[str, int]:
    """Return the reason label and sort order for `decision`.

    `also_notes` are note tags of the work's other copies; they are
    added to the label's notes, after the decision's own, each once.
    """
    tags = list(decision.tags)
    notes = strings["notes"]
    category = audit_category(tags)
    own_notes = audit_note_tags(
        decision, theme_names=theme_names, notes=notes
    )
    note_texts = [audit_note_text(t, notes) for t in own_notes]
    <<add the notes of the work's other copies>>
    if theme_names:
        theme_tags = [t for t in tags if t in theme_names]
    else:
        theme_tags = [
            t for t in tags if t not in AUDIT_CATEGORIES and t not in notes
        ]
    human_decision = not decision.source.is_unreviewed
    kept = decision.status == DecisionStatus.KEPT
    machine_label = decision.source.is_unreviewed or (
        decision.source.is_machine and not decision.is_example
    )
    confidence = ""
    if machine_label and decision.llm_confidence is not None:
        confidence = f" ({decision.llm_confidence:.2f})"
    elif machine_label:
        confidence = f" ({strings['no_confidence']})"

    criterion = audit_exclusion_criterion(
        decision, theme_names=theme_names, notes=notes
    )

    if decision.status == DecisionStatus.PENDING:
        return audit_with_notes(strings["pending"], note_texts), \
            AUDIT_ORDER_PENDING
    if kept and human_decision and theme_tags:
        theme = theme_names.get(theme_tags[0], theme_tags[0])
        label = f"\\emph{{{strings['cited']}}}"
        if theme.casefold() != strings["cited"].casefold():
            label += ": " + escape_latex(theme)
        order = AUDIT_ORDER_CITED
    elif kept and human_decision and not tags:
        label, order = f"\\emph{{{strings['cited']}}}", AUDIT_ORDER_CITED
    elif audit_excluded(decision):
        label = f"{strings[category]}{confidence}, {strings['excluded']}"
        order = AUDIT_ORDER_OTHER
    elif category is not None:
        label = strings[category] + confidence
        order = AUDIT_CATEGORIES[category]
    elif criterion is not None:
        label = escape_latex(criterion) + confidence
        return audit_with_notes(label, note_texts), AUDIT_ORDER_OTHER
    elif own_notes:
        return "; ".join(note_texts), AUDIT_ORDER_OTHER
    elif not tags:
        return audit_with_notes(strings["pending"], note_texts), \
            AUDIT_ORDER_PENDING
    else:
        label = escape_latex(tags[0]) + confidence
        return audit_with_notes(label, note_texts), AUDIT_ORDER_OTHER
    return audit_with_notes(label, note_texts), order
