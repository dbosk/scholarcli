def test_unreadable_session_is_not_a_missing_one(tmp_path, monkeypatch):
    """A truncated session file stops an append instead of being replaced."""
    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    path = save_session(ReviewSession(
        query="q", providers=["openalex"], timestamp=datetime(2026, 9, 3),
        name="broken",
        decisions=[ReviewDecision(
            paper=Paper(title="Kept", authors=["A"], doi="10.5555/wp1-kept"),
            provider="openalex", status=DecisionStatus.KEPT,
        )],
    ))
    truncated = path.read_text()[:200]
    path.write_text(truncated)

    assert load_session("broken") is None
    with pytest.raises(SessionFileError, match="broken.json"):
        load_session("broken", strict=True)

    result = Mock()
    result.provider = "openalex"
    result.query = "q"
    result.filters = None
    result.limit = None
    result.papers = [Paper(title="New", authors=["B"], doi="10.5555/wp1-new")]
    with pytest.raises(SessionFileError):
        create_review_session([result], "q", "broken")
    assert path.read_text() == truncated
