from collections import Counter
<<review report generation>>=
def build_audit_table_latex(
    session: ReviewSession,
    *,
    label: str,
    lang: str = "en",
    track: str | None = None,
    theme_names: dict[str, str] | None = None,
    bearing_only: bool = False,
    truncate_titles: bool = False,
    cited_works: Collection[tuple[str, str]] | None = None,
) -> list[str]:
    """Build the audit longtable as LaTeX lines.

    With `cited_works` (`--cited-from`) the text decides what is cited,
    and the caption says so.
    """
    if lang not in AUDIT_STRINGS:
        raise ValueError(f"Unsupported language: {lang}")
    strings = AUDIT_STRINGS[lang]
    rows = collect_audit_rows(
        session, theme_names=theme_names or {}, strings=strings,
        title_limit=AUDIT_TITLE_LENGTH if truncate_titles else None,
        cited_works=cited_works,
    )
    counts = {
        order: sum(1 for r in rows if r.order == order) for order in range(7)
    }
    excluded = sum(1 for r in rows if r.excluded)
    other_rows = [
        r for r in rows if r.order == AUDIT_ORDER_OTHER and not r.excluded
    ]
    uncited = sum(1 for r in other_rows if r.uncited)
    other_rows = [r for r in other_rows if not r.uncited]
    criteria = Counter(r.criterion for r in other_rows if r.criterion)
    versions = sum(1 for r in other_rows if r.version and not r.criterion)
    rest = len(other_rows) - sum(criteria.values()) - versions
    current = current_records(session.search_records)
    retired = retired_records(session.search_records)
    from scholar.agreement import audit_screening_sentence
    databases = " ".join(filter(None, [
        strings["cited_rule"] if cited_works is not None else "",
        audit_screening_sentence(session.decisions, strings, rows),
        audit_databases_sentence(rows, strings, current, retired),
        audit_semantic_sentence(rows, strings, current, retired),
        audit_dates_sentence(strings, current),
        audit_retired_sentence(rows, strings, current, retired),
    ]))
    if bearing_only:
        template = strings["bearing"]
        rows = [r for r in rows if r.order <= AUDIT_ORDER_BEARING]
    else:
        template = strings["caption"]
    if not rows:
        logger.warning(
            "audit table for %s is empty%s",
            session.name or session.query,
            " (no row bears on the claim)" if bearing_only else "",
        )
    nonlatin_rows = sum(1 for r in rows if r.nonlatin_title)
    if nonlatin_rows:
        logger.warning(
            "audit table for %s: %d row(s) have a title without Latin "
            "letters, printed as %s under pdfLaTeX; the row shows the "
            "paper id too",
            session.name or session.query, nonlatin_rows,
            strings["nonlatin"],
        )
    def number(value: int) -> str:
        return audit_number(value, strings)

    extras = []
    if counts[AUDIT_ORDER_PENDING]:
        extras.append(strings["extra_pending"].format(
            pending=number(counts[AUDIT_ORDER_PENDING])
        ))
    if uncited:
        extras.append(
            strings["extra_uncited"].format(uncited=number(uncited))
        )
    if versions:
        extras.append(
            strings["extra_other"].format(other=number(versions))
        )
    for criterion, count in sorted(
        criteria.items(), key=lambda item: (-item[1], item[0])
    ):
        phrase = strings["criteria"].get(criterion, strings["extra_criterion"])
        extras.append(phrase.format(
            count=number(count), criterion=escape_latex(criterion)
        ))
    if rest:
        extras.append(strings["extra_rest"].format(rest=number(rest)))
    if excluded:
        extras.append(
            strings["extra_excluded"].format(excluded=number(excluded))
        )
    unlisted = [
        strings["unlisted_adjacent"].format(adjacent=number(counts[3])),
        strings["unlisted_offtopic"].format(offtopic=number(counts[4])),
        *extras,
    ] if extras else [strings["unlisted_pair"].format(
        adjacent=number(counts[3]), offtopic=number(counts[4]),
    )]
    caption = template.format(
        track=f", {escape_latex(track)}" if track else "",
        n=number(sum(counts.values())),
        cited=number(counts[0]),
        supports=number(counts[1]),
        qualifies=number(counts[2]),
        adjacent=number(counts[3]),
        offtopic=number(counts[4]),
        extra="".join(", " + item for item in extras),
        unlisted=audit_joined_list(unlisted, strings),
        confidence=audit_confidence_sentence(rows, strings),
        databases=databases,
    )
    header = (
        f"{strings['title']} & {strings['year']} & "
        f"{strings['provider']} & {strings['reason']} \\\\"
    )
    lines = [
        r"\begingroup\footnotesize",
        r"\begin{longtable}{@{}%",
        r"  >{\raggedright\arraybackslash}p{0.44\textwidth}c%",
        r"  >{\raggedright\arraybackslash}p{0.13\textwidth}%",
        r"  >{\raggedright\arraybackslash}p{0.26\textwidth}@{}}",
        f"\\caption{{{caption}}}\\label{{tab:{label}}}\\\\",
        r"\toprule",
        header,
        r"\midrule",
        r"\endfirsthead",
        "\\multicolumn{4}{@{}l}{\\emph{\\tablename~\\thetable{} "
        f"{strings['continued']}}}}}\\\\",
        r"\toprule",
        header,
        r"\midrule",
        r"\endhead",
        f"\\midrule \\multicolumn{{4}}{{r@{{}}}}"
        f"{{\\emph{{{strings['continued_next']}}}}}\\\\",
        r"\endfoot",
        r"\bottomrule",
        r"\endlastfoot",
    ]
    for row in rows:
        providers = ", ".join(row.providers)
        lines.append(
            f"{latex_row_cell(row.title)} & {row.year} & {providers} & "
            f"{row.reason} \\\\"
        )
    lines.extend([r"\end{longtable}", r"\endgroup"])
    return lines


AUDIT_TABLE_PACKAGES: list[str] = [
    r"\usepackage{longtable}",
    r"\usepackage{booktabs}",
    r"\usepackage{array}",
]


def generate_audit_table(
    session: ReviewSession,
    output_path: Path,
    *,
    label: str,
    lang: str = "en",
    track: str | None = None,
    theme_names: dict[str, str] | None = None,
    bearing_only: bool = False,
    truncate_titles: bool = False,
    cited_works: Collection[tuple[str, str]] | None = None,
) -> None:
    """Write the audit table for `session` as a LaTeX fragment."""
    body = build_audit_table_latex(
        session, label=label, lang=lang, track=track,
        theme_names=theme_names, bearing_only=bearing_only,
        truncate_titles=truncate_titles, cited_works=cited_works,
    )
    lines = latex_fragment(
        body,
        packages=AUDIT_TABLE_PACKAGES,
        generator="scholar sessions export -f table",
        comments=[f"Session: {session.name or session.query}"],
        nonlatin_marker=AUDIT_STRINGS[lang]["nonlatin"],
    )
    output_path.write_text("\n".join(lines) + "\n")
