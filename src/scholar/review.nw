class TestRerunOfRetiredSearch:
  """A re-run of a retired search makes it current again (#275)."""

  AT = "2026-11-20T10:00:00+00:00"

  @staticmethod
  def _result(query, when, papers=1, error=None):
    from scholar.scholar import SearchResult
    return SearchResult(
      query=query, provider="openalex", timestamp="t",
      papers=[Paper(title=f"{query} {i}", authors=["A"],
                    doi=f"10.1/rr-{query}-{i}") for i in range(papers)],
      limit=10, error=error, searched_at=when, fetched_at=when,
      from_cache=False,
    )

  def _retired_session(self, name):
    session = create_review_session(
      [self._result("q", "2026-11-01T00:00:00+00:00", papers=2)], "q",
      session_name=name,
    )
    retire_record(session.search_records[0], self.AT, "draft")
    save_session(session)

  def test_answered_rerun_makes_it_current(self, caplog):
    self._retired_session("rr-answer")
    session = create_review_session(
      [self._result("q", "2026-11-21T00:00:00+00:00")], "q",
      session_name="rr-answer",
    )
    save_session(session)
    [record] = load_session("rr-answer").search_records
    assert record.retired is None
    assert record.searched_at.startswith("2026-11-21")
    assert "running it again makes it current" in caplog.text
    assert "retired 2026-11-20: draft" in caplog.text

  def test_failed_rerun_keeps_the_mark(self, caplog):
    self._retired_session("rr-failed")
    session = create_review_session(
      [self._result("q", "2026-11-21T00:00:00+00:00", papers=0,
                    error="HTTP 500")], "q", session_name="rr-failed",
    )
    save_session(session)
    [record] = load_session("rr-failed").search_records
    assert (record.hits, record.retired["note"]) == (2, "draft")
    assert "which stays retired" in caplog.text

  def test_another_query_says_nothing(self, caplog):
    self._retired_session("rr-other")
    session = create_review_session(
      [self._result("r", "2026-11-21T00:00:00+00:00")], "r",
      session_name="rr-other",
    )
    save_session(session)
    records = {r.query: r for r in load_session("rr-other").search_records}
    assert records["q"].retired["note"] == "draft"
    assert records["r"].retired is None
    assert "retired" not in caplog.text
