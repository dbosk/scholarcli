if (their_new and not mine_new
        and their_new[-1].get("text") == theirs.paper.abstract):
    decision.paper.abstract = theirs.paper.abstract
elif (mine_new and paper_id in base_papers and theirs.paper.abstract
        and theirs.paper.abstract
