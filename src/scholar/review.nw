@staticmethod
def _numbered(n):
  return (Paper(title=f"Numbered {n}", authors=["Wei Wang 0001"],
                year=2021),
          Paper(title=f"Numbered {n}", authors=["Wei Wang"], year=2021))

def _append_three_renames(self, name, noted, monkeypatch, caplog):
  """Append the three renames with the lock held; return the time taken
  and the warnings about moves left."""
  import time
  import scholar.notes as notes
  from scholar import SearchResult
  from scholar.notes import save_note
  from scholar.scholar import isolated_registry

  monkeypatch.setattr(notes, "NOTES_LOCK_TIMEOUT", 1.0)
  pairs = [self._numbered(n) for n in range(3)]
  save_session(ReviewSession(
    query="q", providers=["dblp"], timestamp=datetime(2026, 11, 23),
    name=name, decisions=[ReviewDecision(paper=old, provider="dblp")
                          for old, _ in pairs],
  ))
  for old, _ in pairs[:noted]:
    save_note(old, f"About {old.title}.")
  caplog.clear()
  with self._notes_lock_held_elsewhere():
    with isolated_registry():
      started = time.monotonic()
      session = create_review_session([SearchResult(
        query="q", provider="dblp", timestamp="t",
        papers=[new for _, new in pairs])], "q", name)
      took = time.monotonic() - started
  assert session.renamed == {old.id: new.id for old, new in pairs}
  warnings = [r.getMessage() for r in caplog.records
              if "were not moved" in r.getMessage()]
  return took, warnings, pairs

def test_renames_with_nothing_to_move_do_not_wait(self, monkeypatch,
                                                  caplog):
  took, warnings, _ = self._append_three_renames(
    "three-none", 0, monkeypatch, caplog)
  assert took < 0.8 and warnings == []

def test_one_note_costs_one_wait(self, monkeypatch, caplog):
  took, warnings, pairs = self._append_three_renames(
    "three-one", 1, monkeypatch, caplog)
  assert 1.0 <= took < 1.8
  [warning] = warnings
  assert pairs[0][0].id in warning and pairs[1][0].id not in warning

def test_three_notes_cost_one_wait_and_one_warning(self, monkeypatch,
                                                   caplog):
  took, warnings, pairs = self._append_three_renames(
    "three-all", 3, monkeypatch, caplog)
  assert 1.0 <= took < 1.8
  [warning] = warnings
  assert "3 renamed paper(s)" in warning
  for old, new in pairs:
    assert f"{old.id} -> {new.id}" in warning
  assert "scholar sessions reconcile" in warning
