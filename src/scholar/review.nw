      == "The {DNA} of a {wolf} \\textbraceleft{}"

  def test_escaped_braces_mean_the_character(self):
    assert self._text("a \\{ b } c") \
      == "a \\textbraceleft{} b \\textbraceright{} c"
    assert self._text("a \\} b") == "a \\textbraceright{} b"
