def unreviewed_suffix_latex(decision: ReviewDecision) -> str:
    """LaTeX suffix marking an unreviewed machine decision, or ""."""
    mark = unreviewed_mark(decision)
    return f" \\emph{{({escape_latex(mark)})}}" if mark else ""


def paper_item_latex(
