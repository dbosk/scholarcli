class TestSearchRecordVia:
    """The endpoint that answered is kept in the session record."""

    def test_round_trip_and_old_files(self):
        import json
        from scholar.review import _get_sessions_dir

        session = ReviewSession(query="q", providers=["s2"],
                                timestamp=datetime.now(), name="via-new")
        session.add_query_provider_pair("q", "s2", None, 0, hits=3,
                                        via="bulk")
        save_session(session)
        assert load_session("via-new").search_records[0].via == "bulk"

        old = {
            "query": "q", "name": "via-old", "providers": ["s2"],
            "timestamp": datetime.now().isoformat(),
