class TestPartialRerun:
    """A partial re-run with more hits replaces an earlier answer."""

    @staticmethod
    def _result(papers, error=None, limit=100, when=None):
        from scholar.scholar import SearchResult
        return SearchResult(
            query="a AND b", provider="s2", timestamp="t", papers=papers,
            limit=limit, error=error, searched_at=when,
        )

    @staticmethod
    def _papers(n):
        return [Paper(title=f"P{i}", authors=["A"], doi=f"10.1/pr-{i}")
                for i in range(n)]

    def test_partial_with_more_hits_replaces_zero(self):
        save_session(create_review_session(
            [self._result([], when="2026-10-01T00:00:00+00:00")],
            "a AND b", session_name="partial",
        ))
        session = create_review_session(
            [self._result(self._papers(5), error="search cut short",
                          when="2026-11-18T00:00:00+00:00")],
            "a AND b", session_name="partial",
        )
        record = session.search_record_for("s2")
        assert (record.hits, record.error) == (5, "search cut short")
        assert len(session.decisions) == 5

    def test_newer_partial_with_fewer_hits_replaces_answer(self):
        save_session(create_review_session(
            [self._result(self._papers(12),
                          when="2026-10-01T00:00:00+00:00")], "a AND b",
            session_name="partial-less",
        ))
        session = create_review_session(
            [self._result(self._papers(3), error="search cut short",
                          when="2026-11-18T00:00:00+00:00")],
            "a AND b", session_name="partial-less",
        )
        record = session.search_record_for("s2")
        assert (record.hits, record.error, record.searched_at) == (
            3, "search cut short", "2026-11-18T00:00:00+00:00",
        )
        assert search_outcome_label(record) == (
            "3, incomplete (search cut short)"
        )
        assert len(session.decisions) == 12

    def test_undated_partial_with_fewer_hits_keeps_answer(self):
        save_session(create_review_session(
