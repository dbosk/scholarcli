class TestCsvReportAgentSource:
    def test_agent_rows_carry_their_review_outcome(self, tmp_path):
        import csv

        def d(title, status, source, is_example=False):
            return ReviewDecision(
                paper=Paper(title=title, authors=["A"], year=2024),
                provider="p", status=status, tags=["t"], source=source,
                is_example=is_example,
            )
        session = ReviewSession(
            query="q", providers=["p"], timestamp=datetime(2026, 11, 18),
        )
        session.decisions = [
            d("Unreviewed", DecisionStatus.KEPT,
              ReviewSource.AGENT_UNREVIEWED),
            d("Changed", DecisionStatus.KEPT,
              ReviewSource.AGENT_REVIEWED, is_example=True),
            d("Confirmed", DecisionStatus.KEPT, ReviewSource.AGENT_REVIEWED),
        ]
        path = tmp_path / "r.csv"
        generate_csv_report(session, path)
        rows = {
            r["title"]: (r["decision_source"], r["llm_review_outcome"],
                         r["llm_change_direction"])
            for r in csv.DictReader(path.open())
        }
        assert rows == {
            "Unreviewed": ("agent", "unreviewed", ""),
            "Changed": ("agent_reviewed", "changed", "discarded->kept"),
            "Confirmed": ("agent_reviewed", "confirmed", ""),
        }
