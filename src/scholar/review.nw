                hits=len(part.papers), error=error, retries=retries,
                total=total, total_estimated=estimated,
                searched_at=searched_at, fetched_at=fetched_at,
                from_cache=from_cache, via=result_via(part),
            )

    # Merge with previous session's searches (if any), preserving their filters
    replaced_links: dict[tuple, tuple] = {}
    if previous_session:
        current_run = list(session.search_records)
