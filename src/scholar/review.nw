class TestSaveRestoresGarbageCollection:
  """save_session puts the garbage collector back as it found it (#316)."""

  def test_after_a_save_a_refusal_and_a_failure(self, tmp_path, monkeypatch):
    import gc
    import scholar.review as review
    path = TestSaveWhenTheLockIsHeld._make(tmp_path, monkeypatch)
    assert gc.isenabled()
    save_session(load_session("held"))
    assert gc.isenabled()
    with monkeypatch.context() as patched:
      patched.setattr(review, "merge_concurrent_changes",
                      Mock(side_effect=RuntimeError("merge failed")))
      with pytest.raises(RuntimeError):
        save_session(load_session("held"))
    assert gc.isenabled()
    from scholar.utils import lock_path
    lock_path(path).unlink(missing_ok=True)
    path.parent.chmod(0o500)
    try:
      with pytest.raises(SessionNotSaved):
        save_session(load_session("held"))
    finally:
      path.parent.chmod(0o700)
    assert gc.isenabled()

  def test_a_collector_turned_off_stays_off(self, tmp_path, monkeypatch):
    import gc
    TestSaveWhenTheLockIsHeld._make(tmp_path, monkeypatch)
    gc.disable()
    try:
      save_session(load_session("held"))
      assert not gc.isenabled()
    finally:
      gc.enable()
