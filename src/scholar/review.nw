def audit_uncited_keep(decision: ReviewDecision, cited: bool | None) -> bool:
    """Tell whether `decision` is a keep the text does not cite.

    Only with `--cited-from` (`cited` is False), and only for a keep
    without an audit category, which keeps its category's place.
    """
    return (
        cited is False
        and decision.status == DecisionStatus.KEPT
        and audit_category(decision.tags) is None
    )
