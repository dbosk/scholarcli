class TestConcurrentSaves:
    """Saving a stale session object must not undo another process's work."""

    def _create(self):
        session = ReviewSession(
            query="q", providers=["openalex"], timestamp=datetime(2026, 9, 3),
            name="race",
        )
        session.add_query_provider_pair("q", "openalex")
        session.decisions = [
            ReviewDecision(
                paper=Paper(title=f"Paper {i}", authors=["A"],
                            doi=f"10.5555/wp1-race-{i}"),
                provider="openalex",
            )
            for i in range(3)
        ]
        save_session(session)

    def test_stale_save_keeps_decisions_and_context(
        self, tmp_path, monkeypatch
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        self._create()

        enrich = load_session("race")            # process A starts

        classify = load_session("race")          # process B, meanwhile
        classify.research_context = "Does X support Y?"
        classify.decisions[0].status = DecisionStatus.KEPT
        classify.decisions[0].tags = ["supports-claim"]
        classify.decisions[1].status = DecisionStatus.DISCARDED
        classify.decisions[1].tags = ["off-topic"]
        classify.decisions[1].source = ReviewSource.LLM_UNREVIEWED
        classify.decisions[1].llm_confidence = 0.9
        save_session(classify)

        for d in enrich.decisions:               # A finishes and saves
            d.paper.abstract = "Enriched."
        save_session(enrich)

        final = load_session("race")
        assert final.research_context == "Does X support Y?"
        by_title = {d.paper.title: d for d in final.decisions}
        assert by_title["Paper 0"].status == DecisionStatus.KEPT
        assert by_title["Paper 0"].tags == ["supports-claim"]
        assert by_title["Paper 1"].status == DecisionStatus.DISCARDED
        assert by_title["Paper 1"].source == ReviewSource.LLM_UNREVIEWED
        assert by_title["Paper 1"].llm_confidence == 0.9
        assert by_title["Paper 2"].status == DecisionStatus.PENDING
        assert all(d.paper.abstract == "Enriched." for d in final.decisions)

    def test_own_changes_win_and_new_papers_are_kept(
        self, tmp_path, monkeypatch, caplog
    ):
        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        self._create()

        ours = load_session("race")
        theirs = load_session("race")
        theirs.decisions[0].status = DecisionStatus.DISCARDED
        theirs.decisions[0].tags = ["wrong"]
        theirs.decisions.append(ReviewDecision(
            paper=Paper(title="Found later", authors=["B"],
                        doi="10.5555/wp1-race-new"),
            provider="dblp",
        ))
        theirs.add_query_provider_pair("q2", "dblp")
        save_session(theirs)

        ours.decisions[0].status = DecisionStatus.KEPT
        ours.decisions[0].tags = ["right"]
        with caplog.at_level("WARNING", logger="scholar.review"):
            save_session(ours)
        assert "decided by another process meanwhile" in caplog.text
        assert "doi:10.5555/wp1-race-0" in caplog.text

        final = load_session("race")
        by_title = {d.paper.title: d for d in final.decisions}
        assert by_title["Paper 0"].status == DecisionStatus.KEPT
        assert by_title["Paper 0"].tags == ["right"]
        assert "Found later" in by_title
        assert ("q2", "dblp") in final.query_provider_pairs
