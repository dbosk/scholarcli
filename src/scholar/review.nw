    session.decisions[0].status = DecisionStatus.KEPT
    session.decisions[0].tags = ["ml"]
    save_session(session)
    paper = session.decisions[0].paper
    assert paper.year == 2014
    assert paper.abstract is None and paper.venue is None

  def test_a_new_decision_keeps_its_own_work(self):
    from scholar.scholar import isolated_registry
    TestConcurrentSaveKeepsPaperData()._first_save()
    session = load_session("conc-194")
    held = Paper.from_dict({"title": "A Study",
                            "authors": ["Ada Lovelace"], "year": 2014})
    with isolated_registry():
      theirs = load_session("conc-194")
      theirs.decisions.append(ReviewDecision(
        paper=self._older(), provider="dblp",
        status=DecisionStatus.KEPT, tags=["ml"],
      ))
      save_session(theirs)
    save_session(session)
    [added] = [d for d in session.decisions if not d.paper.doi]
    assert added.paper.year == 1994
    assert added.paper.abstract == "the older work"
    assert held.abstract is None
