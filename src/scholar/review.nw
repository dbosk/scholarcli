class TestAgentDecisionSource:
    """The agent source and the questions reports ask of a source."""

    def test_stored_values(self):
        assert ReviewSource("agent") is ReviewSource.AGENT_UNREVIEWED
        assert ReviewSource("agent_reviewed") is ReviewSource.AGENT_REVIEWED
        assert ReviewSource("llm") is ReviewSource.LLM_UNREVIEWED

    def test_unreviewed_and_machine(self):
        unreviewed = {s for s in ReviewSource if s.is_unreviewed}
        assert unreviewed == {
            ReviewSource.LLM_UNREVIEWED, ReviewSource.AGENT_UNREVIEWED,
        }
        assert [s for s in ReviewSource if not s.is_machine] == [
            ReviewSource.HUMAN
        ]

    def test_review_keeps_the_machine_name(self):
        assert ReviewSource.AGENT_UNREVIEWED.reviewed \
            is ReviewSource.AGENT_REVIEWED
        assert ReviewSource.LLM_UNREVIEWED.reviewed \
            is ReviewSource.LLM_REVIEWED
        assert ReviewSource.HUMAN.reviewed is ReviewSource.HUMAN
        assert ReviewSource.AGENT_REVIEWED.reviewed \
            is ReviewSource.AGENT_REVIEWED

    def test_counts_only_decided_papers(self):
        def d(status, source):
            return ReviewDecision(
                paper=Paper(title="T", authors=["A"]), provider="p",
                status=status, source=source,
            )
        decisions = [
            d(DecisionStatus.KEPT, ReviewSource.HUMAN),
            d(DecisionStatus.PENDING, ReviewSource.HUMAN),
            d(DecisionStatus.DISCARDED, ReviewSource.AGENT_UNREVIEWED),
            d(DecisionStatus.DISCARDED, ReviewSource.AGENT_UNREVIEWED),
            d(DecisionStatus.KEPT, ReviewSource.LLM_REVIEWED),
        ]
        assert decision_source_items(decisions) == [
            ("human", 1),
            ("LLM, reviewed by a human", 1),
            ("agent, unreviewed", 2),
        ]
        assert decision_sources_sentence(decisions) == (
            "Decisions by source: 1 human; 1 LLM, reviewed by a human; "
            "2 agent, unreviewed."
        )
        assert unreviewed_mark(decisions[2]) == "agent, unreviewed"
        assert unreviewed_mark(decisions[4]) == ""

    def test_human_row_is_said_aloud(self):
        decisions = [ReviewDecision(
            paper=Paper(title="T", authors=["A"]), provider="p",
            status=DecisionStatus.KEPT, source=ReviewSource.LLM_UNREVIEWED,
        )]
        assert decision_source_items(decisions) == [
            ("human", 0), ("LLM, unreviewed", 1),
        ]
        assert decision_sources_sentence([]) == ""
