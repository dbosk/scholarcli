The records and the refusals the recordings do not show come next.
Several results under one DOI, the first without an abstract, and an
abstract with HTML in it, are built from the recorded record by
changing only what the case needs.
A 429 needs the real session, since the defect was in its [[Retry]]: a
loopback server answers every request with a 429 and counts them.
One lookup must send one request and start a cooldown; the next lookup,
made through [[enrich_paper]], must be refused by the limiter without a
request and appear in the outcome as a failure of [[europepmc]].

<<test functions>>=
def _recorded_record(**changes):
    """The recorded record with `changes` applied (None removes a key)."""
    record = dict(RECORDED_HIT["resultList"]["result"][0])
    for key, value in changes.items():
        if value is None:
            record.pop(key, None)
        else:
            record[key] = value
    return record


@pytest.fixture
def refusing_server(monkeypatch):
    """A loopback server answering every request with HTTP 429."""
    import http.server
    import threading

    import scholar.europepmc

    seen = []

    class Refuser(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            seen.append(self.path)
            self.send_response(429)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Refuser)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    monkeypatch.setattr(
        scholar.europepmc, "EUROPEPMC_SEARCH_URL",
        f"http://127.0.0.1:{server.server_port}/search",
    )
    yield seen
    server.shutdown()


class TestEuropePMCRecordsAndRefusals:
    """Several records, HTML abstracts and a 429 (#260 review)."""

    DOI = "10.7717/peerj.4375"

    def _replay(self, *records):
        answer = {"hitCount": len(records),
                  "resultList": {"result": list(records)}}
        return patch.object(
            _client._session, "get", return_value=_mock_response(200, answer)
        )

    def test_a_matching_record_without_abstract_is_passed_over(self):
        with self._replay(
            _recorded_record(abstractText=None, source="PPR"),
            _recorded_record(),
        ):
            assert fetch_abstract(self.DOI).startswith("Despite growing")

    def test_a_record_whose_abstract_has_no_text_is_passed_over(self):
        with self._replay(
            _recorded_record(abstractText="<p> </p>"),
            _recorded_record(),
        ):
            assert fetch_abstract(self.DOI).startswith("Despite growing")

    def test_an_abstract_without_text_is_none(self):
        with self._replay(_recorded_record(abstractText="<p></p>")):
            assert fetch_abstract(self.DOI) is None
            assert _client.get_paper_by_doi(self.DOI) is None
        assert abstract_text("<p> </p>") is None

    def test_html_in_an_abstract_is_read_as_text(self):
        html = "<h4>Background</h4>First.<br/>Second.<p><i>Third</i>.</p>"
        with self._replay(_recorded_record(abstractText=html)):
            assert fetch_abstract(self.DOI) == (
                "Background First. Second. Third."
            )
        assert _client._cache[("abstract", self.DOI)] == html

    def test_a_429_starts_a_cooldown_and_is_tallied(self, refusing_server):
        from scholar import Paper, ratelimit
        from scholar.enrich import LookupOutcome, enrich_paper

        assert fetch_abstract(self.DOI) is None
        assert last_lookup_error() == "rate limited (HTTP 429)"
        assert len(refusing_server) == 1
        assert not ratelimit.check_available("europepmc").ok

        outcome = LookupOutcome()
        paper = Paper(title="Other", authors=["A B"], doi="10.1/other")
        enrich_paper(
            paper, fields=["abstract"], providers=["europepmc"],
            outcome=outcome,
        )
        assert len(refusing_server) == 1
        assert outcome.asked == ["europepmc"]
        assert "europepmc" in outcome.failed
