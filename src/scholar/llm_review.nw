Repeated runs work through the selection; a paper the model screened
is skipped until [[rescreen]], and another model is not held back by
the first one's screens.

<<second screen test methods>>=
def test_runs_skip_what_the_model_screened(self, monkeypatch):
  session = self._session()
  machine, confirmed, kept, dropped, _ = session.decisions
  self._fake(monkeypatch)
  second_screen_with_llm(session, over="all", count=2, enrich_missing=False)
  second = second_screen_with_llm(session, over="all", count=2,
                                  enrich_missing=False)
  assert [d for d, _ in second.screened] == [kept, dropped]
  assert (second.already_screened, second.remaining) == (2, 0)
  with pytest.raises(ValueError, match="4 already screened by it"):
    second_screen_with_llm(session, over="all", count=2,
                           enrich_missing=False)
  again = second_screen_with_llm(session, over="all", count=1,
                                 rescreen=True, enrich_missing=False)
  assert [d for d, _ in again.screened] == [machine]
  assert [r["origin"] for r in machine.screenings] \
    == ["decision", "screen", "screen"]
  self._fake(monkeypatch, model_id="model-c")
  other = second_screen_with_llm(session, over="all", count=4,
                                 enrich_missing=False)
  assert [d for d, _ in other.screened] == [machine, confirmed, kept,
                                            dropped]
