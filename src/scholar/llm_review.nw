LLM_SOURCES = frozenset({"llm", "llm_reviewed"})


def first_made_by_llm(decision: ReviewDecision) -> bool:
    """Tell whether an LLM made the decision first, relabelled or not.

    A pending paper has no decision, so it never counts.
    """
    return decision.is_decided and (
        source_value(decision) in LLM_SOURCES
        or decision.llm_model is not None
        or any(
            record.get("from") in LLM_SOURCES
            for record in getattr(decision, "relabelled", None) or []
        )
    )


def llm_screening_sentence(session: ReviewSession) -> str | None:
    """Describe the LLM decisions of `session` and what they record."""
    from collections import Counter

    rows = [d for d in session.decisions if first_made_by_llm(d)]
    if not rows:
        return None
    recorded = [d for d in rows if d.llm_model]
    text = (
        f"{len(rows)} of the decisions "
        f"{'was' if len(rows) == 1 else 'were'} first made by an LLM"
    )
    if recorded:
        models = Counter(d.llm_model for d in recorded)
        versions = {d.llm_prompt_version for d in recorded} - {None}
        dates = sorted(d.llm_decided_at[:10] for d in recorded
                       if d.llm_decided_at)
        text += " (model " + ", ".join(
            f"{model}: {count}" for model, count in sorted(models.items())
        )
        if versions:
            text += (
                f"; {len(versions)} prompt version"
                f"{'s' if len(versions) != 1 else ''}: "
                + ", ".join(sorted(versions))
            )
        if dates:
            text += (
                f"; on {dates[0]}" if dates[0] == dates[-1]
                else f"; between {dates[0]} and {dates[-1]}"
            )
        text += ")"
        truncated = sum(1 for d in recorded if d.llm_abstract_truncated)
        if truncated:
            text += (
                f"; for {truncated} of them the model saw a truncated "
                "abstract"
            )
    missing = len(rows) - len(recorded)
    if missing:
        text += (
            f"; for {missing} of them the model, date and prompt were not "
            "recorded"
        )
    return text + "."


def build_llm_screening_latex(
    session: ReviewSession,
    *,
    heading_command: str = r"\section",
    load: Callable[[str], ReviewSession | None] | None = None,
) -> list[str]:
    """Build the report's paragraphs on the LLM screening and its samples."""
    from scholar.review import escape_latex

    sentences = []
    screening = llm_screening_sentence(session)
    if screening:
        sentences.append(screening)
    if session.llm_samples:
        pooled = pooled_sample_sessions([session], load=load)
        own_ids = {sample.sample_id for sample in session.llm_samples}
        sentences.extend(
            sample_report_sentence(report)
            for report in group_sample_reports(sample_reports(pooled))
            if own_ids & report_sample_ids(report)
        )
    if not sentences:
        return []
    lines = [f"{heading_command}{{LLM screening}}", ""]
    for sentence in sentences:
        lines.extend([escape_latex(sentence), ""])
    return lines
