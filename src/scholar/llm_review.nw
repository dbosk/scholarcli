    kept, discarded = get_example_decisions(self._issue_session())
    assert [d.paper.title for d in kept] == ["Paper supporting"]
    assert [d.paper.title for d in discarded] == ["Paper offtopic"]

def test_nor_in_the_prompt(self):
    prompt = classify_papers_with_llm(
        self._issue_session(), enrich_missing=False, dry_run=True,
