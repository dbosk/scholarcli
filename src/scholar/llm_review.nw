def test_the_same_model_is_recorded_and_named(self, monkeypatch):
  from scholar.review import (
    counted_screenings, new_screening, record_screening,
    screener_identity,
  )

  session = self._session()
  machine = session.decisions[0]
  record_screening(machine, new_screening(
    kind="agent", name="agent-2", status="discarded",
    tags=["off-topic-false-hit"], recorded_at=self.AT,
  ))
  self._fake(monkeypatch, model_id="model-a")
  assert second_screen_candidates(session, over="machine").decisions \
    == [machine]
  result = second_screen_with_llm(session, over="machine",
                                  enrich_missing=False)
  assert result.same_model == [machine]
  counted = counted_screenings(machine)
  assert [r["origin"] for r in counted] == ["decision", "screen", "screen"]
  assert {screener_identity(r) for r in counted} == {
    ("llm", "model-a", False), ("agent", "agent-2", False),
    ("llm", "model-a", True),
  }
  with pytest.raises(ValueError, match="1 already screened"):
    second_screen_with_llm(session, over="machine", enrich_missing=False)
