def _sessions(self):
    def session(name, rows):
        s = ReviewSession(
            query=name, providers=["p"], timestamp=datetime(2026, 11, 18),
            name=name,
        )
        for i, (status, source, confidence) in enumerate(rows):
            s.decisions.append(ReviewDecision(
                paper=Paper(title=f"{name} {i}", authors=["A"],
                            doi=f"10.5555/draw-{name}-{i}"),
                provider="p", status=status, tags=["t"], source=source,
                llm_confidence=confidence,
            ))
        return s

    llm, human = ReviewSource.LLM_UNREVIEWED, ReviewSource.HUMAN
    out, kept = DecisionStatus.DISCARDED, DecisionStatus.KEPT
    return [
        session("draw-a", [(out, llm, 0.9)] * 6 + [(out, human, None)]
                + [(kept, llm, 0.9), (out, llm, 0.2), (out, llm, None)]),
        session("draw-b", [(out, llm, 0.95)] * 6
                + [(out, ReviewSource.LLM_REVIEWED, 0.9)]),
    ]

def test_reproducible_and_eligible_only(self):
    first = draw_llm_sample(
        self._sessions(), statuses={"discarded"}, min_confidence=0.8,
        size=5, seed=42,
    )
    again = draw_llm_sample(
        list(reversed(self._sessions())), statuses={"discarded"},
        min_confidence=0.8, size=5, seed=42,
    )
    titles = [d.paper.title for _, d in first.drawn]
    assert titles == [d.paper.title for _, d in again.drawn]
    assert first.population == 12 and len(titles) == 5
    other = draw_llm_sample(
        self._sessions(), statuses={"discarded"}, min_confidence=0.8,
        size=5, seed=43,
    )
    assert [d.paper.title for _, d in other.drawn] != titles
    for _, decision in first.drawn:
        assert decision.source == ReviewSource.LLM_UNREVIEWED
        assert decision.status == DecisionStatus.DISCARDED
        assert decision.llm_confidence >= 0.8

def test_each_session_records_its_share(self):
    from datetime import timezone

    sessions = self._sessions()
    draw = draw_llm_sample(
        sessions, statuses={"discarded", "kept"}, size=20, seed=1,
        now=datetime(2026, 11, 18, 12, 0, tzinfo=timezone.utc),
    )
    assert draw.population == len(draw.drawn) == 15
    a, b = (s.llm_samples[0] for s in sessions)
    assert a.sample_id == b.sample_id == draw.sample_id
