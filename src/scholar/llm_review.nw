class TestSynthesisBibPreamble:
    """The synthesis .bib defines \\scholarnonlatin when it uses it."""

    @staticmethod
    def _bib(*titles):
        from scholar.llm_review import (
            _build_bibtex_content, _generate_all_citation_keys,
        )
        decisions = [
            ReviewDecision(
                paper=Paper(title=title, authors=["A B"], year=2020 + i),
                provider="p", status=DecisionStatus.KEPT,
            )
            for i, title in enumerate(titles)
        ]
        keys = _generate_all_citation_keys(decisions, "latex")
        return _build_bibtex_content(decisions, keys)

    def test_a_plain_bib_has_no_preamble(self):
        assert self._bib("One", "Two").startswith("@article{")

    def test_text_in_another_script_gets_one_preamble(self):
        from scholar.review import nonlatin_definition
        bib = self._bib("\u0422\u0435\u0441\u0442", "Latin",
                        "\u6df1\u5ea6")
        first, rest = bib.split("\n\n", 1)
        assert first == (
            '@preamble{ "' + " ".join(nonlatin_definition()) + '" }'
        )
        assert "@preamble" not in rest


class TestAssembleLatexSynthesis:
    def test_standalone_order(self):
        text = _assemble(_latex_session(), bib_name="foo.bib")
        landmarks = [
            r"\begin{filecontents*}[overwrite]{foo.bib}",
            "@article{smith2024b,",
            r"\documentclass{article}",
            r"\addbibresource{foo.bib}",
            r"\title{A \& B}",
            r"\section{Research Question}",
            r"\section{Synthesis}",
            r"\textcite{smith2024}",
            r"\section{Conclusion}",
            r"\printbibliography",
            r"\appendix",
            r"\begin{refsection}",
            r"\section{Kept Papers}",
            r"\fullcite{smith2024a}",
            r"\section{Discarded Papers}",
            r"\fullcite{smith2024b}",
            r"\end{refsection}",
            r"\end{document}",
        ]
        positions = [text.index(mark) for mark in landmarks]
        assert positions == sorted(positions)
        assert "synthesis.bib" not in text

    def test_fragment(self):
        text = _assemble(
            _latex_session(), standalone=False, bib_name="foo.bib"
        )
        for absent in (
            r"\documentclass", "filecontents", r"\appendix",
            r"\begin{abstract}",
        ):
            assert absent not in text
        lines = text.splitlines()
        for command in (r"\addbibresource", r"\printbibliography"):
            assert not any(l.startswith(command) for l in lines)
        assert "%   \\addbibresource{foo.bib}" in lines
        assert "%   An abstract." in lines
        assert text.index(r"\section{Conclusion}") \
            < text.index(r"\begin{refsection}") \
            < text.index(r"\section{Kept Papers}") \
            < text.index(r"\end{refsection}")
