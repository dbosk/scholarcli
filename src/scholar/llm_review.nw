@dataclass
class StratifiedReport:
    """The bands of one stratified sample, reported together.

    `bands` holds the report of each band, in band order; `criteria`
    holds what the bands share (statuses, sources, cut points).
    """
    group: str
    seed: int | None
    drawn_at: str
    criteria: dict
    sessions: list[str]
    expected_bands: int
    bands: list[SampleReport] = field(default_factory=list)

    @property
    def population(self) -> int:
        """Return the size of the whole population, over all bands."""
        return sum(band.population for band in self.bands)

    @property
    def size(self) -> int:
        """Return the number of decisions drawn, over all bands."""
        return sum(band.size for band in self.bands)

    @property
    def reviewed(self) -> int:
        """Return the number of reviewed decisions, over all bands."""
        return sum(band.reviewed for band in self.bands)

    @property
    def changed(self) -> int:
        """Return the number of changed decisions, over all bands."""
        return sum(band.changed for band in self.bands)

    @property
    def not_found(self) -> int:
        """Return the number of drawn decisions not found."""
        return sum(band.not_found for band in self.bands)

    @property
    def reset_since_draw(self) -> int:
        """Return the number of drawn decisions reset since the draw."""
        return sum(band.reset_since_draw for band in self.bands)

    @property
    def unreviewed(self) -> list[tuple[str, str]]:
        """Return the drawn decisions not yet reviewed, band by band."""
        return [u for band in self.bands for u in band.unreviewed]

    def withheld_reason(self) -> str | None:
        """Say why no estimate is given, or return None when it is."""
        <<say why the estimate is withheld>>
        return None

    def estimate(self) -> StratifiedEstimate | None:
        """Return the estimate for the population, once fully reviewed."""
        if self.withheld_reason() is not None:
            return None
        return stratified_estimate([
            (band.population, band.reviewed, band.changed)
            for band in self.bands
        ])


def band_label(report: SampleReport) -> str:
    """Name the confidence band a band report covers."""
    criteria = report.criteria
    return confidence_criteria_text(
        criteria.get("min_confidence"), criteria.get("max_confidence"),
        bool(criteria.get("no_confidence")),
    )


def group_sample_reports(
    reports: list[SampleReport],
) -> list["SampleReport | StratifiedReport"]:
    """Join the band reports of each stratified sample into one report."""
    items: list[SampleReport | StratifiedReport] = []
    groups: dict[str, StratifiedReport] = {}
    for report in reports:
        stratum = report.criteria.get("stratum")
        if not isinstance(stratum, dict) or "group" not in stratum:
            items.append(report)
            continue
        group = groups.get(stratum["group"])
        if group is None:
            group = groups[stratum["group"]] = StratifiedReport(
                group=stratum["group"], seed=report.seed,
                drawn_at=report.drawn_at,
                criteria={
                    "statuses": report.criteria.get("statuses"),
                    "population_sources":
                        report.criteria.get("population_sources"),
                    "cuts": stratum.get("cuts"),
                },
                sessions=list(report.sessions),
                expected_bands=stratum.get("bands", 0),
            )
            items.append(group)
        group.bands.append(report)
    for group in groups.values():
        group.bands.sort(key=lambda b: b.criteria["stratum"].get("band", 0))
    return items
