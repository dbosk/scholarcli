    assert isinstance(report, StratifiedReport)
    assert [band_label(b) for b in report.bands] == [
        "below 0.5", "0.5 to below 0.7", "at least 0.7"]
    assert [(b.population, b.size, b.census) for b in report.bands] == [
        (6, 3, False), (3, 3, True), (10, 3, False)]
    assert report.estimate() is None
    assert "none of it has been reviewed yet" \
        in sample_report_sentence(report)

