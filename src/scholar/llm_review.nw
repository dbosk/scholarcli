def _decision(self, name, status, tags, source=ReviewSource.HUMAN,
              is_example=False):
    return ReviewDecision(
        paper=Paper(title=f"Paper {name}", authors=["A"],
                    abstract=f"About {name}.",
                    doi=f"10.5555/contradicts-{name}"),
        provider="p", status=status, tags=list(tags), source=source,
        is_example=is_example,
    )

def _session(self, decisions):
    session = ReviewSession(
        query="q", providers=["p"], timestamp=datetime(2026, 11, 20),
        research_context="Does the claim hold?",
    )
    session.decisions = list(decisions)
    return session

def _issue_session(self):
    return self._session([
        self._decision("excluded", DecisionStatus.DISCARDED,
                       ["supports-claim"], is_example=True),
        self._decision("offtopic", DecisionStatus.DISCARDED,
                       ["off-topic-false-hit"]),
        self._decision("supporting", DecisionStatus.KEPT,
                       ["supports-claim"]),
        self._decision("falsehit", DecisionStatus.KEPT,
                       ["off-topic-false-hit"]),
        self._decision("new", DecisionStatus.PENDING, []),
    ])

