        "\n".join(f"{name}\t{pid}" for name, pid, _ in stratum.pool)
        .encode("utf-8")
    ).hexdigest()[:PROMPT_VERSION_DIGITS]
    for session in sessions:
        session.llm_samples.append(LLMSample(
            sample_id=(sample_id if stratum.band is None
                       else f"{sample_id}/band={index}"),
            seed=seed, drawn_at=drawn_at,
            criteria=dict(criteria), sessions=list(names),
            session_files=list(files),
            population=len(stratum.pool), population_digest=digest,
            size=len(stratum.drawn),
            papers=[
                {"paper_id": pid, "status": d.status.value,
                 "source": source_value(d), "confidence": d.llm_confidence}
                for name, pid, d in stratum.drawn
                if name == session_label(session)
