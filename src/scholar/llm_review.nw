status = raw_status.strip().lower() if isinstance(raw_status, str) else ""
if status not in ("kept", "discarded"):
    problems.append(f"invalid decision {raw_status!r}")
    status = ""
<<check the confidence of an answer>>=
confidence = _answer_confidence(item.get("confidence"))
if confidence is None:
    problems.append(f"invalid confidence {item.get('confidence')!r}")
<<llm review llm interaction>>=
def _answer_confidence(value) -> float | None:
    """Return `value` as a confidence in [0, 1], or `None` if it is not one."""
    if isinstance(value, bool):
        return None
    try:
        confidence = float(value)
    except (TypeError, ValueError):
        return None
    return confidence if 0.0 <= confidence <= 1.0 else None
