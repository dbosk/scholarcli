The decisions stay as they were, the human's record included, and each
answer is a screening after the snapshot of the decision's verdict,
its reason cut as a classified decision's; the papers outside the
batch and the pending paper get nothing.

<<second screen test methods>>=
def test_the_decisions_stay_and_the_answers_are_screenings(
  self, monkeypatch
):
  from scholar.review import decision_state, human_record_of

  session = self._session()
  machine, confirmed, kept, dropped, pending = session.decisions
  before = [(decision_state(d), human_record_of(d))
            for d in session.decisions]
  long_reason = "Not about recursion. " + "Details. " * 80
  self._fake(monkeypatch, answers={1: {
    "paper_index": 1, "decision": "discarded",
    "tags": ["off-topic-false-hit"], "confidence": 0.9,
    "reasoning": long_reason,
  }})
  result = second_screen_with_llm(session, over="all", count=2,
                                  enrich_missing=False)
  assert [(decision_state(d), human_record_of(d))
          for d in session.decisions] == before
  assert [d for d, _ in result.screened] == [machine, confirmed]
  snapshot, screening = machine.screenings
  assert (snapshot["origin"], snapshot["kind"], snapshot["name"]) \
    == ("decision", "llm", "model-a")
  assert result.batch.prompt_version
  assert {k: v for k, v in screening.items() if k != "id"} == {
    "origin": "screen", "kind": "llm", "name": "model-b",
    "confirmed_from": None, "confirmed_name": None, "status": "kept",
    "tags": ["adjacent-subtopic"], "confidence": 0.6,
    "reason": "Background only.", "at": result.batch.timestamp,
    "recorded_at": self.NOW,
    "prompt_version": result.batch.prompt_version,
    "abstract_truncated": False, "blind": True, "blind_basis": "prompt",
    "sample_id": None, "via": "classify",
  }
  human_snapshot, verdict = confirmed.screenings
  assert (human_snapshot["kind"], human_snapshot["name"]) \
    == ("human", "the author")
  assert (verdict["status"], verdict["tags"], verdict["reason"]) \
    == ("discarded", ["off-topic-false-hit"], truncate_reason(long_reason))
  assert len(verdict["reason"]) == MAX_REASON_CHARS
  assert kept.screenings == dropped.screenings == pending.screenings == []
  assert (result.same_model, result.snapshots, result.remaining) \
    == ([], 2, 2)
