def _drawn(self):
    from datetime import timezone

    session = ReviewSession(query="strat", providers=["p"],
                            timestamp=datetime(2026, 11, 20), name="strat")
    confidences = [0.1] * 6 + [0.6] * 3 + [0.9] * 10
    session.decisions = [
        ReviewDecision(
            paper=Paper(title=f"T{i}", authors=["A"],
                        doi=f"10.5555/strat-{i}"),
            provider="p", status=DecisionStatus.DISCARDED, tags=["t"],
            source=ReviewSource.LLM_UNREVIEWED, llm_confidence=confidence,
        )
        for i, confidence in enumerate(confidences)
    ]
    draw_llm_sample([session], statuses={"discarded"}, size=3, seed=4,
                    bands=[0.5, 0.7],
                    now=datetime(2026, 11, 20, 12, 0, tzinfo=timezone.utc))
    return session

def _review(self, session, changed, limit=None):
    """Review the drawn decisions, changing those of the given titles."""
    from scholar.notes import get_paper_id

    drawn = {p["paper_id"] for s in session.llm_samples for p in s.papers}
    reviewed = 0
    for decision in session.decisions:
        if get_paper_id(decision.paper) not in drawn:
            continue
        if limit is not None and reviewed == limit:
            break
        decision.source = ReviewSource.LLM_REVIEWED
        if decision.paper.title in changed:
            decision.status = DecisionStatus.KEPT
        reviewed += 1

