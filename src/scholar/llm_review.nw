def _assemble_latex_synthesis(
    session: ReviewSession,
    theme_sections: list[ThemeSectionResult],
    conclusion: str,
    bibtex_content: str,
    included_kept_papers: int,
    total_kept_papers: int,
    report_abstract: str,
    *,
    cite_key: Callable[[ReviewDecision], str],
    standalone: bool = True,
    bib_name: str = "synthesis.bib",
) -> str:
    """Assemble the LaTeX synthesis as a document or a fragment."""
    from scholar.review import (
        LATEX_PACKAGES,
        build_review_decisions_latex,
        latex_document,
        latex_fragment,
        refsection,
    )

    body: list[str] = [
        build_research_question_section_latex(
            session,
            included_kept_papers=included_kept_papers,
            total_kept_papers=total_kept_papers,
        ),
        "",
        r"\section{Synthesis}",
        "",
    ]
    for section in theme_sections:
        body.extend([section.section.strip(), ""])
    body.extend([r"\section{Conclusion}", "", conclusion.strip(), ""])

    appendix = refsection(build_review_decisions_latex(session, cite_key))

    if standalone:
        lines = [
            f"\\begin{{filecontents*}}[overwrite]{{{bib_name}}}",
            bibtex_content,
            r"\end{filecontents*}",
            "",
        ]
        lines.extend(
            latex_document(
                body,
                title=session.name or session.query,
                date=session.timestamp.strftime("%Y-%m-%d"),
                bib_resource=bib_name,
                abstract=report_abstract,
                bibliography=r"\printbibliography",
                appendix=appendix,
                bib_text=bibtex_content,
            )
        )
    else:
        lines = latex_fragment(
            body + appendix,
            packages=LATEX_PACKAGES,
            bib_resource=bib_name,
            abstract=report_abstract,
            generator="scholar llm synthesize --no-standalone",
            bib_text=bibtex_content,
        )

    return "\n".join(lines).strip() + "\n"
