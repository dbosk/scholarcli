def same_work_keys(paper: Paper) -> set[str]:
    """The keys on which two records are taken for one work.

    The paper's id, the DOIs of its recorded versions (as paper ids),
    and its title and first author's surname as the audit table merges
    them, when the title keeps a letter or digit.
    """
    from scholar.notes import get_paper_id
    from scholar.review import audit_work_key
    from scholar.scholar import version_link_dois

    keys = {get_paper_id(paper), *version_link_dois(paper)}
    title, surname = audit_work_key(paper)
    if title:
        keys.add(f"work:{title}|{surname}")
    return keys
