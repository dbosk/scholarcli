    paper=Paper(title="Loops Where Recursion Was Meant",
                authors=["Ada Lovelace"], year=2020,
                doi="10.5555/ss-preprint",
                published_versions=[{"doi": confirmed.paper.doi,
                                     "relation": "preprint-of"}]),
    provider="arxiv", status=DecisionStatus.DISCARDED,
