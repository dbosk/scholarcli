  confirmed = session.decisions[1]
  copy = ReviewDecision(
    paper=Paper(title="Recursion As Loops", authors=["Ada Lovelace"],
                year=2021),
    provider="dblp", status=DecisionStatus.KEPT,
    tags=["supports-claim", "walrus-theme"], source=ReviewSource.HUMAN,
  )
