class TestSecondScreen:
  """The classifier as second screener records, never decides (#253)."""

  <<second screen test methods>>

<<second screen test methods>>=
AT = "2026-11-01T09:00:00+00:00"
NOW = "2026-11-20T10:00:00+00:00"

@staticmethod
def _paper(title, doi, abstract):
  return Paper(title=title, authors=["Ada Lovelace"], year=2021,
               doi=f"10.5555/ss-{doi}", abstract=abstract)

def _session(self):
  from scholar.review import record_human_decision

  machine = ReviewDecision(
    paper=self._paper("Compiler Course Design", "machine",
                      "We describe a compiler course."),
    provider="openalex", status=DecisionStatus.DISCARDED,
    tags=["off-topic-false-hit", "zebra-motivation"],
    source=ReviewSource.LLM_UNREVIEWED, llm_model="model-a",
    llm_confidence=0.7, llm_reason="Zanzibar reason about compilers.",
    llm_decided_at=self.AT, llm_prompt_version="0123456789abcdef",
  )
  confirmed = ReviewDecision(
    paper=self._paper("Recursion as Loops", "confirmed",
                      "Students traced recursion as a loop."),
    provider="openalex", status=DecisionStatus.KEPT,
    tags=["supports-claim", "quokka-theme"],
    source=ReviewSource.LLM_REVIEWED, llm_model="model-a",
    llm_reason="Quokka reason about loops.",
  )
  record_human_decision(confirmed, "tui", by="the author", at=self.AT)
  kept = ReviewDecision(
    paper=self._paper("Tracing Tables", "kept",
                      "Tables helped novices trace calls."),
    provider="openalex", status=DecisionStatus.KEPT,
    tags=["supports-claim", "tracing"], source=ReviewSource.HUMAN,
  )
  record_human_decision(kept, "tui", at=self.AT)
  dropped = ReviewDecision(
    paper=self._paper("Cache Hierarchies", "dropped", "Memory systems."),
    provider="openalex", status=DecisionStatus.DISCARDED,
    tags=["off-topic-false-hit", "hardware"], source=ReviewSource.HUMAN,
  )
  record_human_decision(dropped, "tui", at=self.AT)
  pending = ReviewDecision(
    paper=self._paper("Loops in Practice", "pending", "A study of loops."),
    provider="openalex",
  )
  return ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    name="second", research_context="Do novices misread recursion?",
    decisions=[machine, confirmed, kept, dropped, pending],
  )

def _fake(self, monkeypatch, model_id="model-b", answers=None):
  import re
  from types import SimpleNamespace
  import scholar.llm_review as llm_review
  import scholar.utils

  answers = answers or {}

  def answer(index):
    return answers.get(index, {
      "paper_index": index, "decision": "kept",
      "tags": ["adjacent-subtopic"], "confidence": 0.6,
      "reasoning": "Background only.",
    })

  class FakeModel:
    def __init__(self):
      self.model_id = model_id
      self.prompts = []

    def prompt(self, prompt):
      self.prompts.append(prompt)
      indices = sorted({int(i) for i in re.findall(r"\[Paper (\d+)\]",
                                                   prompt)})
      text = json.dumps({"classifications": [answer(i) for i in indices]})
      return SimpleNamespace(text=lambda: text)

  model = FakeModel()
  monkeypatch.setattr(llm_review, "llm",
                      SimpleNamespace(get_model=lambda *_: model),
                      raising=False)
  monkeypatch.setattr(scholar.utils, "utc_now_iso", lambda: self.NOW)
  return model
