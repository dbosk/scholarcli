def census_sentence(report: SampleReport) -> str:
    """State a census and what its review has shown so far."""
    sessions = len(report.sessions)
    text = (
        f"A census of all {report.population} "
        f"{describe_sample_criteria(report.criteria)} in {sessions} "
        f"session{'s' if sessions != 1 else ''} was taken on "
        f"{report.drawn_at[:10]} for human review"
    )
    if not report.reviewed:
        text += "; none of it has been reviewed yet"
    elif report.unreviewed:
        text += (
            f"; of the {report.reviewed} reviewed so far, the reviewer "
            f"changed {report.changed} ({report.rate:.1%}), and "
            f"{len(report.unreviewed)} are not yet reviewed"
        )
    else:
        text += (
            f"; all {report.reviewed} counted were reviewed, and the "
            f"reviewer changed {report.changed} ({report.rate:.1%})"
        )
    return text + uncounted_text(report) + "."
