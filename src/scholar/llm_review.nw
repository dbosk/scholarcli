def _build_bibtex_content(
    decisions: list[ReviewDecision],
    citation_keys: dict[str, tuple[str, str]],
) -> str:
    """Build BibTeX content for every decision in `decisions`."""
    from scholar.notes import get_paper_id
    from scholar.review import bibtex_file_text, format_bibtex_entry

    entries: list[str] = []
    for decision in decisions:
        paper_id = get_paper_id(decision.paper)
        _, bibtex_key = citation_keys[paper_id]
        entries.append(format_bibtex_entry(decision.paper, bibtex_key))

    return bibtex_file_text(entries)


def _assemble_markdown_synthesis(
    session: ReviewSession,
    theme_sections: list[ThemeSectionResult],
    conclusion: str,
    references_markdown: str,
    included_kept_papers: int,
    total_kept_papers: int,
) -> str:
    parts: list[str] = []
    parts.append(
        build_research_question_section_markdown(
            session,
            included_kept_papers=included_kept_papers,
            total_kept_papers=total_kept_papers,
        )
    )

    parts.append("## Synthesis\n")
    for section in theme_sections:
        parts.append(section.section.strip())
        parts.append("")

    parts.append("## Conclusion\n")
    parts.append(conclusion.strip())
    parts.append("")

    parts.append("## References\n")
    parts.append(references_markdown.strip())

    return "\n".join(parts).strip() + "\n"


@

\subsection{Assembling the \LaTeX{} synthesis}

The \LaTeX{} synthesis is the review report's decision record with a
narrative in front of it, so it is composed from the same pieces as the
report: the body (research question, synthesis, conclusion) and the
decision record from [[review.build_review_decisions_latex]], wrapped by
either [[latex_document]] or [[latex_fragment]]. The front
\enquote{Research Question} section keeps its search parameters and
counts; only the per-paper decisions go to the end. (The alternative,
moving the search parameters to the appendix as well, would be a two-line
change here but would put the method after the findings.)

Three details of the standalone document are deliberate. The embedded
bibliography uses [[filecontents*]] with the [[overwrite]] option: \LaTeX{}
otherwise refuses to regenerate a file that exists, so a [[.bib]] left by
an earlier fragment run would silently shadow the embedded one. The
bibliography is printed before the appendix, the conventional order. And
the decision record sits in its own [[refsection]] so that its
[[\fullcite]]s---of discarded papers, and of kept papers the prose never
cited---do not appear in the reference list, which thus lists exactly what
the synthesis cites. The fragment keeps the [[refsection]] for the same
reason, protecting the including document's bibliography. Both wrappers
also get the bibliography text, because a title in another script
reaches the page only through the [[.bib]], wrapped in
[[\scholarnonlatin]], and the wrapper defines that macro only when
something it emits uses it (\cref{sec:non-latin-definition}).

