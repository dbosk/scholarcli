source (\cref{sec:review-source}), which get their own count so that
the rows still add up to the total.

<<llm review statistics>>=
def get_review_statistics(session: ReviewSession) -> dict[str, int]:
    """
    Get counts of decisions by source and status.

    Args:
        session: The review session

    Returns:
        Dictionary with counts:
        - human: Decisions made by human directly
        - llm_unreviewed: LLM decisions pending review
        - llm_reviewed: LLM decisions reviewed by user
        - agent_unreviewed: AI agent decisions pending review
        - agent_reviewed: AI agent decisions reviewed by user
        - unknown: decisions whose stored source Scholar does not know
        - examples: Papers marked as training examples
        - pending: Papers not yet decided
        - total: Total papers in session
    """
    stats = {
        "human": 0,
        "llm_unreviewed": 0,
        "llm_reviewed": 0,
        "agent_unreviewed": 0,
        "agent_reviewed": 0,
        "unknown": 0,
        "examples": 0,
        "pending": 0,
        "total": len(session.decisions),
    }

    for decision in session.decisions:
        if decision.status == DecisionStatus.PENDING:
            stats["pending"] += 1
        elif decision.source == ReviewSource.HUMAN:
            stats["human"] += 1
        elif decision.source == ReviewSource.LLM_UNREVIEWED:
            stats["llm_unreviewed"] += 1
        elif decision.source == ReviewSource.LLM_REVIEWED:
            stats["llm_reviewed"] += 1
        elif decision.source == ReviewSource.AGENT_UNREVIEWED:
            stats["agent_unreviewed"] += 1
        elif decision.source == ReviewSource.AGENT_REVIEWED:
            stats["agent_reviewed"] += 1
        elif decision.source.is_unknown:
            stats["unknown"] += 1

        if decision.is_example:
            stats["examples"] += 1

    return stats
