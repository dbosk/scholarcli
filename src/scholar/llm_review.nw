        json.dumps({"classifications": answers}), self._papers(count)
    )

def test_each_defect_is_recorded_not_repaired(self):
    good = {"decision": "kept", "tags": ["t"], "confidence": 0.8,
            "reasoning": "fits"}
    parsed = self._parse([
        {**good, "paper_index": 0},
        {**good, "paper_index": 1, "decision": "maybe"},
        {**good, "paper_index": 2, "confidence": None},
        {**good, "paper_index": 3, "confidence": 85},
        {**good, "paper_index": "4", "decision": "discarded", "tags": []},
    ], 6)
    problems = [d.answer_problem for d in parsed]
    assert problems == [
        "",
        "invalid decision 'maybe'",
        "invalid confidence None",
        "invalid confidence 85",
        "discarded without a tag",
        "no answer for this paper",
    ]
    assert parsed[0].confidence == 0.8 and parsed[0].problem == ""
    assert parsed[1].status == "" and parsed[2].confidence is None
    assert all(d.problem for d in parsed[1:])

def test_answers_without_a_usable_index_are_skipped(self):
    good = {"decision": "kept", "tags": ["t"], "confidence": 0.8}
    parsed = self._parse([
        good,
        {**good, "paper_index": True},
        {**good, "paper_index": 7},
        {**good, "paper_index": 0, "confidence": 0.9},
        {**good, "paper_index": 0, "confidence": 0.1},
    ], 1)
    assert len(parsed) == 1
    assert parsed[0].confidence == 0.9
