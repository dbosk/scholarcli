One sentence states a sample for a report.  It says what was drawn,
from what, when and with which seed, and then only what the review has
shown so far: no rate before anything is reviewed, the number still
unreviewed when the review is incomplete, and the number not found.
While part of the sample is unreviewed, the sentence also says that the
rate covers only the reviewed part.  That part is a random sample of
the population only if which papers got reviewed had nothing to do
with the papers themselves; a reviewer who skips the hard cases makes
the rate look better than it is, and the reader should be told that
the rate depends on it.  Papers reset since the draw are counted in
the same way as those not found: the sentence says how many and that
they are not counted.

<<llm review sampling>>=
def describe_sample_criteria(criteria: dict) -> str:
    """Describe a sample's population in words, e.g. 'unreviewed LLM discards'."""
    sources = criteria.get("population_sources") or ["llm"]
    machine = "LLM" if set(sources) <= {"llm"} else "LLM and agent"
    statuses = set(criteria.get("statuses") or ())
    what = (
        "discards" if statuses == {"discarded"}
        else "inclusions" if statuses == {"kept"}
        else "decisions"
    )
    text = f"unreviewed {machine} {what}"
    low = criteria.get("min_confidence")
    high = criteria.get("max_confidence")
    if criteria.get("no_confidence"):
        text += " without a confidence"
    elif low is not None and high is None:
        text += f" with a confidence of at least {low:g}"
    elif high is not None:
        text += (" with a confidence "
                 + ("of " if low is not None else "")
                 + confidence_criteria_text(low, high))
    return text


def sample_sentence(report: SampleReport) -> str:
    """State a sample and what its review has shown so far, in one sentence."""
    if report.census:
        return census_sentence(report)
    sessions = len(report.sessions)
    text = (
        f"A random sample of {report.size} of the {report.population} "
        f"{describe_sample_criteria(report.criteria)} in {sessions} "
        f"session{'s' if sessions != 1 else ''} was drawn on "
        f"{report.drawn_at[:10]} (seed {report.seed}) for human review"
    )
    if not report.reviewed:
        text += "; none of it has been reviewed yet"
    else:
        low, high = report.interval
        text += (
            f"; of the {report.reviewed} reviewed so far, the reviewer "
            f"changed {report.changed} ({report.rate:.1%}; 95% modified "
            f"Wilson interval {low:.1%} to {high:.1%})"
        )
        if report.unreviewed:
            text += (
                f", and {len(report.unreviewed)} are not yet reviewed; the "
                "rate covers only the reviewed part, and if papers were "
                "skipped rather than reviewed in the drawn order it may be "
                "biased"
            )
    return text + uncounted_text(report) + "."


def uncounted_text(report: SampleReport) -> str:
    """Name the sampled decisions a report could not count, if any."""
    text = ""
    if report.reset_since_draw:
        text += (
            f"; {report.reset_since_draw} sampled decisions were reset to "
            "pending after the draw and are not counted"
        )
    if report.not_found:
        text += (
            f"; {report.not_found} sampled decisions were not found in the "
            "sessions reported on and are not counted"
        )
    return text
@

