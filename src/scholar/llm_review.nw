def test_the_prompt_holds_no_verdict_of_the_screened_papers(
  self, monkeypatch
):
  import re

  session = self._session()
  machine, confirmed = session.decisions[:2]
  self._fake(monkeypatch)
  prompt = second_screen_with_llm(session, over="all", count=2,
                                  dry_run=True, enrich_missing=False)
  for word in ("zebra-motivation", "quokka-theme", "Zanzibar", "Quokka"):
    assert word not in prompt
  assert prompt.count("Compiler Course Design") == 1
  assert prompt.count("Recursion as Loops") == 1
  for shown in ("Tracing Tables", "tracing", "Cache Hierarchies",
                "hardware"):
    assert shown in prompt
  papers_part = prompt.split("## Papers to Classify")[1] \
    .split("## Instructions")[0]
  assert not re.search(r"kept|discarded|supports|off-topic", papers_part,
                       re.IGNORECASE)
  machine.status = DecisionStatus.KEPT
  machine.tags = ["supports-claim", "walrus-theme"]
  machine.source = ReviewSource.HUMAN
  confirmed.status = DecisionStatus.DISCARDED
  confirmed.tags = ["off-topic-false-hit", "yak-motivation"]
  assert second_screen_with_llm(session, over="all", count=2,
                                dry_run=True,
                                enrich_missing=False) == prompt
  every = second_screen_with_llm(session, over="all", count=4,
                                 dry_run=True, enrich_missing=False)
  assert "## Category (exactly one per paper)" in every
  assert "hardware" not in every
  assert all(d.screenings == [] for d in session.decisions)
