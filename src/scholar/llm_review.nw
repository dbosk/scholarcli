def test_same_second_same_seed_draws_stay_apart(self):
    from datetime import timezone
    from scholar.review import load_session, save_session

    sessions = self._sessions()
    for session in sessions:
        save_session(session)
    when = datetime(2026, 11, 18, 12, 0, tzinfo=timezone.utc)
    first = [load_session(s.name) for s in sessions]
    second = [load_session(s.name) for s in sessions]
    discards = draw_llm_sample(
        first, statuses={"discarded"}, size=3, seed=9, now=when
    )
    for session in first:
        save_session(session)
    inclusions = draw_llm_sample(
        second, statuses={"kept"}, size=3, seed=9, now=when
    )
    for session in second:
        save_session(session)
    assert discards.sample_id != inclusions.sample_id

    final = [load_session(s.name) for s in sessions]
    reports = {r.sample_id: r for r in sample_reports(final)}
    assert set(reports) == {discards.sample_id, inclusions.sample_id}
    assert reports[discards.sample_id].size == 3
    assert reports[inclusions.sample_id].size == 1
    assert reports[inclusions.sample_id].criteria["statuses"] == ["kept"]
