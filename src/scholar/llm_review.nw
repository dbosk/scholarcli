    assert a.sessions == ["draw-a", "draw-b"] and a.size == 15
    assert len(a.papers) == 9 and len(b.papers) == 6
    assert a.criteria["population_sources"] == ["llm"]
    assert {p["status"] for p in a.papers} == {"discarded", "kept"}

