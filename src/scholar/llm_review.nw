def stratified_sample_sentence(report: StratifiedReport) -> str:
    """State a stratified sample and what its review has shown so far."""
    sessions = len(report.sessions)
    bands = ", ".join(
        f"{band_label(band)}: "
        + ("none" if not band.population
           else f"all {band.population}" if band.census
           else f"{band.size} of {band.population}")
        for band in report.bands
    )
    kind = ("census" if all(band.census for band in report.bands)
            else "stratified random sample")
    seed = f" (seed {report.seed})" if report.seed is not None else ""
    text = (
        f"A {kind} of the {report.population} "
        f"{describe_sample_criteria(report.criteria)} in {sessions} "
        f"session{'s' if sessions != 1 else ''} was drawn on "
        f"{report.drawn_at[:10]}{seed} for human review, "
        f"in {len(report.bands)} confidence bands ({bands})"
    )
    estimate = report.estimate()
    if estimate is not None:
        not_reviewed = estimate.population - estimate.reviewed
        text += (
            f"; with every band reviewed, the reviewer changed "
            f"{estimate.changed} of the {estimate.reviewed} reviewed, and "
            f"weighting each band's rate by its size estimates that "
            f"{estimate.rate:.1%} of all {estimate.population} would be "
            f"changed, {estimate.changed_not_reviewed:.1f} of the "
            f"{not_reviewed} not reviewed (no interval is given for this "
            "estimate)"
        )
    else:
        text += f"; {report.withheld_reason()}"
    return text + uncounted_text(report) + "."


def sample_report_sentence(
    report: "SampleReport | StratifiedReport",
) -> str:
    """State a single or a stratified sample in one sentence."""
    if isinstance(report, StratifiedReport):
        return stratified_sample_sentence(report)
    return sample_sentence(report)


def report_sample_ids(report: "SampleReport | StratifiedReport") -> set[str]:
    """Return the ids of the stored samples a report covers."""
    if isinstance(report, StratifiedReport):
        return {band.sample_id for band in report.bands}
    return {report.sample_id}
