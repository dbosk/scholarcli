Whether a screened decision is the model's own call is read before its
screening is recorded, from the screener its snapshot names
([[verdict_screener]]): an unreviewed classifier decision of this
model.  A decision a human confirmed is the human's verdict, whichever
model proposed it, so it is not the same model's.

<<record the answers as screenings>>=
from scholar.review import new_screening, record_screening, verdict_screener
from scholar.utils import utc_now_iso

recorded_at = utc_now_iso()
for answer in batch.decisions:
    for decision in copies.get(answer.paper_id, []):
        first = verdict_screener(decision)
        if (first["kind"], first["name"]) == ("llm", batch.model_id):
            result.same_model.append(decision)
        screening = new_screening(
            kind="llm", name=batch.model_id, status=answer.status,
            tags=list(answer.tags), recorded_at=recorded_at,
            confidence=answer.confidence,
            reason=truncate_reason(answer.reasoning), at=batch.timestamp,
            prompt_version=batch.prompt_version,
            abstract_truncated=answer.abstract_truncated,
            blind=True, blind_basis="prompt",
            sample_id=selection.sample_of.get(id(decision)), via="classify",
        )
        if record_screening(decision, screening) is not None:
            result.snapshots += 1
        result.screened.append((decision, screening))
