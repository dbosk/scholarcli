def test_a_sample_selects_its_papers(self, monkeypatch):
  from scholar.notes import get_paper_id
  from scholar.review import LLMSample

  session = self._session()
  machine, _, _, dropped, _ = session.decisions
  reset = ReviewDecision(
    paper=self._paper("Reset Since", "reset", "Reset after the draw."),
    provider="openalex",
    resets=[{"at": "2026-11-15T00:00:00+00:00", "status": "discarded"}],
  )
  session.decisions.append(reset)

  def band(index, decisions):
    return LLMSample(
      sample_id=f"g1/band={index}", seed=1,
      drawn_at="2026-11-10T00:00:00+00:00",
      criteria={"stratum": {"group": "g1", "band": index}},
      sessions=["second"], population=len(decisions),
      population_digest="", size=len(decisions),
      papers=[{"paper_id": get_paper_id(d.paper), "status": "discarded"}
              for d in decisions],
    )

  session.llm_samples = [band(0, [machine, reset]), band(1, [dropped])]
  one = second_screen_candidates(session, sample="g1/band=0")
  assert (one.decisions, one.reset_since_draw) == ([machine], 1)
  self._fake(monkeypatch)
  result = second_screen_with_llm(session, sample="g1",
                                  enrich_missing=False)
  assert [(d, s["sample_id"]) for d, s in result.screened] == [
    (machine, "g1/band=0"), (dropped, "g1/band=1"),
  ]
  assert reset.screenings == []
  with pytest.raises(ValueError, match="no review sample"):
    second_screen_candidates(session, sample="g2")
