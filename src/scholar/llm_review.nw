def sample_group(sample) -> str | None:
    """The group id a band of a stratified draw shares, or None."""
    stratum = sample.criteria.get("stratum")
    if isinstance(stratum, dict) and stratum.get("group"):
        return stratum["group"]
    return None


@dataclass
class SecondScreenSelection:
    """The decided papers a second screen may classify, in session order.

    `sample_of` maps `id(decision)` to the id of the sample the paper was
    drawn in (with a sample); `reset_since_draw` counts the sampled
    decisions reset to pending since their draw and `not_in_session` the
    sampled papers the session no longer holds.
    """

    decisions: list[ReviewDecision]
    sample_of: dict[int, str] = field(default_factory=dict)
    reset_since_draw: int = 0
    not_in_session: int = 0


def second_screen_candidates(
    session: ReviewSession, over: str | None = None,
    sample: str | None = None,
) -> SecondScreenSelection:
    """Select the decided papers of `session` for a second screen.

    Exactly one of `over`, `all` or `machine` (unreviewed machine
    decisions), and `sample`, a sample id (a band's, or a banded draw's
    group id) whose papers are selected.

    Raises:
        ValueError: For neither or both, an unknown `over` or a sample
            the session lacks.
    """
    from scholar.notes import get_paper_id

    if (over is None) == (sample is None):
        raise ValueError(
            "A second screen needs exactly one of over (all or machine) "
            "and a sample: which decided papers to screen is chosen, "
            "not defaulted."
        )
    if sample is None:
        if over not in SECOND_SCREEN_SCOPES:
            raise ValueError(f"--over is all or machine, not {over!r}")
        return SecondScreenSelection([
            d for d in session.decisions
            if d.is_decided and (over == "all" or is_unreviewed_machine(d))
        ])
    samples = [s for s in session.llm_samples
               if sample in (s.sample_id, sample_group(s))]
    if not samples:
        raise ValueError(f"no review sample {sample!r} in this session")
    drawn: dict[str, Any] = {}
    for held in samples:
        for entry in held.papers:
            drawn.setdefault(entry.get("paper_id"), held)
    selection = SecondScreenSelection([])
    found: set[str] = set()
    for decision in session.decisions:
        held = drawn.get(get_paper_id(decision.paper))
        if held is None:
            continue
        found.add(get_paper_id(decision.paper))
        if reset_since_draw(decision, held.drawn_at):
            selection.reset_since_draw += 1
        elif decision.is_decided:
            selection.decisions.append(decision)
            selection.sample_of[id(decision)] = held.sample_id
    selection.not_in_session = len(set(drawn) - found)
    return selection


def has_second_screen_by(decision: ReviewDecision, model_id: str) -> bool:
    """Whether `model_id` second-screened `decision` since its last reset."""
    from scholar.review import counted_screenings, screener_identity

    return any(
        screener_identity(record) == ("llm", model_id, True)
        for record in counted_screenings(decision)
    )
@

\paragraph{The record.}
Each usable answer becomes a screening of kind [[llm]], named by the
model's id, with the model's status, tags, confidence and reason.  Its
time [[at]] is the batch's, as for a classified decision
([[llm_decided_at]]); it has the prompt version and the truncation flag
of the classifier's record (\cref{sec:llm-audit-fields} in the review
module), [[blind]] on the ground [[prompt]], the sample id when one was
given, and [[via]] [[classify]], the channel that [[screener_identity]]
reads.  The reason is cut as a classified decision's is
([[truncate_reason]]): the first screen's reason, in the snapshot of a
classified decision, was cut so, the second screen's is kept alike, and
either fits under the screening's own limit.  The prompt version is
the ordinary one: the second screen uses the same procedure, and which
records are examples was never part of the version
(\cref{sec:prompt-version}).  [[record_screening]] snapshots the
decision's verdict first, as for every screening.  An answer the
classifier withholds (no usable answer, or no single category that
fits it) is returned in the batch's [[withheld]], to be listed as the
ordinary run lists it, and stores nothing, neither a screening nor a
snapshot.

\paragraph{The same model.}
The model may be the one that made the decision.  That run is recorded
like any other, never refused, and the result lists those papers
([[same_model]]) so that the command can say so; the screening is told
apart from the decision's snapshot by its channel
([[screener_identity]]).  Issue~\#253 decided that such a screen is
recorded and reported as \enquote{same model}: whether a model's second
run is independent enough is the review's judgement, and the record
gives the review what it needs to make it, the model of both screens
and both prompt versions.

<<llm review second screen>>=
@dataclass
class SecondScreen:
    """What one second-screen run recorded.

    `screened` pairs each decision given a screening with that
    screening; `same_model` lists those whose decision is an unreviewed
    call of the screening model itself; `snapshots` counts the decision
    snapshots taken. `already_screened` counts the selected decisions
    skipped because the model had screened them, and `remaining` the
    papers of the selection still to screen after this run.
    """

    batch: LLMBatchResult
    selection: SecondScreenSelection
    screened: list[tuple[ReviewDecision, dict]] = field(default_factory=list)
    same_model: list[ReviewDecision] = field(default_factory=list)
    snapshots: int = 0
    already_screened: int = 0
    remaining: int = 0


def second_screen_with_llm(
    session: ReviewSession,
    count: int = DEFAULT_BATCH_SIZE,
    *,
    model_id: str | None = None,
    over: str | None = None,
    sample: str | None = None,
    rescreen: bool = False,
    dry_run: bool = False,
    enrich_missing: bool = True,
    require_examples: bool = True,
    use_fulltext: bool = False,
    max_quotes: int = 3,
    vocabulary: set[str] | None = None,
    allow_new_tags: bool = False,
) -> SecondScreen | str:
    """Screen decided papers again with the classifier, as a second screener.

    Selects decided papers (`second_screen_candidates`), skips those the
    model already second-screened since their last reset unless
    `rescreen`, classifies the next `count` with a prompt that holds no
    verdict of theirs and stores each usable answer as a screening
    (`kind` llm, `via` classify). The decisions are not changed.

    Returns:
        A `SecondScreen`, or the prompt when `dry_run`.

    Raises:
        ValueError: For a bad selection, or when no paper is left.
        ImportError: If the llm package is not installed.
    """
    from scholar.notes import get_paper_id

    selection = second_screen_candidates(session, over, sample)
    <<resolve the model of the second screen>>
    copies: dict[str, list[ReviewDecision]] = {}
    already = 0
    for decision in selection.decisions:
        if not rescreen and has_second_screen_by(decision, name):
            already += 1
            continue
        copies.setdefault(get_paper_id(decision.paper), []).append(decision)
    chosen = list(copies)[:count]
    if not chosen:
        raise ValueError(
            f"No decided papers left to screen with {name}"
            + (f": {already} already screened by it since their last "
               "reset (--rescreen screens them again)" if already else "")
        )
    shown = {paper_id: copies[paper_id][0].paper for paper_id in chosen}
    batch = classify_papers_with_llm(
        session, count=count, model_id=name, enrich_missing=enrich_missing,
        dry_run=dry_run, require_examples=require_examples,
        use_fulltext=use_fulltext, max_quotes=max_quotes,
        vocabulary=vocabulary, allow_new_tags=allow_new_tags,
        papers=[copies[paper_id][0] for paper_id in chosen],
    )
    <<give every copy the paper enrichment filled>>
    if dry_run:
        return batch
    result = SecondScreen(batch=batch, selection=selection,
                          already_screened=already,
                          remaining=len(copies) - len(chosen))
    <<record the answers as screenings>>
    return result
@

The model is resolved before the selection is cut to a batch, because
which papers it has already screened depends on its id.  The id is the
one the model reports ([[model_id]]), which [[apply_llm_decisions]]
stores as [[llm_model]], so a second screen names the model as its
decisions do, whatever alias was given on the command line.  The model
is looked up through [[globals()]], the seam the classifier tests use,
for a dry run too, which then shows the batch a real run would send.
A model the [[llm]] package does not know raises its
[[UnknownModelError]], a [[KeyError]]; it is turned into a
[[ValueError]] with the package's message, so that the command ends
with that one line and status~1 like any other failed selection,
instead of a traceback.

<<resolve the model of the second screen>>=
try:
    import llm as llm_module
except ImportError:
    raise ImportError(
        "The 'llm' package is required for LLM classification. "
        "Install it with: pip install llm"
    )
llm = globals().get("llm", llm_module)
try:
    model = llm.get_model(model_id) if model_id else llm.get_model()
except KeyError as error:
    raise ValueError(error.args[0] if error.args else str(error)) from error
name = model.model_id
