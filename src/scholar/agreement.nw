def _decision(self, **kwargs):
  values = dict(status=DecisionStatus.DISCARDED, tags=["t"],
                source=ReviewSource.LLM_UNREVIEWED, llm_model="m-1",
                llm_decided_at="2020-01-01T09:00:00+00:00")
  values.update(kwargs)
  return ReviewDecision(paper=Paper(title="P", authors=["A"],
                                    doi="10.5555/agree-1"),
                        provider="p", **values)

def _screen(self, decision, status, at, name="agent-2", kind="agent"):
  record_screening(decision, new_screening(
    kind=kind, name=name, status=status, tags=["t"], recorded_at=at))

def test_the_latest_verdict_counts(self):
  decision = self._decision()
  self._screen(decision, "kept", "2020-01-02T10:00:00+00:00")
  self._screen(decision, "discarded", "2020-01-03T10:00:00+00:00")
  verdicts = screener_verdicts(decision)
  assert set(verdicts) == {("llm", "m-1", False), ("agent", "agent-2", False)}
  assert verdicts[("agent", "agent-2", False)]["status"] == "discarded"
  assert verdicts[("llm", "m-1", False)]["origin"] == "decision"

def test_a_reset_sets_aside_the_earlier_verdicts(self):
  decision = self._decision()
  self._screen(decision, "kept", "2020-01-02T10:00:00+00:00")
  decision.resets.append({"at": "2020-01-03T00:00:00+00:00"})
  assert screener_verdicts(decision) == {}

def test_unknown_origin_is_counted_not_paired(self):
  decision = self._decision()
  self._screen(decision, "kept", "2020-01-02T10:00:00+00:00")
  decision.screenings[0]["kind"] = None
  assert set(screener_verdicts(decision)) == {("agent", "agent-2", False)}
  assert unknown_origin_count([decision]) == 1

def test_unnamed_screeners_of_one_kind_are_one(self):
  decision = self._decision(source=ReviewSource.HUMAN,
                            status=DecisionStatus.PENDING)
  self._screen(decision, "kept", "2020-01-02T10:00:00+00:00", name=None)
  self._screen(decision, "discarded", "2020-01-03T10:00:00+00:00",
               name=None)
  verdicts = screener_verdicts(decision)
  assert list(verdicts) == [("agent", None, False)]
  assert verdicts[("agent", None, False)]["status"] == "discarded"
  assert ScreenerProfile(("agent", None, False)).label == "unnamed agent"
