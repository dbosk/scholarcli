<<screening agreement test methods>>=
def _verdicts(self, llm, agent):
  def record(kind, name, verdict):
    status, *tags = verdict
    return {"kind": kind, "name": name, "status": status, "tags": tags,
            "origin": "screen"}
  verdicts = {}
  if llm:
    verdicts[("llm", "m-1", False)] = record("llm", "m-1", llm)
  if agent:
    verdicts[("agent", "a-2", False)] = record("agent", "a-2", agent)
  return verdicts

def test_status_bearing_and_category(self):
  records = [
    self._verdicts(("kept", "supports-claim"), ("kept", "qualifies-claim")),
    self._verdicts(("discarded", "off-topic-false-hit"),
                   ("kept", "adjacent-subtopic")),
    self._verdicts(("discarded", "off-topic-false-hit"), ("discarded",)),
    self._verdicts(None, ("kept", "supports-claim")),
  ]
  llm, agent = ("llm", "m-1", False), ("agent", "a-2", False)
  status = screening_agreement(records, llm, agent, "status")
  assert status.cells == ((1, 0), (1, 1))
  bearing = screening_agreement(records, llm, agent, "bearing")
  assert bearing.cells == ((1, 0), (0, 1))
  assert bearing.without_category == 1
  category = screening_agreement(records, llm, agent, "category")
  assert category.n == 2 and category.agreeing == 0
  assert category.cells[0][1] == 1 and category.cells[3][2] == 1
  assert screener_pairs(records) == [(llm, agent)]
