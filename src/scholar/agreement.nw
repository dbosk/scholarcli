def test_hits_are_counted_by_work(self):
  from scholar.review import build_audit_table_latex
  session = ReviewSession(query="q", providers=["openalex"],
                          timestamp=datetime(2026, 11, 20))

  def call(doi, title):
    return ReviewDecision(
      paper=Paper(title=title, authors=["Ada Nilsson"], year=2020,
                  doi=doi),
      provider="openalex", status=DecisionStatus.DISCARDED,
      tags=["off-topic-false-hit"], source=ReviewSource.LLM_UNREVIEWED,
      llm_model="m-1", llm_decided_at="2020-01-01T00:00:00+00:00")
  with_doi = call("10.5555/work-copy", "One work in two copies")
  without_doi = call(None, "One work in two copies")
  other = call("10.5555/work-other", "Another work")
  session.decisions = [with_doi, without_doi, other]
  for decision in (with_doi, without_doi):
    record_screening(decision, new_screening(
      kind="agent", name="a-2", status="discarded",
      tags=["off-topic-false-hit"], blind=True, blind_basis="declared",
      recorded_at="2020-01-02T00:00:00+00:00"))
  captions = {
    lang: next(line for line in build_audit_table_latex(
      session, label="w", lang=lang) if line.startswith("\\caption{"))
    for lang in ("en", "sv")
