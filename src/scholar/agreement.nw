  assert "(3 unique hits:" not in captions["en"]
  assert "(2 unique hits:" in captions["en"]
  assert "1 of 2 hits was screened a second time (1 by an agent, " \
    "blind by the agent's own declaration)." in captions["en"]
  assert "over 2 records screened by both" in captions["en"]
  assert "1 av 2 träffar granskades en andra gång (1 granskad av en " \
    "agent, blint enligt agentens egen uppgift)." in captions["sv"]
