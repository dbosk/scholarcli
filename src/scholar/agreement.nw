def agreement_block(
    table: AgreementTable, *, interval_note: str | None = None
) -> list[str]:
    """The lines `sessions agreement` prints for one pair and question."""
    title = QUESTION_TITLES[table.question]
    if not table.n:
        return [
            f"{title}: no record has a value from both screeners"
            + (
                f" ({table.without_category} without a category)"
                if table.without_category else ""
            )
            + "."
        ]
    lines = [
        f"{title}, {table.n} {_records(table.n)} screened by both:"
    ]
    lines += _table_lines(table)
    observed = f"  observed agreement  {_percent(table.observed)}"
    if table.interval is not None:
        low, high = table.interval
        observed += f"  (95 % CI {100 * low:.1f}-{100 * high:.1f})"
    elif interval_note:
        observed += f"  ({interval_note})"
    lines.append(observed)
    if table.is_binary:
        <<the measures of a two-by-two table>>
    if table.without_category:
        lines.append(
            f"  {table.without_category} records without a category from "
            "one or both screeners, not compared"
        )
    if table.is_binary:
        lines += interpretive_sentences(table)
    return lines
