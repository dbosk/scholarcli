  without = build_audit_table_latex(screened, label="ds", lang=lang)
  return with_screens, without

@pytest.mark.parametrize("lang", ["en", "sv"])
def test_the_sentences_and_unchanged_rows(self, lang):
  with_screens, without = self._tables(lang)
  sentences = self.EN if lang == "en" else self.SV
  [caption] = [i for i, line in enumerate(with_screens)
               if line.startswith("\\caption{")]
  assert with_screens[:caption] + with_screens[caption + 1:] == (
    without[:caption] + without[caption + 1:])
  assert with_screens[caption].replace(sentences + " ", "") \
    == without[caption]
  databases = "Databases searched" if lang == "en" else "Sökta databaser"
  assert f". {sentences} {databases}:" in with_screens[caption]

def test_one_group_per_kind_and_ground(self):
  from scholar.review import AUDIT_STRINGS
  decisions = []
  for i, (kind, name, blind, basis, via) in enumerate([
    ("llm", "m-2", True, "prompt", "classify"),
    ("agent", "a-3", True, "declared", "screen"),
    ("agent", "a-4", True, "declared", "screen"),
    ("agent", "a-3", False, None, "screen"),
    ("human", None, None, None, "screen"),
  ]):
    decision = ReviewDecision(
      paper=Paper(title=f"K{i}", authors=["A"], doi=f"10.5555/kind-{i}"),
      provider="p", status=DecisionStatus.DISCARDED, tags=["t"],
      source=ReviewSource.LLM_UNREVIEWED, llm_model="m-1",
      llm_decided_at="2020-01-01T00:00:00+00:00")
    record_screening(decision, new_screening(
      kind=kind, name=name, status="discarded", tags=["t"], blind=blind,
      blind_basis=basis, via=via,
      recorded_at="2020-01-02T00:00:00+00:00"))
    decisions.append(decision)
  text = audit_screening_sentence(decisions, AUDIT_STRINGS["en"])
  assert text.startswith(
    "5 of 5 records were screened a second time (1 by a language model, "
    "blind by construction of the prompt; 2 by 2 agents, blind by the "
    "agents' own declaration; "
    "1 by an agent, not blind; 1 by a human, blindness not recorded). ")
  assert "between model m-1 and an unnamed human, over 1 record " \
    "screened by both: 100.0\\,\\% (Cohen's kappa undefined: both " \
    "screeners gave only one verdict)." in text
  assert "between model m-1 and model m-2 (second screen)," in text

