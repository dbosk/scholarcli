DRAWN = "2020-02-01T00:00:00+00:00"

def _session(self, statuses, screened=None, criteria=None,
             sample_id="s-1"):
  decisions = []
  for i, (machine, agent) in enumerate(statuses):
    decision = ReviewDecision(
      paper=Paper(title=f"T{i}", authors=["A"],
                  doi=f"10.5555/agree-sample-{i}"),
      provider="p", status=DecisionStatus(machine), tags=["t"],
      source=ReviewSource.LLM_UNREVIEWED, llm_model="m-1",
      llm_decided_at="2020-01-01T00:00:00+00:00")
    if agent:
      record_screening(decision, new_screening(
        kind="agent", name="a-2", status=agent, tags=["t"],
        recorded_at="2020-03-01T00:00:00+00:00"))
    decisions.append(decision)
  session = ReviewSession(query="q", providers=["p"],
                          timestamp=datetime(2020, 1, 1),
                          decisions=decisions)
  session.llm_samples = [LLMSample(
    sample_id=sample_id, seed=1, drawn_at=self.DRAWN,
    criteria=dict(criteria or {}), sessions=["q"], population=100,
    population_digest="d", size=len(decisions),
    papers=[{"paper_id": d.paper.id, "status": d.status.value,
             "source": "llm", "confidence": 0.9} for d in decisions])]
  return session

def test_the_interval_is_the_modified_wilson_interval(self):
  from scholar.llm_review import modified_wilson_interval

  session = self._session(
    [("discarded", "discarded")] * 18 + [("discarded", "kept")] * 2)
  [band] = sample_bands([session], "s-1")
  table = band_agreement(band, ("llm", "m-1", False), ("agent", "a-2", False))
  assert (table.n, table.agreeing) == (20, 18)
  assert table.interval == modified_wilson_interval(18, 20)

def test_reset_papers_are_left_out_and_counted(self):
  session = self._session([("discarded", "discarded")] * 5)
  session.decisions[0].resets.append({"at": "2020-02-02T00:00:00+00:00"})
  [band] = sample_bands([session], "s-1")
  assert (band.counted, band.reset_since_draw) == (4, 1)
  table = band_agreement(band, ("llm", "m-1", False), ("agent", "a-2", False))
  assert table.n == 4 and table.interval is not None

def test_papers_of_sessions_not_given_are_not_found(self):
  session = self._session([("discarded", "discarded")] * 3)
  session.llm_samples[0].size = 5
  [band] = sample_bands([session], "s-1")
