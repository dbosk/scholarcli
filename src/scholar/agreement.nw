def double_screening_sentences(decisions) -> list[str]:
    """The report's sentences on the double screen; [] without one."""
    decisions = list(decisions)
    overview = ScreeningOverview.of(decisions)
    if overview is None or not (
        overview.profiles or overview.unknown_origin
    ):
        return []
    again = overview.screened_again
    sentences = [
        f"{again} of the {len(decisions)} "
        f"{'decision' if len(decisions) == 1 else 'decisions'} "
        f"{'was' if again == 1 else 'were'} screened a second time."
    ]
    <<say which screenings are no second screen, and the sample>>
    sentences += [
        screener_sentence(overview.profiles[screener])
        for screener in sorted(overview.profiles, key=_screener_order)
    ]
    for a, b in overview.pairs:
        sentences += pair_sentences(overview, a, b)
    if overview.pairs:
        sentences.append(interpretive_sentences(
            screening_agreement(overview.verdicts, *overview.pairs[0])
        )[1])
        sentences += conflict_sentences(overview)
    if overview.unknown_origin:
        sentences.append(
            f"{overview.unknown_origin} verdict(s) of unknown origin were "
            "not compared."
        )
    return sentences
