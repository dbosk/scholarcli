def agreement_data(table: AgreementTable, *, sample: bool = False) -> dict:
    """One table's numbers as JSON."""
    data = {
        "question": table.question,
        "labels": list(table.labels),
        "cells": [list(row) for row in table.cells],
        "n": table.n,
        "agreeing": table.agreeing,
        "observed_agreement": table.observed,
        "without_category": table.without_category,
    }
    if table.is_binary:
        data.update(
            positive_agreement=table.positive_agreement,
            negative_agreement=table.negative_agreement,
            kappa=table.kappa,
            kappa_undefined_reason=table.kappa_undefined_reason,
            prevalence_index=table.prevalence_index,
            bias_index=table.bias_index,
        )
    if sample:
        data["interval"] = (
            list(table.interval) if table.interval is not None else None
        )
    return data
