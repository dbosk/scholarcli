@staticmethod
def _without_the_double_screen(monkeypatch):
  import scholar.agreement as agreement
  monkeypatch.setattr(agreement, "double_screening_sentences",
                      lambda decisions: [])
  monkeypatch.setattr(agreement, "summary_rows",
                      lambda decisions, minus="-": [])
  monkeypatch.setattr(agreement, "audit_screening_sentence",
                      lambda *args, **kwargs: "")

def test_the_three_functions_give_nothing(self):
  from scholar.review import AUDIT_STRINGS
  decisions = _surface_session(False).decisions
  assert double_screening_sentences(decisions) == []
  assert summary_rows(decisions) == []
  for lang in ("en", "sv"):
    assert audit_screening_sentence(decisions, AUDIT_STRINGS[lang]) == ""

def test_report(self, tmp_path, monkeypatch):
  from scholar.review import generate_latex_report
  # The report names its .bib file after itself, so both get one name.
  for folder in ("with", "without"):
    (tmp_path / folder).mkdir()
  generate_latex_report(_surface_session(False),
                        tmp_path / "with" / "r.tex")
  self._without_the_double_screen(monkeypatch)
  generate_latex_report(_surface_session(False),
                        tmp_path / "without" / "r.tex")
  report = (tmp_path / "with" / "r.tex").read_text()
  assert report == (tmp_path / "without" / "r.tex").read_text()
  assert "Double screening" not in report

def test_csv_has_no_column_for_screenings(self, tmp_path):
  import csv
  from scholar.review import generate_csv_report
  generate_csv_report(_surface_session(False), tmp_path / "r.csv")
  with open(tmp_path / "r.csv", newline="") as handle:
    header = next(row for row in csv.reader(handle)
                  if row and not row[0].startswith("#"))
  assert not [name for name in header if "screen" in name.lower()]

def test_synthesis_summary_in_both_formats(self, monkeypatch):
  from scholar.llm_review import (
    build_research_question_section_latex,
    build_research_question_section_markdown,
  )
  session = _surface_session(False)
  markdown = build_research_question_section_markdown(session, 2, 2)
  latex = build_research_question_section_latex(session, 2, 2)
  self._without_the_double_screen(monkeypatch)
  assert markdown == build_research_question_section_markdown(session, 2, 2)
  assert latex == build_research_question_section_latex(session, 2, 2)

