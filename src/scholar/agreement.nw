@staticmethod
def _confirmed(i, status, agent, source=ReviewSource.LLM_REVIEWED):
  decision = ReviewDecision(
    paper=Paper(title=f"C{i}", authors=["A"], doi=f"10.5555/asym-{i}"),
    provider="p", status=status, tags=["off-topic-false-hit"],
