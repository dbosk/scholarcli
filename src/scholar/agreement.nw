class TestAgreementTable:
  """The measures against the sources' worked numbers (#253)."""

  <<agreement table test methods>>

<<agreement table test methods>>=
def _table(self, x11, x12, x21, x22):
  return AgreementTable(
    ("llm", "m", False), ("agent", "a", False), "status",
                        ("kept", "discarded"), ((x11, x12), (x21, x22)))

def test_shankar_and_bangdiwala_scenarios(self):
  for cells, (po, pe, kappa, bi, pi) in {
    (40, 9, 6, 45): (0.85, 0.50, 0.70, 0.03, -0.05),
    (80, 10, 5, 5): (0.85, 0.78, 0.32, 0.05, 0.75),
    (90, 5, 5, 0): (0.90, 0.905, -0.05, 0.0, 0.90),
    (45, 15, 25, 15): (0.60, 0.54, 0.13, -0.10, 0.30),
  }.items():
    table = self._table(*cells)
    assert table.n == 100
    assert table.observed == pytest.approx(po)
    assert round(table.chance_agreement, 3) == pytest.approx(pe, abs=5e-3)
    assert round(table.kappa, 2) == pytest.approx(kappa)
    assert table.bias_index == pytest.approx(bi)
    assert table.prevalence_index == pytest.approx(pi)

def test_tan_specific_agreement(self):
  lepidic = self._table(18, 5, 4, 23)
  assert lepidic.positive_agreement == pytest.approx(18 / 22.5)
  assert lepidic.negative_agreement == pytest.approx(23 / 27.5)
  acinar = self._table(41, 6, 0, 3)
  assert acinar.positive_agreement == pytest.approx(41 / 44)
  assert acinar.negative_agreement == pytest.approx(3 / 6)
