                        at="2020-01-01T12:00:00+00:00")
  record_screening(decision, new_screening(
    kind="agent", name="a-2", status=agent,
    tags=["off-topic-false-hit"], recorded_at="2020-01-02T00:00:00+00:00"))
  return decision

def _decisions(self):
  kept, discarded = DecisionStatus.KEPT, DecisionStatus.DISCARDED
  cells = ([(kept, "kept")] + [(discarded, "kept")] * 2
           + [(discarded, "discarded")] * 4)
  return [self._confirmed(i, status, agent)
          for i, (status, agent) in enumerate(cells)]

