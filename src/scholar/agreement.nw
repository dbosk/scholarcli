def conflict_sentences(overview: "ScreeningOverview") -> list[str]:
    """The report's sentences on the conflicts and their resolution."""
    counts = overview.conflict_counts()
    status, resolved = counts["status"], counts["status_resolved"]
    if status == 1:
        settled = (
            ", and it was resolved by a human who decided after the "
            "latest screening" if resolved
            else ", and it is unresolved"
        )
    elif status:
        settled = (f", {resolved} of them resolved by a human who decided "
                   "after the latest screening")
    else:
        settled = ""
    sentences = [
        f"{status} {_records(status)} had a status conflict{settled}; "
        f"{counts['category_only']} had conflicts on the category only."
    ]
    for (a, b, kind), tally in sorted_outcomes(
        resolved_outcomes(overview.conflicts)
    ):
        sentences.append(outcome_line(
            overview.profiles[a].label, overview.profiles[b].label, kind,
            tally,
        ))
    return sentences
@

