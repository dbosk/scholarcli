  assert overview.lines() == [
    "Double screening: llm (m-1) vs agent (a-2): 2 records, "
    "kept/discarded agreement 50.0 %, kappa undefined (one screener "
    "gave only one verdict); 1 status conflicts (1 resolved)",
    "Screening conflicts: 1 status (1 resolved by a human), "
    "0 category only",
  ]
  [pair] = overview.data()["pairs"]
  assert pair["status"]["cells"] == [[0, 0], [1, 1]]
  assert pair["status"]["kappa"] is None

def test_nothing_without_screenings(self):
  plain = ReviewDecision(paper=Paper(title="X", authors=["A"]),
                         provider="p")
  assert ScreeningOverview.of([plain]) is None
