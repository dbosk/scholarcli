<<pdf import functions>>=
def read_import_record(pdf_path: Path) -> dict:
    """The import record of `pdf_path`, or {} if it cannot be read."""
    try:
        return json.loads(import_record_path(pdf_path).read_text())
    except (OSError, ValueError) as error:
        logger.warning(
            "Cannot read the import record of %s: %s", pdf_path.name, error
        )
        return {}


def list_imported_pdfs() -> list[tuple[Path, dict]]:
    """The imported PDFs in the cache with their records, oldest first."""
    imported = [
        (pdf_file, read_import_record(pdf_file))
        for pdf_file in get_pdf_cache_dir().glob("*.pdf")
        if import_record_path(pdf_file).exists()
    ]
    imported.sort(
        key=lambda item: (item[1].get("imported_at") or "", item[0].name)
    )
    return imported
