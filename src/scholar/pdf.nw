on_disk = [get_cached_doi_pdf_path(doi)] if doi else []
if url:
    on_disk.append(get_cached_pdf_path(url))
for path in on_disk:
    if usable_cached_pdf(path, warn=False):
        logger.debug("PDF on disk for %s: %s", paper_title, path.name)
        if progress_callback:
            progress_callback(f"Using cached PDF: {path}")
