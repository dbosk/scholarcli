class TestUnreadablePDF:
  def test_an_unreadable_pdf_is_a_one_line_failure(
    self, tmp_path, monkeypatch
  ):
    bad = tmp_path / "bad.pdf"
    bad.write_bytes(make_pdf(tmp_path / "p.pdf").read_bytes()[:200])
    monkeypatch.setattr("scholar.pdf.get_pdf", lambda *a, **k: bad)
    assert find_quote_candidates("https://x/p.pdf", "c", use_llm=False) == []
    with pytest.raises(PDFUnreadableError) as error:
      find_quote_candidates(
        "https://x/p.pdf", "c", use_llm=False, raise_errors=True
      )
    assert "cannot read the PDF" in str(error.value)
    assert "\n" not in str(error.value)
