class PDFImportError(Exception):
    """A file that `import_pdf` refuses; the message says why."""


@dataclass
class PDFImport:
    """
    The outcome of `import_pdf`.

    `status` is "imported", "replaced", "recorded" (same content was
    cached, without a record) or "unchanged" (same content, already
    imported).
    """

    path: Path
    record: dict
    status: str


def import_pdf(
    file: str | os.PathLike,
    *,
    url: str | None = None,
    doi: str | None = None,
    source: str | None = None,
    replace: bool = False,
) -> PDFImport:
    """
    Copy a local PDF into the cache under the key of `url` or `doi`.

    The file is checked to be a PDF, copied (never moved) and recorded
    with its SHA-256, size, import time, base name, `source` and the
    URL or DOI given. A different PDF already cached under the key is
    replaced only with `replace`.

    Raises:
        ValueError: Unless exactly one of `url` and `doi` is given.
        PDFImportError: If the file cannot be read, is not a PDF, the
            DOI is not one, or another PDF is cached under the key.
    """
    <<choose the key of an import>>
    <<read and check the file to import>>
    record = {
        "sha256": digest,
        "size": len(data),
        "imported_at": utc_now_iso(),
        "file_name": Path(file).name,
        "from": source,
        "url": url,
        "doi": doi,
    }
    record_path = import_record_path(cache_path)
    with file_lock(cache_path):
        <<compare with the copy already cached>>
        atomic_write_text(record_path, json.dumps(record, indent=2) + "\n")
        atomic_write_bytes(cache_path, data)
    logger.info("Imported %s as %s", record["file_name"], cache_path.name)
    return PDFImport(cache_path, record, status)
