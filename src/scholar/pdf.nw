class TestImportsUnderTheWrittenKey:
  """PDFs imported by a doi.org URL before it was decoded (#304)."""

  URL = "https://doi.org/10.5555/(SICI)abc;2-%23"
  WRITTEN = "10.5555/(SICI)abc;2-%23"

  def _old_import(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
    pdf = make_pdf(tmp_path / "paper.pdf", text="old import")
    old = import_pdf(pdf, doi=self.WRITTEN).path
    assert old != get_cached_doi_pdf_path(extract_doi(self.URL))
    return pdf, old

  @staticmethod
  def _pdfs():
    return sorted(get_pdf_cache_dir().glob("*.pdf"))

  def test_the_lookups_find_it_without_a_request(
    self, tmp_path, monkeypatch
  ):
    _, old = self._old_import(tmp_path, monkeypatch)
    with patch("scholar.pdf.requests.get",
               side_effect=AssertionError("no request")):
      assert get_pdf(self.URL) == old
      assert download_doi_pdf(extract_doi(self.URL),
                              written=self.WRITTEN) == old

  def test_importing_it_again_keeps_one_copy(self, tmp_path, monkeypatch):
    pdf, old = self._old_import(tmp_path, monkeypatch)
    again = import_pdf(pdf, url=self.URL)
    assert (again.status, again.path) == ("unchanged", old)
    other = make_pdf(tmp_path / "other.pdf", text="another file")
    with pytest.raises(PDFImportError, match="--replace"):
      import_pdf(other, url=self.URL)
    replaced = import_pdf(other, url=self.URL, replace=True)
    assert (replaced.status, replaced.path) == ("replaced", old)
    assert self._pdfs() == [old]

  def test_a_new_import_takes_the_decoded_key(self, tmp_path, monkeypatch):
    monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path / "cache"))
    pdf = make_pdf(tmp_path / "paper.pdf")
    outcome = import_pdf(pdf, url=self.URL)
    assert outcome.path == get_cached_doi_pdf_path("10.5555/(SICI)abc;2-#")
    assert doi_pdf_paths(extract_doi(self.URL), self.WRITTEN)[0] \
      == outcome.path
