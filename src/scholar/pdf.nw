The comparison hashes the cached copy under the lock, so it judges the
copy the rename would replace.

<<compare with the copy already cached>>=
status = "imported"
if cache_path.exists():
    cached = file_sha256(cache_path)
    if cached == digest:
        if record_path.exists():
            return PDFImport(
                cache_path, import_record_of(cache_path), "unchanged",
                warnings,
            )
        atomic_write_text(record_path, json.dumps(record, indent=2) + "\n")
        return PDFImport(cache_path, record, "recorded", warnings)
    if not replace and not pdf_file_problem(cache_path):
        kind = "an imported" if record_path.exists() else "a downloaded"
        raise PDFImportError(
            f"{kind} PDF with other content is cached for this key "
            f"(sha256 {cached}); pass --replace to overwrite it"
        )
    status = "replaced"
