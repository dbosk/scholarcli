        raw = "<jats:p>one<jats:break/>two</jats:p><jats:p>three</jats:p>"
        assert markup_to_text(raw) == "one two three"

    def test_html_blocks_are_separated(self):
        raw = "<h4>Background</h4>Why.<br/>How.<p>More.</p>"
        assert markup_to_text(raw) == "Background Why. How. More."

    def test_inline_elements_leave_no_space(self):
