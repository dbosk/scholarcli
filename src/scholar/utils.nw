class TestFileLock:
    """file_lock serialises read-modify-writes of one file."""

    def test_a_second_writer_waits(self, tmp_path):
        import threading

        target = tmp_path / "s.json"
        events = []

        def second():
            with file_lock(target):
                events.append("second")

        with file_lock(target) as locked:
            assert locked
            thread = threading.Thread(target=second)
            thread.start()
            thread.join(0.3)
            events.append("first")
        thread.join(5)
        assert events == ["first", "second"]

    def test_reentrant_and_hidden(self, tmp_path):
        target = tmp_path / "s.json"
        with file_lock(target) as outer:
            with file_lock(target) as inner:
                assert outer and inner
        assert lock_path(target).name == ".s.json.lock"
        assert not list(tmp_path.glob("*.json"))

    def test_gives_up_with_a_warning(self, tmp_path, caplog):
        import threading

        target = tmp_path / "s.json"
        holding, release = threading.Event(), threading.Event()

        def holder():
            with file_lock(target):
                holding.set()
                release.wait(5)

        thread = threading.Thread(target=holder)
        thread.start()
        holding.wait(5)
        try:
            with file_lock(target, timeout=0.1) as locked:
                assert not locked
        finally:
            release.set()
            thread.join(5)
        assert "writing without the lock" in caplog.text
