import logging
import threading

from filelock import FileLock, Timeout

LOCK_TIMEOUT = 10  # seconds; holders keep the lock for milliseconds

_FILE_LOCKS: dict[Path, FileLock] = {}
_FILE_LOCKS_GUARD = threading.Lock()


def lock_path(path: str | os.PathLike) -> Path:
    """Return the lock file `file_lock(path)` uses: `.<name>.lock`."""
    path = Path(path)
    return path.with_name(f".{path.name}.lock")


class LockNotTaken(Exception):
    """`file_lock(..., required=True)` could not take its lock.

    `path` is the file the lock protects; `reason` says why, in a few
    words ("still locked after 300 s"); `held` is True when another
    holder kept the lock, False when the lock file `lock_file` could not
    be opened or created.
    """

    def __init__(
        self, path: str | os.PathLike, reason: str, *, held: bool,
        lock_file: str | os.PathLike,
    ) -> None:
        super().__init__(f"{path}: {reason}")
        self.path = Path(path)
        self.reason = reason
        self.held = held
        self.lock_file = Path(lock_file)


@contextmanager
def file_lock(
    path: str | os.PathLike, timeout: float | None = None, *,
    required: bool = False, notice_after: float | None = None,
    notice_every: float | None = None, notice_hint: str = "",
) -> Iterator[bool]:
    """Hold an exclusive lock on `path` for one read-modify-write.

    Yields True while the lock is held, or False if it could not be
    taken within `timeout` seconds (default `LOCK_TIMEOUT`) or the lock
    file cannot be created; the body then runs unlocked. With
    `required`, it raises `LockNotTaken` instead and the body does not
    run. With `notice_after`, a wait longer than that many seconds is
    logged, naming `path`, and again every `notice_every` seconds;
    `notice_hint` is added to each such line.
    """
    if timeout is None:
        timeout = LOCK_TIMEOUT
    target = lock_path(path).absolute()
    with _FILE_LOCKS_GUARD:
        lock = _FILE_LOCKS.setdefault(target, FileLock(target))
    try:
        <<take [[lock]] within [[timeout]], saying when the wait is long>>
    except Timeout:
        if required:
            raise LockNotTaken(
                path, f"still locked after {timeout:g} s", held=True,
                lock_file=target,
            )
        logging.getLogger(__name__).warning(
            "%s is still locked after %g s; writing without the lock",
            path, timeout,
        )
        yield False
        return
    except OSError as error:
        if required:
            raise LockNotTaken(
                path, f"cannot open the lock file {target}: {error}",
                held=False, lock_file=target,
            ) from error
        logging.getLogger(__name__).debug(
            "Cannot lock %s (%s); writing without the lock", path, error
        )
        yield False
        return
    try:
        yield True
    finally:
        lock.release()
