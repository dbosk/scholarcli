        assert clean_metadata_text("Café résumé") \
            == "Café résumé"

    def test_clean_paper_text_in_place(self):
        paper = Paper(title="A &amp; <b>B</b>", authors=["X"],
                      venue="J &lt;3", abstract="<i>fine</i>")
        assert clean_paper_text(paper) is paper
        assert (paper.title, paper.venue, paper.abstract) \
            == ("A & B", "J <3", "fine")
