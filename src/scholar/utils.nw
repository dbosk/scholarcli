def test_the_sticky_bit_rule(self):
    import stat

    def status(mode, uid):
        return os.stat_result((mode, 0, 0, 1, uid, 0, 0, 0, 0, 0))

    sticky_dir = status(stat.S_IFDIR | 0o1777, 0)
    plain_dir = status(stat.S_IFDIR | 0o777, 0)
    theirs = status(stat.S_IFREG | 0o644, 2000)
    mine = status(stat.S_IFREG | 0o644, 1000)
    assert sticky_refuses(sticky_dir, theirs, 1000)
    assert not sticky_refuses(sticky_dir, mine, 1000)
    assert not sticky_refuses(plain_dir, theirs, 1000)
    assert not sticky_refuses(sticky_dir, theirs, 0)
