class TestRequiredFileLock:
    """file_lock(required=True) raises instead of running unlocked."""

    def test_refuses_after_the_timeout_and_says_it_waits(
        self, tmp_path, caplog
    ):
        import threading

        target = tmp_path / "s.json"
        holding, release = threading.Event(), threading.Event()
        ran = []

        def holder():
            with file_lock(target):
                holding.set()
                release.wait(5)

        thread = threading.Thread(target=holder)
        thread.start()
        holding.wait(5)
        try:
            with pytest.raises(LockNotTaken) as raised:
                with file_lock(target, timeout=0.3, required=True,
                               notice_after=0.1):
                    ran.append(True)
        finally:
            release.set()
            thread.join(5)
        assert ran == []
        assert raised.value.path == target
        assert raised.value.reason == "still locked after 0.3 s"
        notices = [r for r in caplog.records
                   if "locked by another scholar process" in r.message]
        assert len(notices) == 1 and str(target) in notices[0].message
        assert raised.value.held
        assert "writing without the lock" not in caplog.text

    def test_the_notice_repeats_with_its_hint(self, tmp_path, caplog):
        import threading

        target = tmp_path / "s.json"
        holding, release = threading.Event(), threading.Event()

        def holder():
            with file_lock(target):
                holding.set()
                release.wait(5)

        thread = threading.Thread(target=holder)
        thread.start()
        holding.wait(5)
        try:
            with pytest.raises(LockNotTaken):
                with file_lock(target, timeout=0.5, required=True,
                               notice_after=0.1, notice_every=0.15,
                               notice_hint="; press Ctrl-C to stop"):
                    pass
        finally:
            release.set()
            thread.join(5)
        assert [r.message for r in caplog.records] == [
            f"{target} is locked by another scholar process; waited "
            f"{waited} s, waiting up to {left} s more; press Ctrl-C to stop"
            for waited, left in ((0.1, 0.4), (0.25, 0.25), (0.4, 0.1))
        ]

    def test_a_free_lock_is_taken_at_once(self, tmp_path, caplog):
        with file_lock(tmp_path / "s.json", timeout=0.3, required=True,
                       notice_after=0.1) as locked:
            assert locked
        assert caplog.text == ""

    def test_a_lock_file_that_cannot_be_made_is_refused(self, tmp_path):
        read_only = tmp_path / "read-only"
        read_only.mkdir(mode=0o500)
        try:
            with pytest.raises(LockNotTaken) as raised:
                with file_lock(read_only / "s.json", required=True):
                    pass
        finally:
            read_only.chmod(0o700)
        assert not raised.value.held
        assert raised.value.reason.startswith(
            f"cannot open the lock file {lock_path(read_only / 's.json')}"
        )
