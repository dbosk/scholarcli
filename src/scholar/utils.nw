NAMES = ("a.csv", "b.tex", "c.txt")

def _content(self, out_dir):
    """Every entry of `out_dir`: file bytes, or "dir" for a directory."""
    return {
        p.name: "dir" if p.is_dir() else p.read_bytes()
        for p in out_dir.iterdir()
    }

def _export(self, out_dir, remove=()):
    with staged_outputs(out_dir, remove=remove) as staging:
        for name in self.NAMES:
            (staging / name).write_text(f"new {name}")

def _fail_on(self, monkeypatch, failing):
    """Make `os.replace` raise for the renames `failing` picks."""
    import scholar.utils as utils

    real_replace = os.replace

    def replace(source, target):
        if failing(Path(source), Path(target)):
            raise OSError(28, "No space left on device")
        return real_replace(source, target)

    monkeypatch.setattr(utils.os, "replace", replace)

def test_a_directory_at_the_second_target_moves_nothing(self, out_dir):
    for name in ("a.csv", "c.txt"):
        (out_dir / name).write_text(f"old {name}")
    (out_dir / "b.tex").mkdir()
    before = self._content(out_dir)
    with pytest.raises(OutputsNotPlaced) as caught:
        self._export(out_dir)
    assert self._content(out_dir) == before
    assert not caught.value.changed
    assert not caught.value.rolled_back
    assert caught.value.old == [out_dir / name for name in self.NAMES]
    assert "b.tex is a directory" in str(caught.value)

