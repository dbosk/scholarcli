A 404 leaves [[None]] in both entries: Crossref has no record, so it
holds neither notices nor an abstract for the DOI.
The abstract entry keeps the text as Crossref sent it, markup and all,
and the text is cleaned when it is read (\cref{sec:crossref-abstract});
how it is cleaned can then change without asking Crossref again.

<<crossref client methods>>=
def _remember_work(self, doi: str, message: dict | None) -> None:
    """Cache the currency result and the raw abstract of `doi`'s record.

    `message` is the work record, or None when Crossref has none.
    """
    currency = None
    abstract = None
    if message is not None:
        currency = {
            "updated_by": _normalize_updated_by(message),
            "newer_versions": _normalize_newer_versions(message),
            "preprints": _normalize_preprints(message),
        }
        raw = message.get("abstract")
        abstract = raw if isinstance(raw, str) and raw.strip() else None
    self._cache[("currency", CURRENCY_CACHE_VERSION, doi)] = currency
    self._cache[abstract_cache_key(doi)] = abstract
@

