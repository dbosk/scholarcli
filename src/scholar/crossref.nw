\subsection{Reducing a paper to a status}

Both the [[verify]] report and the [[enrich]] warnings need the same one-word
summary of a paper's currency, so we define it once here rather than in the CLI.
The order of the checks encodes severity: a retraction outranks a correction,
which outranks mere supersession.  Only once those are ruled out do we
distinguish a checked-clean paper (\enquote{ok}) from one we never managed to
check (\enquote{unknown}), using the [[None]]-versus-empty distinction the
[[Paper]] model preserves for exactly this purpose.

Supersession needs one refinement.  An entry that \emph{is} an adopted
preprint (\cref{preprint-module}) will be reported by Crossref as
[[is-preprint-of]] its published version---which is precisely the
substitution the user chose, recorded in [[published_versions]].
Flagging it \enquote{superseded} would make every deliberate adoption
look like a stale citation.  When the newer versions Crossref reports
are exactly the recorded published versions (compared as normalized
DOIs), we report the distinct status \enquote{preprint} instead;
a newer version \emph{beyond} those still warns as superseded.
Retractions and corrections are never softened this way: a retracted
work is retracted no matter which version we cite.

<<module-level currency interface>>=
def currency_status(paper: Paper) -> str:
    """Summarize a paper's currency as one of six status words.

    Returns ``"retracted"``, ``"corrected"``, ``"superseded"``,
    ``"preprint"`` (a deliberately adopted preprint of a published
    version), ``"ok"`` (checked, no issues), or ``"unknown"`` (never
    successfully checked).
    """
    if paper.is_retracted:
        return "retracted"
    if paper.is_corrected:
        return "corrected"
    if paper.is_superseded:
        if _is_adopted_substitution(paper):
            return "preprint"
        return "superseded"
    if paper.updated_by is None and paper.newer_versions is None:
        return "unknown"
    return "ok"


def _is_adopted_substitution(paper: Paper) -> bool:
    """Whether all reported newer versions are recorded adoptions."""
    recorded = {
        Paper._normalize_doi(entry["doi"])
        for entry in paper.published_versions or []
        if entry.get("doi")
    }
    if not recorded:
        return False
    reported = {
        Paper._normalize_doi(version["doi"])
        for version in paper.newer_versions or []
        if version.get("doi")
    }
    return bool(reported) and reported <= recorded
@

<<test functions>>=
class TestCurrencyStatus:
    """Tests for currency_status precedence and the ok/unknown split."""

    def test_retraction_outranks_correction(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[{"type": "retraction"}, {"type": "correction"}],
        )
        assert currency_status(paper) == "retracted"

    def test_checked_clean_is_ok(self):
        paper = Paper(title="T", authors=["a"], updated_by=[], newer_versions=[])
        assert currency_status(paper) == "ok"

    def test_unchecked_is_unknown(self):
        paper = Paper(title="T", authors=["a"])
        assert currency_status(paper) == "unknown"

    def test_superseded_when_only_newer_versions(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[],
            newer_versions=[{"doi": "10.1/v2", "relation": "is-preprint-of"}],
        )
        assert currency_status(paper) == "superseded"

    def test_adopted_preprint_is_not_superseded(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[],
            newer_versions=[
                {"doi": "10.1/Published", "relation": "is-preprint-of"}
            ],
            published_versions=[
                {"doi": "10.1/published", "relation": "preprint-of"}
            ],
        )
        assert currency_status(paper) == "preprint"

    def test_newer_version_beyond_adoption_still_warns(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[],
            newer_versions=[
                {"doi": "10.1/published", "relation": "is-preprint-of"},
                {"doi": "10.1/other", "relation": "is-version-of"},
            ],
            published_versions=[
                {"doi": "10.1/published", "relation": "preprint-of"}
            ],
        )
        assert currency_status(paper) == "superseded"
