class TestCheckFailures:
    """A failed check is counted, and the paper stays unchecked (#259)."""

    BUNDLE = "/nonexistent/scholar-test/ca.pem"

    def test_broken_tls_setup(self, monkeypatch):
        monkeypatch.setenv("REQUESTS_CA_BUNDLE", self.BUNDLE)
        papers = [
            Paper(title="A", authors=["x"], doi="10.1/tls-a"),
            Paper(title="B", authors=["x"], doi="10.1/tls-b"),
            Paper(title="C", authors=["x"]),
        ]
        failures = Counter()
        done = []
        out = annotate_papers(
            papers,
            progress_callback=noting_failures(
                failures, lambda d, t: done.append(d)
            ),
        )
        assert [p.updated_by for p in out] == [None, None, None]
        assert done == [1, 2, 3]
        [(reason, count)] = failures.items()
        assert count == 2
        assert reason.startswith(
