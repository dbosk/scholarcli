# Recorded 2026-11-20: headers of an anonymous (no mailto) answer from
# https://api.crossref.org/works/10.7717%2Fpeerj.4375, the rate ones only.
RECORDED_ANONYMOUS_HEADERS = {
    "x-rate-limit-limit": "5",
    "x-rate-limit-interval": "1s",
    "x-concurrency-limit": "1",
}


@pytest.fixture
def refusing_server(monkeypatch):
    """A loopback server answering every request with HTTP 429."""
    import http.server
    import threading

    import scholar.crossref

    seen = []

    class Refuser(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            seen.append(self.path)
            self.send_response(429)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Refuser)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    monkeypatch.setattr(
        scholar.crossref, "CROSSREF_WORKS_URL",
        f"http://127.0.0.1:{server.server_port}/works",
    )
    yield seen
    server.shutdown()


class TestCrossrefPools:
    """The client paces at its pool's documented rate (#270)."""

    def _fetch(self, doi):
        response = _mock_response(200, {})
        response.headers = dict(RECORDED_ANONYMOUS_HEADERS)
        with patch.object(_client._session, "get", return_value=response):
            fetch_currency(doi)
        return _client._limiter.limits.per_second

    def test_anonymous_rate_is_the_announced_one(self):
        limit = int(RECORDED_ANONYMOUS_HEADERS["x-rate-limit-limit"])
        interval = float(
            RECORDED_ANONYMOUS_HEADERS["x-rate-limit-interval"].rstrip("s")
        )
        assert self._fetch("10.1/anonymous") == limit / interval

    def test_polite_rate_with_an_address(self, monkeypatch):
        monkeypatch.setenv("CROSSREF_MAILTO", "test@example.org")
        assert self._fetch("10.1/polite") == 10.0
        monkeypatch.delenv("CROSSREF_MAILTO")
        assert self._fetch("10.1/anonymous-again") == 5.0

    def test_a_429_starts_a_cooldown_the_next_lookup_respects(
        self, refusing_server,
    ):
        from scholar import ratelimit

        assert fetch_currency("10.1/first") is None
        assert last_lookup_error() == "rate limited (HTTP 429)"
        assert len(refusing_server) == 1
        assert not ratelimit.check_available("crossref").ok
        assert fetch_abstract("10.1/second") is None
        assert last_lookup_error()
        assert len(refusing_server) == 1
