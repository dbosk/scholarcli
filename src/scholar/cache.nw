def test_loopback_stays_reachable(block_network):
    """Local sockets are not network access."""
    import socket

    server = socket.socket()
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    try:
        client = socket.create_connection(server.getsockname(), timeout=1)
        client.close()
    finally:
        server.close()
    assert block_network == []


