Let's verify that a clear waits for a save in progress.
A second thread plays the saving process and holds the file's lock;
[[file_lock]] excludes threads of one process as it excludes processes
(\cref{sec:file-lock}).
While it holds the lock the file must survive, and once it lets go the
clear must go ahead.

<<test functions>>=
def test_clear_cache_waits_for_a_save_in_progress():
    """clear_cache deletes a file only under its lock."""
    save_cache("scopus", {"a": 1})
    cache_file = get_cache_dir() / "scopus.pkl"
    holding, release = threading.Event(), threading.Event()

    def save_in_progress():
        with file_lock(cache_file):
            holding.set()
            release.wait(timeout=10)

    saver = threading.Thread(target=save_in_progress)
    saver.start()
    assert holding.wait(timeout=10)
    clearer = threading.Thread(target=clear_cache)
    clearer.start()
    clearer.join(timeout=0.5)
    waited = clearer.is_alive() and cache_file.exists()
    release.set()
    saver.join(timeout=10)
    clearer.join(timeout=10)
    assert waited
    assert not cache_file.exists()
