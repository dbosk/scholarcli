        monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path))
        first, second = load_cache("meta_two"), load_cache("meta_two")
        remember_fetch(first, ("a", 1, ""), fetched_at="by first")
        remember_fetch(second, ("b", 1, ""), fetched_at="by second")
        save_cache("meta_two", first)
        save_cache("meta_two", second)
        loaded = load_cache("meta_two")
        assert fetch_meta(loaded, ("a", 1, "")) == {"fetched_at": "by first"}
        assert fetch_meta(loaded, ("b", 1, "")) == {"fetched_at": "by second"}
