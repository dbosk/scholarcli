class TestSaveMergesWithTheFile:
    """A save adds to the file; unchanged caches are not saved (#175)."""

    def test_keeps_entries_another_process_wrote(self, monkeypatch):
        cache = load_cache("openalex")
        save_cache("openalex", {"theirs": 1})
        cache["ours"] = 2
