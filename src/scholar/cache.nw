Let's check the stand-in itself: what a client sends arrives as sent,
a host not named still meets the guard, and the decoding helpers give
back a percent-encoded path and the query parameters.

<<test functions>>=
def test_request_targets_keeps_what_was_sent(request_targets):
    """The target arrives as the client wrote it, encoding and all."""
    import requests

    request_targets.serve("service.example")
    response = requests.get(
        "https://service.example/a%23b/c", params={"q": "x y"}
    )
    assert response.status_code == 404
    assert request_targets.targets == ["/a%23b/c?q=x+y"]
    assert request_targets.paths() == ["/a#b/c"]
    assert request_targets.queries() == [{"q": ["x y"]}]


def test_request_targets_leaves_other_hosts_to_the_guard(
    request_targets, block_network
):
    """A host the test did not name is not served."""
    import requests

    request_targets.serve("service.example")
    with pytest.raises(requests.exceptions.ConnectionError):
        requests.get("https://other.example/x", timeout=1)
    assert request_targets.targets == []
    assert "other.example" in block_network
    block_network.clear()
