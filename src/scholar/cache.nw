Unsetting variables removes the known ways a test reaches the network,
but not the unknown ones.
Three keyless providers (OpenAlex, arXiv and anonymous Semantic Scholar)
answer without any configuration, so a test that forgets one mock still
goes online---as [[TestEnrichmentCache]] did, through the enrichment
lookups of every reference it \enquote{fetched}.
And because providers swallow their errors and return an empty list,
such a leak never fails a test: it only
makes it slow, flaky and expensive.

So the suite enforces the rule instead of hoping for it.
For every test except the live ones, the [[block_network]] fixture
replaces name resolution and [[socket.connect]] with versions that refuse
anything but the loopback interface and Unix sockets, and records each
refused destination.
Refusing alone would be swallowed like any other error, so the fixture
also fails the test at teardown when anything was refused, naming the
hosts.
Loopback stays open because nothing on it is a real service (the TUI's
event loop, for one, uses a local socket pair).
A test that probes the guard itself requests the fixture and empties the
returned list once it has checked it.

<<[[conftest.py]]>>=


def is_local_address(address):
    """Return whether a socket address is a Unix socket or loopback."""
    if isinstance(address, (str, bytes)):
        return True
    host = address[0]
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


@pytest.fixture(autouse=True)
def block_network(request, monkeypatch):
    """Refuse and report network access outside the loopback interface.

    Yields the list of refused destinations; the test fails at teardown
    unless the list is empty by then.  Live integration tests are exempt.
    """
    refused = []
    if is_live_test(request):
        yield refused
        return
    real_connect = socket.socket.connect
    real_connect_ex = socket.socket.connect_ex
    real_getaddrinfo = socket.getaddrinfo

    def refuse(destination):
        refused.append(destination)
        return OSError(f"unit tests may not reach the network: {destination}")

    def connect(self, address):
        if not is_local_address(address):
            raise refuse(address)
        return real_connect(self, address)

    def connect_ex(self, address):
        if not is_local_address(address):
            refuse(address)
            return 111  # ECONNREFUSED
        return real_connect_ex(self, address)

    def getaddrinfo(host, *args, **kwargs):
        if host is not None and not is_local_address((host,)):
            raise refuse(host)
        return real_getaddrinfo(host, *args, **kwargs)

    monkeypatch.setattr(socket.socket, "connect", connect)
    monkeypatch.setattr(socket.socket, "connect_ex", connect_ex)
    monkeypatch.setattr(socket, "getaddrinfo", getaddrinfo)
    yield refused
    if refused:
        pytest.fail(
            "test tried to reach the network (mock it): "
            + ", ".join(sorted({str(dest) for dest in refused}))
        )
@

