def test_unit_tests_cannot_reach_the_network(block_network):
    """A connection to a real host is refused and recorded."""
    import socket

    with pytest.raises(OSError):
        socket.create_connection(("example.org", 80), timeout=1)
    assert "example.org" in block_network
