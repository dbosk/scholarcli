        cache["key"] = "ours"
        save_cache("openalex", cache)
        assert load_cache("openalex") == {"key": "ours", "other": 1}

    def test_unchanged_cache_is_not_rewritten(self, monkeypatch):
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        save_cache("crossref", {"10.1/x": {"retracted": False}})
        cache_file = get_cache_dir() / "crossref.pkl"
        os.utime(cache_file, ns=(10**18, 10**18))
        register_cache("crossref", load_cache("crossref"))
        save_all_caches()
        assert cache_file.stat().st_mtime_ns == 10**18

    def test_an_update_is_saved(self, monkeypatch):
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        cache = load_cache("crossref")
        register_cache("crossref", cache)
        cache.update({"10.1/y": {"retracted": True}})
        save_all_caches()
        assert load_cache("crossref") == {"10.1/y": {"retracted": True}}

    def test_unreadable_file_at_save_is_kept(self, monkeypatch):
        """A file damaged after our load is not replaced either."""
        cache = load_cache("hal")
        cache_file = get_cache_dir() / "hal.pkl"
        cache_file.write_bytes(TRUNCATED_PICKLE)
        cache["ours"] = 1
        save_cache("hal", cache)
        assert cache_file.read_bytes() == TRUNCATED_PICKLE
        (beside,) = get_cache_dir().glob("hal.pkl.unmerged-*")
        with open(beside, "rb") as f:
            assert pickle.load(f) == {"ours": 1}
@

Atomicity is a property of the moment in the middle of a write, so the
test stops a save there.
The value it saves pickles only when the test lets it: its
[[__reduce__]] signals that the write has started and waits.
At that moment the file must still hold the old cache, complete.
A save that writes in place fails here, since opening the file for
writing has already emptied it.

<<test functions>>=
class PausingValue:
    """A value whose pickling waits until the test lets it go on."""

    def __init__(self):
        self.started = threading.Event()
        self.proceed = threading.Event()

    def __reduce__(self):
        self.started.set()
        self.proceed.wait(timeout=10)
        return (str, ("written",))


def test_a_reader_never_sees_a_partial_cache_file(monkeypatch):
    """While a save is under way, the file holds the old cache."""
    save_cache("openalex", {"old": "entry"})
    cache_file = get_cache_dir() / "openalex.pkl"
    cache = load_cache("openalex")
    value = PausingValue()
    cache["new"] = value
    writer = threading.Thread(target=save_cache, args=("openalex", cache))
    writer.start()
    try:
        assert value.started.wait(timeout=10)
        with open(cache_file, "rb") as f:
            assert pickle.load(f) == {"old": "entry"}
    finally:
        value.proceed.set()
        writer.join(timeout=10)
    assert load_cache("openalex") == {"old": "entry", "new": "written"}
@

A save must also outwait a lock held longer than the session timeout.
The test shortens that timeout to a fifth of a second and has a second
thread hold the lock for half a second, as a slow save of another
process would, writing that process's entries before it lets go.
A save that gave up after the session timeout would go ahead unlocked,
and one of the two writes would drop the other's entries.

<<test functions>>=
def test_a_cache_save_outwaits_the_session_lock_timeout(monkeypatch):
    """A slow save ahead of us costs time, not entries."""
    monkeypatch.setattr("scholar.utils.LOCK_TIMEOUT", 0.2)
    cache_file = get_cache_dir() / "scopus.pkl"
    holding = threading.Event()

    def slow_save_of_another_process():
        with file_lock(cache_file):
            holding.set()
            time.sleep(0.5)
            cache_file.write_bytes(pickle.dumps({"theirs": 1}))

    other = threading.Thread(target=slow_save_of_another_process)
    other.start()
    assert holding.wait(timeout=10)
    cache = load_cache("scopus")
    cache["ours"] = 2
    save_cache("scopus", cache)
    other.join(timeout=10)
    assert load_cache("scopus") == {"theirs": 1, "ours": 2}
@

The bug itself needs real processes: each loads at start-up and saves in
its exit hook, and no test inside the pytest process can observe that.
The script below is such a process.
It waits for a common start time, so that the processes of one round
load, add and save at nearly the same moment, then loads the shared
cache, adds keys of its own and exits.
The file is seeded with a megabyte of entries so that a write takes long
enough for another process's load to fall into it.
Before the fix, each round kept only the keys of whichever process wrote
last, and a load that fell into a write emptied the file; now every key
of every round, and the seed, must survive.

<<test functions>>=
CONCURRENT_CACHE_WRITER = """
import sys, time
from scholar.cache import load_cache, register_cache

name, start = sys.argv[1], float(sys.argv[2])
while time.time() < start:
    time.sleep(0.001)
cache = load_cache("shared")
register_cache("shared", cache)
for i in range(50):
    cache[(name, i)] = name * 500
"""


def test_processes_saving_at_once_keep_each_others_entries():
    """Concurrent exit saves lose no entries (#175)."""
    import time

    seed = {("seed", i): "s" * 2000 for i in range(500)}
    save_cache("shared", seed)
    env = dict(os.environ, SCHOLAR_CACHE_DIR=str(get_cache_dir()))
    names = []
    for round_ in range(4):
        start = time.time() + 1.5
        round_names = [f"r{round_}p{p}" for p in range(3)]
        writers = [
            subprocess.Popen(
                [sys.executable, "-c", CONCURRENT_CACHE_WRITER,
                 name, str(start)],
                env=env, stderr=subprocess.PIPE, text=True,
            )
            for name in round_names
        ]
        for writer in writers:
            _, stderr = writer.communicate(timeout=60)
            assert writer.returncode == 0, stderr[-2000:]
        names += round_names
    saved = load_cache("shared")
    assert set(seed) <= set(saved)
    missing = [name for name in names if (name, 49) not in saved]
    assert missing == []
@


\section{When a cached answer was fetched}
\label{sec:fetch-meta}

A cache entry is an answer without a date.  A search served from it
used to be stamped with the time of the run, so a session, the report
and the [[DATE]] of a [[bibtex+prov]] block claimed that the database
had been searched today when the answer was months old
(\url{https://github.com/dbosk/scholar/issues/167}).  PRISMA asks for
the date each source was last searched, and the cache is the one place
that can know it.

So a provider that stores an answer also stores when it fetched it,
and the total the service reported with it, since a cached answer
should not lose that either (\cref{sec:reported-total} in the providers
chapter).  The facts go into a side table kept in the same cache
dictionary: beside the answer at [[key]], an entry at
[[(FETCH_META_KEY, key)]] holds its facts.  Wrapping the cached answers
themselves would have changed the shape of every entry, so every entry
already on disk would have to be read through a fallback or thrown
away; throwing them away would mean re-fetching them, against the
provider's quota.  With a side table nothing that exists changes: an
entry stored before has no facts, and [[fetch_meta]] answers an empty
dictionary for it, which callers read as \enquote{fetch date unknown}.
The side entries go wherever their cache goes: saved and loaded with
it, and emptied with it by [[clear_cache]].  Their keys begin with a
string no provider uses, so they cannot collide with an answer, and
[[is_fetch_meta_key]] tells them apart where entries are counted.

Each fact is an entry of its own, not a value inside one shared
table, for the sake of the [[PersistentCache]] (\cref{sec:cache-concurrency}):
only an assignment through [[__setitem__]] marks the cache changed, so
a fact written into a nested table after the table existed would never
be saved; and [[save_cache]] merges with what other processes saved by
top-level key, so one shared table would let the last process to save
erase the facts the others stored.  Reading the facts assigns nothing,
so a search served from the cache leaves the cache unchanged and
unsaved, as before.

<<constants>>=
FETCH_META_KEY = "__fetch_meta__"
<<cache load and save functions>>=
def is_fetch_meta_key(key: Any) -> bool:
    """Whether `key` is that of a side entry of fetch facts."""
    return (
        isinstance(key, tuple) and len(key) == 2
        and key[0] == FETCH_META_KEY
    )


def fetch_meta(cache: dict[Any, Any], key: Any) -> dict[str, Any]:
    """The facts stored about the cached answer at `key`, or `{}`.

    The facts are `fetched_at` (UTC ISO time of the fetch), `total`
    and `total_estimated` (what the service reported). Answers cached
    before facts were stored have none. Reading changes nothing.
    """
    facts = cache.get((FETCH_META_KEY, key))
    return dict(facts) if isinstance(facts, dict) else {}


def remember_fetch(
    cache: dict[Any, Any], key: Any, **facts: Any
) -> None:
    """Store `facts` about the cached answer at `key` in its side entry."""
    cache[(FETCH_META_KEY, key)] = facts
@

Let's verify that the facts survive a save and a load with the answer
they describe, and that an answer cached without them, as every answer
on disk today was, reads as having none:

<<test functions>>=
class TestFetchMeta:
    """Facts about cached answers live in a side table (#167)."""

    def test_round_trip(self, tmp_path, monkeypatch):
        monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path))
        cache = {("q", 100, ""): []}
        remember_fetch(cache, ("q", 100, ""),
                       fetched_at="2026-10-02T08:00:00+00:00", total=7)
        save_cache("meta_provider", cache)
        loaded = load_cache("meta_provider")
        assert loaded[("q", 100, "")] == []
        assert fetch_meta(loaded, ("q", 100, "")) == {
            "fetched_at": "2026-10-02T08:00:00+00:00", "total": 7,
        }

    def test_old_entries_have_no_facts(self):
        cache = {("q", 100, ""): []}
        assert fetch_meta(cache, ("q", 100, "")) == {}
        remember_fetch(cache, ("other", 5, ""), fetched_at="x")
        assert fetch_meta(cache, ("q", 100, "")) == {}

    def test_reading_leaves_the_cache_unchanged(self, tmp_path, monkeypatch):
        monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path))
        cache = load_cache("meta_read")
        cache[("q", 100, "")] = []
        remember_fetch(cache, ("q", 100, ""), fetched_at="x")
        save_cache("meta_read", cache)
        loaded = load_cache("meta_read")
        assert fetch_meta(loaded, ("q", 100, "")) == {"fetched_at": "x"}
