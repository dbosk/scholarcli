TRUNCATED_PICKLE = pickle.dumps(TRUNCATED_ENTRIES)
TRUNCATED_PICKLE = TRUNCATED_PICKLE[: len(TRUNCATED_PICKLE) // 2]


class TestUnreadableCacheFile:
    """A cache file that fails to load is never written over (#175)."""

    def test_load_warns_naming_the_file(self, monkeypatch, caplog):
        """The warning says which file could not be read."""
        cache_file = get_cache_dir() / "s2.pkl"
        cache_file.write_bytes(TRUNCATED_PICKLE)
        with caplog.at_level("WARNING", logger="scholar.cache"):
            assert load_cache("s2") == {}
        assert str(cache_file) in caplog.text

    def test_unchanged_cache_leaves_the_file_alone(self, monkeypatch):
        """The exit save does not write an empty cache over the file."""
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        cache_file = get_cache_dir() / "s2.pkl"
        cache_file.write_bytes(TRUNCATED_PICKLE)
        register_cache("s2", load_cache("s2"))
        save_all_caches()
        assert cache_file.read_bytes() == TRUNCATED_PICKLE
        assert sorted(p.name for p in get_cache_dir().iterdir()
                      if not p.name.startswith(".")) == ["s2.pkl"]

    def test_new_entries_go_beside_the_file(self, monkeypatch, caplog):
        """Entries added after a failed load are kept in a side file."""
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        cache_file = get_cache_dir() / "s2.pkl"
        cache_file.write_bytes(TRUNCATED_PICKLE)
        cache = load_cache("s2")
        register_cache("s2", cache)
        cache[("new query", 10)] = ["fetched"]
        with caplog.at_level("WARNING", logger="scholar.cache"):
            save_all_caches()
        assert cache_file.read_bytes() == TRUNCATED_PICKLE
        beside = list(get_cache_dir().glob("s2.pkl.unmerged-*"))
        assert len(beside) == 1
        with open(beside[0], "rb") as f:
            assert pickle.load(f) == {("new query", 10): ["fetched"]}
        assert str(beside[0]) in caplog.text

    def test_merges_once_the_file_reads_again(self, monkeypatch):
        """A file completed after our failed load is merged, not lost."""
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        cache_file = get_cache_dir() / "s2.pkl"
        cache_file.write_bytes(TRUNCATED_PICKLE)
        cache = load_cache("s2")
        register_cache("s2", cache)
        cache_file.write_bytes(pickle.dumps(TRUNCATED_ENTRIES))
        cache[("new query", 10)] = ["fetched"]
        save_all_caches()
        assert load_cache("s2") == {
            **TRUNCATED_ENTRIES, ("new query", 10): ["fetched"]
        }

    def test_a_missing_class_makes_the_file_unreadable(self, monkeypatch):
        """A pickle naming a class that is gone neither crashes nor is
        overwritten."""
        monkeypatch.setattr("scholar.cache.CACHE_REGISTRY", {})
        cache_file = get_cache_dir() / "dblp.pkl"
        old_class = b"cno_such_module\nThing\n."
        cache_file.write_bytes(old_class)
        cache = load_cache("dblp")
        register_cache("dblp", cache)
        cache["new"] = 1
        save_all_caches()
        assert cache_file.read_bytes() == old_class
@

The other rules need a second writer.
Within one process a direct [[save_cache]] of a plain dictionary plays
the other process: it writes the file after our cache was loaded, which
is all the merge has to cope with.
The skip is checked on the file's modification time, dated back to 2001
first so that a rewrite shows even on a file system with coarse
timestamps, and on an [[update]], the method the flag is easiest to
miss on.

