        monkeypatch.setenv("SCHOLAR_CACHE_DIR", str(tmp_path))
        cache = load_cache("meta_add")
        cache[("q", 100, "")] = []
        remember_fetch(cache, ("q", 100, ""), fetched_at="first")
        save_cache("meta_add", cache)
        assert cache.changed is False
        remember_fetch(cache, ("r", 5, ""), fetched_at="second")
        assert cache.changed is True
        save_cache("meta_add", cache)
        loaded = load_cache("meta_add")
        assert fetch_meta(loaded, ("q", 100, "")) == {"fetched_at": "first"}
        assert fetch_meta(loaded, ("r", 5, "")) == {"fetched_at": "second"}

    def test_two_processes_keep_each_others_facts(
        self, tmp_path, monkeypatch
