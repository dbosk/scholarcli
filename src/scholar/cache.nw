def test_limiter_registry_starts_with_the_clients():
    """The clients' limiters are registered before the test body."""
    from scholar import ratelimit

    assert {"crossref", "europepmc", "unpaywall"} <= set(ratelimit._LIMITERS)


def refuse_openalex_request():
    """Put the shared OpenAlex limiter on cooldown and ask it anyway."""
    from scholar.ratelimit import RateLimited, get_limiter

    limiter = get_limiter("openalex")
    limiter.record_limit_hit(retry_after=60, reason="test cooldown")
    with pytest.raises(RateLimited):
        limiter.acquire()


def test_limiter_first_test_spends_the_warning():
    """Make the shared limiter warn once."""
    refuse_openalex_request()


def test_limiter_second_test_is_warned_too(caplog):
    """The previous test's warning flag did not carry over."""
    with caplog.at_level("WARNING", logger="scholar.ratelimit"):
        refuse_openalex_request()
    assert "test cooldown" in caplog.text
