    def caches_with_unmerged_files(self):
        return sorted(
            path.name.split(".pkl.unmerged-")[0]
            for path in get_cache_dir().glob("*.pkl.unmerged-*")
        )

    def test_a_reused_process_id_keeps_both_files(self):
        """Two saves of one process write two files, not one."""
        self.make_unmerged("s2")
        self.make_unmerged("s2")
        assert self.caches_with_unmerged_files() == ["s2", "s2"]

    def test_stats_list_them(self):
