def decide_as_human(self, decision: ReviewDecision, status: DecisionStatus,
                    tags: list[str]) -> bool | None:
    """Store a human's decision of `status` with `tags` on `decision`.

    Returns None when the category rule refuses it (nothing stored, the
    user told why), else whether it changed the status or the category
    of a decision that was made (a machine's or a human's), which asks
    for a reason. A human's decision decided again unchanged keeps its
    reason, unless another named human made it.
    """
    refusal = decision_refusal(self.session.decisions, status, tags,
                               named_by="the chosen tags name")
    if refusal is not None:
        self.notify(refusal, severity="error", timeout=RULE_NOTICE_TIMEOUT)
        return None
    was_machine = decision.source.is_unreviewed
    changed = decision.is_decided and \
        changes_the_verdict(decision, status, tags)
    keeps_words = decision.is_decided and not was_machine \
        and not changed and not self.decided_by_another(decision)
    reason = decision.human_reason if keeps_words else None
    decision.status = status
    decision.tags = list(tags)
    self.session._invalidate_cache()
    if was_machine:
        from scholar.llm_review import mark_as_reviewed

        mark_as_reviewed(decision, user_agrees=not changed,
                         new_status=status, new_tags=list(tags))
    record_human_decision(decision, "tui", by=self.reviewer, reason=reason)
    return changed
