@staticmethod
def offered(app):
  from textual.widgets import SelectionList
  tags = app.screen.query_one(SelectionList)
  return [tags.get_option_at_index(i).value
          for i in range(tags.option_count)]

@classmethod
def run(cls, keys, reviewer="alice", inspect=None, session=None,
        blind=True):
  import asyncio

  session = session or cls.session()
  app = PaperReviewApp(session, reviewer=reviewer, blind=blind)
  app.notices = []
  show = app.notify

  def record(message, **kwargs):
    app.notices.append(message)
    show(message, **kwargs)

  app.notify = record

  async def drive():
    async with app.run_test() as pilot:
      await pilot.pause()
      for key in keys:
        await pilot.press(key)
        await pilot.pause()
      if inspect is not None:
        inspect(app)

  asyncio.run(drive())
  return app, session.decisions[0]
