Let's verify that a review is saved as a session and nowhere else.
We replace the Textual application by a stand-in whose [[run]] returns at
once, since the save path is what we test, not the interface.

<<test functions>>=
def test_run_review_saves_session_only(monkeypatch):
    """run_review writes the session file, not legacy per-query decisions."""
    from scholar.notes import get_decisions_dir
    from scholar.review import load_session

    class FakeApp:
        def __init__(self, *args, **kwargs):
            pass

        def run(self):
            pass

    monkeypatch.setattr("scholar.tui.PaperReviewApp", FakeApp)
    result = SearchResult(
        query="q",
        provider="openalex",
        timestamp=datetime.now(),
        papers=[Paper(title="A paper", authors=["A. Author"], year=2024)],
    )
    run_review([result], "q", session_name="legacy-test")
    assert load_session("legacy-test") is not None
    assert list(get_decisions_dir().glob("*.json")) == []
