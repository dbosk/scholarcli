The save on exit can be refused, when another scholar process holds
the session file's lock for minutes
(\cref{sec:session-lock} in the review chapter).  Then the review is
not lost: [[save_session]] keeps it beside the file and raises, and the
entry point prints the one line that says how to merge it in.  Let's
verify it with another process holding the lock and a short timeout:
the decision made in the stand-in review is in the kept file, and no
session file was written.

<<test functions>>=
def test_a_refused_save_on_exit_keeps_the_review(tmp_path, monkeypatch):
    """A review whose save is refused is kept beside the session (#316)."""
    import json
    import subprocess
    import sys
    import textwrap
    import scholar.review as review
    from scholar.review import (
        DecisionStatus, SessionNotSaved, _get_sessions_dir,
    )

    monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
    monkeypatch.setattr(review, "SESSION_LOCK_TIMEOUT", 0.5)
    monkeypatch.setattr(review, "SESSION_LOCK_NOTICE", 0.2)

    class FakeApp:
        def __init__(self, session, *args, **kwargs):
            self.session = session

        def run(self):
            self.session.decisions[0].status = DecisionStatus.KEPT

    monkeypatch.setattr("scholar.tui.PaperReviewApp", FakeApp)
    path = _get_sessions_dir() / "tui-held.json"
    holder = subprocess.Popen(
        [sys.executable, "-c", textwrap.dedent("""
            import sys
            from scholar.utils import file_lock
            with file_lock(sys.argv[1]):
                print("holding", flush=True)
                sys.stdin.readline()
        """), str(path)],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    try:
        assert holder.stdout.readline().strip() == "holding"
        result = SearchResult(
            query="q", provider="openalex", timestamp=datetime.now(),
            papers=[Paper(title="A paper", authors=["A. Author"],
                          year=2024)],
        )
        with pytest.raises(SessionNotSaved) as raised:
            run_review([result], "q", session_name="tui-held")
    finally:
        holder.communicate("go\n", timeout=60)
    assert not path.exists()
    kept = json.loads(raised.value.unsaved.read_text())
    assert [d["status"] for d in kept["decisions"]] == ["kept"]
