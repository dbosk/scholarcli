def test_a_screening_during_a_concurrent_reset_is_set_aside(
    self, monkeypatch):
  import asyncio
  import json
  import subprocess
  import sys
  from typer.testing import CliRunner
  from scholar.cli import app as cli_app
  from scholar.review import _get_sessions_dir, save_session
  from scholar.scholar import isolated_registry

  with isolated_registry():
    session = self.session()
    session.name = "blind-race"
    save_session(session)
  reset = (
    "from scholar.review import load_session, reset_decision, "
    "save_session\n"
    "s = load_session('blind-race')\n"
    "reset_decision(s.decisions[0], '2026-11-20T10:00:00+00:00')\n"
    "save_session(s)\n"
  )

  def run_headless(self_app):
    async def drive():
      async with self_app.run_test() as pilot:
        await pilot.pause()
        await pilot.press("K")
        await pilot.pause()
        subprocess.run([sys.executable, "-c", reset], check=True,
                       timeout=120)

    asyncio.run(drive())

  monkeypatch.setattr(PaperReviewApp, "run", run_headless)
  with isolated_registry():
    result = CliRunner().invoke(
      cli_app, ["sessions", "resume", "blind-race", "--blind",
                "--by", "alice"])
  assert result.exit_code == 0, result.output
  saved = json.loads(
    (_get_sessions_dir() / "blind-race.json").read_text()
  )["decisions"][0]
  assert saved["status"] == "pending"
  assert [(r["origin"], r["kind"], r["name"], r["blind"])
          for r in saved["screenings"]] \
    == [("decision", "llm", "m-1", None),
        ("screen", "human", "alice", True)]
  assert all(r["set_aside_at"] == "2026-11-20T10:00:00+00:00"
             for r in saved["screenings"])
