        show = app.notify

        def record(message, **kwargs):
            notices.append((message, kwargs.get("severity")))
            show(message, **kwargs)

        app.notify = record

        async def drive():
            async with app.run_test() as pilot:
                await pilot.pause()
                await pilot.press(*keys)
                await pilot.pause()
                if inspect is not None:
                    inspect(app)

        asyncio.run(drive())
        return app, notices

