@staticmethod
def session():
  from scholar.review import LLMSample

  def decision(i, status, tags, source, confidence=None):
    return ReviewDecision(
      paper=Paper(title=f"Paper {i}", authors=["Ada Lovelace"],
                  doi=f"10.5555/blind-{i}", abstract=f"Abstract {i}.",
                  year=2020 + i),
      provider="openalex", status=status, tags=tags, source=source,
      llm_confidence=confidence,
      llm_model="m-1" if source.is_machine else None,
      llm_reason="Unrelated to recursion." if source.is_machine else None,
    )

  sampled = decision(0, DecisionStatus.DISCARDED, ["off-topic"],
                     ReviewSource.LLM_UNREVIEWED, 0.9)
  unsampled = decision(1, DecisionStatus.KEPT, ["recursion"],
                       ReviewSource.LLM_UNREVIEWED, 0.7)
  human = decision(2, DecisionStatus.KEPT, [], ReviewSource.HUMAN)
  session = ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 20),
    decisions=[sampled, unsampled, human],
  )
  session.llm_samples = [LLMSample(
    sample_id="s-1", seed=1, drawn_at="2026-11-19T00:00:00+00:00",
    criteria={"statuses": ["discarded", "kept"],
              "population_sources": ["llm"]},
    sessions=["q"], population=2, population_digest="d", size=1,
    papers=[{"paper_id": "doi:10.5555/blind-0", "status": "discarded",
             "source": "llm", "confidence": 0.9}],
  )]
  return session

