class ReviewerNameModal(ModalScreen[str | None]):
    """Ask the reviewer's name before blind mode starts."""

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    DEFAULT_CSS = """
    ReviewerNameModal {
        align: center middle;
    }
    #reviewer-dialog {
        width: 60;
        height: auto;
        border: thick $primary;
        background: $surface;
        padding: 1 2;
    }
    """

    def compose(self) -> ComposeResult:
        with Container(id="reviewer-dialog"):
            yield Static("[bold]Blind review[/bold]")
            yield Static("Your name, recorded with your blind verdicts "
                         "and decisions:")
            yield Input(placeholder="Your name", id="reviewer-name")

    def on_mount(self) -> None:
        self.query_one("#reviewer-name", Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.dismiss(event.value.strip() or None)

    def action_cancel(self) -> None:
        self.dismiss(None)
