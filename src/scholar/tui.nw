        )

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        notes_file = get_data_dir() / NOTES_FILE
        notes_file.parent.mkdir(parents=True, exist_ok=True)
        notes_file.write_text("{")
        invalidate_notes_cache()
        yield notes_file
        invalidate_notes_cache()

    @staticmethod
    def run(keys, inspect=None):
        """Run the app on a one-paper session, press `keys`, and return
        the app and the (message, severity) notifications it showed."""
        import asyncio

        paper = Paper(title="T", authors=["A B"], doi="10.1/tui")
        session = ReviewSession(
            query="q", providers=["openalex"], timestamp=datetime.now(),
            decisions=[ReviewDecision(paper=paper, provider="openalex")],
        )
