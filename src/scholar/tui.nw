@staticmethod
def session(categories=True):
  from scholar.review import record_human_decision as record

  machine = ReviewDecision(
    paper=Paper(title="Paper 0", authors=["Ada Lovelace"],
                doi="10.5555/human-0"),
    provider="openalex", status=DecisionStatus.KEPT,
    tags=["supports-claim", "loops"] if categories else ["loops"],
    source=ReviewSource.AGENT_UNREVIEWED, llm_confidence=0.8,
    agent_reason="Interviews novices about loops.", agent_by="agent-1")
  pending = ReviewDecision(
    paper=Paper(title="Paper 1", authors=["Ada Lovelace"],
                doi="10.5555/human-1"), provider="openalex")
  human = ReviewDecision(
    paper=Paper(title="Paper 2", authors=["Ada Lovelace"],
                doi="10.5555/human-2"), provider="openalex",
    status=DecisionStatus.DISCARDED, tags=["workshop-paper"])
  record(human, "decide", reason="Bears on it, but a workshop paper.")
  return ReviewSession(
    query="q", providers=["openalex"], timestamp=datetime(2026, 11, 27),
    decisions=[machine, pending, human])

@classmethod
def run(cls, keys, session=None, inspect=None, reviewer="alice"):
  return TestBlindReview.run(keys, session=session or cls.session(),
                             inspect=inspect, blind=False,
