def record_notices(app):
    """Record the (message, severity) of each notification `app` shows."""
    notices = []
    show = app.notify

    def record(message, **kwargs):
        notices.append((message, kwargs.get("severity")))
        show(message, **kwargs)

    app.notify = record
    return notices


async def settle_after_enrichment(pilot, notices):
    """Wait for the enrichment thread's last notification, then idle."""
    for _ in range(200):
        await pilot.pause(0.05)
        if any("adopted preprint" in message for message, _ in notices):
            break
    await pilot.pause()
    await pilot.pause()


