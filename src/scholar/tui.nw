class TestRefusedNotesLock:
    """A note refused its lock is kept and named in the TUI (#319)."""

    def test_the_typed_note_is_kept(self, tmp_path, monkeypatch):
        import subprocess
        import sys
        from contextlib import nullcontext
        import scholar.notes as notes
        from scholar.utils import lock_path

        monkeypatch.setenv("SCHOLAR_DATA_DIR", str(tmp_path))
        monkeypatch.setattr(notes, "NOTES_LOCK_TIMEOUT", 0.3)
        notes_file = notes.get_data_dir() / notes.NOTES_FILE
        notes_file.write_text("{}")
        notes.invalidate_notes_cache()
        monkeypatch.setattr(
            notes.click, "edit", lambda *args, **kwargs: "Hours of reading."
        )
        monkeypatch.setattr(
            PaperReviewApp, "suspend", lambda self: nullcontext()
        )
        holder = subprocess.Popen(
            [sys.executable, "-c",
             "import sys\n"
             "from filelock import FileLock\n"
             "lock = FileLock(sys.argv[1])\n"
             "lock.acquire()\n"
             "print('held', flush=True)\n"
             "sys.stdin.read()\n",
             str(lock_path(notes_file))],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
        )
        try:
            assert holder.stdout.readline().strip() == "held"
            app, notices = TestUnreadableNotesFile.run(["n"])
        finally:
            holder.stdin.close()
            holder.wait(10)
        notes.invalidate_notes_cache()
        assert notes_file.read_text() == "{}"
        [(message, severity)] = notices
        assert severity == "error"
        assert "is locked by another scholar process" in message
        assert "repaired" not in message and ".bak" not in message
        kept = Path(message.split("its text is in ")[1].split(".md")[0] + ".md")
        assert kept.read_text().endswith("Hours of reading.\n")
