def test_conflict_filter_lists_the_unresolved_conflicts():
    import asyncio
    from scholar.review import (
        ReviewSource, new_screening, record_human_decision,
        record_screening,
    )

    def decision(i, agent):
        d = ReviewDecision(
            paper=Paper(title=f"X{i}", authors=["A"],
                        doi=f"10.5555/tui-conflict-{i}"),
            provider="p", status=DecisionStatus.DISCARDED, tags=["t"],
            source=ReviewSource.LLM_UNREVIEWED, llm_model="m-1",
            llm_decided_at="2020-01-01T00:00:00+00:00",
        )
        record_screening(d, new_screening(
            kind="agent", name="a-2", status=agent, tags=["t"],
            recorded_at="2020-01-02T00:00:00+00:00"))
        return d

    settled = decision(2, "kept")
    settled.source = ReviewSource.LLM_REVIEWED
    record_human_decision(settled, "tui", at="2020-01-03T00:00:00+00:00")
    session = ReviewSession(
        query="q", providers=["p"], timestamp=datetime(2020, 1, 1),
        decisions=[decision(0, "kept"), decision(1, "discarded"), settled],
    )
    app = PaperReviewApp(session)
    listed = []

    async def drive():
        async with app.run_test() as pilot:
            await pilot.pause()
            await pilot.press("f", "x")
            await pilot.pause()
            listed.append([d.paper.title
                           for d in app.get_filtered_decisions()])
            await pilot.press("C")
            await pilot.pause()

    asyncio.run(drive())
    assert app.current_filter == "conflicts"
