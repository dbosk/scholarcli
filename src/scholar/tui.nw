  typed = ["d", "tab", *"supports", "minus", *"claim", "enter", "enter"]
  for keys in (typed, ["enter", *typed]):
    screens = []
    app, decision = self.run(keys, inspect=lambda app: screens.append(
      type(app.screen).__name__))
    assert (decision.status, decision.source) \
      == (DecisionStatus.KEPT, ReviewSource.AGENT_UNREVIEWED), keys
    assert decision.human_decided_at is None, keys
