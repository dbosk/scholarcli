    def test_exit_ip_goes_through_the_route(self, monkeypatch):
        monkeypatch.setenv("SCHOLAR_PROXY", "http://proxy:3128")
        response = Mock(text="130.237.0.1\n")
        with patch("requests.get", return_value=response) as get_:
            assert exit_ip() == "130.237.0.1"
        assert get_.call_args.args[0] == EXIT_IP_URL
        assert get_.call_args.kwargs["proxies"]["https"] == (
            "http://proxy:3128"
