class TestRequestFailureReason:
    """Failed requests are named without their URLs (#259)."""

    URL = "https://api.unpaywall.org/v2/10.1%2Fx?email=someone@example.org"

    @pytest.mark.parametrize("failure, reason", [
        (requests.exceptions.RetryError(URL), RETRIES_SPENT),
        (requests.exceptions.ConnectionError(URL),
         "connection failed (ConnectionError)"),
        (requests.exceptions.SSLError(URL), "connection failed (SSLError)"),
        (requests.exceptions.ReadTimeout(URL),
         "connection failed (ReadTimeout)"),
        (requests.exceptions.HTTPError(
            URL, response=Mock(status_code=503)), "HTTP 503"),
        (requests.exceptions.HTTPError(
            URL, response=Mock(status_code=429)), "rate limited (HTTP 429)"),
        (requests.exceptions.InvalidJSONError(URL), "InvalidJSONError"),
    ], ids=["retries", "connection", "ssl", "timeout", "503", "429", "json"])
    def test_requests_failures_in_our_words(self, failure, reason):
        assert request_failure_reason(failure) == reason

    def test_other_failures_keep_their_text(self):
        failure = OSError(
            "Could not find a suitable TLS CA certificate bundle, "
            "invalid path: /nonexistent/ca.pem"
        )
        assert request_failure_reason(failure) == str(failure)

    def test_long_text_is_cut_and_redacted(self):
        reason = request_failure_reason(
            ValueError("bad\n answer from /a?api_key=SECRET " + "x" * 200)
        )
        assert reason.startswith("bad answer from /a?api_key=[redacted] ")
        assert len(reason) == FAILURE_REASON_MAX_CHARS
        assert reason.endswith("...")
