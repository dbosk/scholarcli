            (Paper(**doi), LookupOutcome(["s2"], {"s2": "HTTP 429"}),
             {"at": self.AT, "outcome": "failed", "asked": ["s2"],
              "failed": {"s2": "HTTP 429"}}),
            (Paper(title="T", authors=["a"]), LookupOutcome(),
             {"at": self.AT, "outcome": "no-doi"}),
            (Paper(**doi), LookupOutcome(declined={"ieee": "no key"}),
             {"at": self.AT, "outcome": "none-asked"}),
        ]
        for paper, outcome, record in cases:
            assert abstract_lookup_record(paper, outcome, self.AT) == record
        assert [r["outcome"] for _, _, r in cases] \
