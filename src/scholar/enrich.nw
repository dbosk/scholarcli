<<enrichment functions>>=
def clean_paper_text_except(
    paper: Paper, plain_abstract: str | None = None
) -> Paper:
    """Clean `paper` like `clean_paper_text`, except a plain abstract.

    An abstract equal to `plain_abstract`, text an abstract service
    already reduced to plain text, is kept as it is.
    """
    abstract = paper.abstract
    clean_paper_text(paper)
    if plain_abstract is not None and abstract == plain_abstract:
        paper.abstract = abstract
    return paper
