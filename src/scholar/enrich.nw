class TestLookupTally:
    """The tally that ends `scholar enrich` (#259)."""

    REFUSED = "rate limited (HTTP 429)"

    def _tally(self):
        papers = [
            Paper(title="A", authors=["a"], doi="10.1/a"),
            Paper(title="B", authors=["a"], doi="10.1/b"),
            Paper(title="C", authors=["a"], doi="10.1/c"),
            Paper(title="D", authors=["a"]),
            Paper(title="E", authors=["a"], doi="10.1/e", abstract="Got it."),
        ]
        outcomes = [
            LookupOutcome(["s2", "openalex"], {"s2": self.REFUSED}),
            LookupOutcome(
                ["s2", "openalex"],
                {"s2": self.REFUSED, "openalex": "HTTP 503"},
            ),
            LookupOutcome(["s2", "openalex"]),
            LookupOutcome(),
            LookupOutcome(["s2", "openalex"], {"s2": self.REFUSED}),
        ]
        return tally_lookups(papers, outcomes)

    def test_failed_and_answered_are_counted_apart(self):
        tally = self._tally()
        assert (tally.papers, tally.without_abstract) == (5, 4)
        assert (tally.with_failure, tally.all_answered) == (2, 1)
        assert (tally.without_doi, tally.none_asked) == (1, 0)
        assert tally.failures == {
            ("s2", self.REFUSED): 2, ("openalex", "HTTP 503"): 1,
        }

    def test_text(self):
        assert abstract_tally_lines(self._tally(), "papers") == [
            "Still without an abstract: 4 of 5 papers.",
            "  1 answered by every database asked: no abstract in any "
            "of them.",
            "  1 without a DOI: no database could be asked.",
            "  2 with a failed lookup, by database and reason:",
            "    s2: rate limited (HTTP 429) (2)",
            "    openalex: HTTP 503 (1)",
            "  Run again to retry the failed lookups.",
        ]

    def test_no_hint_without_failures(self):
        tally = tally_lookups(
            [Paper(title="A", authors=["a"], doi="10.1/a")],
            [LookupOutcome(["s2"])],
        )
        lines = abstract_tally_lines(tally, "pending papers")
        assert lines == [
            "Still without an abstract: 1 of 1 pending papers.",
            "  1 answered by every database asked: no abstract in any "
            "of them.",
        ]

    def test_missing_outcome_reads_as_nothing_asked(self):
        tally = tally_lookups(
            [Paper(title="A", authors=["a"], doi="10.1/a")], []
        )
        assert (tally.none_asked, tally.with_failure) == (1, 0)

    def test_declined_is_information_not_failure(self):
        declined = {"scopus": "SCOPUS_VIEW=standard has no abstracts"}
        papers = [
            Paper(title="A", authors=["a"], doi="10.1/a"),
            Paper(title="B", authors=["a"], doi="10.1/b"),
            Paper(title="C", authors=["a"], doi="10.1/c"),
        ]
        outcomes = [
            LookupOutcome(["s2"], declined=dict(declined)),
            LookupOutcome(["s2"], declined=dict(declined)),
            LookupOutcome(declined=dict(declined)),
        ]
        tally = tally_lookups(papers, outcomes)
        assert (tally.all_answered, tally.with_failure) == (2, 0)
        assert tally.none_asked == 1
        assert abstract_tally_lines(tally, "papers") == [
            "Still without an abstract: 3 of 3 papers.",
            "  2 answered by every database asked: no abstract in any "
            "of them.",
            "  1 with a DOI that no database was asked about: each one "
            "declined or was unavailable.",
            "  scopus not asked: SCOPUS_VIEW=standard has no abstracts "
            "(3 papers)",
        ]

    def test_declined_line_for_one_paper(self):
        tally = tally_lookups(
            [Paper(title="A", authors=["a"], doi="10.1/a")],
            [LookupOutcome(["s2"], declined={"ieee": "IEEE_API_KEY not set"})],
        )
        assert abstract_tally_lines(tally, "papers")[-1] == (
            "  ieee not asked: IEEE_API_KEY not set (1 paper)"
        )

    def test_open_access_text(self):
        papers = [
            Paper(title="A", authors=["a"], doi="10.1/a"),
            Paper(title="B", authors=["a"], doi="10.1/b"),
            Paper(title="C", authors=["a"]),
            Paper(title="D", authors=["a"], doi="10.1/d", oa_status="green"),
        ]
        outcomes = [
            LookupOutcome(open_access_error=self.REFUSED),
            LookupOutcome(),
            LookupOutcome(),
            LookupOutcome(open_access_error=self.REFUSED),
        ]
        lines = open_access_tally_lines(
            tally_lookups(papers, outcomes), "papers"
        )
        assert lines == [
            "Open-access status unknown for 3 papers: 1 without a DOI, "
            "1 not in Unpaywall, 1 with a failed lookup.",
            "  unpaywall: rate limited (HTTP 429) (1)",
            "  Run again to retry the failed lookups.",
        ]

    def test_no_open_access_lines_when_all_known(self):
        tally = tally_lookups(
            [Paper(title="A", authors=["a"], doi="10.1/a", oa_status="gold")],
            [LookupOutcome()],
        )
        assert open_access_tally_lines(tally, "papers") == []
