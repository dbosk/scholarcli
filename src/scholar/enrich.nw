class TestDoubtfulTally:
    """The run's doubtful abstracts, by reason and ending (#287)."""

    def test_counts_and_text(self):
        conflict = "conflict-of-interest statement"
        papers = [
            Paper(title=f"P{n}", authors=["a"], doi=f"10.1/d{n}",
                  abstract="Text.")
            for n in range(4)
        ]
        outcomes = [
            LookupOutcome(abstract_from="openalex", doubtful=conflict),
            LookupOutcome(doubtful=conflict),
            LookupOutcome(abstract_from="crossref",
                          doubtful="funding statement", doubtful_from="s2"),
            LookupOutcome(abstract_from="s2"),
        ]
        outcomes.append(LookupOutcome(doubtful=conflict,
                                      abstract_adopted=True))
        papers.append(Paper(title="P4", authors=["a"], doi="10.1/d4"))
        tally = tally_lookups(papers, outcomes)
        assert tally.doubtful == {
            (conflict, "replaced"): 1, (conflict, "kept"): 1,
            (conflict, "adopted"): 1, ("funding statement", "replaced"): 1,
        }
        assert doubtful_tally_lines(tally) == [
            "Doubtful abstracts (text that looks like something other "
            "than an abstract): 4 papers.",
            "  conflict-of-interest statement: 1 replaced by a later "
            "source's abstract, 1 replaced by an adopted preprint's "
            "abstract, 1 kept, no better one found",
            "  funding statement: 1 replaced by a later source's abstract",
            "  " + DOUBTFUL_KEPT_HINT,
        ]

    def test_no_hint_when_all_were_replaced(self):
        tally = tally_lookups(
            [Paper(title="P", authors=["a"], doi="10.1/r")],
            [LookupOutcome(abstract_from="s2", doubtful="keywords line")],
        )
        assert DOUBTFUL_KEPT_HINT not in " ".join(doubtful_tally_lines(tally))

    def test_nothing_without_doubtful_abstracts(self):
        tally = tally_lookups(
            [Paper(title="P", authors=["a"], doi="10.1/n")],
            [LookupOutcome(["s2"])],
        )
        assert doubtful_tally_lines(tally) == []
