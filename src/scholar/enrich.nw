The reasons are read the way [[provider_outcome]] reads a search's
[[last_error]] (\cref{sec:provider-protocol}): as optional
attributes, accepted only if they are non-empty strings.
A provider from elsewhere has no such attribute, and the [[MagicMock]]
providers of the tests answer every attribute with another mock; both
read as \enquote{answered}, which is what they reported before this
existed.

<<lookup outcomes>>=
def lookup_error(source) -> str | None:
    """Return why `source`'s last DOI lookup failed; None if it answered.

    Reads the optional `last_lookup_error` attribute; anything but a
    non-empty string reads as "answered".
    """
    return _as_reason(getattr(source, "last_lookup_error", None))


def lookup_declined(source) -> str | None:
    """Return why `source` declined its last DOI lookup, or None.

    Reads the optional `last_lookup_declined` attribute, as
    `lookup_error` reads its own.
    """
    return _as_reason(getattr(source, "last_lookup_declined", None))


def _as_reason(value) -> str | None:
    """Return `value` if it is a non-empty string, else None."""
    return value if isinstance(value, str) and value else None
