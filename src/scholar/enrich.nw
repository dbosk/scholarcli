class TestLookupOutcome:
    """enrich_paper tells a failed lookup from an answer (#259)."""

    @staticmethod
    def _throttled_s2(monkeypatch, answered_doi):
        from scholar.providers import SemanticScholarProvider

        provider = SemanticScholarProvider(api_key=None)
        monkeypatch.setattr(provider, "_cache", {("doi", answered_doi): None})
        provider._limiter.record_limit_hit(
            retry_after=3600, reason="cooldown for the test"
        )
        return provider

    def test_refused_and_not_found_give_different_outcomes(
        self, monkeypatch
    ):
        s2 = self._throttled_s2(monkeypatch, "10.1/answered")
        monkeypatch.setattr(
            "scholar.enrich.get_provider",
            lambda name: s2 if name == "s2" else None,
        )
        papers = [
            Paper(title="Refused", authors=["a"], doi="10.1/refused"),
            Paper(title="Answered", authors=["a"], doi="10.1/answered"),
        ]
        outcomes = []
        enriched = enrich_papers(
            papers, fields=["abstract"], outcomes=outcomes
        )
        assert [p.abstract for p in enriched] == [None, None]
        refused, answered = outcomes
        assert refused.asked == ["s2"]
        assert "cooldown for the test" in refused.failed["s2"]
        assert answered.asked == ["s2"]
        assert answered.failed == {}

    def test_mock_providers_read_as_answered(self):
        """A MagicMock, or a provider without the attribute, answered."""

        class Bare:
            def get_paper_by_doi(self, doi):
                return None

        providers = {"s2": MagicMock(), "openalex": Bare()}
        providers["s2"].get_paper_by_doi.return_value = None
        outcome = LookupOutcome()
        with patch("scholar.enrich.get_provider", providers.get):
            enrich_paper(
                Paper(title="T", authors=["a"], doi="10.1/t"),
                fields=["abstract"],
                providers=["s2", "openalex"],
                outcome=outcome,
            )
        assert outcome.asked == ["s2", "openalex"]
        assert outcome.failed == {}

    def test_no_collector_no_change(self):
        """Without `outcomes` the batch returns the papers as before."""
        papers = [Paper(title="T", authors=["a"], doi="10.1/t")]
        assert enrich_papers(papers, fields=["abstract"]) == papers
