def test_ten_thousand_abstracts_are_judged_quickly():
    import time

    texts = (REAL_LOOKING_ABSTRACTS * 700)[:10_000]
    started = time.perf_counter()
    for text in texts:
        doubtful_abstract(text)
    assert time.perf_counter() - started < 1.0
