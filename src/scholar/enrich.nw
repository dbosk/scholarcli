def doubtful_tally_lines(tally: LookupTally) -> list[str]:
    """Describe the doubtful abstracts the run met, by reason.

    Returns no lines when it met none.
    """
    if not tally.doubtful:
        return []
    total = sum(tally.doubtful.values())
    lines = [
        "Doubtful abstracts (text that looks like something other than "
        f"an abstract): {_papers(total)}."
    ]
    by_reason = Counter()
    for (reason, _), count in tally.doubtful.items():
        by_reason[reason] += count
    for reason, _ in _most_frequent(by_reason):
        parts = [
            f"{tally.doubtful[reason, ending]} {text}"
            for ending, text in DOUBTFUL_ENDINGS
            if tally.doubtful[reason, ending]
        ]
        lines.append(f"  {reason}: {', '.join(parts)}")
    if any(ending == "kept" for _, ending in tally.doubtful):
        lines.append(f"  {DOUBTFUL_KEPT_HINT}")
    return lines
<<constants>>=
DOUBTFUL_ENDINGS = (
    ("replaced", "replaced by a later source's abstract"),
    ("adopted", "replaced by an adopted preprint's abstract"),
    ("kept", "kept, no better one found"),
)
DOUBTFUL_KEPT_HINT = (
    "The kept ones are marked in `scholar sessions show`; replace one "
    "with `scholar sessions set-abstract --replace`."
)
