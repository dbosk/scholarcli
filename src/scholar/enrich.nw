<<enrichment functions>>=
def abstract_source(name: str):
    """Return the shared client of the abstract service `name`."""
    module = {"crossref": crossref, "europepmc": europepmc}[name]
    return module.enrichment_source()


def enrichment_source(name: str):
    """Return what to ask for DOI lookups under `name`, or None.

    An abstract service's client (`ABSTRACT_SOURCE_FIELDS`), else the
    registered provider of that name.
    """
    if name in ABSTRACT_SOURCE_FIELDS:
        return abstract_source(name)
    return get_provider(name)
