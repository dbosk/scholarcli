def _json_response(data):
    """A replayed HTTP 200 answer with the JSON body `data`."""
    response = MagicMock()
    response.status_code = 200
    response.headers = {}
    response.json.return_value = data
    return response


class TestAbstractServices:
    """Crossref and Europe PMC fill abstracts the providers lack (#260)."""

    DOI = "10.7717/peerj.4375"

    @pytest.fixture(autouse=True)
    def _services(self, monkeypatch):
        """The real service clients, with caches of their own."""
        from scholar import crossref, europepmc

        monkeypatch.setattr(
            "scholar.enrich.abstract_source", abstract_source
        )
        monkeypatch.setattr(crossref._client, "_cache", {})
        monkeypatch.setattr(europepmc._client, "_cache", {})
        self.crossref = crossref._client
        self.europepmc = europepmc._client

    def _replay(self, crossref=None, europepmc=None):
        """Patch both sessions to answer `body`, or raise it if an error."""
        from contextlib import ExitStack

        stack = ExitStack()
        gets = []
        for client, body in (
            (self.crossref, crossref), (self.europepmc, europepmc),
        ):
            if isinstance(body, Exception):
                get = stack.enter_context(
                    patch.object(client._session, "get", side_effect=body)
                )
            else:
                get = stack.enter_context(patch.object(
                    client._session, "get",
                    return_value=_json_response(
                        {"message": body} if client is self.crossref
                        else body
                    ),
                ))
            gets.append(get)
        return stack, gets

    def _paper(self, **fields):
        return Paper(
            title="The state of OA", authors=["Heather Piwowar"],
            doi=self.DOI, **fields,
        )

    def test_crossref_fills_a_missing_abstract(self):
        outcome = LookupOutcome()
        stack, (crossref_get, europepmc_get) = self._replay(
            crossref=CROSSREF_WITH_ABSTRACT, europepmc=EUROPEPMC_HIT,
        )
        with stack:
            paper = enrich_paper(
                self._paper(), fields=["abstract"], outcome=outcome,
            )
        assert paper.abstract.startswith("Despite growing interest")
        assert "<" not in paper.abstract
        assert "crossref" in paper.sources
        assert outcome.asked == ["crossref"]
        europepmc_get.assert_not_called()

