            ("10.1/oa-refused", refused), ("10.1/oa-unknown", answered),
        ):
            enrich_paper(
                Paper(title="T", authors=["a"], doi=doi),
                fields=["pdf_url"],
                outcome=outcome,
            )
        assert refused.asked == []
        assert "unpaywall cooldown for the test" in refused.open_access_error
        assert answered.open_access_error is None
