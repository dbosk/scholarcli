The text says the counts in the order a user acts on them: what is
settled (no abstract anywhere asked), what cannot be asked, and last
what failed, by provider and reason with the most frequent first,
followed by the one thing to do about it.
The hint to run again appears only when something failed: the other
kinds would get the same answer again.
A count of zero is left out, except the first line's, which says that
nothing is missing.
[[scope]] is the command's word for what it processed (\enquote{papers}
or \enquote{pending papers}).

<<lookup outcomes>>=
def abstract_tally_lines(tally: LookupTally, scope: str) -> list[str]:
    """Describe the papers still without an abstract, one line each."""
    lines = [
        f"Still without an abstract: {tally.without_abstract} of "
        f"{tally.papers} {scope}."
    ]
    if tally.all_answered:
        lines.append(
            f"  {tally.all_answered} answered by every database asked: "
            "no abstract in any of them."
        )
    if tally.without_doi:
        lines.append(
            f"  {tally.without_doi} without a DOI: no database could "
            "be asked."
        )
    if tally.none_asked:
        lines.append(
            f"  {tally.none_asked} with a DOI that no database was "
            "asked about: each one declined or was unavailable."
        )
    lines.extend(
        f"  {provider} not asked: {reason} ({_papers(count)})"
        for (provider, reason), count in _most_frequent(tally.declined)
    )
    if tally.with_failure:
        lines.append(
            f"  {tally.with_failure} with a failed lookup, by database "
            "and reason:"
        )
        lines.extend(
            f"    {provider}: {reason} ({count})"
            for (provider, reason), count in _most_frequent(tally.failures)
        )
        lines.append(f"  {RUN_AGAIN_HINT}")
    return lines


def open_access_tally_lines(tally: LookupTally, scope: str) -> list[str]:
    """Describe the papers whose open-access status is still unknown.

    Returns no lines when every paper has a status.
    """
    if not tally.oa_undetermined:
        return []
    parts = [
        f"{count} {what}"
        for count, what in (
            (tally.oa_without_doi, "without a DOI"),
            (tally.oa_not_found, "not in Unpaywall"),
            (tally.oa_failed, "with a failed lookup"),
        )
        if count
    ]
    lines = [
        f"Open-access status unknown for {tally.oa_undetermined} "
        f"{scope}: {', '.join(parts)}."
    ]
    if tally.oa_failed:
        lines.extend(
            f"  unpaywall: {reason} ({count})"
            for reason, count in _most_frequent(tally.oa_failures)
        )
        lines.append(f"  {RUN_AGAIN_HINT}")
    return lines


def _papers(count: int) -> str:
    """Return "1 paper" or "N papers"."""
    return f"{count} paper" if count == 1 else f"{count} papers"


def _most_frequent(counts: Counter) -> list:
    """Return the items of `counts`, most frequent first, then by key."""
    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
