<<enrichment functions>>=
def _get_enrichment_cache_dir() -> Path:
    """
    Return the directory for storing enriched paper data.

    A subdirectory of the data directory (`SCHOLAR_DATA_DIR` if set,
    otherwise the platform's), created if it doesn't exist.
    """
    path = get_data_dir() / ENRICHMENT_CACHE_DIR
    path.mkdir(parents=True, exist_ok=True)
    return path
