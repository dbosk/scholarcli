<<enrichment functions>>=
def enrich_papers(
    papers: list[Paper],
    fields: list[str] | None = None,
    providers: list[str] | None = None,
    progress_callback: Callable[[int, int], None] | None = None,
    preprint_search: bool = False,
    outcomes: list[LookupOutcome] | None = None,
    judge_abstracts: Sequence[bool] | None = None,
) -> list[Paper]:
    """
    Enrich multiple papers.

    Args:
        papers: List of papers to enrich.
        fields: Fields to enrich. If None, enriches 'abstract' and 'pdf_url'.
        providers: Provider names to try, in priority order. If None, uses
            [[ENRICHMENT_PROVIDERS]].
        progress_callback: Called with (current, total) after each paper.
        preprint_search: Passed through to `enrich_paper`: allow the
            preprint fallback to search preprint servers by title.
        outcomes: If given, one `LookupOutcome` per paper is appended
            to it, in the order of `papers`.
        judge_abstracts: One flag per paper, passed to `enrich_paper` as
            `judge_abstract`; None judges no abstract.

    Returns:
        List of enriched papers in the same order.
    """
    if fields is None:
        fields = ["abstract", "pdf_url"]

    logger.info(f"Starting batch enrichment of {len(papers)} papers")
    judged = list(judge_abstracts or [False] * len(papers))
    _prefetch_openalex_lookups(papers, fields, providers, judged)

    enriched = []
    total = len(papers)
    enriched_count = 0

    for i, paper in enumerate(papers):
        outcome = LookupOutcome() if outcomes is not None else None
        result = enrich_paper(
            paper,
            fields,
            providers=providers,
            preprint_search=preprint_search,
            outcome=outcome,
            judge_abstract=judged[i],
        )
        if outcomes is not None:
            outcomes.append(outcome)
        if result != paper:  # Paper was enriched
            enriched_count += 1
        enriched.append(result)
        if progress_callback:
            progress_callback(i + 1, total)

    logger.info(f"Batch enrichment complete: {enriched_count}/{total} papers enriched")
    return enriched
