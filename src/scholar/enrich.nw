@dataclass
class LookupTally:
    """Why the papers of a run still lack an abstract or an OA status."""

    papers: int = 0
    without_abstract: int = 0
    all_answered: int = 0
    with_failure: int = 0
    without_doi: int = 0
    none_asked: int = 0
    failures: Counter = field(default_factory=Counter)
    declined: Counter = field(default_factory=Counter)
    oa_undetermined: int = 0
    oa_without_doi: int = 0
    oa_not_found: int = 0
    oa_failed: int = 0
    oa_failures: Counter = field(default_factory=Counter)


def tally_lookups(
    papers: list[Paper], outcomes: list[LookupOutcome | None]
) -> LookupTally:
    """Count why `papers` still lack an abstract or an open-access status.

    `outcomes[i]` is the outcome of enriching `papers[i]`; a missing
    one reads as nothing asked. `failures` and `declined` count papers
    per `(provider, reason)`, `oa_failures` per reason.
    """
    tally = LookupTally(papers=len(papers))
    for index, paper in enumerate(papers):
        outcome = outcomes[index] if index < len(outcomes) else None
        outcome = outcome or LookupOutcome()
        <<count a paper still without an abstract>>
        <<count a paper whose open-access status is unknown>>
    return tally
